00F612  1  AD BE 07             lda Sfx_SecondaryCounter  ;this sound doesn't decrement the usual counter
00F615  1  4A                   lsr                       ;divide by 2 to get the offset
00F616  1  A8                   tay
00F617  1  CC BD 07             cpy Squ2_SfxLenCounter    ;have we reached the end yet?
00F61A  1  F0 0C                beq StopGrowItems         ;if so, branch to jump, and stop playing sounds
00F61C  1  A9 9D                lda #$9d                  ;load contents of other reg directly
00F61E  1  8D 04 40             sta SND_SQUARE2_REG
00F621  1  B9 F8 F4             lda PUp_VGrow_FreqData,y  ;use secondary counter / 2 as offset for frequency regs
00F624  1  20 A9 F3             jsr SetFreq_Squ2
