00D17B  1               BowserGfxHandler:
00D17B  1  20 BC D1               jsr ProcessBowserHalf    ;do a sub here to process bowser's front
00D17E  1  A0 10                  ldy #$10                 ;load default value here to position bowser's rear
00D180  1  B5 46                  lda Enemy_MovingDir,x    ;check moving direction
00D182  1  4A                     lsr
00D183  1  90 02                  bcc CopyFToR             ;if moving left, use default
00D185  1  A0 F0                  ldy #$f0                 ;otherwise load alternate positioning value here
00D187  1  98           CopyFToR: tya                      ;move bowser's rear object position value to A
00D188  1  18                     clc
00D189  1  75 87                  adc Enemy_X_Position,x   ;add to bowser's front object horizontal coordinate
00D18B  1  AC CF 06               ldy DuplicateObj_Offset  ;get bowser's rear object offset
00D18E  1  99 87 00               sta Enemy_X_Position,y   ;store A as bowser's rear horizontal coordinate
00D191  1  B5 CF                  lda Enemy_Y_Position,x
00D193  1  18                     clc                      ;add eight pixels to bowser's front object
00D194  1  69 08                  adc #$08                 ;vertical coordinate and store as vertical coordinate
00D196  1  99 CF 00               sta Enemy_Y_Position,y   ;for bowser's rear
00D199  1  B5 1E                  lda Enemy_State,x
00D19B  1  99 1E 00               sta Enemy_State,y        ;copy enemy state directly from front to rear
00D19E  1  B5 46                  lda Enemy_MovingDir,x
00D1A0  1  99 46 00               sta Enemy_MovingDir,y    ;copy moving direction also
00D1A3  1  A5 08                  lda ObjectOffset         ;save enemy object offset of front to stack
00D1A5  1  48                     pha
00D1A6  1  AE CF 06               ldx DuplicateObj_Offset  ;put enemy object offset of rear as current
00D1A9  1  86 08                  stx ObjectOffset
00D1AB  1  A9 2D                  lda #Bowser              ;set bowser's enemy identifier
00D1AD  1  95 16                  sta Enemy_ID,x           ;store in bowser's rear object
00D1AF  1  20 BC D1               jsr ProcessBowserHalf    ;do a sub here to process bowser's rear
00D1B2  1  68                     pla
00D1B3  1  85 08                  sta ObjectOffset         ;get original enemy object offset
00D1B5  1  AA                     tax
00D1B6  1  A9 00                  lda #$00                 ;nullify bowser's front/rear graphics flag
00D1B8  1  8D 6A 03               sta BowserGfxFlag
00D1BB  1  60           ExBGfxH:  rts                      ;leave!
00D1BC  1               
00D1BC  1               ProcessBowserHalf:
00D1BC  1  EE 6A 03           inc BowserGfxFlag         ;increment bowser's graphics flag, then run subroutines
00D1BF  1  20 D7 C8           jsr RunRetainerObj        ;to get offscreen bits, relative position and draw bowser (finally!)
00D1C2  1  B5 1E              lda Enemy_State,x
00D1C4  1  D0 F5              bne ExBGfxH               ;if either enemy object not in normal state, branch to leave
00D1C6  1  A9 0A              lda #$0a
00D1C8  1  9D 9A 04           sta Enemy_BoundBoxCtrl,x  ;set bounding box size control
00D1CB  1  20 43 E2           jsr GetEnemyBoundBox      ;get bounding box coordinates
00D1CE  1  4C 53 D8           jmp PlayerEnemyCollision  ;do player-to-enemy collision detection
