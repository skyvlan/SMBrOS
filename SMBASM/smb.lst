00B84B  1               
00B84B  1               FlagpoleScoreMods:
00B84B  1  05 02 08 04        .byte $05, $02, $08, $04, $01
00B84F  1  01           
00B850  1               
00B850  1               FlagpoleScoreDigits:
00B850  1  03 03 04 04        .byte $03, $03, $04, $04, $04
00B854  1  04           
00B855  1               
00B855  1               FlagpoleRoutine:
00B855  1  A2 05                   ldx #$05                  ;set enemy object offset
00B857  1  86 08                   stx ObjectOffset          ;to special use slot
00B859  1  B5 16                   lda Enemy_ID,x
00B85B  1  C9 30                   cmp #FlagpoleFlagObject   ;if flagpole flag not found,
00B85D  1  D0 56                   bne ExitFlagP             ;branch to leave
00B85F  1  A5 0E                   lda GameEngineSubroutine
00B861  1  C9 04                   cmp #$04                  ;if flagpole slide routine not running,
00B863  1  D0 31                   bne SkipScore             ;branch to near the end of code
00B865  1  A5 1D                   lda Player_State
00B867  1  C9 03                   cmp #$03                  ;if player state not climbing,
00B869  1  D0 2B                   bne SkipScore             ;branch to near the end of code
00B86B  1  B5 CF                   lda Enemy_Y_Position,x    ;check flagpole flag's vertical coordinate
00B86D  1  C9 AA                   cmp #$aa                  ;if flagpole flag down to a certain point,
00B86F  1  B0 28                   bcs GiveFPScr             ;branch to end the level
00B871  1  A5 CE                   lda Player_Y_Position     ;check player's vertical coordinate
00B873  1  C9 A2                   cmp #$a2                  ;if player down to a certain point,
00B875  1  B0 22                   bcs GiveFPScr             ;branch to end the level
00B877  1  BD 17 04                lda Enemy_YMF_Dummy,x
00B87A  1  69 FF                   adc #$ff                  ;add movement amount to dummy variable
00B87C  1  9D 17 04                sta Enemy_YMF_Dummy,x     ;save dummy variable
00B87F  1  B5 CF                   lda Enemy_Y_Position,x    ;get flag's vertical coordinate
00B881  1  69 01                   adc #$01                  ;add 1 plus carry to move flag, and
00B883  1  95 CF                   sta Enemy_Y_Position,x    ;store vertical coordinate
00B885  1  AD 0E 01                lda FlagpoleFNum_YMFDummy
00B888  1  38                      sec                       ;subtract movement amount from dummy variable
00B889  1  E9 FF                   sbc #$ff
00B88B  1  8D 0E 01                sta FlagpoleFNum_YMFDummy ;save dummy variable
00B88E  1  AD 0D 01                lda FlagpoleFNum_Y_Pos
00B891  1  E9 01                   sbc #$01                  ;subtract one plus borrow to move floatey number,
00B893  1  8D 0D 01                sta FlagpoleFNum_Y_Pos    ;and store vertical coordinate here
00B896  1  4C AC B8     SkipScore: jmp FPGfx                 ;jump to skip ahead and draw flag and floatey number
00B899  1  AC 0F 01     GiveFPScr: ldy FlagpoleScore         ;get score offset from earlier (when player touched flagpole)
00B89C  1  B9 4B B8                lda FlagpoleScoreMods,y   ;get amount to award player points
00B89F  1  BE 50 B8                ldx FlagpoleScoreDigits,y ;get digit with which to award points
00B8A2  1  9D 34 01                sta DigitModifier,x       ;store in digit modifier
00B8A5  1  20 27 BC                jsr AddToScore            ;do sub to award player points depending on height of collision
00B8A8  1  A9 05                   lda #$05
00B8AA  1  85 0E                   sta GameEngineSubroutine  ;set to run end-of-level subroutine on next frame
00B8AC  1  20 AF F1     FPGfx:     jsr GetEnemyOffscreenBits ;get offscreen information
00B8AF  1  20 52 F1                jsr RelativeEnemyPosition ;get relative coordinates
00B8B2  1  20 4B E5                jsr FlagpoleGfxHandler    ;draw flagpole flag and floatey number
00B8B5  1  60           ExitFlagP: rts
