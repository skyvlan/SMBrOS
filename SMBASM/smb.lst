009001  1  8D 25 07                    sta CurrentPageLoc       ;also set as current page
009004  1  8D 28 07                    sta BackloadingFlag      ;set flag here if halfway page or saved entry page number found
009007  1  20 38 B0                    jsr GetScreenPosition    ;get pixel coordinates for screen borders
00900A  1  A0 20                       ldy #$20                 ;if on odd numbered page, use $2480 as start of rendering
00900C  1  29 01                       and #%00000001           ;otherwise use $2080, this address used later as name table
00900E  1  F0 02                       beq SetInitNTHigh        ;address for rendering of game area
009010  1  A0 24                       ldy #$24
009012  1  8C 20 07     SetInitNTHigh: sty CurrentNTAddr_High   ;store name table address
009015  1  A0 80                       ldy #$80
009017  1  8C 21 07                    sty CurrentNTAddr_Low
00901A  1  0A                          asl                      ;store LSB of page number in high nybble
00901B  1  0A                          asl                      ;of block buffer column position
00901C  1  0A                          asl
00901D  1  0A                          asl
00901E  1  8D A0 06                    sta BlockBufferColumnPos
009021  1  CE 30 07                    dec AreaObjectLength     ;set area object lengths for all empty
009024  1  CE 31 07                    dec AreaObjectLength+1
009027  1  CE 32 07                    dec AreaObjectLength+2
00902A  1  A9 0B                       lda #$0b                 ;set value for renderer to update 12 column sets
00902C  1  8D 1E 07                    sta ColumnSets           ;12 column sets = 24 metatile columns = 1 1/2 screens
00902F  1  20 22 9C                    jsr GetAreaDataAddrs     ;get enemy and level addresses and load header
009032  1  AD 6A 07                    lda PrimaryHardMode      ;check to see if primary hard mode has been activated
009035  1  D0 10                       bne SetSecHard           ;if so, activate the secondary no matter where we're at
009037  1  AD 5F 07                    lda WorldNumber          ;otherwise check world number
