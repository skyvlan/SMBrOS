008F04  1  1E 24        
008F06  1               
008F06  1               PrintStatusBarNumbers:
008F06  1  85 00              sta $00            ;store player-specific offset
008F08  1  20 11 8F           jsr OutputNumbers  ;use first nybble to print the coin display
008F0B  1  A5 00              lda $00            ;move high nybble to low
008F0D  1  4A                 lsr                ;and print to score display
008F0E  1  4A                 lsr
008F0F  1  4A                 lsr
008F10  1  4A                 lsr
008F11  1               
008F11  1               OutputNumbers:
008F11  1  18                        clc                      ;add 1 to low nybble
008F12  1  69 01                     adc #$01
008F14  1  29 0F                     and #%00001111           ;mask out high nybble
008F16  1  C9 06                     cmp #$06
008F18  1  B0 44                     bcs ExitOutputN
008F1A  1  48                        pha                      ;save incremented value to stack for now and
008F1B  1  0A                        asl                      ;shift to left and use as offset
008F1C  1  A8                        tay
008F1D  1  AE 00 03                  ldx VRAM_Buffer1_Offset  ;get current buffer pointer
008F20  1  A9 20                     lda #$20                 ;put at top of screen by default
008F22  1  C0 00                     cpy #$00                 ;are we writing top score on title screen?
008F24  1  D0 02                     bne SetupNums
008F26  1  A9 22                     lda #$22                 ;if so, put further down on the screen
008F28  1  9D 01 03     SetupNums:   sta VRAM_Buffer1,x
008F2B  1  B9 F4 8E                  lda StatusBarData,y      ;write low vram address and length of thing
008F2E  1  9D 02 03                  sta VRAM_Buffer1+1,x     ;we're printing to the buffer
008F31  1  B9 F5 8E                  lda StatusBarData+1,y
008F34  1  9D 03 03                  sta VRAM_Buffer1+2,x
008F37  1  85 03                     sta $03                  ;save length byte in counter
008F39  1  86 02                     stx $02                  ;and buffer pointer elsewhere for now
008F3B  1  68                        pla                      ;pull original incremented value from stack
008F3C  1  AA                        tax
008F3D  1  BD 00 8F                  lda StatusBarOffset,x    ;load offset to value we want to write
008F40  1  38                        sec
008F41  1  F9 F5 8E                  sbc StatusBarData+1,y    ;subtract from length byte we read before
008F44  1  A8                        tay                      ;use value as offset to display digits
008F45  1  A6 02                     ldx $02
008F47  1  B9 D7 07     DigitPLoop:  lda DisplayDigits,y      ;write digits to the buffer
008F4A  1  9D 04 03                  sta VRAM_Buffer1+3,x
008F4D  1  E8                        inx
008F4E  1  C8                        iny
008F4F  1  C6 03                     dec $03                  ;do this until all the digits are written
008F51  1  D0 F4                     bne DigitPLoop
008F53  1  A9 00                     lda #$00                 ;put null terminator at end
008F55  1  9D 04 03                  sta VRAM_Buffer1+3,x
008F58  1  E8                        inx                      ;increment buffer pointer by 3
008F59  1  E8                        inx
008F5A  1  E8                        inx
008F5B  1  8E 00 03                  stx VRAM_Buffer1_Offset  ;store it in case we want to use it again
008F5E  1  60           ExitOutputN: rts
