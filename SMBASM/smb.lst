00E4DC  1               DrawHammer:
00E4DC  1  BC F3 06                 ldy Misc_SprDataOffset,x    ;get misc object OAM data offset
00E4DF  1  AD 47 07                 lda TimerControl
00E4E2  1  D0 08                    bne ForceHPose              ;if master timer control set, skip this part
00E4E4  1  B5 2A                    lda Misc_State,x            ;otherwise get hammer's state
00E4E6  1  29 7F                    and #%01111111              ;mask out d7
00E4E8  1  C9 01                    cmp #$01                    ;check to see if set to 1 yet
00E4EA  1  F0 04                    beq GetHPose                ;if so, branch
00E4EC  1  A2 00        ForceHPose: ldx #$00                    ;reset offset here
00E4EE  1  F0 07                    beq RenderH                 ;do unconditional branch to rendering part
00E4F0  1  A5 09        GetHPose:   lda FrameCounter            ;get frame counter
00E4F2  1  4A                       lsr                         ;move d3-d2 to d1-d0
00E4F3  1  4A                       lsr
00E4F4  1  29 03                    and #%00000011              ;mask out all but d1-d0 (changes every four frames)
00E4F6  1  AA                       tax                         ;use as timing offset
00E4F7  1  AD BE 03     RenderH:    lda Misc_Rel_YPos           ;get relative vertical coordinate
00E4FA  1  18                       clc
00E4FB  1  7D C4 E4                 adc FirstSprYPos,x          ;add first sprite vertical adder based on offset
00E4FE  1  99 00 02                 sta Sprite_Y_Position,y     ;store as sprite Y coordinate for first sprite
00E501  1  18                       clc
00E502  1  7D CC E4                 adc SecondSprYPos,x         ;add second sprite vertical adder based on offset
00E505  1  99 04 02                 sta Sprite_Y_Position+4,y   ;store as sprite Y coordinate for second sprite
00E508  1  AD B3 03                 lda Misc_Rel_XPos           ;get relative horizontal coordinate
00E50B  1  18                       clc
00E50C  1  7D C0 E4                 adc FirstSprXPos,x          ;add first sprite horizontal adder based on offset
00E50F  1  99 03 02                 sta Sprite_X_Position,y     ;store as sprite X coordinate for first sprite
00E512  1  18                       clc
00E513  1  7D C8 E4                 adc SecondSprXPos,x         ;add second sprite horizontal adder based on offset
00E516  1  99 07 02                 sta Sprite_X_Position+4,y   ;store as sprite X coordinate for second sprite
00E519  1  BD D0 E4                 lda FirstSprTilenum,x
00E51C  1  99 01 02                 sta Sprite_Tilenumber,y     ;get and store tile number of first sprite
00E51F  1  BD D4 E4                 lda SecondSprTilenum,x
00E522  1  99 05 02                 sta Sprite_Tilenumber+4,y   ;get and store tile number of second sprite
00E525  1  BD D8 E4                 lda HammerSprAttrib,x
00E528  1  99 02 02                 sta Sprite_Attributes,y     ;get and store attribute bytes for both
00E52B  1  99 06 02                 sta Sprite_Attributes+4,y   ;note in this case they use the same data
00E52E  1  A6 08                    ldx ObjectOffset            ;get misc object offset
