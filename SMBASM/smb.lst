00F282  1               ;$00-$01 - tile numbers
00F282  1               ;$02 - Y coordinate
00F282  1               ;$03 - flip control
00F282  1               ;$04 - sprite attributes
00F282  1               ;$05 - X coordinate
00F282  1               
00F282  1               DrawSpriteObject:
00F282  1  A5 03                 lda $03                    ;get saved flip control bits
00F284  1  4A                    lsr
00F285  1  4A                    lsr                        ;move d1 into carry
00F286  1  A5 00                 lda $00
00F288  1  90 0C                 bcc NoHFlip                ;if d1 not set, branch
00F28A  1  99 05 02              sta Sprite_Tilenumber+4,y  ;store first tile into second sprite
00F28D  1  A5 01                 lda $01                    ;and second into first sprite
00F28F  1  99 01 02              sta Sprite_Tilenumber,y
00F292  1  A9 40                 lda #$40                   ;activate horizontal flip OAM attribute
00F294  1  D0 0A                 bne SetHFAt                ;and unconditionally branch
00F296  1  99 01 02     NoHFlip: sta Sprite_Tilenumber,y    ;store first tile into first sprite
00F299  1  A5 01                 lda $01                    ;and second into second sprite
00F29B  1  99 05 02              sta Sprite_Tilenumber+4,y
00F29E  1  A9 00                 lda #$00                   ;clear bit for horizontal flip
00F2A0  1  05 04        SetHFAt: ora $04                    ;add other OAM attributes if necessary
00F2A2  1  99 02 02              sta Sprite_Attributes,y    ;store sprite attributes
00F2A5  1  99 06 02              sta Sprite_Attributes+4,y
00F2A8  1  A5 02                 lda $02                    ;now the y coordinates
00F2AA  1  99 00 02              sta Sprite_Y_Position,y    ;note because they are
00F2AD  1  99 04 02              sta Sprite_Y_Position+4,y  ;side by side, they are the same
00F2B0  1  A5 05                 lda $05
00F2B2  1  99 03 02              sta Sprite_X_Position,y    ;store x coordinate, then
00F2B5  1  18                    clc                        ;add 8 pixels and store another to
00F2B6  1  69 08                 adc #$08                   ;put them side by side
00F2B8  1  99 07 02              sta Sprite_X_Position+4,y
00F2BB  1  A5 02                 lda $02                    ;add eight pixels to the next y
00F2BD  1  18                    clc                        ;coordinate
00F2BE  1  69 08                 adc #$08
00F2C0  1  85 02                 sta $02
00F2C2  1  98                    tya                        ;add eight to the offset in Y to
00F2C3  1  18                    clc                        ;move to the next two sprites
00F2C4  1  69 08                 adc #$08
00F2C6  1  A8                    tay
00F2C7  1  E8                    inx                        ;increment offset to return it to the
00F2C8  1  E8                    inx                        ;routine that called this subroutine
00F2C9  1  60                    rts
