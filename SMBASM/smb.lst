0097C1  1  C8                      iny
0097C2  1  BD 30 07                lda AreaObjectLength,x    ;if not at the end, render rope
0097C5  1  D0 01                   bne RenderPul
0097C7  1  C8                      iny                       ;otherwise render right pulley
0097C8  1  B9 B7 97     RenderPul: lda PulleyRopeMetatiles,y
0097CB  1  8D A1 06                sta MetatileBuffer        ;render at the top of the screen
0097CE  1  60           MushLExit: rts                       ;and leave
