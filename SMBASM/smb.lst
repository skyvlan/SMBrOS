00EFA4  1               DrawPlayer_Intermediate:
00EFA4  1  A2 05                  ldx #$05                       ;store data into zero page memory
00EFA6  1  BD 9E EF     PIntLoop: lda IntermediatePlayerData,x   ;load data to display player as he always
00EFA9  1  95 02                  sta $02,x                      ;appears on world/lives display
00EFAB  1  CA                     dex
00EFAC  1  10 F8                  bpl PIntLoop                   ;do this until all data is loaded
00EFAE  1  A2 B8                  ldx #$b8                       ;load offset for small standing
00EFB0  1  A0 04                  ldy #$04                       ;load sprite data offset
00EFB2  1  20 DC EF               jsr DrawPlayerLoop             ;draw player accordingly
00EFB5  1  AD 26 02               lda Sprite_Attributes+36       ;get empty sprite attributes
00EFB8  1  09 40                  ora #%01000000                 ;set horizontal flip bit for bottom-right sprite
00EFBA  1  8D 22 02               sta Sprite_Attributes+32       ;store and leave
00EFBD  1  60                     rts
00EFBE  1               
00EFBE  1               ;-------------------------------------------------------------------------------------
00EFBE  1               ;$00-$01 - used to hold tile numbers, $00 also used to hold upper extent of animation frames
00EFBE  1               ;$02 - vertical position
00EFBE  1               ;$03 - facing direction, used as horizontal flip control
00EFBE  1               ;$04 - attributes
00EFBE  1               ;$05 - horizontal position
00EFBE  1               ;$07 - number of rows to draw
00EFBE  1               ;these also used in IntermediatePlayerData
00EFBE  1               
00EFBE  1               RenderPlayerSub:
00EFBE  1  85 07                sta $07                      ;store number of rows of sprites to draw
00EFC0  1  AD AD 03             lda Player_Rel_XPos
00EFC3  1  8D 55 07             sta Player_Pos_ForScroll     ;store player's relative horizontal position
00EFC6  1  85 05                sta $05                      ;store it here also
00EFC8  1  AD B8 03             lda Player_Rel_YPos
00EFCB  1  85 02                sta $02                      ;store player's vertical position
00EFCD  1  A5 33                lda PlayerFacingDir
00EFCF  1  85 03                sta $03                      ;store player's facing direction
00EFD1  1  AD C4 03             lda Player_SprAttrib
00EFD4  1  85 04                sta $04                      ;store player's sprite attributes
00EFD6  1  AE D5 06             ldx PlayerGfxOffset          ;load graphics table offset
00EFD9  1  AC E4 06             ldy Player_SprDataOffset     ;get player's sprite data offset
00EFDC  1               
00EFDC  1               DrawPlayerLoop:
00EFDC  1  BD 17 EE             lda PlayerGraphicsTable,x    ;load player's left side
00EFDF  1  85 00                sta $00
00EFE1  1  BD 18 EE             lda PlayerGraphicsTable+1,x  ;now load right side
00EFE4  1  20 B2 EB             jsr DrawOneSpriteRow
00EFE7  1  C6 07                dec $07                      ;decrement rows of sprites to draw
00EFE9  1  D0 F1                bne DrawPlayerLoop           ;do this until all rows are drawn
00EFEB  1  60                   rts
00EFEC  1               
00EFEC  1               ProcessPlayerAction:
00EFEC  1  A5 1D                lda Player_State      ;get player's state
00EFEE  1  C9 03                cmp #$03
00EFF0  1  F0 52                beq ActionClimbing    ;if climbing, branch here
00EFF2  1  C9 02                cmp #$02
00EFF4  1  F0 3E                beq ActionFalling     ;if falling, branch here
00EFF6  1  C9 01                cmp #$01
00EFF8  1  D0 11                bne ProcOnGroundActs  ;if not jumping, branch here
00EFFA  1  AD 04 07             lda SwimmingFlag
00EFFD  1  D0 51                bne ActionSwimming    ;if swimming flag set, branch elsewhere
00EFFF  1  A0 06                ldy #$06              ;load offset for crouching
00F001  1  AD 14 07             lda CrouchingFlag     ;get crouching flag
00F004  1  D0 22                bne NonAnimatedActs   ;if set, branch to get offset for graphics table
00F006  1  A0 00                ldy #$00              ;otherwise load offset for jumping
00F008  1  4C 28 F0             jmp NonAnimatedActs   ;go to get offset to graphics table
00F00B  1               
00F00B  1               ProcOnGroundActs:
00F00B  1  A0 06                ldy #$06                   ;load offset for crouching
00F00D  1  AD 14 07             lda CrouchingFlag          ;get crouching flag
00F010  1  D0 16                bne NonAnimatedActs        ;if set, branch to get offset for graphics table
00F012  1  A0 02                ldy #$02                   ;load offset for standing
00F014  1  A5 57                lda Player_X_Speed         ;check player's horizontal speed
00F016  1  05 0C                ora Left_Right_Buttons     ;and left/right controller bits
00F018  1  F0 0E                beq NonAnimatedActs        ;if no speed or buttons pressed, use standing offset
00F01A  1  AD 00 07             lda Player_XSpeedAbsolute  ;load walking/running speed
00F01D  1  C9 09                cmp #$09
00F01F  1  90 1B                bcc ActionWalkRun          ;if less than a certain amount, branch, too slow to skid
00F021  1  A5 45                lda Player_MovingDir       ;otherwise check to see if moving direction
00F023  1  25 33                and PlayerFacingDir        ;and facing direction are the same
00F025  1  D0 15                bne ActionWalkRun          ;if moving direction = facing direction, branch, don't skid
00F027  1  C8                   iny                        ;otherwise increment to skid offset ($03)
00F028  1               
00F028  1               NonAnimatedActs:
00F028  1  20 91 F0             jsr GetGfxOffsetAdder      ;do a sub here to get offset adder for graphics table
00F02B  1  A9 00                lda #$00
00F02D  1  8D 0D 07             sta PlayerAnimCtrl         ;initialize animation frame control
00F030  1  B9 07 EE             lda PlayerGfxTblOffsets,y  ;load offset to graphics table using size as offset
00F033  1  60                   rts
00F034  1               
00F034  1               ActionFalling:
00F034  1  A0 04                ldy #$04                  ;load offset for walking/running
00F036  1  20 91 F0             jsr GetGfxOffsetAdder     ;get offset to graphics table
00F039  1  4C 62 F0             jmp GetCurrentAnimOffset  ;execute instructions for falling state
00F03C  1               
00F03C  1               ActionWalkRun:
00F03C  1  A0 04                ldy #$04               ;load offset for walking/running
00F03E  1  20 91 F0             jsr GetGfxOffsetAdder  ;get offset to graphics table
00F041  1  4C 68 F0             jmp FourFrameExtent    ;execute instructions for normal state
00F044  1               
00F044  1               ActionClimbing:
00F044  1  A0 05                ldy #$05               ;load offset for climbing
00F046  1  A5 9F                lda Player_Y_Speed     ;check player's vertical speed
00F048  1  F0 DE                beq NonAnimatedActs    ;if no speed, branch, use offset as-is
00F04A  1  20 91 F0             jsr GetGfxOffsetAdder  ;otherwise get offset for graphics table
00F04D  1  4C 6D F0             jmp ThreeFrameExtent   ;then skip ahead to more code
00F050  1               
00F050  1               ActionSwimming:
00F050  1  A0 01                ldy #$01               ;load offset for swimming
00F052  1  20 91 F0             jsr GetGfxOffsetAdder
00F055  1  AD 82 07             lda JumpSwimTimer      ;check jump/swim timer
00F058  1  0D 0D 07             ora PlayerAnimCtrl     ;and animation frame control
00F05B  1  D0 0B                bne FourFrameExtent    ;if any one of these set, branch ahead
00F05D  1  A5 0A                lda A_B_Buttons
00F05F  1  0A                   asl                    ;check for A button pressed
00F060  1  B0 06                bcs FourFrameExtent    ;branch to same place if A button pressed
00F062  1               
00F062  1               GetCurrentAnimOffset:
00F062  1  AD 0D 07             lda PlayerAnimCtrl         ;get animation frame control
00F065  1  4C D0 F0             jmp GetOffsetFromAnimCtrl  ;jump to get proper offset to graphics table
00F068  1               
00F068  1               FourFrameExtent:
00F068  1  A9 03                lda #$03              ;load upper extent for frame control
00F06A  1  4C 6F F0             jmp AnimationControl  ;jump to get offset and animate player object
00F06D  1               
00F06D  1               ThreeFrameExtent:
00F06D  1  A9 02                lda #$02              ;load upper extent for frame control for climbing
00F06F  1               
00F06F  1               AnimationControl:
00F06F  1  85 00                  sta $00                   ;store upper extent here
00F071  1  20 62 F0               jsr GetCurrentAnimOffset  ;get proper offset to graphics table
00F074  1  48                     pha                       ;save offset to stack
00F075  1  AD 81 07               lda PlayerAnimTimer       ;load animation frame timer
00F078  1  D0 15                  bne ExAnimC               ;branch if not expired
00F07A  1  AD 0C 07               lda PlayerAnimTimerSet    ;get animation frame timer amount
00F07D  1  8D 81 07               sta PlayerAnimTimer       ;and set timer accordingly
00F080  1  AD 0D 07               lda PlayerAnimCtrl
00F083  1  18                     clc                       ;add one to animation frame control
00F084  1  69 01                  adc #$01
00F086  1  C5 00                  cmp $00                   ;compare to upper extent
00F088  1  90 02                  bcc SetAnimC              ;if frame control + 1 < upper extent, use as next
00F08A  1  A9 00                  lda #$00                  ;otherwise initialize frame control
00F08C  1  8D 0D 07     SetAnimC: sta PlayerAnimCtrl        ;store as new animation frame control
00F08F  1  68           ExAnimC:  pla                       ;get offset to graphics table from stack and leave
00F090  1  60                     rts
00F091  1               
00F091  1               GetGfxOffsetAdder:
00F091  1  AD 54 07             lda PlayerSize  ;get player's size
00F094  1  F0 05                beq SzOfs       ;if player big, use current offset as-is
00F096  1  98                   tya             ;for big player
00F097  1  18                   clc             ;otherwise add eight bytes to offset
00F098  1  69 08                adc #$08        ;for small player
00F09A  1  A8                   tay
00F09B  1  60           SzOfs:  rts             ;go back
00F09C  1               
00F09C  1               ChangeSizeOffsetAdder:
00F09C  1  00 01 00 01          .byte $00, $01, $00, $01, $00, $01, $02, $00, $01, $02
00F0A0  1  00 01 02 00  
00F0A4  1  01 02        
