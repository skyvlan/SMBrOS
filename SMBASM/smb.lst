00E638  1  68           SChk5:  pla                         ;get bits from stack
00E639  1  0A                   asl                         ;rotate d3 into carry
00E63A  1  48                   pha                         ;save to stack
00E63B  1  90 05                bcc SChk6
00E63D  1  A9 F8                lda #$f8                    ;if d3 was set, move fifth sprite offscreen
00E63F  1  99 10 02             sta Sprite_Y_Position+16,y
00E642  1  68           SChk6:  pla                         ;get bits from stack
00E643  1  0A                   asl                         ;rotate d2 into carry
00E644  1  90 05                bcc SLChk                   ;save to stack
00E646  1  A9 F8                lda #$f8
00E648  1  99 14 02             sta Sprite_Y_Position+20,y  ;if d2 was set, move sixth sprite offscreen
00E64B  1  AD D1 03     SLChk:  lda Enemy_OffscreenBits     ;check d7 of offscreen bits
00E64E  1  0A                   asl                         ;and if d7 is not set, skip sub
00E64F  1  90 03                bcc ExDLPl
00E651  1  20 B3 E5             jsr MoveSixSpritesOffscreen ;otherwise branch to move all sprites offscreen
00E654  1  60           ExDLPl: rts
00E655  1               
00E655  1               ;-------------------------------------------------------------------------------------
00E655  1               
00E655  1               DrawFloateyNumber_Coin:
00E655  1  A5 09                  lda FrameCounter          ;get frame counter
00E657  1  4A                     lsr                       ;divide by 2
00E658  1  B0 02                  bcs NotRsNum              ;branch if d0 not set to raise number every other frame
00E65A  1  D6 DB                  dec Misc_Y_Position,x     ;otherwise, decrement vertical coordinate
00E65C  1  B5 DB        NotRsNum: lda Misc_Y_Position,x     ;get vertical coordinate
00E65E  1  20 C1 E5               jsr DumpTwoSpr            ;dump into both sprites
00E661  1  AD B3 03               lda Misc_Rel_XPos         ;get relative horizontal coordinate
00E664  1  99 03 02               sta Sprite_X_Position,y   ;store as X coordinate for first sprite
00E667  1  18                     clc
00E668  1  69 08                  adc #$08                  ;add eight pixels
00E66A  1  99 07 02               sta Sprite_X_Position+4,y ;store as X coordinate for second sprite
00E66D  1  A9 02                  lda #$02
00E66F  1  99 02 02               sta Sprite_Attributes,y   ;store attribute byte in both sprites
00E672  1  99 06 02               sta Sprite_Attributes+4,y
00E675  1  A9 F7                  lda #$f7
00E677  1  99 01 02               sta Sprite_Tilenumber,y   ;put tile numbers into both sprites
00E67A  1  A9 FB                  lda #$fb                  ;that resemble "200"
00E67C  1  99 05 02               sta Sprite_Tilenumber+4,y
00E67F  1  4C BD E6               jmp ExJCGfx               ;then jump to leave (why not an rts here instead?)
00E682  1               
00E682  1               JumpingCoinTiles:
00E682  1  60 61 62 63        .byte $60, $61, $62, $63
00E686  1               
00E686  1               JCoinGfxHandler:
00E686  1  BC F3 06              ldy Misc_SprDataOffset,x    ;get coin/floatey number's OAM data offset
00E689  1  B5 2A                 lda Misc_State,x            ;get state of misc object
00E68B  1  C9 02                 cmp #$02                    ;if 2 or greater,
00E68D  1  B0 C6                 bcs DrawFloateyNumber_Coin  ;branch to draw floatey number
00E68F  1  B5 DB                 lda Misc_Y_Position,x       ;store vertical coordinate as
00E691  1  99 00 02              sta Sprite_Y_Position,y     ;Y coordinate for first sprite
00E694  1  18                    clc
00E695  1  69 08                 adc #$08                    ;add eight pixels
00E697  1  99 04 02              sta Sprite_Y_Position+4,y   ;store as Y coordinate for second sprite
00E69A  1  AD B3 03              lda Misc_Rel_XPos           ;get relative horizontal coordinate
00E69D  1  99 03 02              sta Sprite_X_Position,y
00E6A0  1  99 07 02              sta Sprite_X_Position+4,y   ;store as X coordinate for first and second sprites
00E6A3  1  A5 09                 lda FrameCounter            ;get frame counter
00E6A5  1  4A                    lsr                         ;divide by 2 to alter every other frame
00E6A6  1  29 03                 and #%00000011              ;mask out d2-d1
00E6A8  1  AA                    tax                         ;use as graphical offset
00E6A9  1  BD 82 E6              lda JumpingCoinTiles,x      ;load tile number
00E6AC  1  C8                    iny                         ;increment OAM data offset to write tile numbers
00E6AD  1  20 C1 E5              jsr DumpTwoSpr              ;do sub to dump tile number into both sprites
00E6B0  1  88                    dey                         ;decrement to get old offset
00E6B1  1  A9 02                 lda #$02
00E6B3  1  99 02 02              sta Sprite_Attributes,y     ;set attribute byte in first sprite
00E6B6  1  A9 82                 lda #$82
00E6B8  1  99 06 02              sta Sprite_Attributes+4,y   ;set attribute byte with vertical flip in second sprite
00E6BB  1  A6 08                 ldx ObjectOffset            ;get misc object offset
00E6BD  1  60           ExJCGfx: rts                         ;leave
00E6BE  1               
00E6BE  1               ;-------------------------------------------------------------------------------------
00E6BE  1               ;$00-$01 - used to hold tiles for drawing the power-up, $00 also used to hold power-up type
00E6BE  1               ;$02 - used to hold bottom row Y position
00E6BE  1               ;$03 - used to hold flip control (not used here)
00E6BE  1               ;$04 - used to hold sprite attributes
00E6BE  1               ;$05 - used to hold X position
00E6BE  1               ;$07 - counter
00E6BE  1               
00E6BE  1               ;tiles arranged in top left, right, bottom left, right order
00E6BE  1               PowerUpGfxTable:
00E6BE  1  76 77 78 79        .byte $76, $77, $78, $79 ;regular mushroom
00E6C2  1  D6 D6 D9 D9        .byte $d6, $d6, $d9, $d9 ;fire flower
00E6C6  1  8D 8D E4 E4        .byte $8d, $8d, $e4, $e4 ;star
00E6CA  1  76 77 78 79        .byte $76, $77, $78, $79 ;1-up mushroom
00E6CE  1               
00E6CE  1               PowerUpAttributes:
00E6CE  1  02 01 02 01        .byte $02, $01, $02, $01
00E6D2  1               
00E6D2  1               DrawPowerUp:
00E6D2  1  AC EA 06           ldy Enemy_SprDataOffset+5  ;get power-up's sprite data offset
00E6D5  1  AD B9 03           lda Enemy_Rel_YPos         ;get relative vertical coordinate
00E6D8  1  18                 clc
00E6D9  1  69 08              adc #$08                   ;add eight pixels
00E6DB  1  85 02              sta $02                    ;store result here
00E6DD  1  AD AE 03           lda Enemy_Rel_XPos         ;get relative horizontal coordinate
00E6E0  1  85 05              sta $05                    ;store here
00E6E2  1  A6 39              ldx PowerUpType            ;get power-up type
00E6E4  1  BD CE E6           lda PowerUpAttributes,x    ;get attribute data for power-up type
00E6E7  1  0D CA 03           ora Enemy_SprAttrib+5      ;add background priority bit if set
00E6EA  1  85 04              sta $04                    ;store attributes here
00E6EC  1  8A                 txa
00E6ED  1  48                 pha                        ;save power-up type to the stack
00E6EE  1  0A                 asl
00E6EF  1  0A                 asl                        ;multiply by four to get proper offset
00E6F0  1  AA                 tax                        ;use as X
00E6F1  1  A9 01              lda #$01
00E6F3  1  85 07              sta $07                    ;set counter here to draw two rows of sprite object
00E6F5  1  85 03              sta $03                    ;init d1 of flip control
00E6F7  1               
00E6F7  1               PUpDrawLoop:
00E6F7  1  BD BE E6             lda PowerUpGfxTable,x      ;load left tile of power-up object
00E6FA  1  85 00                sta $00
00E6FC  1  BD BF E6             lda PowerUpGfxTable+1,x    ;load right tile
00E6FF  1  20 B2 EB             jsr DrawOneSpriteRow       ;branch to draw one row of our power-up object
00E702  1  C6 07                dec $07                    ;decrement counter
00E704  1  10 F1                bpl PUpDrawLoop            ;branch until two rows are drawn
00E706  1  AC EA 06             ldy Enemy_SprDataOffset+5  ;get sprite data offset again
00E709  1  68                   pla                        ;pull saved power-up type from the stack
00E70A  1  F0 2F                beq PUpOfs                 ;if regular mushroom, branch, do not change colors or flip
00E70C  1  C9 03                cmp #$03
00E70E  1  F0 2B                beq PUpOfs                 ;if 1-up mushroom, branch, do not change colors or flip
00E710  1  85 00                sta $00                    ;store power-up type here now
00E712  1  A5 09                lda FrameCounter           ;get frame counter
00E714  1  4A                   lsr                        ;divide by 2 to change colors every two frames
00E715  1  29 03                and #%00000011             ;mask out all but d1 and d0 (previously d2 and d1)
00E717  1  0D CA 03             ora Enemy_SprAttrib+5      ;add background priority bit if any set
00E71A  1  99 02 02             sta Sprite_Attributes,y    ;set as new palette bits for top left and
00E71D  1  99 06 02             sta Sprite_Attributes+4,y  ;top right sprites for fire flower and star
00E720  1  A6 00                ldx $00
00E722  1  CA                   dex                        ;check power-up type for fire flower
00E723  1  F0 06                beq FlipPUpRightSide       ;if found, skip this part
00E725  1  99 0A 02             sta Sprite_Attributes+8,y  ;otherwise set new palette bits  for bottom left
00E728  1  99 0E 02             sta Sprite_Attributes+12,y ;and bottom right sprites as well for star only
00E72B  1               
00E72B  1               FlipPUpRightSide:
00E72B  1  B9 06 02             lda Sprite_Attributes+4,y
00E72E  1  09 40                ora #%01000000             ;set horizontal flip bit for top right sprite
00E730  1  99 06 02             sta Sprite_Attributes+4,y
00E733  1  B9 0E 02             lda Sprite_Attributes+12,y
00E736  1  09 40                ora #%01000000             ;set horizontal flip bit for bottom right sprite
00E738  1  99 0E 02             sta Sprite_Attributes+12,y ;note these are only done for fire flower and star power-ups
00E73B  1  4C 64 EB     PUpOfs: jmp SprObjectOffscrChk     ;jump to check to see if power-up is offscreen at all, then leave
00E73E  1               
