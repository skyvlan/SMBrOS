00CF28  1               MoveLakitu:
00CF28  1  B5 1E                 lda Enemy_State,x          ;check lakitu's enemy state
00CF2A  1  29 20                 and #%00100000             ;for d5 set
00CF2C  1  F0 03                 beq ChkLS                  ;if not set, continue with code
00CF2E  1  4C 63 BF              jmp MoveD_EnemyVertically  ;otherwise jump to move defeated lakitu downwards
00CF31  1  B5 1E        ChkLS:   lda Enemy_State,x          ;if lakitu's enemy state not set at all,
00CF33  1  F0 0B                 beq Fr12S                  ;go ahead and continue with code
00CF35  1  A9 00                 lda #$00
00CF37  1  95 A0                 sta LakituMoveDirection,x  ;otherwise initialize moving direction to move to left
00CF39  1  8D CB 06              sta EnemyFrenzyBuffer      ;initialize frenzy buffer
00CF3C  1  A9 10                 lda #$10
00CF3E  1  D0 13                 bne SetLSpd                ;load horizontal speed and do unconditional branch
00CF40  1  A9 12        Fr12S:   lda #Spiny
00CF42  1  8D CB 06              sta EnemyFrenzyBuffer      ;set spiny identifier in frenzy buffer
00CF45  1  A0 02                 ldy #$02
00CF47  1  B9 25 CF     LdLDa:   lda LakituDiffAdj,y        ;load values
00CF4A  1  99 01 00              sta $0001,y                ;store in zero page
00CF4D  1  88                    dey
00CF4E  1  10 F7                 bpl LdLDa                  ;do this until all values are stired
00CF50  1  20 6C CF              jsr PlayerLakituDiff       ;execute sub to set speed and create spinys
00CF53  1  95 58        SetLSpd: sta LakituMoveSpeed,x      ;set movement speed returned from sub
00CF55  1  A0 01                 ldy #$01                   ;set moving direction to right by default
00CF57  1  B5 A0                 lda LakituMoveDirection,x
00CF59  1  29 01                 and #$01                   ;get LSB of moving direction
00CF5B  1  D0 0A                 bne SetLMov                ;if set, branch to the end to use moving direction
00CF5D  1  B5 58                 lda LakituMoveSpeed,x
00CF5F  1  49 FF                 eor #$ff                   ;get two's compliment of moving speed
00CF61  1  18                    clc
00CF62  1  69 01                 adc #$01
00CF64  1  95 58                 sta LakituMoveSpeed,x      ;store as new moving speed
00CF66  1  C8                    iny                        ;increment moving direction to left
00CF67  1  94 46        SetLMov: sty Enemy_MovingDir,x      ;store moving direction
00CF69  1  4C 02 BF              jmp MoveEnemyHorizontally  ;move lakitu horizontally
00CF6C  1               
00CF6C  1               PlayerLakituDiff:
00CF6C  1  A0 00                   ldy #$00                   ;set Y for default value
00CF6E  1  20 43 E1                jsr PlayerEnemyDiff        ;get horizontal difference between enemy and player
00CF71  1  10 0A                   bpl ChkLakDif              ;branch if enemy is to the right of the player
00CF73  1  C8                      iny                        ;increment Y for left of player
00CF74  1  A5 00                   lda $00
00CF76  1  49 FF                   eor #$ff                   ;get two's compliment of low byte of horizontal difference
00CF78  1  18                      clc
00CF79  1  69 01                   adc #$01                   ;store two's compliment as horizontal difference
00CF7B  1  85 00                   sta $00
00CF7D  1  A5 00        ChkLakDif: lda $00                    ;get low byte of horizontal difference
00CF7F  1  C9 3C                   cmp #$3c                   ;if within a certain distance of player, branch
00CF81  1  90 1C                   bcc ChkPSpeed
00CF83  1  A9 3C                   lda #$3c                   ;otherwise set maximum distance
00CF85  1  85 00                   sta $00
00CF87  1  B5 16                   lda Enemy_ID,x             ;check if lakitu is in our current enemy slot
00CF89  1  C9 11                   cmp #Lakitu
00CF8B  1  D0 12                   bne ChkPSpeed              ;if not, branch elsewhere
00CF8D  1  98                      tya                        ;compare contents of Y, now in A
00CF8E  1  D5 A0                   cmp LakituMoveDirection,x  ;to what is being used as horizontal movement direction
00CF90  1  F0 0D                   beq ChkPSpeed              ;if moving toward the player, branch, do not alter
00CF92  1  B5 A0                   lda LakituMoveDirection,x  ;if moving to the left beyond maximum distance,
00CF94  1  F0 06                   beq SetLMovD               ;branch and alter without delay
00CF96  1  D6 58                   dec LakituMoveSpeed,x      ;decrement horizontal speed
00CF98  1  B5 58                   lda LakituMoveSpeed,x      ;if horizontal speed not yet at zero, branch to leave
00CF9A  1  D0 40                   bne ExMoveLak
00CF9C  1  98           SetLMovD:  tya                        ;set horizontal direction depending on horizontal
00CF9D  1  95 A0                   sta LakituMoveDirection,x  ;difference between enemy and player if necessary
00CF9F  1  A5 00        ChkPSpeed: lda $00
00CFA1  1  29 3C                   and #%00111100             ;mask out all but four bits in the middle
00CFA3  1  4A                      lsr                        ;divide masked difference by four
00CFA4  1  4A                      lsr
00CFA5  1  85 00                   sta $00                    ;store as new value
00CFA7  1  A0 00                   ldy #$00                   ;init offset
00CFA9  1  A5 57                   lda Player_X_Speed
00CFAB  1  F0 24                   beq SubDifAdj              ;if player not moving horizontally, branch
00CFAD  1  AD 75 07                lda ScrollAmount
00CFB0  1  F0 1F                   beq SubDifAdj              ;if scroll speed not set, branch to same place
00CFB2  1  C8                      iny                        ;otherwise increment offset
00CFB3  1  A5 57                   lda Player_X_Speed
00CFB5  1  C9 19                   cmp #$19                   ;if player not running, branch
00CFB7  1  90 08                   bcc ChkSpinyO
00CFB9  1  AD 75 07                lda ScrollAmount
00CFBC  1  C9 02                   cmp #$02                   ;if scroll speed below a certain amount, branch
00CFBE  1  90 01                   bcc ChkSpinyO              ;to same place
00CFC0  1  C8                      iny                        ;otherwise increment once more
00CFC1  1  B5 16        ChkSpinyO: lda Enemy_ID,x             ;check for spiny object
00CFC3  1  C9 12                   cmp #Spiny
00CFC5  1  D0 04                   bne ChkEmySpd              ;branch if not found
00CFC7  1  A5 57                   lda Player_X_Speed         ;if player not moving, skip this part
00CFC9  1  D0 06                   bne SubDifAdj
00CFCB  1  B5 A0        ChkEmySpd: lda Enemy_Y_Speed,x        ;check vertical speed
00CFCD  1  D0 02                   bne SubDifAdj              ;branch if nonzero
00CFCF  1  A0 00                   ldy #$00                   ;otherwise reinit offset
00CFD1  1  B9 01 00     SubDifAdj: lda $0001,y                ;get one of three saved values from earlier
00CFD4  1  A4 00                   ldy $00                    ;get saved horizontal difference
00CFD6  1  38           SPixelLak: sec                        ;subtract one for each pixel of horizontal difference
00CFD7  1  E9 01                   sbc #$01                   ;from one of three saved values
00CFD9  1  88                      dey
00CFDA  1  10 FA                   bpl SPixelLak              ;branch until all pixels are subtracted, to adjust difference
00CFDC  1  60           ExMoveLak: rts                        ;leave!!!
