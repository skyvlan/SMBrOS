008943  1  A4 00                    ldy $00                      ;get current vram buffer offset, increment by 3
008945  1  C8                       iny                          ;(for name table address and length bytes)
008946  1  C8                       iny
008947  1  C8                       iny
008948  1  A9 00                    lda #$00
00894A  1  99 41 03                 sta VRAM_Buffer2,y           ;put null terminator at end of data for name table
00894D  1  8C 40 03                 sty VRAM_Buffer2_Offset      ;store new buffer offset
008950  1  EE 21 07                 inc CurrentNTAddr_Low        ;increment name table address low
008953  1  AD 21 07                 lda CurrentNTAddr_Low        ;check current low byte
008956  1  29 1F                    and #%00011111               ;if no wraparound, just skip this part
008958  1  D0 0D                    bne ExitDrawM
