00859B  1               
00859B  1               ;-------------------------------------------------------------------------------------
00859B  1               
00859B  1               SetupIntermediate:
00859B  1  AD 44 07           lda BackgroundColorCtrl  ;save current background color control
00859E  1  48                 pha                      ;and player status to stack
00859F  1  AD 56 07           lda PlayerStatus
0085A2  1  48                 pha
0085A3  1  A9 00              lda #$00                 ;set background color to black
0085A5  1  8D 56 07           sta PlayerStatus         ;and player status to not fiery
0085A8  1  A9 02              lda #$02                 ;this is the ONLY time background color control
0085AA  1  8D 44 07           sta BackgroundColorCtrl  ;is set to less than 4
0085AD  1  20 F1 85           jsr GetPlayerColors
0085B0  1  68                 pla                      ;we only execute this routine for
0085B1  1  8D 56 07           sta PlayerStatus         ;the intermediate lives display
0085B4  1  68                 pla                      ;and once we're done, we return bg
0085B5  1  8D 44 07           sta BackgroundColorCtrl  ;color ctrl and player status from stack
0085B8  1  4C 45 87           jmp IncSubtask           ;then move onto the next task
0085BB  1               
0085BB  1               ;-------------------------------------------------------------------------------------
0085BB  1               
