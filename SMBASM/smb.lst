00EF40  1  A0 0E              ldy #$0e                      ;load offset for player killed
00EF42  1  B9 07 EE           lda PlayerGfxTblOffsets,y     ;get offset to graphics table
00EF45  1               
00EF45  1               PlayerGfxProcessing:
00EF45  1  8D D5 06            sta PlayerGfxOffset           ;store offset to graphics table here
00EF48  1  A9 04               lda #$04
00EF4A  1  20 BE EF            jsr RenderPlayerSub           ;draw player based on offset loaded
00EF4D  1  20 E9 F0            jsr ChkForPlayerAttrib        ;set horizontal flip bits as necessary
00EF50  1  AD 11 07            lda FireballThrowingTimer
00EF53  1  F0 25               beq PlayerOffscreenChk        ;if fireball throw timer not set, skip to the end
00EF55  1  A0 00               ldy #$00                      ;set value to initialize by default
00EF57  1  AD 81 07            lda PlayerAnimTimer           ;get animation frame timer
00EF5A  1  CD 11 07            cmp FireballThrowingTimer     ;compare to fireball throw timer
00EF5D  1  8C 11 07            sty FireballThrowingTimer     ;initialize fireball throw timer
00EF60  1  B0 18               bcs PlayerOffscreenChk        ;if animation frame timer => fireball throw timer skip to end
00EF62  1  8D 11 07            sta FireballThrowingTimer     ;otherwise store animation timer into fireball throw timer
00EF65  1  A0 07               ldy #$07                      ;load offset for throwing
00EF67  1  B9 07 EE            lda PlayerGfxTblOffsets,y     ;get offset to graphics table
00EF6A  1  8D D5 06            sta PlayerGfxOffset           ;store it for use later
00EF6D  1  A0 04               ldy #$04                      ;set to update four sprite rows by default
00EF6F  1  A5 57               lda Player_X_Speed
00EF71  1  05 0C               ora Left_Right_Buttons        ;check for horizontal speed or left/right button press
00EF73  1  F0 01               beq SUpdR                     ;if no speed or button press, branch using set value in Y
00EF75  1  88                  dey                           ;otherwise set to update only three sprite rows
00EF76  1  98           SUpdR: tya                           ;save in A for use
00EF77  1  20 BE EF            jsr RenderPlayerSub           ;in sub, draw player object again
00EF7A  1               
00EF7A  1               PlayerOffscreenChk:
00EF7A  1  AD D0 03                lda Player_OffscreenBits      ;get player's offscreen bits
00EF7D  1  4A                      lsr
00EF7E  1  4A                      lsr                           ;move vertical bits to low nybble
00EF7F  1  4A                      lsr
00EF80  1  4A                      lsr
00EF81  1  85 00                   sta $00                       ;store here
00EF83  1  A2 03                   ldx #$03                      ;check all four rows of player sprites
00EF85  1  AD E4 06                lda Player_SprDataOffset      ;get player's sprite data offset
00EF88  1  18                      clc
00EF89  1  69 18                   adc #$18                      ;add 24 bytes to start at bottom row
00EF8B  1  A8                      tay                           ;set as offset here
00EF8C  1  A9 F8        PROfsLoop: lda #$f8                      ;load offscreen Y coordinate just in case
00EF8E  1  46 00                   lsr $00                       ;shift bit into carry
00EF90  1  90 03                   bcc NPROffscr                 ;if bit not set, skip, do not move sprites
00EF92  1  20 C1 E5                jsr DumpTwoSpr                ;otherwise dump offscreen Y coordinate into sprite data
00EF95  1  98           NPROffscr: tya
00EF96  1  38                      sec                           ;subtract eight bytes to do
00EF97  1  E9 08                   sbc #$08                      ;next row up
00EF99  1  A8                      tay
00EF9A  1  CA                      dex                           ;decrement row counter
00EF9B  1  10 EF                   bpl PROfsLoop                 ;do this until all sprite rows are checked
00EF9D  1  60                      rts                           ;then we are done!
