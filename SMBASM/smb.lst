00F9B8  1               ;MUSIC DATA
00F9B8  1               ;square 2/triangle format
00F9B8  1               ;d7 - length byte flag (0-note, 1-length)
00F9B8  1               ;if d7 is set to 0 and d6-d0 is nonzero:
00F9B8  1               ;d6-d0 - note offset in frequency look-up table (must be even)
00F9B8  1               ;if d7 is set to 1:
00F9B8  1               ;d6-d3 - unused
00F9B8  1               ;d2-d0 - length offset in length look-up table
00F9B8  1               ;value of $00 in square 2 data is used as null terminator, affects all sound channels
00F9B8  1               ;value of $00 in triangle data causes routine to skip note
00F9B8  1               
00F9B8  1               ;square 1 format
00F9B8  1               ;d7-d6, d0 - length offset in length look-up table (bit order is d0,d7,d6)
00F9B8  1               ;d5-d1 - note offset in frequency look-up table
00F9B8  1               ;value of $00 in square 1 data is flag alternate control reg data to be loaded
00F9B8  1               
00F9B8  1               ;noise format
00F9B8  1               ;d7-d6, d0 - length offset in length look-up table (bit order is d0,d7,d6)
00F9B8  1               ;d5-d4 - beat type (0 - rest, 1 - short, 2 - strong, 3 - long)
00F9B8  1               ;d3-d1 - unused
00F9B8  1               ;value of $00 in noise data is used as null terminator, affects only noise
00F9B8  1               
00F9B8  1               ;all music data is organized into sections (unless otherwise stated):
00F9B8  1               ;square 2, square 1, triangle, noise
