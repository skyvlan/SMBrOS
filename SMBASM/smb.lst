00E87D  1               
00E87D  1               EnemyGfxHandler:
00E87D  1  B5 CF              lda Enemy_Y_Position,x      ;get enemy object vertical position
00E87F  1  85 02              sta $02
00E881  1  AD AE 03           lda Enemy_Rel_XPos          ;get enemy object horizontal position
00E884  1  85 05              sta $05                     ;relative to screen
00E886  1  BC E5 06           ldy Enemy_SprDataOffset,x
00E889  1  84 EB              sty $eb                     ;get sprite data offset
00E88B  1  A9 00              lda #$00
00E88D  1  8D 09 01           sta VerticalFlipFlag        ;initialize vertical flip flag by default
00E890  1  B5 46              lda Enemy_MovingDir,x
00E892  1  85 03              sta $03                     ;get enemy object moving direction
00E894  1  BD C5 03           lda Enemy_SprAttrib,x
00E897  1  85 04              sta $04                     ;get enemy object sprite attributes
00E899  1  B5 16              lda Enemy_ID,x
00E89B  1  C9 0D              cmp #PiranhaPlant           ;is enemy object piranha plant?
00E89D  1  D0 0A              bne CheckForRetainerObj     ;if not, branch
00E89F  1  B4 58              ldy PiranhaPlant_Y_Speed,x
00E8A1  1  30 06              bmi CheckForRetainerObj     ;if piranha plant moving upwards, branch
00E8A3  1  BC 8A 07           ldy EnemyFrameTimer,x
00E8A6  1  F0 01              beq CheckForRetainerObj     ;if timer for movement expired, branch
00E8A8  1  60                 rts                         ;if all conditions fail, leave
00E8A9  1               
00E8A9  1               CheckForRetainerObj:
00E8A9  1  B5 1E              lda Enemy_State,x           ;store enemy state
00E8AB  1  85 ED              sta $ed
00E8AD  1  29 1F              and #%00011111              ;nullify all but 5 LSB and use as Y
00E8AF  1  A8                 tay
00E8B0  1  B5 16              lda Enemy_ID,x              ;check for mushroom retainer/princess object
00E8B2  1  C9 35              cmp #RetainerObject
00E8B4  1  D0 08              bne CheckForBulletBillCV    ;if not found, branch
00E8B6  1  A0 00              ldy #$00                    ;if found, nullify saved state in Y
00E8B8  1  A9 01              lda #$01                    ;set value that will not be used
00E8BA  1  85 03              sta $03
00E8BC  1  A9 15              lda #$15                    ;set value $15 as code for mushroom retainer/princess object
00E8BE  1               
00E8BE  1               CheckForBulletBillCV:
00E8BE  1  C9 33               cmp #BulletBill_CannonVar   ;otherwise check for bullet bill object
00E8C0  1  D0 13               bne CheckForJumpspring      ;if not found, branch again
00E8C2  1  C6 02               dec $02                     ;decrement saved vertical position
00E8C4  1  A9 03               lda #$03
00E8C6  1  BC 8A 07            ldy EnemyFrameTimer,x       ;get timer for enemy object
00E8C9  1  F0 02               beq SBBAt                   ;if expired, do not set priority bit
00E8CB  1  09 20               ora #%00100000              ;otherwise do so
00E8CD  1  85 04        SBBAt: sta $04                     ;set new sprite attributes
00E8CF  1  A0 00               ldy #$00                    ;nullify saved enemy state both in Y and in
00E8D1  1  84 ED               sty $ed                     ;memory location here
00E8D3  1  A9 08               lda #$08                    ;set specific value to unconditionally branch once
00E8D5  1               
00E8D5  1               CheckForJumpspring:
00E8D5  1  C9 32              cmp #JumpspringObject        ;check for jumpspring object
00E8D7  1  D0 08              bne CheckForPodoboo
00E8D9  1  A0 03              ldy #$03                     ;set enemy state -2 MSB here for jumpspring object
00E8DB  1  AE 0E 07           ldx JumpspringAnimCtrl       ;get current frame number for jumpspring object
00E8DE  1  BD 78 E8           lda JumpspringFrameOffsets,x ;load data using frame number as offset
00E8E1  1               
00E8E1  1               CheckForPodoboo:
00E8E1  1  85 EF              sta $ef                 ;store saved enemy object value here
00E8E3  1  84 EC              sty $ec                 ;and Y here (enemy state -2 MSB if not changed)
00E8E5  1  A6 08              ldx ObjectOffset        ;get enemy object offset
00E8E7  1  C9 0C              cmp #$0c                ;check for podoboo object
00E8E9  1  D0 07              bne CheckBowserGfxFlag  ;branch if not found
