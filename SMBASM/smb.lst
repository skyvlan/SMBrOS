00D1D9  1               SetFlameTimer:
00D1D9  1  AC 67 03           ldy BowserFlameTimerCtrl  ;load counter as offset
00D1DC  1  EE 67 03           inc BowserFlameTimerCtrl  ;increment
00D1DF  1  AD 67 03           lda BowserFlameTimerCtrl  ;mask out all but 3 LSB
00D1E2  1  29 07              and #%00000111            ;to keep in range of 0-7
00D1E4  1  8D 67 03           sta BowserFlameTimerCtrl
00D1E7  1  B9 D1 D1           lda FlameTimerData,y      ;load value to be used then leave
00D1EA  1  60           ExFl: rts
