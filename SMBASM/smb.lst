00C71B  1               HandleGroupEnemies:
00C71B  1  A0 00                ldy #$00                  ;load value for green koopa troopa
00C71D  1  38                   sec
00C71E  1  E9 37                sbc #$37                  ;subtract $37 from second byte read
00C720  1  48                   pha                       ;save result in stack for now
00C721  1  C9 04                cmp #$04                  ;was byte in $3b-$3e range?
00C723  1  B0 0B                bcs SnglID                ;if so, branch
00C725  1  48                   pha                       ;save another copy to stack
00C726  1  A0 06                ldy #Goomba               ;load value for goomba enemy
00C728  1  AD 6A 07             lda PrimaryHardMode       ;if primary hard mode flag not set,
00C72B  1  F0 02                beq PullID                ;branch, otherwise change to value
00C72D  1  A0 02                ldy #BuzzyBeetle          ;for buzzy beetle
00C72F  1  68           PullID: pla                       ;get second copy from stack
00C730  1  84 01        SnglID: sty $01                   ;save enemy id here
00C732  1  A0 B0                ldy #$b0                  ;load default y coordinate
00C734  1  29 02                and #$02                  ;check to see if d1 was set
00C736  1  F0 02                beq SetYGp                ;if so, move y coordinate up,
00C738  1  A0 70                ldy #$70                  ;otherwise branch and use default
00C73A  1  84 00        SetYGp: sty $00                   ;save y coordinate here
00C73C  1  AD 1B 07             lda ScreenRight_PageLoc   ;get page number of right edge of screen
00C73F  1  85 02                sta $02                   ;save here
00C741  1  AD 1D 07             lda ScreenRight_X_Pos     ;get pixel coordinate of right edge
00C744  1  85 03                sta $03                   ;save here
00C746  1  A0 02                ldy #$02                  ;load two enemies by default
00C748  1  68                   pla                       ;get first copy from stack
00C749  1  4A                   lsr                       ;check to see if d0 was set
00C74A  1  90 01                bcc CntGrp                ;if not, use default value
00C74C  1  C8                   iny                       ;otherwise increment to three enemies
00C74D  1  8C D3 06     CntGrp: sty NumberofGroupEnemies  ;save number of enemies here
00C750  1  A2 FF        GrLoop: ldx #$ff                  ;start at beginning of enemy buffers
00C752  1  E8           GSltLp: inx                       ;increment and branch if past
00C753  1  E0 05                cpx #$05                  ;end of buffers
00C755  1  B0 2D                bcs NextED
00C757  1  B5 0F                lda Enemy_Flag,x          ;check to see if enemy is already
00C759  1  D0 F7                bne GSltLp                ;stored in buffer, and branch if so
00C75B  1  A5 01                lda $01
00C75D  1  95 16                sta Enemy_ID,x            ;store enemy object identifier
00C75F  1  A5 02                lda $02
00C761  1  95 6E                sta Enemy_PageLoc,x       ;store page location for enemy object
00C763  1  A5 03                lda $03
00C765  1  95 87                sta Enemy_X_Position,x    ;store x coordinate for enemy object
00C767  1  18                   clc
00C768  1  69 18                adc #$18                  ;add 24 pixels for next enemy
00C76A  1  85 03                sta $03
00C76C  1  A5 02                lda $02                   ;add carry to page location for
00C76E  1  69 00                adc #$00                  ;next enemy
00C770  1  85 02                sta $02
00C772  1  A5 00                lda $00                   ;store y coordinate for enemy object
00C774  1  95 CF                sta Enemy_Y_Position,x
00C776  1  A9 01                lda #$01                  ;activate flag for buffer, and
00C778  1  95 B6                sta Enemy_Y_HighPos,x     ;put enemy within the screen vertically
00C77A  1  95 0F                sta Enemy_Flag,x
00C77C  1  20 6C C2             jsr CheckpointEnemyID     ;process each enemy object separately
00C77F  1  CE D3 06             dec NumberofGroupEnemies  ;do this until we run out of enemy objects
00C782  1  D0 CC                bne GrLoop
00C784  1  4C 5E C2     NextED: jmp Inc2B                 ;jump to increment data offset and leave
