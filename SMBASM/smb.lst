00E40F  1  18                  clc
00E410  1  79 CC E3            adc BlockBuffer_Y_Adder,y   ;add it to value obtained using Y as offset
00E413  1  29 F0               and #%11110000              ;mask out low nybble
00E415  1  38                  sec
00E416  1  E9 20               sbc #$20                    ;subtract 32 pixels for the status bar
00E418  1  85 02               sta $02                     ;store result here
00E41A  1  A8                  tay                         ;use as offset for block buffer
00E41B  1  B1 06               lda ($06),y                 ;check current content of block buffer
00E41D  1  85 03               sta $03                     ;and store here
00E41F  1  A4 04               ldy $04                     ;get old contents of Y again
00E421  1  68                  pla                         ;pull A from stack
00E422  1  D0 05               bne RetXC                   ;if A = 1, branch
00E424  1  B5 CE               lda SprObject_Y_Position,x  ;if A = 0, load vertical coordinate
00E426  1  4C 2B E4            jmp RetYC                   ;and jump
00E429  1  B5 86        RetXC: lda SprObject_X_Position,x  ;otherwise load horizontal coordinate
00E42B  1  29 0F        RetYC: and #%00001111              ;and mask out high nybble
00E42D  1  85 04               sta $04                     ;store masked out result here
00E42F  1  A5 03               lda $03                     ;get saved content of block buffer
00E431  1  60                  rts                         ;and leave
