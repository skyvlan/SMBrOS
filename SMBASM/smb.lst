0089F9  1  90 F4                      bcc GetBlankPal          ;do this until all bytes are copied
0089FB  1  AE 00 03                   ldx VRAM_Buffer1_Offset  ;get current vram buffer offset
0089FE  1  A9 03                      lda #$03
008A00  1  85 00                      sta $00                  ;set counter here
008A02  1  AD 4E 07                   lda AreaType             ;get area type
008A05  1  0A                         asl                      ;multiply by 4 to get proper offset
008A06  1  0A                         asl
008A07  1  A8                         tay                      ;save as offset here
