00E0A5  1  B5 16                 lda Enemy_ID,x            ;check enemy identifier for goomba
00E0A7  1  C9 06                 cmp #Goomba               ;branch if found
00E0A9  1  F0 22                 beq LandEnemyInitState
00E0AB  1  C9 12                 cmp #Spiny                ;check for spiny
00E0AD  1  D0 0E                 bne InvtD                 ;branch if not found
00E0AF  1  A9 01                 lda #$01
00E0B1  1  95 46                 sta Enemy_MovingDir,x     ;send enemy moving to the right by default
00E0B3  1  A9 08                 lda #$08
00E0B5  1  95 58                 sta Enemy_X_Speed,x       ;set horizontal speed accordingly
00E0B7  1  A5 09                 lda FrameCounter
00E0B9  1  29 07                 and #%00000111            ;if timed appropriately, spiny will skip over
00E0BB  1  F0 10                 beq LandEnemyInitState    ;trying to face the player
00E0BD  1  A0 01        InvtD:   ldy #$01                  ;load 1 for enemy to face the left (inverted here)
00E0BF  1  20 43 E1              jsr PlayerEnemyDiff       ;get horizontal difference between player and enemy
00E0C2  1  10 01                 bpl CNwCDir               ;if enemy to the right of player, branch
00E0C4  1  C8                    iny                       ;if to the left, increment by one for enemy to face right (inverted)
00E0C5  1  98           CNwCDir: tya
00E0C6  1  D5 46                 cmp Enemy_MovingDir,x     ;compare direction in A with current direction in memory
00E0C8  1  D0 03                 bne LandEnemyInitState
00E0CA  1  20 24 E1              jsr ChkForBump_HammerBroJ ;if equal, not facing in correct dir, do sub to turn around
00E0CD  1               
