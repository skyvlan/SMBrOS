00E5CD  1  C8                 iny                         ;add 3 to it for offset
00E5CE  1  C8                 iny                         ;to X coordinate
00E5CF  1  C8                 iny
00E5D0  1  AD AE 03           lda Enemy_Rel_XPos          ;get horizontal relative coordinate
00E5D3  1  20 AE E4           jsr SixSpriteStacker        ;store X coordinates using A as base, stack horizontally
00E5D6  1  A6 08              ldx ObjectOffset
