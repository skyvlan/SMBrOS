00CAFF  1               ProcMoveRedPTroopa:
00CAFF  1  B5 A0                  lda Enemy_Y_Speed,x
00CB01  1  1D 34 04               ora Enemy_Y_MoveForce,x     ;check for any vertical force or speed
00CB04  1  D0 13                  bne MoveRedPTUpOrDown       ;branch if any found
00CB06  1  9D 17 04               sta Enemy_YMF_Dummy,x       ;initialize something here
00CB09  1  B5 CF                  lda Enemy_Y_Position,x      ;check current vs. original vertical coordinate
00CB0B  1  DD 01 04               cmp RedPTroopaOrigXPos,x
00CB0E  1  B0 09                  bcs MoveRedPTUpOrDown       ;if current => original, skip ahead to more code
00CB10  1  A5 09                  lda FrameCounter            ;get frame counter
00CB12  1  29 07                  and #%00000111              ;mask out all but 3 LSB
00CB14  1  D0 02                  bne NoIncPT                 ;if any bits set, branch to leave
00CB16  1  F6 CF                  inc Enemy_Y_Position,x      ;otherwise increment red paratroopa's vertical position
00CB18  1  60           NoIncPT:  rts                         ;leave
00CB19  1               
00CB19  1               MoveRedPTUpOrDown:
00CB19  1  B5 CF                  lda Enemy_Y_Position,x      ;check current vs. central vertical coordinate
00CB1B  1  D5 58                  cmp RedPTroopaCenterYPos,x
00CB1D  1  90 03                  bcc MovPTDwn                ;if current < central, jump to move downwards
00CB1F  1  4C 75 BF               jmp MoveRedPTroopaUp        ;otherwise jump to move upwards
00CB22  1  4C 70 BF     MovPTDwn: jmp MoveRedPTroopaDown      ;move downwards
