00896A  1               RenderAttributeTables:
00896A  1  AD 21 07                  lda CurrentNTAddr_Low    ;get low byte of next name table address
00896D  1  29 1F                     and #%00011111           ;to be written to, mask out all but 5 LSB,
00896F  1  38                        sec                      ;subtract four
008970  1  E9 04                     sbc #$04
008972  1  29 1F                     and #%00011111           ;mask out bits again and store
008974  1  85 01                     sta $01
008976  1  AD 20 07                  lda CurrentNTAddr_High   ;get high byte and branch if borrow not set
008979  1  B0 02                     bcs SetATHigh
00897B  1  49 04                     eor #%00000100           ;otherwise invert d2
00897D  1  29 04        SetATHigh:   and #%00000100           ;mask out all other bits
00897F  1  09 23                     ora #$23                 ;add $2300 to the high byte and store
008981  1  85 00                     sta $00
008983  1  A5 01                     lda $01                  ;get low byte - 4, divide by 4, add offset for
008985  1  4A                        lsr                      ;attribute table and store
008986  1  4A                        lsr
008987  1  69 C0                     adc #$c0                 ;we should now have the appropriate block of
008989  1  85 01                     sta $01                  ;attribute table in our temp address
00898B  1  A2 00                     ldx #$00
00898D  1  AC 40 03                  ldy VRAM_Buffer2_Offset  ;get buffer offset
008990  1  A5 00        AttribLoop:  lda $00
008992  1  99 41 03                  sta VRAM_Buffer2,y       ;store high byte of attribute table address
008995  1  A5 01                     lda $01
008997  1  18                        clc                      ;get low byte, add 8 because we want to start
008998  1  69 08                     adc #$08                 ;below the status bar, and store
00899A  1  99 42 03                  sta VRAM_Buffer2+1,y
00899D  1  85 01                     sta $01                  ;also store in temp again
00899F  1  BD F9 03                  lda AttributeBuffer,x    ;fetch current attribute table byte and store
0089A2  1  99 44 03                  sta VRAM_Buffer2+3,y     ;in the buffer
0089A5  1  A9 01                     lda #$01
0089A7  1  99 43 03                  sta VRAM_Buffer2+2,y     ;store length of 1 in buffer
0089AA  1  4A                        lsr
0089AB  1  9D F9 03                  sta AttributeBuffer,x    ;clear current byte in attribute buffer
0089AE  1  C8                        iny                      ;increment buffer offset by 4 bytes
0089AF  1  C8                        iny
0089B0  1  C8                        iny
0089B1  1  C8                        iny
