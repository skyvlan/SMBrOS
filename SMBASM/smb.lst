00E43E  1  BE 9A 03              ldx VineObjOffset,y        ;get offset to vine
00E441  1  BC E5 06              ldy Enemy_SprDataOffset,x  ;get sprite data offset
00E444  1  84 02                 sty $02                    ;store sprite data offset here
00E446  1  20 AE E4              jsr SixSpriteStacker       ;stack six sprites on top of each other vertically
00E449  1  AD AE 03              lda Enemy_Rel_XPos         ;get relative horizontal coordinate
00E44C  1  99 03 02              sta Sprite_X_Position,y    ;store in first, third and fifth sprites
00E44F  1  99 0B 02              sta Sprite_X_Position+8,y
00E452  1  99 13 02              sta Sprite_X_Position+16,y
00E455  1  18                    clc
00E456  1  69 06                 adc #$06                   ;add six pixels to second, fourth and sixth sprites
00E458  1  99 07 02              sta Sprite_X_Position+4,y  ;to give characteristic staggered vine shape to
00E45B  1  99 0F 02              sta Sprite_X_Position+12,y ;our vertical stack of sprites
00E45E  1  99 17 02              sta Sprite_X_Position+20,y
00E461  1  A9 21                 lda #%00100001             ;set bg priority and palette attribute bits
00E463  1  99 02 02              sta Sprite_Attributes,y    ;set in first, third and fifth sprites
00E466  1  99 0A 02              sta Sprite_Attributes+8,y
00E469  1  99 12 02              sta Sprite_Attributes+16,y
00E46C  1  09 40                 ora #%01000000             ;additionally, set horizontal flip bit
00E46E  1  99 06 02              sta Sprite_Attributes+4,y  ;for second, fourth and sixth sprites
00E471  1  99 0E 02              sta Sprite_Attributes+12,y
00E474  1  99 16 02              sta Sprite_Attributes+20,y
00E477  1  A2 05                 ldx #$05                   ;set tiles for six sprites
00E479  1  A9 E1        VineTL:  lda #$e1                   ;set tile number for sprite
00E47B  1  99 01 02              sta Sprite_Tilenumber,y
00E47E  1  C8                    iny                        ;move offset to next sprite data
00E47F  1  C8                    iny
00E480  1  C8                    iny
00E481  1  C8                    iny
00E482  1  CA                    dex                        ;move onto next sprite
00E483  1  10 F4                 bpl VineTL                 ;loop until all sprites are done
00E485  1  A4 02                 ldy $02                    ;get original offset
00E487  1  A5 00                 lda $00                    ;get offset to vine adding data
00E489  1  D0 05                 bne SkpVTop                ;if offset not zero, skip this part
00E48B  1  A9 E0                 lda #$e0
00E48D  1  99 01 02              sta Sprite_Tilenumber,y    ;set other tile number for top of vine
00E490  1  A2 00        SkpVTop: ldx #$00                   ;start with the first sprite again
00E492  1  AD 9D 03     ChkFTop: lda VineStart_Y_Position   ;get original starting vertical coordinate
00E495  1  38                    sec
00E496  1  F9 00 02              sbc Sprite_Y_Position,y    ;subtract top-most sprite's Y coordinate
00E499  1  C9 64                 cmp #$64                   ;if two coordinates are less than 100/$64 pixels
00E49B  1  90 05                 bcc NextVSp                ;apart, skip this to leave sprite alone
00E49D  1  A9 F8                 lda #$f8
00E49F  1  99 00 02              sta Sprite_Y_Position,y    ;otherwise move sprite offscreen
00E4A2  1  C8           NextVSp: iny                        ;move offset to next OAM data
00E4A3  1  C8                    iny
00E4A4  1  C8                    iny
00E4A5  1  C8                    iny
00E4A6  1  E8                    inx                        ;move onto next sprite
00E4A7  1  E0 06                 cpx #$06                   ;do this until all sprites are checked
00E4A9  1  D0 E7                 bne ChkFTop
