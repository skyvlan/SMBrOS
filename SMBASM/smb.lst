00D041  1  A9 08                 lda #Sfx_Blast            ;load the fireworks/gunfire sound into the square 2 sfx
00D043  1  85 FE                 sta Square2SoundQueue     ;queue while at the same time loading the brick
00D045  1  A9 01                 lda #Sfx_BrickShatter     ;shatter sound into the noise sfx queue thus
00D047  1  85 FD                 sta NoiseSoundQueue       ;producing the unique sound of the bridge collapsing
00D049  1  EE 69 03              inc BridgeCollapseOffset  ;increment bridge collapse offset
00D04C  1  AD 69 03              lda BridgeCollapseOffset
