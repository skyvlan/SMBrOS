00D312  1               AwardGameTimerPoints:
00D312  1  AD F8 07              lda GameTimerDisplay   ;check all game timer digits for any intervals left
00D315  1  0D F9 07              ora GameTimerDisplay+1
00D318  1  0D FA 07              ora GameTimerDisplay+2
00D31B  1  F0 F1                 beq IncrementSFTask1   ;if no time left on game timer at all, branch to next task
00D31D  1  A5 09                 lda FrameCounter
00D31F  1  29 04                 and #%00000100         ;check frame counter for d2 set (skip ahead
00D321  1  F0 04                 beq NoTTick            ;for four frames every four frames) branch if not set
00D323  1  A9 10                 lda #Sfx_TimerTick
00D325  1  85 FE                 sta Square2SoundQueue  ;load timer tick sound
00D327  1  A0 23        NoTTick: ldy #$23               ;set offset here to subtract from game timer's last digit
00D329  1  A9 FF                 lda #$ff               ;set adder here to $ff, or -1, to subtract one
00D32B  1  8D 39 01              sta DigitModifier+5    ;from the last digit of the game timer
00D32E  1  20 5F 8F              jsr DigitsMathRoutine  ;subtract digit
00D331  1  A9 05                 lda #$05               ;set now to add 50 points
00D333  1  8D 39 01              sta DigitModifier+5    ;per game timer interval subtracted
00D336  1               
00D336  1               EndAreaPoints:
00D336  1  A0 0B                 ldy #$0b               ;load offset for mario's score by default
00D338  1  AD 53 07              lda CurrentPlayer      ;check player on the screen
00D33B  1  F0 02                 beq ELPGive            ;if mario, do not change
00D33D  1  A0 11                 ldy #$11               ;otherwise load offset for luigi's score
00D33F  1  20 5F 8F     ELPGive: jsr DigitsMathRoutine  ;award 50 points per game timer interval
00D342  1  AD 53 07              lda CurrentPlayer      ;get player on the screen (or 500 points per
00D345  1  0A                    asl                    ;fireworks explosion if branched here from there)
00D346  1  0A                    asl                    ;shift to high nybble
00D347  1  0A                    asl
00D348  1  0A                    asl
00D349  1  09 04                 ora #%00000100         ;add four to set nybble for game timer
00D34B  1  4C 36 BC              jmp UpdateNumber       ;jump to print the new score and game timer
00D34E  1               
00D34E  1               RaiseFlagSetoffFWorks:
00D34E  1  B5 CF                 lda Enemy_Y_Position,x  ;check star flag's vertical position
00D350  1  C9 72                 cmp #$72                ;against preset value
00D352  1  90 05                 bcc SetoffF             ;if star flag higher vertically, branch to other code
00D354  1  D6 CF                 dec Enemy_Y_Position,x  ;otherwise, raise star flag by one pixel
00D356  1  4C 65 D3              jmp DrawStarFlag        ;and skip this part here
00D359  1  AD D7 06     SetoffF: lda FireworksCounter    ;check fireworks counter
00D35C  1  F0 38                 beq DrawFlagSetTimer    ;if no fireworks left to go off, skip this part
00D35E  1  30 36                 bmi DrawFlagSetTimer    ;if no fireworks set to go off, skip this part
00D360  1  A9 16                 lda #Fireworks
00D362  1  8D CB 06              sta EnemyFrenzyBuffer   ;otherwise set fireworks object in frenzy queue
00D365  1               
00D365  1               DrawStarFlag:
00D365  1  20 52 F1              jsr RelativeEnemyPosition  ;get relative coordinates of star flag
00D368  1  BC E5 06              ldy Enemy_SprDataOffset,x  ;get OAM data offset
00D36B  1  A2 03                 ldx #$03                   ;do four sprites
00D36D  1  AD B9 03     DSFLoop: lda Enemy_Rel_YPos         ;get relative vertical coordinate
00D370  1  18                    clc
00D371  1  7D CD D2              adc StarFlagYPosAdder,x    ;add Y coordinate adder data
00D374  1  99 00 02              sta Sprite_Y_Position,y    ;store as Y coordinate
00D377  1  BD D5 D2              lda StarFlagTileData,x     ;get tile number
00D37A  1  99 01 02              sta Sprite_Tilenumber,y    ;store as tile number
00D37D  1  A9 22                 lda #$22                   ;set palette and background priority bits
00D37F  1  99 02 02              sta Sprite_Attributes,y    ;store as attributes
00D382  1  AD AE 03              lda Enemy_Rel_XPos         ;get relative horizontal coordinate
00D385  1  18                    clc
00D386  1  7D D1 D2              adc StarFlagXPosAdder,x    ;add X coordinate adder data
00D389  1  99 03 02              sta Sprite_X_Position,y    ;store as X coordinate
00D38C  1  C8                    iny
00D38D  1  C8                    iny                        ;increment OAM data offset four bytes
00D38E  1  C8                    iny                        ;for next sprite
00D38F  1  C8                    iny
00D390  1  CA                    dex                        ;move onto next sprite
00D391  1  10 DA                 bpl DSFLoop                ;do this until all sprites are done
00D393  1  A6 08                 ldx ObjectOffset           ;get enemy object offset and leave
00D395  1  60                    rts
00D396  1               
00D396  1               DrawFlagSetTimer:
00D396  1  20 65 D3           jsr DrawStarFlag          ;do sub to draw star flag
00D399  1  A9 06              lda #$06
00D39B  1  9D 96 07           sta EnemyIntervalTimer,x  ;set interval timer here
00D39E  1               
00D39E  1               IncrementSFTask2:
00D39E  1  EE 46 07           inc StarFlagTaskControl   ;move onto next task
00D3A1  1  60                 rts
00D3A2  1               
00D3A2  1               DelayToAreaEnd:
00D3A2  1  20 65 D3           jsr DrawStarFlag          ;do sub to draw star flag
00D3A5  1  BD 96 07           lda EnemyIntervalTimer,x  ;if interval timer set in previous task
00D3A8  1  D0 05              bne StarFlagExit2         ;not yet expired, branch to leave
00D3AA  1  AD B1 07           lda EventMusicBuffer      ;if event music buffer empty,
00D3AD  1  F0 EF              beq IncrementSFTask2      ;branch to increment task
00D3AF  1               
00D3AF  1               StarFlagExit2:
00D3AF  1  60                 rts                       ;otherwise leave
00D3B0  1               
00D3B0  1               ;--------------------------------
00D3B0  1               ;$00 - used to store horizontal difference between player and piranha plant
00D3B0  1               
00D3B0  1               MovePiranhaPlant:
00D3B0  1  B5 1E              lda Enemy_State,x           ;check enemy state
00D3B2  1  D0 56              bne PutinPipe               ;if set at all, branch to leave
00D3B4  1  BD 8A 07           lda EnemyFrameTimer,x       ;check enemy's timer here
00D3B7  1  D0 51              bne PutinPipe               ;branch to end if not yet expired
00D3B9  1  B5 A0              lda PiranhaPlant_MoveFlag,x ;check movement flag
00D3BB  1  D0 23              bne SetupToMovePPlant       ;if moving, skip to part ahead
00D3BD  1  B5 58              lda PiranhaPlant_Y_Speed,x  ;if currently rising, branch
00D3BF  1  30 14              bmi ReversePlantSpeed       ;to move enemy upwards out of pipe
00D3C1  1  20 43 E1           jsr PlayerEnemyDiff         ;get horizontal difference between player and
00D3C4  1  10 09              bpl ChkPlayerNearPipe       ;piranha plant, and branch if enemy to right of player
00D3C6  1  A5 00              lda $00                     ;otherwise get saved horizontal difference
00D3C8  1  49 FF              eor #$ff
00D3CA  1  18                 clc                         ;and change to two's compliment
00D3CB  1  69 01              adc #$01
00D3CD  1  85 00              sta $00                     ;save as new horizontal difference
00D3CF  1               
00D3CF  1               ChkPlayerNearPipe:
00D3CF  1  A5 00              lda $00                     ;get saved horizontal difference
00D3D1  1  C9 21              cmp #$21
00D3D3  1  90 35              bcc PutinPipe               ;if player within a certain distance, branch to leave
00D3D5  1               
00D3D5  1               ReversePlantSpeed:
00D3D5  1  B5 58              lda PiranhaPlant_Y_Speed,x  ;get vertical speed
00D3D7  1  49 FF              eor #$ff
00D3D9  1  18                 clc                         ;change to two's compliment
00D3DA  1  69 01              adc #$01
00D3DC  1  95 58              sta PiranhaPlant_Y_Speed,x  ;save as new vertical speed
00D3DE  1  F6 A0              inc PiranhaPlant_MoveFlag,x ;increment to set movement flag
00D3E0  1               
00D3E0  1               SetupToMovePPlant:
00D3E0  1  BD 34 04           lda PiranhaPlantDownYPos,x  ;get original vertical coordinate (lowest point)
00D3E3  1  B4 58              ldy PiranhaPlant_Y_Speed,x  ;get vertical speed
00D3E5  1  10 03              bpl RiseFallPiranhaPlant    ;branch if moving downwards
00D3E7  1  BD 17 04           lda PiranhaPlantUpYPos,x    ;otherwise get other vertical coordinate (highest point)
00D3EA  1               
00D3EA  1               RiseFallPiranhaPlant:
00D3EA  1  85 00              sta $00                     ;save vertical coordinate here
00D3EC  1  A5 09              lda FrameCounter            ;get frame counter
00D3EE  1  4A                 lsr
00D3EF  1  90 19              bcc PutinPipe               ;branch to leave if d0 set (execute code every other frame)
00D3F1  1  AD 47 07           lda TimerControl            ;get master timer control
00D3F4  1  D0 14              bne PutinPipe               ;branch to leave if set (likely not necessary)
00D3F6  1  B5 CF              lda Enemy_Y_Position,x      ;get current vertical coordinate
00D3F8  1  18                 clc
00D3F9  1  75 58              adc PiranhaPlant_Y_Speed,x  ;add vertical speed to move up or down
00D3FB  1  95 CF              sta Enemy_Y_Position,x      ;save as new vertical coordinate
00D3FD  1  C5 00              cmp $00                     ;compare against low or high coordinate
00D3FF  1  D0 09              bne PutinPipe               ;branch to leave if not yet reached
00D401  1  A9 00              lda #$00
00D403  1  95 A0              sta PiranhaPlant_MoveFlag,x ;otherwise clear movement flag
00D405  1  A9 40              lda #$40
00D407  1  9D 8A 07           sta EnemyFrameTimer,x       ;set timer to delay piranha plant movement
00D40A  1               
00D40A  1               PutinPipe:
00D40A  1  A9 20              lda #%00100000              ;set background priority bit in sprite
00D40C  1  9D C5 03           sta Enemy_SprAttrib,x       ;attributes to give illusion of being inside pipe
00D40F  1  60                 rts                         ;then leave
00D410  1               
00D410  1               ;-------------------------------------------------------------------------------------
00D410  1               ;$07 - spinning speed
00D410  1               
00D410  1               FirebarSpin:
00D410  1  85 07              sta $07                     ;save spinning speed here
00D412  1  B5 34              lda FirebarSpinDirection,x  ;check spinning direction
00D414  1  D0 0E              bne SpinCounterClockwise    ;if moving counter-clockwise, branch to other part
00D416  1  A0 18              ldy #$18                    ;possibly residual ldy
00D418  1  B5 58              lda FirebarSpinState_Low,x
00D41A  1  18                 clc                         ;add spinning speed to what would normally be
00D41B  1  65 07              adc $07                     ;the horizontal speed
00D41D  1  95 58              sta FirebarSpinState_Low,x
00D41F  1  B5 A0              lda FirebarSpinState_High,x ;add carry to what would normally be the vertical speed
00D421  1  69 00              adc #$00
00D423  1  60                 rts
00D424  1               
00D424  1               SpinCounterClockwise:
00D424  1  A0 08              ldy #$08                    ;possibly residual ldy
00D426  1  B5 58              lda FirebarSpinState_Low,x
00D428  1  38                 sec                         ;subtract spinning speed to what would normally be
00D429  1  E5 07              sbc $07                     ;the horizontal speed
00D42B  1  95 58              sta FirebarSpinState_Low,x
00D42D  1  B5 A0              lda FirebarSpinState_High,x ;add carry to what would normally be the vertical speed
00D42F  1  E9 00              sbc #$00
00D431  1  60                 rts
00D432  1               
00D432  1               ;-------------------------------------------------------------------------------------
00D432  1               ;$00 - used to hold collision flag, Y movement force + 5 or low byte of name table for rope
00D432  1               ;$01 - used to hold high byte of name table for rope
00D432  1               ;$02 - used to hold page location of rope
00D432  1               
00D432  1               BalancePlatform:
00D432  1  B5 B6               lda Enemy_Y_HighPos,x       ;check high byte of vertical position
00D434  1  C9 03               cmp #$03
00D436  1  D0 03               bne DoBPl
00D438  1  4C 98 C9            jmp EraseEnemyObject        ;if far below screen, kill the object
00D43B  1  B5 1E        DoBPl: lda Enemy_State,x           ;get object's state (set to $ff or other platform offset)
00D43D  1  10 01               bpl CheckBalPlatform        ;if doing other balance platform, branch to leave
00D43F  1  60                  rts
00D440  1               
00D440  1               CheckBalPlatform:
00D440  1  A8                  tay                         ;save offset from state as Y
00D441  1  BD A2 03            lda PlatformCollisionFlag,x ;get collision flag of platform
00D444  1  85 00               sta $00                     ;store here
00D446  1  B5 46               lda Enemy_MovingDir,x       ;get moving direction
00D448  1  F0 03               beq ChkForFall
00D44A  1  4C BB D5            jmp PlatformFall            ;if set, jump here
00D44D  1               
00D44D  1               ChkForFall:
00D44D  1  A9 2D               lda #$2d                    ;check if platform is above a certain point
00D44F  1  D5 CF               cmp Enemy_Y_Position,x
00D451  1  90 0F               bcc ChkOtherForFall         ;if not, branch elsewhere
00D453  1  C4 00               cpy $00                     ;if collision flag is set to same value as
00D455  1  F0 08               beq MakePlatformFall        ;enemy state, branch to make platforms fall
00D457  1  18                  clc
00D458  1  69 02               adc #$02                    ;otherwise add 2 pixels to vertical position
00D45A  1  95 CF               sta Enemy_Y_Position,x      ;of current platform and branch elsewhere
00D45C  1  4C B1 D5            jmp StopPlatforms           ;to make platforms stop
00D45F  1               
00D45F  1               MakePlatformFall:
00D45F  1  4C 98 D5            jmp InitPlatformFall        ;make platforms fall
00D462  1               
00D462  1               ChkOtherForFall:
00D462  1  D9 CF 00            cmp Enemy_Y_Position,y      ;check if other platform is above a certain point
00D465  1  90 0D               bcc ChkToMoveBalPlat        ;if not, branch elsewhere
00D467  1  E4 00               cpx $00                     ;if collision flag is set to same value as
00D469  1  F0 F4               beq MakePlatformFall        ;enemy state, branch to make platforms fall
00D46B  1  18                  clc
00D46C  1  69 02               adc #$02                    ;otherwise add 2 pixels to vertical position
00D46E  1  99 CF 00            sta Enemy_Y_Position,y      ;of other platform and branch elsewhere
00D471  1  4C B1 D5            jmp StopPlatforms           ;jump to stop movement and do not return
00D474  1               
00D474  1               ChkToMoveBalPlat:
00D474  1  B5 CF                lda Enemy_Y_Position,x      ;save vertical position to stack
00D476  1  48                   pha
00D477  1  BD A2 03             lda PlatformCollisionFlag,x ;get collision flag
00D47A  1  10 18                bpl ColFlg                  ;branch if collision
00D47C  1  BD 34 04             lda Enemy_Y_MoveForce,x
00D47F  1  18                   clc                         ;add $05 to contents of moveforce, whatever they be
00D480  1  69 05                adc #$05
00D482  1  85 00                sta $00                     ;store here
00D484  1  B5 A0                lda Enemy_Y_Speed,x
00D486  1  69 00                adc #$00                    ;add carry to vertical speed
00D488  1  30 1A                bmi PlatDn                  ;branch if moving downwards
00D48A  1  D0 0C                bne PlatUp                  ;branch elsewhere if moving upwards
00D48C  1  A5 00                lda $00
00D48E  1  C9 0B                cmp #$0b                    ;check if there's still a little force left
00D490  1  90 0C                bcc PlatSt                  ;if not enough, branch to stop movement
00D492  1  B0 04                bcs PlatUp                  ;otherwise keep branch to move upwards
00D494  1  C5 08        ColFlg: cmp ObjectOffset            ;if collision flag matches
00D496  1  F0 0C                beq PlatDn                  ;current enemy object offset, branch
00D498  1  20 B7 BF     PlatUp: jsr MovePlatformUp          ;do a sub to move upwards
00D49B  1  4C A7 D4             jmp DoOtherPlatform         ;jump ahead to remaining code
00D49E  1  20 B1 D5     PlatSt: jsr StopPlatforms           ;do a sub to stop movement
00D4A1  1  4C A7 D4             jmp DoOtherPlatform         ;jump ahead to remaining code
00D4A4  1  20 B4 BF     PlatDn: jsr MovePlatformDown        ;do a sub to move downwards
00D4A7  1               
00D4A7  1               DoOtherPlatform:
00D4A7  1  B4 1E               ldy Enemy_State,x           ;get offset of other platform
00D4A9  1  68                  pla                         ;get old vertical coordinate from stack
00D4AA  1  38                  sec
00D4AB  1  F5 CF               sbc Enemy_Y_Position,x      ;get difference of old vs. new coordinate
00D4AD  1  18                  clc
00D4AE  1  79 CF 00            adc Enemy_Y_Position,y      ;add difference to vertical coordinate of other
00D4B1  1  99 CF 00            sta Enemy_Y_Position,y      ;platform to move it in the opposite direction
00D4B4  1  BD A2 03            lda PlatformCollisionFlag,x ;if no collision, skip this part here
00D4B7  1  30 04               bmi DrawEraseRope
00D4B9  1  AA                  tax                         ;put offset which collision occurred here
00D4BA  1  20 21 DC            jsr PositionPlayerOnVPlat   ;and use it to position player accordingly
00D4BD  1               
00D4BD  1               DrawEraseRope:
00D4BD  1  A4 08                 ldy ObjectOffset            ;get enemy object offset
00D4BF  1  B9 A0 00              lda Enemy_Y_Speed,y         ;check to see if current platform is
00D4C2  1  19 34 04              ora Enemy_Y_MoveForce,y     ;moving at all
00D4C5  1  F0 77                 beq ExitRp                  ;if not, skip all of this and branch to leave
00D4C7  1  AE 00 03              ldx VRAM_Buffer1_Offset     ;get vram buffer offset
00D4CA  1  E0 20                 cpx #$20                    ;if offset beyond a certain point, go ahead
00D4CC  1  B0 70                 bcs ExitRp                  ;and skip this, branch to leave
00D4CE  1  B9 A0 00              lda Enemy_Y_Speed,y
00D4D1  1  48                    pha                         ;save two copies of vertical speed to stack
00D4D2  1  48                    pha
00D4D3  1  20 41 D5              jsr SetupPlatformRope       ;do a sub to figure out where to put new bg tiles
00D4D6  1  A5 01                 lda $01                     ;write name table address to vram buffer
00D4D8  1  9D 01 03              sta VRAM_Buffer1,x          ;first the high byte, then the low
00D4DB  1  A5 00                 lda $00
00D4DD  1  9D 02 03              sta VRAM_Buffer1+1,x
00D4E0  1  A9 02                 lda #$02                    ;set length for 2 bytes
00D4E2  1  9D 03 03              sta VRAM_Buffer1+2,x
00D4E5  1  B9 A0 00              lda Enemy_Y_Speed,y         ;if platform moving upwards, branch
00D4E8  1  30 0D                 bmi EraseR1                 ;to do something else
00D4EA  1  A9 A2                 lda #$a2
00D4EC  1  9D 04 03              sta VRAM_Buffer1+3,x        ;otherwise put tile numbers for left
00D4EF  1  A9 A3                 lda #$a3                    ;and right sides of rope in vram buffer
00D4F1  1  9D 05 03              sta VRAM_Buffer1+4,x
00D4F4  1  4C FF D4              jmp OtherRope               ;jump to skip this part
00D4F7  1  A9 24        EraseR1: lda #$24                    ;put blank tiles in vram buffer
00D4F9  1  9D 04 03              sta VRAM_Buffer1+3,x        ;to erase rope
00D4FC  1  9D 05 03              sta VRAM_Buffer1+4,x
00D4FF  1               
00D4FF  1               OtherRope:
00D4FF  1  B9 1E 00              lda Enemy_State,y           ;get offset of other platform from state
00D502  1  A8                    tay                         ;use as Y here
00D503  1  68                    pla                         ;pull second copy of vertical speed from stack
00D504  1  49 FF                 eor #$ff                    ;invert bits to reverse speed
00D506  1  20 41 D5              jsr SetupPlatformRope       ;do sub again to figure out where to put bg tiles
00D509  1  A5 01                 lda $01                     ;write name table address to vram buffer
00D50B  1  9D 06 03              sta VRAM_Buffer1+5,x        ;this time we're doing putting tiles for
00D50E  1  A5 00                 lda $00                     ;the other platform
00D510  1  9D 07 03              sta VRAM_Buffer1+6,x
00D513  1  A9 02                 lda #$02
00D515  1  9D 08 03              sta VRAM_Buffer1+7,x        ;set length again for 2 bytes
00D518  1  68                    pla                         ;pull first copy of vertical speed from stack
00D519  1  10 0D                 bpl EraseR2                 ;if moving upwards (note inversion earlier), skip this
00D51B  1  A9 A2                 lda #$a2
00D51D  1  9D 09 03              sta VRAM_Buffer1+8,x        ;otherwise put tile numbers for left
00D520  1  A9 A3                 lda #$a3                    ;and right sides of rope in vram
00D522  1  9D 0A 03              sta VRAM_Buffer1+9,x        ;transfer buffer
00D525  1  4C 30 D5              jmp EndRp                   ;jump to skip this part
00D528  1  A9 24        EraseR2: lda #$24                    ;put blank tiles in vram buffer
00D52A  1  9D 09 03              sta VRAM_Buffer1+8,x        ;to erase rope
00D52D  1  9D 0A 03              sta VRAM_Buffer1+9,x
00D530  1  A9 00        EndRp:   lda #$00                    ;put null terminator at the end
00D532  1  9D 0B 03              sta VRAM_Buffer1+10,x
00D535  1  AD 00 03              lda VRAM_Buffer1_Offset     ;add ten bytes to the vram buffer offset
00D538  1  18                    clc                         ;and store
00D539  1  69 0A                 adc #10
00D53B  1  8D 00 03              sta VRAM_Buffer1_Offset
00D53E  1  A6 08        ExitRp:  ldx ObjectOffset            ;get enemy object buffer offset and leave
00D540  1  60                    rts
00D541  1               
00D541  1               SetupPlatformRope:
00D541  1  48                   pha                     ;save second/third copy to stack
00D542  1  B9 87 00             lda Enemy_X_Position,y  ;get horizontal coordinate
00D545  1  18                   clc
00D546  1  69 08                adc #$08                ;add eight pixels
00D548  1  AE CC 06             ldx SecondaryHardMode   ;if secondary hard mode flag set,
00D54B  1  D0 03                bne GetLRp              ;use coordinate as-is
00D54D  1  18                   clc
00D54E  1  69 10                adc #$10                ;otherwise add sixteen more pixels
00D550  1  48           GetLRp: pha                     ;save modified horizontal coordinate to stack
00D551  1  B9 6E 00             lda Enemy_PageLoc,y
00D554  1  69 00                adc #$00                ;add carry to page location
00D556  1  85 02                sta $02                 ;and save here
00D558  1  68                   pla                     ;pull modified horizontal coordinate
00D559  1  29 F0                and #%11110000          ;from the stack, mask out low nybble
00D55B  1  4A                   lsr                     ;and shift three bits to the right
00D55C  1  4A                   lsr
00D55D  1  4A                   lsr
00D55E  1  85 00                sta $00                 ;store result here as part of name table low byte
00D560  1  B6 CF                ldx Enemy_Y_Position,y  ;get vertical coordinate
00D562  1  68                   pla                     ;get second/third copy of vertical speed from stack
00D563  1  10 05                bpl GetHRp              ;skip this part if moving downwards or not at all
00D565  1  8A                   txa
00D566  1  18                   clc
00D567  1  69 08                adc #$08                ;add eight to vertical coordinate and
00D569  1  AA                   tax                     ;save as X
00D56A  1  8A           GetHRp: txa                     ;move vertical coordinate to A
00D56B  1  AE 00 03             ldx VRAM_Buffer1_Offset ;get vram buffer offset
00D56E  1  0A                   asl
00D56F  1  2A                   rol                     ;rotate d7 to d0 and d6 into carry
00D570  1  48                   pha                     ;save modified vertical coordinate to stack
00D571  1  2A                   rol                     ;rotate carry to d0, thus d7 and d6 are at 2 LSB
00D572  1  29 03                and #%00000011          ;mask out all bits but d7 and d6, then set
00D574  1  09 20                ora #%00100000          ;d5 to get appropriate high byte of name table
00D576  1  85 01                sta $01                 ;address, then store
00D578  1  A5 02                lda $02                 ;get saved page location from earlier
00D57A  1  29 01                and #$01                ;mask out all but LSB
00D57C  1  0A                   asl
00D57D  1  0A                   asl                     ;shift twice to the left and save with the
00D57E  1  05 01                ora $01                 ;rest of the bits of the high byte, to get
00D580  1  85 01                sta $01                 ;the proper name table and the right place on it
00D582  1  68                   pla                     ;get modified vertical coordinate from stack
00D583  1  29 E0                and #%11100000          ;mask out low nybble and LSB of high nybble
00D585  1  18                   clc
00D586  1  65 00                adc $00                 ;add to horizontal part saved here
00D588  1  85 00                sta $00                 ;save as name table low byte
00D58A  1  B9 CF 00             lda Enemy_Y_Position,y
00D58D  1  C9 E8                cmp #$e8                ;if vertical position not below the
00D58F  1  90 06                bcc ExPRp               ;bottom of the screen, we're done, branch to leave
00D591  1  A5 00                lda $00
00D593  1  29 BF                and #%10111111          ;mask out d6 of low byte of name table address
00D595  1  85 00                sta $00
00D597  1  60           ExPRp:  rts                     ;leave!
00D598  1               
00D598  1               InitPlatformFall:
00D598  1  98                 tya                        ;move offset of other platform from Y to X
00D599  1  AA                 tax
00D59A  1  20 AF F1           jsr GetEnemyOffscreenBits  ;get offscreen bits
00D59D  1  A9 06              lda #$06
00D59F  1  20 11 DA           jsr SetupFloateyNumber     ;award 1000 points to player
00D5A2  1  AD AD 03           lda Player_Rel_XPos
00D5A5  1  9D 17 01           sta FloateyNum_X_Pos,x     ;put floatey number coordinates where player is
00D5A8  1  A5 CE              lda Player_Y_Position
00D5AA  1  9D 1E 01           sta FloateyNum_Y_Pos,x
00D5AD  1  A9 01              lda #$01                   ;set moving direction as flag for
00D5AF  1  95 46              sta Enemy_MovingDir,x      ;falling platforms
00D5B1  1               
00D5B1  1               StopPlatforms:
00D5B1  1  20 63 C3           jsr InitVStf             ;initialize vertical speed and low byte
00D5B4  1  99 A0 00           sta Enemy_Y_Speed,y      ;for both platforms and leave
00D5B7  1  99 34 04           sta Enemy_Y_MoveForce,y
00D5BA  1  60                 rts
00D5BB  1               
00D5BB  1               PlatformFall:
00D5BB  1  98                 tya                         ;save offset for other platform to stack
00D5BC  1  48                 pha
00D5BD  1  20 6B BF           jsr MoveFallingPlatform     ;make current platform fall
00D5C0  1  68                 pla
00D5C1  1  AA                 tax                         ;pull offset from stack and save to X
00D5C2  1  20 6B BF           jsr MoveFallingPlatform     ;make other platform fall
00D5C5  1  A6 08              ldx ObjectOffset
00D5C7  1  BD A2 03           lda PlatformCollisionFlag,x ;if player not standing on either platform,
00D5CA  1  30 04              bmi ExPF                    ;skip this part
00D5CC  1  AA                 tax                         ;transfer collision flag offset as offset to X
00D5CD  1  20 21 DC           jsr PositionPlayerOnVPlat   ;and position player appropriately
00D5D0  1  A6 08        ExPF: ldx ObjectOffset            ;get enemy object buffer offset and leave
00D5D2  1  60                 rts
00D5D3  1               
00D5D3  1               ;--------------------------------
00D5D3  1               
00D5D3  1               YMovingPlatform:
00D5D3  1  B5 A0                lda Enemy_Y_Speed,x          ;if platform moving up or down, skip ahead to
00D5D5  1  1D 34 04             ora Enemy_Y_MoveForce,x      ;check on other position
00D5D8  1  D0 15                bne ChkYCenterPos
00D5DA  1  9D 17 04             sta Enemy_YMF_Dummy,x        ;initialize dummy variable
00D5DD  1  B5 CF                lda Enemy_Y_Position,x
00D5DF  1  DD 01 04             cmp YPlatformTopYPos,x       ;if current vertical position => top position, branch
00D5E2  1  B0 0B                bcs ChkYCenterPos            ;ahead of all this
00D5E4  1  A5 09                lda FrameCounter
00D5E6  1  29 07                and #%00000111               ;check for every eighth frame
00D5E8  1  D0 02                bne SkipIY
00D5EA  1  F6 CF                inc Enemy_Y_Position,x       ;increase vertical position every eighth frame
00D5EC  1  4C FE D5     SkipIY: jmp ChkYPCollision           ;skip ahead to last part
00D5EF  1               
00D5EF  1               ChkYCenterPos:
00D5EF  1  B5 CF                lda Enemy_Y_Position,x       ;if current vertical position < central position, branch
00D5F1  1  D5 58                cmp YPlatformCenterYPos,x    ;to slow ascent/move downwards
00D5F3  1  90 06                bcc YMDown
00D5F5  1  20 B7 BF             jsr MovePlatformUp           ;otherwise start slowing descent/moving upwards
00D5F8  1  4C FE D5             jmp ChkYPCollision
00D5FB  1  20 B4 BF     YMDown: jsr MovePlatformDown         ;start slowing ascent/moving downwards
00D5FE  1               
00D5FE  1               ChkYPCollision:
00D5FE  1  BD A2 03            lda PlatformCollisionFlag,x  ;if collision flag not set here, branch
00D601  1  30 03               bmi ExYPl                    ;to leave
00D603  1  20 21 DC            jsr PositionPlayerOnVPlat    ;otherwise position player appropriately
00D606  1  60           ExYPl: rts                          ;leave
00D607  1               
00D607  1               ;--------------------------------
00D607  1               ;$00 - used as adder to position player hotizontally
00D607  1               
00D607  1               XMovingPlatform:
00D607  1  A9 0E              lda #$0e                     ;load preset maximum value for secondary counter
00D609  1  20 47 CB           jsr XMoveCntr_Platform       ;do a sub to increment counters for movement
00D60C  1  20 66 CB           jsr MoveWithXMCntrs          ;do a sub to move platform accordingly, and return value
00D60F  1  BD A2 03           lda PlatformCollisionFlag,x  ;if no collision with player,
00D612  1  30 1C              bmi ExXMP                    ;branch ahead to leave
00D614  1               
00D614  1               PositionPlayerOnHPlat:
00D614  1  A5 86                 lda Player_X_Position
00D616  1  18                    clc                       ;add saved value from second subroutine to
00D617  1  65 00                 adc $00                   ;current player's position to position
00D619  1  85 86                 sta Player_X_Position     ;player accordingly in horizontal position
00D61B  1  A5 6D                 lda Player_PageLoc        ;get player's page location
00D61D  1  A4 00                 ldy $00                   ;check to see if saved value here is positive or negative
00D61F  1  30 05                 bmi PPHSubt               ;if negative, branch to subtract
00D621  1  69 00                 adc #$00                  ;otherwise add carry to page location
00D623  1  4C 28 D6              jmp SetPVar               ;jump to skip subtraction
00D626  1  E9 00        PPHSubt: sbc #$00                  ;subtract borrow from page location
00D628  1  85 6D        SetPVar: sta Player_PageLoc        ;save result to player's page location
00D62A  1  8C A1 03              sty Platform_X_Scroll     ;put saved value from second sub here to be used later
00D62D  1  20 21 DC              jsr PositionPlayerOnVPlat ;position player vertically and appropriately
00D630  1  60           ExXMP:   rts                       ;and we are done here
00D631  1               
00D631  1               ;--------------------------------
00D631  1               
00D631  1               DropPlatform:
00D631  1  BD A2 03            lda PlatformCollisionFlag,x  ;if no collision between platform and player
00D634  1  30 06               bmi ExDPl                    ;occurred, just leave without moving anything
00D636  1  20 88 BF            jsr MoveDropPlatform         ;otherwise do a sub to move platform down very quickly
00D639  1  20 21 DC            jsr PositionPlayerOnVPlat    ;do a sub to position player appropriately
00D63C  1  60           ExDPl: rts                          ;leave
00D63D  1               
00D63D  1               ;--------------------------------
00D63D  1               ;$00 - residual value from sub
00D63D  1               
00D63D  1               RightPlatform:
00D63D  1  20 02 BF            jsr MoveEnemyHorizontally     ;move platform with current horizontal speed, if any
00D640  1  85 00               sta $00                       ;store saved value here (residual code)
00D642  1  BD A2 03            lda PlatformCollisionFlag,x   ;check collision flag, if no collision between player
00D645  1  30 07               bmi ExRPl                     ;and platform, branch ahead, leave speed unaltered
00D647  1  A9 10               lda #$10
00D649  1  95 58               sta Enemy_X_Speed,x           ;otherwise set new speed (gets moving if motionless)
00D64B  1  20 14 D6            jsr PositionPlayerOnHPlat     ;use saved value from earlier sub to position player
00D64E  1  60           ExRPl: rts                           ;then leave
00D64F  1               
00D64F  1               ;--------------------------------
00D64F  1               
00D64F  1               MoveLargeLiftPlat:
00D64F  1  20 5B D6           jsr MoveLiftPlatforms  ;execute common to all large and small lift platforms
00D652  1  4C FE D5           jmp ChkYPCollision     ;branch to position player correctly
00D655  1               
00D655  1               MoveSmallPlatform:
00D655  1  20 5B D6           jsr MoveLiftPlatforms      ;execute common to all large and small lift platforms
00D658  1  4C 71 D6           jmp ChkSmallPlatCollision  ;branch to position player correctly
00D65B  1               
00D65B  1               MoveLiftPlatforms:
00D65B  1  AD 47 07           lda TimerControl         ;if master timer control set, skip all of this
00D65E  1  D0 19              bne ExLiftP              ;and branch to leave
00D660  1  BD 17 04           lda Enemy_YMF_Dummy,x
00D663  1  18                 clc                      ;add contents of movement amount to whatever's here
00D664  1  7D 34 04           adc Enemy_Y_MoveForce,x
00D667  1  9D 17 04           sta Enemy_YMF_Dummy,x
00D66A  1  B5 CF              lda Enemy_Y_Position,x   ;add whatever vertical speed is set to current
00D66C  1  75 A0              adc Enemy_Y_Speed,x      ;vertical position plus carry to move up or down
00D66E  1  95 CF              sta Enemy_Y_Position,x   ;and then leave
00D670  1  60                 rts
00D671  1               
00D671  1               ChkSmallPlatCollision:
00D671  1  BD A2 03              lda PlatformCollisionFlag,x ;get bounding box counter saved in collision flag
00D674  1  F0 03                 beq ExLiftP                 ;if none found, leave player position alone
00D676  1  20 19 DC              jsr PositionPlayerOnS_Plat  ;use to position player correctly
00D679  1  60           ExLiftP: rts                         ;then leave
00D67A  1               
00D67A  1               ;-------------------------------------------------------------------------------------
00D67A  1               ;$00 - page location of extended left boundary
00D67A  1               ;$01 - extended left boundary position
00D67A  1               ;$02 - page location of extended right boundary
00D67A  1               ;$03 - extended right boundary position
00D67A  1               
00D67A  1               OffscreenBoundsCheck:
00D67A  1  B5 16                  lda Enemy_ID,x          ;check for cheep-cheep object
00D67C  1  C9 14                  cmp #FlyingCheepCheep   ;branch to leave if found
00D67E  1  F0 55                  beq ExScrnBd
00D680  1  AD 1C 07               lda ScreenLeft_X_Pos    ;get horizontal coordinate for left side of screen
00D683  1  B4 16                  ldy Enemy_ID,x
00D685  1  C0 05                  cpy #HammerBro          ;check for hammer bro object
00D687  1  F0 04                  beq LimitB
00D689  1  C0 0D                  cpy #PiranhaPlant       ;check for piranha plant object
00D68B  1  D0 02                  bne ExtendLB            ;these two will be erased sooner than others if too far left
00D68D  1  69 38        LimitB:   adc #$38                ;add 56 pixels to coordinate if hammer bro or piranha plant
00D68F  1  E9 48        ExtendLB: sbc #$48                ;subtract 72 pixels regardless of enemy object
00D691  1  85 01                  sta $01                 ;store result here
00D693  1  AD 1A 07               lda ScreenLeft_PageLoc
00D696  1  E9 00                  sbc #$00                ;subtract borrow from page location of left side
00D698  1  85 00                  sta $00                 ;store result here
00D69A  1  AD 1D 07               lda ScreenRight_X_Pos   ;add 72 pixels to the right side horizontal coordinate
00D69D  1  69 48                  adc #$48
00D69F  1  85 03                  sta $03                 ;store result here
00D6A1  1  AD 1B 07               lda ScreenRight_PageLoc
00D6A4  1  69 00                  adc #$00                ;then add the carry to the page location
00D6A6  1  85 02                  sta $02                 ;and store result here
00D6A8  1  B5 87                  lda Enemy_X_Position,x  ;compare horizontal coordinate of the enemy object
00D6AA  1  C5 01                  cmp $01                 ;to modified horizontal left edge coordinate to get carry
00D6AC  1  B5 6E                  lda Enemy_PageLoc,x
00D6AE  1  E5 00                  sbc $00                 ;then subtract it from the page coordinate of the enemy object
00D6B0  1  30 20                  bmi TooFar              ;if enemy object is too far left, branch to erase it
00D6B2  1  B5 87                  lda Enemy_X_Position,x  ;compare horizontal coordinate of the enemy object
00D6B4  1  C5 03                  cmp $03                 ;to modified horizontal right edge coordinate to get carry
00D6B6  1  B5 6E                  lda Enemy_PageLoc,x
00D6B8  1  E5 02                  sbc $02                 ;then subtract it from the page coordinate of the enemy object
00D6BA  1  30 19                  bmi ExScrnBd            ;if enemy object is on the screen, leave, do not erase enemy
00D6BC  1  B5 1E                  lda Enemy_State,x       ;if at this point, enemy is offscreen to the right, so check
00D6BE  1  C9 05                  cmp #HammerBro          ;if in state used by spiny's egg, do not erase
00D6C0  1  F0 13                  beq ExScrnBd
00D6C2  1  C0 0D                  cpy #PiranhaPlant       ;if piranha plant, do not erase
00D6C4  1  F0 0F                  beq ExScrnBd
00D6C6  1  C0 30                  cpy #FlagpoleFlagObject ;if flagpole flag, do not erase
00D6C8  1  F0 0B                  beq ExScrnBd
00D6CA  1  C0 31                  cpy #StarFlagObject     ;if star flag, do not erase
00D6CC  1  F0 07                  beq ExScrnBd
00D6CE  1  C0 32                  cpy #JumpspringObject   ;if jumpspring, do not erase
00D6D0  1  F0 03                  beq ExScrnBd            ;erase all others too far to the right
00D6D2  1  20 98 C9     TooFar:   jsr EraseEnemyObject    ;erase object if necessary
00D6D5  1  60           ExScrnBd: rts                     ;leave
00D6D6  1               
00D6D6  1               ;-------------------------------------------------------------------------------------
00D6D6  1               
00D6D6  1               ;some unused space
00D6D6  1  FF FF FF           .byte $ff, $ff, $ff
00D6D9  1               
00D6D9  1               ;-------------------------------------------------------------------------------------
00D6D9  1               ;$01 - enemy buffer offset
00D6D9  1               
00D6D9  1               FireballEnemyCollision:
00D6D9  1  B5 24              lda Fireball_State,x  ;check to see if fireball state is set at all
00D6DB  1  F0 56              beq ExitFBallEnemy    ;branch to leave if not
00D6DD  1  0A                 asl
00D6DE  1  B0 53              bcs ExitFBallEnemy    ;branch to leave also if d7 in state is set
00D6E0  1  A5 09              lda FrameCounter
00D6E2  1  4A                 lsr                   ;get LSB of frame counter
00D6E3  1  B0 4E              bcs ExitFBallEnemy    ;branch to leave if set (do routine every other frame)
00D6E5  1  8A                 txa
00D6E6  1  0A                 asl                   ;multiply fireball offset by four
00D6E7  1  0A                 asl
00D6E8  1  18                 clc
00D6E9  1  69 1C              adc #$1c              ;then add $1c or 28 bytes to it
00D6EB  1  A8                 tay                   ;to use fireball's bounding box coordinates
00D6EC  1  A2 04              ldx #$04
00D6EE  1               
00D6EE  1               FireballEnemyCDLoop:
00D6EE  1  86 01                   stx $01                     ;store enemy object offset here
00D6F0  1  98                      tya
00D6F1  1  48                      pha                         ;push fireball offset to the stack
00D6F2  1  B5 1E                   lda Enemy_State,x
00D6F4  1  29 20                   and #%00100000              ;check to see if d5 is set in enemy state
00D6F6  1  D0 34                   bne NoFToECol               ;if so, skip to next enemy slot
00D6F8  1  B5 0F                   lda Enemy_Flag,x            ;check to see if buffer flag is set
00D6FA  1  F0 30                   beq NoFToECol               ;if not, skip to next enemy slot
00D6FC  1  B5 16                   lda Enemy_ID,x              ;check enemy identifier
00D6FE  1  C9 24                   cmp #$24
00D700  1  90 04                   bcc GoombaDie               ;if < $24, branch to check further
00D702  1  C9 2B                   cmp #$2b
00D704  1  90 26                   bcc NoFToECol               ;if in range $24-$2a, skip to next enemy slot
00D706  1  C9 06        GoombaDie: cmp #Goomba                 ;check for goomba identifier
00D708  1  D0 06                   bne NotGoomba               ;if not found, continue with code
00D70A  1  B5 1E                   lda Enemy_State,x           ;otherwise check for defeated state
00D70C  1  C9 02                   cmp #$02                    ;if stomped or otherwise defeated,
00D70E  1  B0 1C                   bcs NoFToECol               ;skip to next enemy slot
00D710  1  BD D8 03     NotGoomba: lda EnemyOffscrBitsMasked,x ;if any masked offscreen bits set,
00D713  1  D0 17                   bne NoFToECol               ;skip to next enemy slot
00D715  1  8A                      txa
00D716  1  0A                      asl                         ;otherwise multiply enemy offset by four
00D717  1  0A                      asl
00D718  1  18                      clc
00D719  1  69 04                   adc #$04                    ;add 4 bytes to it
00D71B  1  AA                      tax                         ;to use enemy's bounding box coordinates
00D71C  1  20 27 E3                jsr SprObjectCollisionCore  ;do fireball-to-enemy collision detection
00D71F  1  A6 08                   ldx ObjectOffset            ;return fireball's original offset
00D721  1  90 09                   bcc NoFToECol               ;if carry clear, no collision, thus do next enemy slot
00D723  1  A9 80                   lda #%10000000
00D725  1  95 24                   sta Fireball_State,x        ;set d7 in enemy state
00D727  1  A6 01                   ldx $01                     ;get enemy offset
00D729  1  20 3E D7                jsr HandleEnemyFBallCol     ;jump to handle fireball to enemy collision
00D72C  1  68           NoFToECol: pla                         ;pull fireball offset from stack
00D72D  1  A8                      tay                         ;put it in Y
00D72E  1  A6 01                   ldx $01                     ;get enemy object offset
00D730  1  CA                      dex                         ;decrement it
00D731  1  10 BB                   bpl FireballEnemyCDLoop     ;loop back until collision detection done on all enemies
00D733  1               
00D733  1               ExitFBallEnemy:
00D733  1  A6 08              ldx ObjectOffset                 ;get original fireball offset and leave
00D735  1  60                 rts
00D736  1               
00D736  1               BowserIdentities:
00D736  1  06 00 02 12        .byte Goomba, GreenKoopa, BuzzyBeetle, Spiny, Lakitu, Bloober, HammerBro, Bowser
00D73A  1  11 07 05 2D  
00D73E  1               
00D73E  1               HandleEnemyFBallCol:
00D73E  1  20 52 F1           jsr RelativeEnemyPosition  ;get relative coordinate of enemy
00D741  1  A6 01              ldx $01                    ;get current enemy object offset
00D743  1  B5 0F              lda Enemy_Flag,x           ;check buffer flag for d7 set
00D745  1  10 0B              bpl ChkBuzzyBeetle         ;branch if not set to continue
00D747  1  29 0F              and #%00001111             ;otherwise mask out high nybble and
00D749  1  AA                 tax                        ;use low nybble as enemy offset
00D74A  1  B5 16              lda Enemy_ID,x
00D74C  1  C9 2D              cmp #Bowser                ;check enemy identifier for bowser
00D74E  1  F0 0C              beq HurtBowser             ;branch if found
00D750  1  A6 01              ldx $01                    ;otherwise retrieve current enemy offset
00D752  1               
00D752  1               ChkBuzzyBeetle:
00D752  1  B5 16              lda Enemy_ID,x
00D754  1  C9 02              cmp #BuzzyBeetle           ;check for buzzy beetle
00D756  1  F0 6B              beq ExHCF                  ;branch if found to leave (buzzy beetles fireproof)
00D758  1  C9 2D              cmp #Bowser                ;check for bowser one more time (necessary if d7 of flag was clear)
00D75A  1  D0 2D              bne ChkOtherEnemies        ;if not found, branch to check other enemies
00D75C  1               
00D75C  1               HurtBowser:
00D75C  1  CE 83 04               dec BowserHitPoints        ;decrement bowser's hit points
00D75F  1  D0 62                  bne ExHCF                  ;if bowser still has hit points, branch to leave
00D761  1  20 63 C3               jsr InitVStf               ;otherwise do sub to init vertical speed and movement force
00D764  1  95 58                  sta Enemy_X_Speed,x        ;initialize horizontal speed
00D766  1  8D CB 06               sta EnemyFrenzyBuffer      ;init enemy frenzy buffer
00D769  1  A9 FE                  lda #$fe
00D76B  1  95 A0                  sta Enemy_Y_Speed,x        ;set vertical speed to make defeated bowser jump a little
00D76D  1  AC 5F 07               ldy WorldNumber            ;use world number as offset
00D770  1  B9 36 D7               lda BowserIdentities,y     ;get enemy identifier to replace bowser with
00D773  1  95 16                  sta Enemy_ID,x             ;set as new enemy identifier
00D775  1  A9 20                  lda #$20                   ;set A to use starting value for state
00D777  1  C0 03                  cpy #$03                   ;check to see if using offset of 3 or more
00D779  1  B0 02                  bcs SetDBSte               ;branch if so
00D77B  1  09 03                  ora #$03                   ;otherwise add 3 to enemy state
00D77D  1  95 1E        SetDBSte: sta Enemy_State,x          ;set defeated enemy state
00D77F  1  A9 80                  lda #Sfx_BowserFall
00D781  1  85 FE                  sta Square2SoundQueue      ;load bowser defeat sound
00D783  1  A6 01                  ldx $01                    ;get enemy offset
00D785  1  A9 09                  lda #$09                   ;award 5000 points to player for defeating bowser
00D787  1  D0 33                  bne EnemySmackScore        ;unconditional branch to award points
00D789  1               
00D789  1               ChkOtherEnemies:
00D789  1  C9 08              cmp #BulletBill_FrenzyVar
00D78B  1  F0 36              beq ExHCF                 ;branch to leave if bullet bill (frenzy variant)
00D78D  1  C9 0C              cmp #Podoboo
00D78F  1  F0 32              beq ExHCF                 ;branch to leave if podoboo
00D791  1  C9 15              cmp #$15
00D793  1  B0 2E              bcs ExHCF                 ;branch to leave if identifier => $15
00D795  1               
00D795  1               ShellOrBlockDefeat:
00D795  1  B5 16              lda Enemy_ID,x            ;check for piranha plant
00D797  1  C9 0D              cmp #PiranhaPlant
00D799  1  D0 06              bne StnE                  ;branch if not found
00D79B  1  B5 CF              lda Enemy_Y_Position,x
00D79D  1  69 18              adc #$18                  ;add 24 pixels to enemy object's vertical position
00D79F  1  95 CF              sta Enemy_Y_Position,x
00D7A1  1  20 1B E0     StnE: jsr ChkToStunEnemies      ;do yet another sub
00D7A4  1  B5 1E              lda Enemy_State,x
00D7A6  1  29 1F              and #%00011111            ;mask out 2 MSB of enemy object's state
00D7A8  1  09 20              ora #%00100000            ;set d5 to defeat enemy and save as new state
00D7AA  1  95 1E              sta Enemy_State,x
00D7AC  1  A9 02              lda #$02                  ;award 200 points by default
00D7AE  1  B4 16              ldy Enemy_ID,x            ;check for hammer bro
00D7B0  1  C0 05              cpy #HammerBro
00D7B2  1  D0 02              bne GoombaPoints          ;branch if not found
00D7B4  1  A9 06              lda #$06                  ;award 1000 points for hammer bro
00D7B6  1               
00D7B6  1               GoombaPoints:
00D7B6  1  C0 06              cpy #Goomba               ;check for goomba
00D7B8  1  D0 02              bne EnemySmackScore       ;branch if not found
00D7BA  1  A9 01              lda #$01                  ;award 100 points for goomba
00D7BC  1               
00D7BC  1               EnemySmackScore:
00D7BC  1  20 11 DA            jsr SetupFloateyNumber   ;update necessary score variables
00D7BF  1  A9 08               lda #Sfx_EnemySmack      ;play smack enemy sound
00D7C1  1  85 FF               sta Square1SoundQueue
00D7C3  1  60           ExHCF: rts                      ;and now let's leave
00D7C4  1               
00D7C4  1               ;-------------------------------------------------------------------------------------
00D7C4  1               
00D7C4  1               PlayerHammerCollision:
00D7C4  1  A5 09                lda FrameCounter          ;get frame counter
00D7C6  1  4A                   lsr                       ;shift d0 into carry
00D7C7  1  90 36                bcc ExPHC                 ;branch to leave if d0 not set to execute every other frame
00D7C9  1  AD 47 07             lda TimerControl          ;if either master timer control
00D7CC  1  0D D6 03             ora Misc_OffscreenBits    ;or any offscreen bits for hammer are set,
00D7CF  1  D0 2E                bne ExPHC                 ;branch to leave
00D7D1  1  8A                   txa
00D7D2  1  0A                   asl                       ;multiply misc object offset by four
00D7D3  1  0A                   asl
00D7D4  1  18                   clc
00D7D5  1  69 24                adc #$24                  ;add 36 or $24 bytes to get proper offset
00D7D7  1  A8                   tay                       ;for misc object bounding box coordinates
00D7D8  1  20 25 E3             jsr PlayerCollisionCore   ;do player-to-hammer collision detection
00D7DB  1  A6 08                ldx ObjectOffset          ;get misc object offset
00D7DD  1  90 1B                bcc ClHCol                ;if no collision, then branch
00D7DF  1  BD BE 06             lda Misc_Collision_Flag,x ;otherwise read collision flag
00D7E2  1  D0 1B                bne ExPHC                 ;if collision flag already set, branch to leave
00D7E4  1  A9 01                lda #$01
00D7E6  1  9D BE 06             sta Misc_Collision_Flag,x ;otherwise set collision flag now
00D7E9  1  B5 64                lda Misc_X_Speed,x
00D7EB  1  49 FF                eor #$ff                  ;get two's compliment of
00D7ED  1  18                   clc                       ;hammer's horizontal speed
00D7EE  1  69 01                adc #$01
00D7F0  1  95 64                sta Misc_X_Speed,x        ;set to send hammer flying the opposite direction
00D7F2  1  AD 9F 07             lda StarInvincibleTimer   ;if star mario invincibility timer set,
00D7F5  1  D0 08                bne ExPHC                 ;branch to leave
00D7F7  1  4C 2C D9             jmp InjurePlayer          ;otherwise jump to hurt player, do not return
00D7FA  1  A9 00        ClHCol: lda #$00                  ;clear collision flag
00D7FC  1  9D BE 06             sta Misc_Collision_Flag,x
00D7FF  1  60           ExPHC:  rts
