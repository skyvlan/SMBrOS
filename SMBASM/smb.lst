00C6FD  1               DoBulletBills:
00C6FD  1  A0 FF                  ldy #$ff                   ;start at beginning of enemy slots
00C6FF  1  C8           BB_SLoop: iny                        ;move onto the next slot
00C700  1  C0 05                  cpy #$05                   ;branch to play sound if we've done all slots
00C702  1  B0 0D                  bcs FireBulletBill
00C704  1  B9 0F 00               lda Enemy_Flag,y           ;if enemy buffer flag not set,
00C707  1  F0 F6                  beq BB_SLoop               ;loop back and check another slot
00C709  1  B9 16 00               lda Enemy_ID,y
00C70C  1  C9 08                  cmp #BulletBill_FrenzyVar  ;check enemy identifier for
00C70E  1  D0 EF                  bne BB_SLoop               ;bullet bill object (frenzy variant)
00C710  1  60           ExF17:    rts                        ;if found, leave
