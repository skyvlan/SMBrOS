008F97  1               UpdateTopScore:
008F97  1  A2 05              ldx #$05          ;start with mario's score
008F99  1  20 9E 8F           jsr TopScoreCheck
008F9C  1  A2 0B              ldx #$0b          ;now do luigi's score
008F9E  1               
008F9E  1               TopScoreCheck:
008F9E  1  A0 05                      ldy #$05                 ;start with the lowest digit
008FA0  1  38                         sec
008FA1  1  BD DD 07     GetScoreDiff: lda PlayerScoreDisplay,x ;subtract each player digit from each high score digit
008FA4  1  F9 D7 07                   sbc TopScoreDisplay,y    ;from lowest to highest, if any top score digit exceeds
008FA7  1  CA                         dex                      ;any player digit, borrow will be set until a subsequent
008FA8  1  88                         dey                      ;subtraction clears it (player digit is higher than top)
008FA9  1  10 F6                      bpl GetScoreDiff
008FAB  1  90 0E                      bcc NoTopSc              ;check to see if borrow is still set, if so, no new high score
008FAD  1  E8                         inx                      ;increment X and Y once to the start of the score
008FAE  1  C8                         iny
008FAF  1  BD DD 07     CopyScore:    lda PlayerScoreDisplay,x ;store player's score digits into high score memory area
008FB2  1  99 D7 07                   sta TopScoreDisplay,y
008FB5  1  E8                         inx
008FB6  1  C8                         iny
008FB7  1  C0 06                      cpy #$06                 ;do this until we have stored them all
008FB9  1  90 F4                      bcc CopyScore
008FBB  1  60           NoTopSc:      rts
