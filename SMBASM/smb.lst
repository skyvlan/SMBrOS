00C3A4  1               LakituAndSpinyHandler:
00C3A4  1  AD 8F 07               lda FrenzyEnemyTimer    ;if timer here not expired, leave
00C3A7  1  D0 3C                  bne ExLSHand
00C3A9  1  E0 05                  cpx #$05                ;if we are on the special use slot, leave
00C3AB  1  B0 38                  bcs ExLSHand
00C3AD  1  A9 80                  lda #$80                ;set timer
00C3AF  1  8D 8F 07               sta FrenzyEnemyTimer
00C3B2  1  A0 04                  ldy #$04                ;start with the last enemy slot
00C3B4  1  B9 16 00     ChkLak:   lda Enemy_ID,y          ;check all enemy slots to see
00C3B7  1  C9 11                  cmp #Lakitu             ;if lakitu is on one of them
00C3B9  1  F0 2B                  beq CreateSpiny         ;if so, branch out of this loop
00C3BB  1  88                     dey                     ;otherwise check another slot
00C3BC  1  10 F6                  bpl ChkLak              ;loop until all slots are checked
00C3BE  1  EE D1 06               inc LakituReappearTimer ;increment reappearance timer
00C3C1  1  AD D1 06               lda LakituReappearTimer
00C3C4  1  C9 07                  cmp #$07                ;check to see if we're up to a certain value yet
00C3C6  1  90 1D                  bcc ExLSHand            ;if not, leave
00C3C8  1  A2 04                  ldx #$04                ;start with the last enemy slot again
00C3CA  1  B5 0F        ChkNoEn:  lda Enemy_Flag,x        ;check enemy buffer flag for non-active enemy slot
00C3CC  1  F0 05                  beq CreateL             ;branch out of loop if found
00C3CE  1  CA                     dex                     ;otherwise check next slot
00C3CF  1  10 F9                  bpl ChkNoEn             ;branch until all slots are checked
00C3D1  1  30 10                  bmi RetEOfs             ;if no empty slots were found, branch to leave
00C3D3  1  A9 00        CreateL:  lda #$00                ;initialize enemy state
00C3D5  1  95 1E                  sta Enemy_State,x
00C3D7  1  A9 11                  lda #Lakitu             ;create lakitu enemy object
00C3D9  1  95 16                  sta Enemy_ID,x
00C3DB  1  20 8A C3               jsr SetupLakitu         ;do a sub to set up lakitu
00C3DE  1  A9 20                  lda #$20
00C3E0  1  20 D8 C5               jsr PutAtRightExtent    ;finish setting up lakitu
00C3E3  1  A6 08        RetEOfs:  ldx ObjectOffset        ;get enemy object buffer offset again and leave
00C3E5  1  60           ExLSHand: rts
