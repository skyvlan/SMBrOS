0084C3  1               FloateyNumbersRoutine:
0084C3  1  BD 10 01                   lda FloateyNum_Control,x     ;load control for floatey number
0084C6  1  F0 BE                      beq EndExitOne               ;if zero, branch to leave
0084C8  1  C9 0B                      cmp #$0b                     ;if less than $0b, branch
0084CA  1  90 05                      bcc ChkNumTimer
0084CC  1  A9 0B                      lda #$0b                     ;otherwise set to $0b, thus keeping
0084CE  1  9D 10 01                   sta FloateyNum_Control,x     ;it in range
0084D1  1  A8           ChkNumTimer:  tay                          ;use as Y
0084D2  1  BD 2C 01                   lda FloateyNum_Timer,x       ;check value here
0084D5  1  D0 04                      bne DecNumTimer              ;if nonzero, branch ahead
0084D7  1  9D 10 01                   sta FloateyNum_Control,x     ;initialize floatey number control and leave
0084DA  1  60                         rts
0084DB  1  DE 2C 01     DecNumTimer:  dec FloateyNum_Timer,x       ;decrement value here
0084DE  1  C9 2B                      cmp #$2b                     ;if not reached a certain point, branch
0084E0  1  D0 1E                      bne ChkTallEnemy
0084E2  1  C0 0B                      cpy #$0b                     ;check offset for $0b
0084E4  1  D0 07                      bne LoadNumTiles             ;branch ahead if not found
0084E6  1  EE 5A 07                   inc NumberofLives            ;give player one extra life (1-up)
0084E9  1  A9 40                      lda #Sfx_ExtraLife
0084EB  1  85 FE                      sta Square2SoundQueue        ;and play the 1-up sound
0084ED  1  B9 B7 84     LoadNumTiles: lda ScoreUpdateData,y        ;load point value here
0084F0  1  4A                         lsr                          ;move high nybble to low
0084F1  1  4A                         lsr
0084F2  1  4A                         lsr
0084F3  1  4A                         lsr
0084F4  1  AA                         tax                          ;use as X offset, essentially the digit
0084F5  1  B9 B7 84                   lda ScoreUpdateData,y        ;load again and this time
0084F8  1  29 0F                      and #%00001111               ;mask out the high nybble
0084FA  1  9D 34 01                   sta DigitModifier,x          ;store as amount to add to the digit
0084FD  1  20 27 BC                   jsr AddToScore               ;update the score accordingly
008500  1  BC E5 06     ChkTallEnemy: ldy Enemy_SprDataOffset,x    ;get OAM data offset for enemy object
008503  1  B5 16                      lda Enemy_ID,x               ;get enemy object identifier
008505  1  C9 12                      cmp #Spiny
008507  1  F0 22                      beq FloateyPart              ;branch if spiny
008509  1  C9 0D                      cmp #PiranhaPlant
00850B  1  F0 1E                      beq FloateyPart              ;branch if piranha plant
00850D  1  C9 05                      cmp #HammerBro
00850F  1  F0 12                      beq GetAltOffset             ;branch elsewhere if hammer bro
008511  1  C9 0A                      cmp #GreyCheepCheep
008513  1  F0 16                      beq FloateyPart              ;branch if cheep-cheep of either color
008515  1  C9 0B                      cmp #RedCheepCheep
008517  1  F0 12                      beq FloateyPart
008519  1  C9 09                      cmp #TallEnemy
00851B  1  B0 06                      bcs GetAltOffset             ;branch elsewhere if enemy object => $09
00851D  1  B5 1E                      lda Enemy_State,x
00851F  1  C9 02                      cmp #$02                     ;if enemy state defeated or otherwise
008521  1  B0 08                      bcs FloateyPart              ;$02 or greater, branch beyond this part
008523  1  AE EE 03     GetAltOffset: ldx SprDataOffset_Ctrl       ;load some kind of control bit
008526  1  BC EC 06                   ldy Alt_SprDataOffset,x      ;get alternate OAM data offset
008529  1  A6 08                      ldx ObjectOffset             ;get enemy object offset again
