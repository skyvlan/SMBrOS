00F2D0  1               
00F2D0  1               SoundEngine:
00F2D0  1  AD 70 07              lda OperMode              ;are we in title screen mode?
00F2D3  1  D0 04                 bne SndOn
00F2D5  1  8D 15 40              sta SND_MASTERCTRL_REG    ;if so, disable sound and leave
00F2D8  1  60                    rts
00F2D9  1  A9 FF        SndOn:   lda #$ff
00F2DB  1  8D 17 40              sta JOYPAD_PORT2          ;disable irqs and set frame counter mode???
00F2DE  1  A9 0F                 lda #$0f
00F2E0  1  8D 15 40              sta SND_MASTERCTRL_REG    ;enable first four channels
00F2E3  1  AD C6 07              lda PauseModeFlag         ;is sound already in pause mode?
00F2E6  1  D0 06                 bne InPause
00F2E8  1  A5 FA                 lda PauseSoundQueue       ;if not, check pause sfx queue
00F2EA  1  C9 01                 cmp #$01
00F2EC  1  D0 5D                 bne RunSoundSubroutines   ;if queue is empty, skip pause mode routine
00F2EE  1  AD B2 07     InPause: lda PauseSoundBuffer      ;check pause sfx buffer
00F2F1  1  D0 23                 bne ContPau
00F2F3  1  A5 FA                 lda PauseSoundQueue       ;check pause queue
00F2F5  1  F0 66                 beq SkipSoundSubroutines
00F2F7  1  8D B2 07              sta PauseSoundBuffer      ;if queue full, store in buffer and activate
00F2FA  1  8D C6 07              sta PauseModeFlag         ;pause mode to interrupt game sounds
00F2FD  1  A9 00                 lda #$00                  ;disable sound and clear sfx buffers
00F2FF  1  8D 15 40              sta SND_MASTERCTRL_REG
00F302  1  85 F1                 sta Square1SoundBuffer
00F304  1  85 F2                 sta Square2SoundBuffer
00F306  1  85 F3                 sta NoiseSoundBuffer
00F308  1  A9 0F                 lda #$0f
00F30A  1  8D 15 40              sta SND_MASTERCTRL_REG    ;enable sound again
00F30D  1  A9 2A                 lda #$2a                  ;store length of sound in pause counter
00F30F  1  8D BB 07              sta Squ1_SfxLenCounter
00F312  1  A9 44        PTone1F: lda #$44                  ;play first tone
00F314  1  D0 11                 bne PTRegC                ;unconditional branch
00F316  1  AD BB 07     ContPau: lda Squ1_SfxLenCounter    ;check pause length left
00F319  1  C9 24                 cmp #$24                  ;time to play second?
00F31B  1  F0 08                 beq PTone2F
00F31D  1  C9 1E                 cmp #$1e                  ;time to play first again?
00F31F  1  F0 F1                 beq PTone1F
00F321  1  C9 18                 cmp #$18                  ;time to play second again?
00F323  1  D0 09                 bne DecPauC               ;only load regs during times, otherwise skip
00F325  1  A9 64        PTone2F: lda #$64                  ;store reg contents and play the pause sfx
00F327  1  A2 84        PTRegC:  ldx #$84
00F329  1  A0 7F                 ldy #$7f
00F32B  1  20 88 F3              jsr PlaySqu1Sfx
00F32E  1  CE BB 07     DecPauC: dec Squ1_SfxLenCounter    ;decrement pause sfx counter
