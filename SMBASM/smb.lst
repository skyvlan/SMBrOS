00C9A0  1  9D 10 01           sta FloateyNum_Control,x
00C9A3  1  9D 96 07           sta EnemyIntervalTimer,x
00C9A6  1  9D 25 01           sta ShellChainCounter,x
00C9A9  1  9D C5 03           sta Enemy_SprAttrib,x
