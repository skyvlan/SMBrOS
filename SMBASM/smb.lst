00B04A  1               GameRoutines:
00B04A  1  A5 0E              lda GameEngineSubroutine  ;run routine based on number (a few of these routines are
00B04C  1  20 04 8E           jsr JumpEngine            ;merely placeholders as conditions for other routines)
00B04F  1               
00B04F  1  31 91              .word Entrance_GameTimerSetup
00B051  1  C7 B1              .word Vine_AutoClimb
00B053  1  06 B2              .word SideExitPipeEntry
00B055  1  E5 B1              .word VerticalPipeEntry
00B057  1  A4 B2              .word FlagpoleSlide
00B059  1  CA B2              .word PlayerEndLevel
00B05B  1  CD 91              .word PlayerLoseLife
00B05D  1  69 B0              .word PlayerEntrance
00B05F  1  E9 B0              .word PlayerCtrlRoutine
00B061  1  33 B2              .word PlayerChangeSize
00B063  1  45 B2              .word PlayerInjuryBlink
00B065  1  69 B2              .word PlayerDeath
00B067  1  7D B2              .word PlayerFireFlower
00B069  1               
00B069  1               ;-------------------------------------------------------------------------------------
00B069  1               
00B069  1               PlayerEntrance:
00B069  1  AD 52 07                 lda AltEntranceControl    ;check for mode of alternate entry
00B06C  1  C9 02                    cmp #$02
00B06E  1  F0 2B                    beq EntrMode2             ;if found, branch to enter from pipe or with vine
00B070  1  A9 00                    lda #$00
00B072  1  A4 CE                    ldy Player_Y_Position     ;if vertical position above a certain
00B074  1  C0 30                    cpy #$30                  ;point, nullify controller bits and continue
00B076  1  90 6E                    bcc AutoControlPlayer     ;with player movement code, do not return
00B078  1  AD 10 07                 lda PlayerEntranceCtrl    ;check player entry bits from header
00B07B  1  C9 06                    cmp #$06
00B07D  1  F0 04                    beq ChkBehPipe            ;if set to 6 or 7, execute pipe intro code
00B07F  1  C9 07                    cmp #$07                  ;otherwise branch to normal entry
00B081  1  D0 50                    bne PlayerRdy
00B083  1  AD C4 03     ChkBehPipe: lda Player_SprAttrib      ;check for sprite attributes
00B086  1  D0 05                    bne IntroEntr             ;branch if found
00B088  1  A9 01                    lda #$01
00B08A  1  4C E6 B0                 jmp AutoControlPlayer     ;force player to walk to the right
