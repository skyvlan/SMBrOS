00892C  1  46 03                    lsr $03                      ;thus in d5-d4 for lower left square
00892E  1  E6 04        NextMTRow:  inc $04                      ;move onto next attribute row
008930  1  B9 F9 03     SetAttrib:  lda AttributeBuffer,y        ;get previously saved bits from before
008933  1  05 03                    ora $03                      ;if any, and put new bits, if any, onto
008935  1  99 F9 03                 sta AttributeBuffer,y        ;the old, and store
008938  1  E6 00                    inc $00                      ;increment vram buffer offset by 2
00893A  1  E6 00                    inc $00
