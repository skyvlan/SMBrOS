00B58C  1               
00B58C  1               PlayerAnimTmrData:
00B58C  1  02 04 07           .byte $02, $04, $07
00B58F  1               
00B58F  1               GetPlayerAnimSpeed:
00B58F  1  A0 00                    ldy #$00                   ;initialize offset in Y
00B591  1  AD 00 07                 lda Player_XSpeedAbsolute  ;check player's walking/running speed
00B594  1  C9 1C                    cmp #$1c                   ;against preset amount
00B596  1  B0 15                    bcs SetRunSpd              ;if greater than a certain amount, branch ahead
00B598  1  C8                       iny                        ;otherwise increment Y
00B599  1  C9 0E                    cmp #$0e                   ;compare against lower amount
00B59B  1  B0 01                    bcs ChkSkid                ;if greater than this but not greater than first, skip increment
00B59D  1  C8                       iny                        ;otherwise increment Y again
00B59E  1  AD FC 06     ChkSkid:    lda SavedJoypadBits        ;get controller bits
00B5A1  1  29 7F                    and #%01111111             ;mask out A button
00B5A3  1  F0 20                    beq SetAnimSpd             ;if no other buttons pressed, branch ahead of all this
00B5A5  1  29 03                    and #$03                   ;mask out all others except left and right
00B5A7  1  C5 45                    cmp Player_MovingDir       ;check against moving direction
00B5A9  1  D0 08                    bne ProcSkid               ;if left/right controller bits <> moving direction, branch
00B5AB  1  A9 00                    lda #$00                   ;otherwise set zero value here
00B5AD  1  8D 03 07     SetRunSpd:  sta RunningSpeed           ;store zero or running speed here
00B5B0  1  4C C5 B5                 jmp SetAnimSpd
00B5B3  1  AD 00 07     ProcSkid:   lda Player_XSpeedAbsolute  ;check player's walking/running speed
00B5B6  1  C9 0B                    cmp #$0b                   ;against one last amount
00B5B8  1  B0 0B                    bcs SetAnimSpd             ;if greater than this amount, branch
00B5BA  1  A5 33                    lda PlayerFacingDir
00B5BC  1  85 45                    sta Player_MovingDir       ;otherwise use facing direction to set moving direction
00B5BE  1  A9 00                    lda #$00
00B5C0  1  85 57                    sta Player_X_Speed         ;nullify player's horizontal speed
00B5C2  1  8D 05 07                 sta Player_X_MoveForce     ;and dummy variable for player
00B5C5  1  B9 8C B5     SetAnimSpd: lda PlayerAnimTmrData,y    ;get animation timer setting using Y as offset
00B5C8  1  8D 0C 07                 sta PlayerAnimTimerSet
00B5CB  1  60                       rts
00B5CC  1               
00B5CC  1               ;-------------------------------------------------------------------------------------
00B5CC  1               
00B5CC  1               ImposeFriction:
00B5CC  1  2D 90 04                and Player_CollisionBits  ;perform AND between left/right controller bits and collision flag
00B5CF  1  C9 00                   cmp #$00                  ;then compare to zero (this instruction is redundant)
00B5D1  1  D0 08                   bne JoypFrict             ;if any bits set, branch to next part
00B5D3  1  A5 57                   lda Player_X_Speed
00B5D5  1  F0 49                   beq SetAbsSpd             ;if player has no horizontal speed, branch ahead to last part
00B5D7  1  10 23                   bpl RghtFrict             ;if player moving to the right, branch to slow
00B5D9  1  30 03                   bmi LeftFrict             ;otherwise logic dictates player moving left, branch to slow
00B5DB  1  4A           JoypFrict: lsr                       ;put right controller bit into carry
00B5DC  1  90 1E                   bcc RghtFrict             ;if left button pressed, carry = 0, thus branch
00B5DE  1  AD 05 07     LeftFrict: lda Player_X_MoveForce    ;load value set here
00B5E1  1  18                      clc
00B5E2  1  6D 02 07                adc FrictionAdderLow      ;add to it another value set here
00B5E5  1  8D 05 07                sta Player_X_MoveForce    ;store here
00B5E8  1  A5 57                   lda Player_X_Speed
00B5EA  1  6D 01 07                adc FrictionAdderHigh     ;add value plus carry to horizontal speed
00B5ED  1  85 57                   sta Player_X_Speed        ;set as new horizontal speed
00B5EF  1  CD 56 04                cmp MaximumRightSpeed     ;compare against maximum value for right movement
00B5F2  1  30 23                   bmi XSpdSign              ;if horizontal speed greater negatively, branch
00B5F4  1  AD 56 04                lda MaximumRightSpeed     ;otherwise set preset value as horizontal speed
00B5F7  1  85 57                   sta Player_X_Speed        ;thus slowing the player's left movement down
00B5F9  1  4C 20 B6                jmp SetAbsSpd             ;skip to the end
00B5FC  1  AD 05 07     RghtFrict: lda Player_X_MoveForce    ;load value set here
00B5FF  1  38                      sec
00B600  1  ED 02 07                sbc FrictionAdderLow      ;subtract from it another value set here
00B603  1  8D 05 07                sta Player_X_MoveForce    ;store here
00B606  1  A5 57                   lda Player_X_Speed
00B608  1  ED 01 07                sbc FrictionAdderHigh     ;subtract value plus borrow from horizontal speed
00B60B  1  85 57                   sta Player_X_Speed        ;set as new horizontal speed
00B60D  1  CD 50 04                cmp MaximumLeftSpeed      ;compare against maximum value for left movement
00B610  1  10 05                   bpl XSpdSign              ;if horizontal speed greater positively, branch
00B612  1  AD 50 04                lda MaximumLeftSpeed      ;otherwise set preset value as horizontal speed
00B615  1  85 57                   sta Player_X_Speed        ;thus slowing the player's right movement down
00B617  1  C9 00        XSpdSign:  cmp #$00                  ;if player not moving or moving to the right,
00B619  1  10 05                   bpl SetAbsSpd             ;branch and leave horizontal speed value unmodified
00B61B  1  49 FF                   eor #$ff
00B61D  1  18                      clc                       ;otherwise get two's compliment to get absolute
00B61E  1  69 01                   adc #$01                  ;unsigned walking/running speed
00B620  1  8D 00 07     SetAbsSpd: sta Player_XSpeedAbsolute ;store walking/running speed here and leave
00B623  1  60                      rts
00B624  1               
00B624  1               ;-------------------------------------------------------------------------------------
00B624  1               ;$00 - used to store downward movement force in FireballObjCore
00B624  1               ;$02 - used to store maximum vertical speed in FireballObjCore
00B624  1               ;$07 - used to store pseudorandom bit in BubbleCheck
00B624  1               
00B624  1               ProcFireball_Bubble:
00B624  1  AD 56 07           lda PlayerStatus           ;check player's status
00B627  1  C9 02              cmp #$02
00B629  1  90 43              bcc ProcAirBubbles         ;if not fiery, branch
00B62B  1  A5 0A              lda A_B_Buttons
00B62D  1  29 40              and #B_Button              ;check for b button pressed
00B62F  1  F0 33              beq ProcFireballs          ;branch if not pressed
00B631  1  25 0D              and PreviousA_B_Buttons
00B633  1  D0 2F              bne ProcFireballs          ;if button pressed in previous frame, branch
00B635  1  AD CE 06           lda FireballCounter        ;load fireball counter
00B638  1  29 01              and #%00000001             ;get LSB and use as offset for buffer
00B63A  1  AA                 tax
00B63B  1  B5 24              lda Fireball_State,x       ;load fireball state
00B63D  1  D0 25              bne ProcFireballs          ;if not inactive, branch
00B63F  1  A4 B5              ldy Player_Y_HighPos       ;if player too high or too low, branch
00B641  1  88                 dey
00B642  1  D0 20              bne ProcFireballs
00B644  1  AD 14 07           lda CrouchingFlag          ;if player crouching, branch
00B647  1  D0 1B              bne ProcFireballs
00B649  1  A5 1D              lda Player_State           ;if player's state = climbing, branch
00B64B  1  C9 03              cmp #$03
00B64D  1  F0 15              beq ProcFireballs
00B64F  1  A9 20              lda #Sfx_Fireball          ;play fireball sound effect
00B651  1  85 FF              sta Square1SoundQueue
00B653  1  A9 02              lda #$02                   ;load state
00B655  1  95 24              sta Fireball_State,x
00B657  1  AC 0C 07           ldy PlayerAnimTimerSet     ;copy animation frame timer setting
00B65A  1  8C 11 07           sty FireballThrowingTimer  ;into fireball throwing timer
00B65D  1  88                 dey
00B65E  1  8C 81 07           sty PlayerAnimTimer        ;decrement and store in player's animation timer
00B661  1  EE CE 06           inc FireballCounter        ;increment fireball counter
00B664  1               
00B664  1               ProcFireballs:
00B664  1  A2 00              ldx #$00
00B666  1  20 89 B6           jsr FireballObjCore  ;process first fireball object
00B669  1  A2 01              ldx #$01
00B66B  1  20 89 B6           jsr FireballObjCore  ;process second fireball object, then do air bubbles
00B66E  1               
00B66E  1               ProcAirBubbles:
00B66E  1  AD 4E 07               lda AreaType                ;if not water type level, skip the rest of this
00B671  1  D0 13                  bne BublExit
00B673  1  A2 02                  ldx #$02                    ;otherwise load counter and use as offset
00B675  1  86 08        BublLoop: stx ObjectOffset            ;store offset
00B677  1  20 F9 B6               jsr BubbleCheck             ;check timers and coordinates, create air bubble
00B67A  1  20 31 F1               jsr RelativeBubblePosition  ;get relative coordinates
00B67D  1  20 91 F1               jsr GetBubbleOffscreenBits  ;get offscreen information
00B680  1  20 E1 ED               jsr DrawBubble              ;draw the air bubble
00B683  1  CA                     dex
00B684  1  10 EF                  bpl BublLoop                ;do this until all three are handled
00B686  1  60           BublExit: rts                         ;then leave
00B687  1               
00B687  1               FireballXSpdData:
00B687  1  40 C0              .byte $40, $c0
00B689  1               
00B689  1               FireballObjCore:
00B689  1  86 08                 stx ObjectOffset             ;store offset as current object
00B68B  1  B5 24                 lda Fireball_State,x         ;check for d7 = 1
00B68D  1  0A                    asl
00B68E  1  B0 63                 bcs FireballExplosion        ;if so, branch to get relative coordinates and draw explosion
00B690  1  B4 24                 ldy Fireball_State,x         ;if fireball inactive, branch to leave
00B692  1  F0 5E                 beq NoFBall
00B694  1  88                    dey                          ;if fireball state set to 1, skip this part and just run it
00B695  1  F0 27                 beq RunFB
00B697  1  A5 86                 lda Player_X_Position        ;get player's horizontal position
00B699  1  69 04                 adc #$04                     ;add four pixels and store as fireball's horizontal position
00B69B  1  95 8D                 sta Fireball_X_Position,x
00B69D  1  A5 6D                 lda Player_PageLoc           ;get player's page location
00B69F  1  69 00                 adc #$00                     ;add carry and store as fireball's page location
00B6A1  1  95 74                 sta Fireball_PageLoc,x
00B6A3  1  A5 CE                 lda Player_Y_Position        ;get player's vertical position and store
00B6A5  1  95 D5                 sta Fireball_Y_Position,x
00B6A7  1  A9 01                 lda #$01                     ;set high byte of vertical position
00B6A9  1  95 BC                 sta Fireball_Y_HighPos,x
00B6AB  1  A4 33                 ldy PlayerFacingDir          ;get player's facing direction
00B6AD  1  88                    dey                          ;decrement to use as offset here
00B6AE  1  B9 87 B6              lda FireballXSpdData,y       ;set horizontal speed of fireball accordingly
00B6B1  1  95 5E                 sta Fireball_X_Speed,x
00B6B3  1  A9 04                 lda #$04                     ;set vertical speed of fireball
00B6B5  1  95 A6                 sta Fireball_Y_Speed,x
00B6B7  1  A9 07                 lda #$07
00B6B9  1  9D A0 04              sta Fireball_BoundBoxCtrl,x  ;set bounding box size control for fireball
00B6BC  1  D6 24                 dec Fireball_State,x         ;decrement state to 1 to skip this part from now on
00B6BE  1  8A           RunFB:   txa                          ;add 7 to offset to use
00B6BF  1  18                    clc                          ;as fireball offset for next routines
00B6C0  1  69 07                 adc #$07
00B6C2  1  AA                    tax
00B6C3  1  A9 50                 lda #$50                     ;set downward movement force here
00B6C5  1  85 00                 sta $00
00B6C7  1  A9 03                 lda #$03                     ;set maximum speed here
00B6C9  1  85 02                 sta $02
00B6CB  1  A9 00                 lda #$00
00B6CD  1  20 D7 BF              jsr ImposeGravity            ;do sub here to impose gravity on fireball and move vertically
00B6D0  1  20 0F BF              jsr MoveObjectHorizontally   ;do another sub to move it horizontally
00B6D3  1  A6 08                 ldx ObjectOffset             ;return fireball offset to X
00B6D5  1  20 3B F1              jsr RelativeFireballPosition ;get relative coordinates
00B6D8  1  20 87 F1              jsr GetFireballOffscreenBits ;get offscreen information
00B6DB  1  20 2D E2              jsr GetFireballBoundBox      ;get bounding box coordinates
00B6DE  1  20 C8 E1              jsr FireballBGCollision      ;do fireball to background collision detection
00B6E1  1  AD D2 03              lda FBall_OffscreenBits      ;get fireball offscreen bits
00B6E4  1  29 CC                 and #%11001100               ;mask out certain bits
00B6E6  1  D0 06                 bne EraseFB                  ;if any bits still set, branch to kill fireball
00B6E8  1  20 D9 D6              jsr FireballEnemyCollision   ;do fireball to enemy collision detection and deal with collisions
00B6EB  1  4C DE EC              jmp DrawFireball             ;draw fireball appropriately and leave
00B6EE  1  A9 00        EraseFB: lda #$00                     ;erase fireball state
00B6F0  1  95 24                 sta Fireball_State,x
00B6F2  1  60           NoFBall: rts                          ;leave
00B6F3  1               
00B6F3  1               FireballExplosion:
00B6F3  1  20 3B F1           jsr RelativeFireballPosition
00B6F6  1  4C 09 ED           jmp DrawExplosion_Fireball
00B6F9  1               
00B6F9  1               BubbleCheck:
00B6F9  1  BD A8 07           lda PseudoRandomBitReg+1,x  ;get part of LSFR
00B6FC  1  29 01              and #$01
00B6FE  1  85 07              sta $07                     ;store pseudorandom bit here
00B700  1  B5 E4              lda Bubble_Y_Position,x     ;get vertical coordinate for air bubble
00B702  1  C9 F8              cmp #$f8                    ;if offscreen coordinate not set,
00B704  1  D0 2C              bne MoveBubl                ;branch to move air bubble
00B706  1  AD 92 07           lda AirBubbleTimer          ;if air bubble timer not expired,
00B709  1  D0 3F              bne ExitBubl                ;branch to leave, otherwise create new air bubble
00B70B  1               
00B70B  1               SetupBubble:
00B70B  1  A0 00                  ldy #$00                 ;load default value here
00B70D  1  A5 33                  lda PlayerFacingDir      ;get player's facing direction
00B70F  1  4A                     lsr                      ;move d0 to carry
00B710  1  90 02                  bcc PosBubl              ;branch to use default value if facing left
00B712  1  A0 08                  ldy #$08                 ;otherwise load alternate value here
00B714  1  98           PosBubl:  tya                      ;use value loaded as adder
00B715  1  65 86                  adc Player_X_Position    ;add to player's horizontal position
00B717  1  95 9C                  sta Bubble_X_Position,x  ;save as horizontal position for airbubble
00B719  1  A5 6D                  lda Player_PageLoc
00B71B  1  69 00                  adc #$00                 ;add carry to player's page location
00B71D  1  95 83                  sta Bubble_PageLoc,x     ;save as page location for airbubble
00B71F  1  A5 CE                  lda Player_Y_Position
00B721  1  18                     clc                      ;add eight pixels to player's vertical position
00B722  1  69 08                  adc #$08
00B724  1  95 E4                  sta Bubble_Y_Position,x  ;save as vertical position for air bubble
00B726  1  A9 01                  lda #$01
00B728  1  95 CB                  sta Bubble_Y_HighPos,x   ;set vertical high byte for air bubble
00B72A  1  A4 07                  ldy $07                  ;get pseudorandom bit, use as offset
00B72C  1  B9 4D B7               lda BubbleTimerData,y    ;get data for air bubble timer
00B72F  1  8D 92 07               sta AirBubbleTimer       ;set air bubble timer
00B732  1  A4 07        MoveBubl: ldy $07                  ;get pseudorandom bit again, use as offset
00B734  1  BD 2C 04               lda Bubble_YMF_Dummy,x
00B737  1  38                     sec                      ;subtract pseudorandom amount from dummy variable
00B738  1  F9 4B B7               sbc Bubble_MForceData,y
00B73B  1  9D 2C 04               sta Bubble_YMF_Dummy,x   ;save dummy variable
00B73E  1  B5 E4                  lda Bubble_Y_Position,x
00B740  1  E9 00                  sbc #$00                 ;subtract borrow from airbubble's vertical coordinate
00B742  1  C9 20                  cmp #$20                 ;if below the status bar,
00B744  1  B0 02                  bcs Y_Bubl               ;branch to go ahead and use to move air bubble upwards
00B746  1  A9 F8                  lda #$f8                 ;otherwise set offscreen coordinate
00B748  1  95 E4        Y_Bubl:   sta Bubble_Y_Position,x  ;store as new vertical coordinate for air bubble
00B74A  1  60           ExitBubl: rts                      ;leave
00B74B  1               
00B74B  1               Bubble_MForceData:
00B74B  1  FF 50              .byte $ff, $50
00B74D  1               
00B74D  1               BubbleTimerData:
00B74D  1  40 20              .byte $40, $20
00B74F  1               
00B74F  1               ;-------------------------------------------------------------------------------------
00B74F  1               
00B74F  1               RunGameTimer:
00B74F  1  AD 70 07                lda OperMode               ;get primary mode of operation
00B752  1  F0 4F                   beq ExGTimer               ;branch to leave if in title screen mode
00B754  1  A5 0E                   lda GameEngineSubroutine
00B756  1  C9 08                   cmp #$08                   ;if routine number less than eight running,
00B758  1  90 49                   bcc ExGTimer               ;branch to leave
00B75A  1  C9 0B                   cmp #$0b                   ;if running death routine,
00B75C  1  F0 45                   beq ExGTimer               ;branch to leave
00B75E  1  A5 B5                   lda Player_Y_HighPos
00B760  1  C9 02                   cmp #$02                   ;if player below the screen,
00B762  1  B0 3F                   bcs ExGTimer               ;branch to leave regardless of level type
00B764  1  AD 87 07                lda GameTimerCtrlTimer     ;if game timer control not yet expired,
00B767  1  D0 3A                   bne ExGTimer               ;branch to leave
00B769  1  AD F8 07                lda GameTimerDisplay
00B76C  1  0D F9 07                ora GameTimerDisplay+1     ;otherwise check game timer digits
00B76F  1  0D FA 07                ora GameTimerDisplay+2
00B772  1  F0 26                   beq TimeUpOn               ;if game timer digits at 000, branch to time-up code
00B774  1  AC F8 07                ldy GameTimerDisplay       ;otherwise check first digit
00B777  1  88                      dey                        ;if first digit not on 1,
00B778  1  D0 0C                   bne ResGTCtrl              ;branch to reset game timer control
00B77A  1  AD F9 07                lda GameTimerDisplay+1     ;otherwise check second and third digits
00B77D  1  0D FA 07                ora GameTimerDisplay+2
00B780  1  D0 04                   bne ResGTCtrl              ;if timer not at 100, branch to reset game timer control
00B782  1  A9 40                   lda #TimeRunningOutMusic
00B784  1  85 FC                   sta EventMusicQueue        ;otherwise load time running out music
00B786  1  A9 18        ResGTCtrl: lda #$18                   ;reset game timer control
00B788  1  8D 87 07                sta GameTimerCtrlTimer
00B78B  1  A0 23                   ldy #$23                   ;set offset for last digit
00B78D  1  A9 FF                   lda #$ff                   ;set value to decrement game timer digit
00B78F  1  8D 39 01                sta DigitModifier+5
00B792  1  20 5F 8F                jsr DigitsMathRoutine      ;do sub to decrement game timer slowly
00B795  1  A9 A4                   lda #$a4                   ;set status nybbles to update game timer display
00B797  1  4C 06 8F                jmp PrintStatusBarNumbers  ;do sub to update the display
00B79A  1  8D 56 07     TimeUpOn:  sta PlayerStatus           ;init player status (note A will always be zero here)
00B79D  1  20 31 D9                jsr ForceInjury            ;do sub to kill the player (note player is small here)
00B7A0  1  EE 59 07                inc GameTimerExpiredFlag   ;set game timer expiration flag
00B7A3  1  60           ExGTimer:  rts                        ;leave
00B7A4  1               
00B7A4  1               ;-------------------------------------------------------------------------------------
00B7A4  1               
00B7A4  1               WarpZoneObject:
00B7A4  1  AD 23 07           lda ScrollLock         ;check for scroll lock flag
00B7A7  1  F0 FA              beq ExGTimer           ;branch if not set to leave
00B7A9  1  A5 CE              lda Player_Y_Position  ;check to see if player's vertical coordinate has
00B7AB  1  25 B5              and Player_Y_HighPos   ;same bits set as in vertical high byte (why?)
00B7AD  1  D0 F4              bne ExGTimer           ;if so, branch to leave
00B7AF  1  8D 23 07           sta ScrollLock         ;otherwise nullify scroll lock flag
00B7B2  1  EE D6 06           inc WarpZoneControl    ;increment warp zone flag to make warp pipes for warp zone
00B7B5  1  4C 98 C9           jmp EraseEnemyObject   ;kill this object
00B7B8  1               
00B7B8  1               ;-------------------------------------------------------------------------------------
00B7B8  1               ;$00 - used in WhirlpoolActivate to store whirlpool length / 2, page location of center of whirlpool
00B7B8  1               ;and also to store movement force exerted on player
00B7B8  1               ;$01 - used in ProcessWhirlpools to store page location of right extent of whirlpool
00B7B8  1               ;and in WhirlpoolActivate to store center of whirlpool
00B7B8  1               ;$02 - used in ProcessWhirlpools to store right extent of whirlpool and in
00B7B8  1               ;WhirlpoolActivate to store maximum vertical speed
00B7B8  1               
00B7B8  1               ProcessWhirlpools:
00B7B8  1  AD 4E 07             lda AreaType                ;check for water type level
00B7BB  1  D0 37                bne ExitWh                  ;branch to leave if not found
00B7BD  1  8D 7D 04             sta Whirlpool_Flag          ;otherwise initialize whirlpool flag
00B7C0  1  AD 47 07             lda TimerControl            ;if master timer control set,
00B7C3  1  D0 2F                bne ExitWh                  ;branch to leave
00B7C5  1  A0 04                ldy #$04                    ;otherwise start with last whirlpool data
00B7C7  1  B9 71 04     WhLoop: lda Whirlpool_LeftExtent,y  ;get left extent of whirlpool
00B7CA  1  18                   clc
00B7CB  1  79 77 04             adc Whirlpool_Length,y      ;add length of whirlpool
00B7CE  1  85 02                sta $02                     ;store result as right extent here
00B7D0  1  B9 6B 04             lda Whirlpool_PageLoc,y     ;get page location
00B7D3  1  F0 1C                beq NextWh                  ;if none or page 0, branch to get next data
00B7D5  1  69 00                adc #$00                    ;add carry
00B7D7  1  85 01                sta $01                     ;store result as page location of right extent here
00B7D9  1  A5 86                lda Player_X_Position       ;get player's horizontal position
00B7DB  1  38                   sec
00B7DC  1  F9 71 04             sbc Whirlpool_LeftExtent,y  ;subtract left extent
00B7DF  1  A5 6D                lda Player_PageLoc          ;get player's page location
00B7E1  1  F9 6B 04             sbc Whirlpool_PageLoc,y     ;subtract borrow
00B7E4  1  30 0B                bmi NextWh                  ;if player too far left, branch to get next data
00B7E6  1  A5 02                lda $02                     ;otherwise get right extent
00B7E8  1  38                   sec
00B7E9  1  E5 86                sbc Player_X_Position       ;subtract player's horizontal coordinate
00B7EB  1  A5 01                lda $01                     ;get right extent's page location
00B7ED  1  E5 6D                sbc Player_PageLoc          ;subtract borrow
00B7EF  1  10 04                bpl WhirlpoolActivate       ;if player within right extent, branch to whirlpool code
00B7F1  1  88           NextWh: dey                         ;move onto next whirlpool data
00B7F2  1  10 D3                bpl WhLoop                  ;do this until all whirlpools are checked
00B7F4  1  60           ExitWh: rts                         ;leave
00B7F5  1               
00B7F5  1               WhirlpoolActivate:
00B7F5  1  B9 77 04             lda Whirlpool_Length,y      ;get length of whirlpool
00B7F8  1  4A                   lsr                         ;divide by 2
00B7F9  1  85 00                sta $00                     ;save here
00B7FB  1  B9 71 04             lda Whirlpool_LeftExtent,y  ;get left extent of whirlpool
00B7FE  1  18                   clc
00B7FF  1  65 00                adc $00                     ;add length divided by 2
00B801  1  85 01                sta $01                     ;save as center of whirlpool
00B803  1  B9 6B 04             lda Whirlpool_PageLoc,y     ;get page location
00B806  1  69 00                adc #$00                    ;add carry
00B808  1  85 00                sta $00                     ;save as page location of whirlpool center
00B80A  1  A5 09                lda FrameCounter            ;get frame counter
00B80C  1  4A                   lsr                         ;shift d0 into carry (to run on every other frame)
00B80D  1  90 2C                bcc WhPull                  ;if d0 not set, branch to last part of code
00B80F  1  A5 01                lda $01                     ;get center
00B811  1  38                   sec
00B812  1  E5 86                sbc Player_X_Position       ;subtract player's horizontal coordinate
00B814  1  A5 00                lda $00                     ;get page location of center
00B816  1  E5 6D                sbc Player_PageLoc          ;subtract borrow
00B818  1  10 0E                bpl LeftWh                  ;if player to the left of center, branch
00B81A  1  A5 86                lda Player_X_Position       ;otherwise slowly pull player left, towards the center
00B81C  1  38                   sec
00B81D  1  E9 01                sbc #$01                    ;subtract one pixel
00B81F  1  85 86                sta Player_X_Position       ;set player's new horizontal coordinate
00B821  1  A5 6D                lda Player_PageLoc
00B823  1  E9 00                sbc #$00                    ;subtract borrow
00B825  1  4C 39 B8             jmp SetPWh                  ;jump to set player's new page location
00B828  1  AD 90 04     LeftWh: lda Player_CollisionBits    ;get player's collision bits
00B82B  1  4A                   lsr                         ;shift d0 into carry
00B82C  1  90 0D                bcc WhPull                  ;if d0 not set, branch
00B82E  1  A5 86                lda Player_X_Position       ;otherwise slowly pull player right, towards the center
00B830  1  18                   clc
00B831  1  69 01                adc #$01                    ;add one pixel
00B833  1  85 86                sta Player_X_Position       ;set player's new horizontal coordinate
00B835  1  A5 6D                lda Player_PageLoc
00B837  1  69 00                adc #$00                    ;add carry
00B839  1  85 6D        SetPWh: sta Player_PageLoc          ;set player's new page location
00B83B  1  A9 10        WhPull: lda #$10
00B83D  1  85 00                sta $00                     ;set vertical movement force
00B83F  1  A9 01                lda #$01
00B841  1  8D 7D 04             sta Whirlpool_Flag          ;set whirlpool flag to be used later
00B844  1  85 02                sta $02                     ;also set maximum vertical speed
00B846  1  4A                   lsr
00B847  1  AA                   tax                         ;set X for player offset
00B848  1  4C D7 BF             jmp ImposeGravity           ;jump to put whirlpool effect on player vertically, do not return
