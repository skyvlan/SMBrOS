00DC06  1  B9 AE 04              lda BoundingBox_DR_XPos,y  ;get difference by subtracting player's left edge
00DC09  1  18                    clc                        ;from platform's right edge
00DC0A  1  ED AC 04              sbc BoundingBox_UL_XPos
