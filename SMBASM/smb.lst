0088B8  1  84 00                    sty $00
0088BA  1  AD 21 07                 lda CurrentNTAddr_Low        ;get current name table address we're supposed to render
0088BD  1  99 42 03                 sta VRAM_Buffer2+1,y
0088C0  1  AD 20 07                 lda CurrentNTAddr_High
0088C3  1  99 41 03                 sta VRAM_Buffer2,y
