00BFD8  1  BD 16 04              lda SprObject_YMF_Dummy,x
00BFDB  1  18                    clc                          ;add value in movement force to contents of dummy variable
00BFDC  1  7D 33 04              adc SprObject_Y_MoveForce,x
00BFDF  1  9D 16 04              sta SprObject_YMF_Dummy,x
00BFE2  1  A0 00                 ldy #$00                     ;set Y to zero by default
00BFE4  1  B5 9F                 lda SprObject_Y_Speed,x      ;get current vertical speed
00BFE6  1  10 01                 bpl AlterYP                  ;if currently moving downwards, do not decrement Y
00BFE8  1  88                    dey                          ;otherwise decrement Y
00BFE9  1  84 07        AlterYP: sty $07                      ;store Y here
00BFEB  1  75 CE                 adc SprObject_Y_Position,x   ;add vertical position to vertical speed plus carry
00BFED  1  95 CE                 sta SprObject_Y_Position,x   ;store as new vertical position
00BFEF  1  B5 B5                 lda SprObject_Y_HighPos,x
00BFF1  1  65 07                 adc $07                      ;add carry plus contents of $07 to vertical high byte
00BFF3  1  95 B5                 sta SprObject_Y_HighPos,x    ;store as new vertical high byte
00BFF5  1  BD 33 04              lda SprObject_Y_MoveForce,x
00BFF8  1  18                    clc
00BFF9  1  65 00                 adc $00                      ;add downward movement amount to contents of $0433
00BFFB  1  9D 33 04              sta SprObject_Y_MoveForce,x
00BFFE  1  B5 9F                 lda SprObject_Y_Speed,x      ;add carry to vertical speed and store
00C000  1  69 00                 adc #$00
00C002  1  95 9F                 sta SprObject_Y_Speed,x
00C004  1  C5 02                 cmp $02                      ;compare to maximum speed
00C006  1  30 10                 bmi ChkUpM                   ;if less than preset value, skip this part
00C008  1  BD 33 04              lda SprObject_Y_MoveForce,x
00C00B  1  C9 80                 cmp #$80                     ;if less positively than preset maximum, skip this part
00C00D  1  90 09                 bcc ChkUpM
00C00F  1  A5 02                 lda $02
00C011  1  95 9F                 sta SprObject_Y_Speed,x      ;keep vertical speed within maximum value
00C013  1  A9 00                 lda #$00
00C015  1  9D 33 04              sta SprObject_Y_MoveForce,x  ;clear fractional
00C018  1  68           ChkUpM:  pla                          ;get value from stack
00C019  1  F0 2B                 beq ExVMove                  ;if set to zero, branch to leave
00C01B  1  A5 02                 lda $02
00C01D  1  49 FF                 eor #%11111111               ;otherwise get two's compliment of maximum speed
00C01F  1  A8                    tay
00C020  1  C8                    iny
00C021  1  84 07                 sty $07                      ;store two's compliment here
00C023  1  BD 33 04              lda SprObject_Y_MoveForce,x
00C026  1  38                    sec                          ;subtract upward movement amount from contents
00C027  1  E5 01                 sbc $01                      ;of movement force, note that $01 is twice as large as $00,
00C029  1  9D 33 04              sta SprObject_Y_MoveForce,x  ;thus it effectively undoes add we did earlier
00C02C  1  B5 9F                 lda SprObject_Y_Speed,x
00C02E  1  E9 00                 sbc #$00                     ;subtract borrow from vertical speed and store
00C030  1  95 9F                 sta SprObject_Y_Speed,x
00C032  1  C5 07                 cmp $07                      ;compare vertical speed to two's compliment
00C034  1  10 10                 bpl ExVMove                  ;if less negatively than preset maximum, skip this part
00C036  1  BD 33 04              lda SprObject_Y_MoveForce,x
