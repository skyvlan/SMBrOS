00F3EC  1  C9 20        N2Prt:    cmp #$20               ;check for third part
00F3EE  1  D0 29                  bne DecJpFPS
00F3F0  1  A2 48                  ldx #$48               ;load third part
00F3F2  1  A0 BC        FPS2nd:   ldy #$bc               ;the flagpole slide sound shares part of third part
00F3F4  1  20 81 F3     DmpJpFPS: jsr Dump_Squ1_Regs
00F3F7  1  D0 20                  bne DecJpFPS           ;unconditional branch outta here
