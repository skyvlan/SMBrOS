009131  1               Entrance_GameTimerSetup:
009131  1  AD 1A 07               lda ScreenLeft_PageLoc      ;set current page for area objects
009134  1  85 6D                  sta Player_PageLoc          ;as page location for player
009136  1  A9 28                  lda #$28                    ;store value here
009138  1  8D 0A 07               sta VerticalForceDown       ;for fractional movement downwards if necessary
00913B  1  A9 01                  lda #$01                    ;set high byte of player position and
00913D  1  85 33                  sta PlayerFacingDir         ;set facing direction so that player faces right
00913F  1  85 B5                  sta Player_Y_HighPos
009141  1  A9 00                  lda #$00                    ;set player state to on the ground by default
009143  1  85 1D                  sta Player_State
009145  1  CE 90 04               dec Player_CollisionBits    ;initialize player's collision bits
009148  1  A0 00                  ldy #$00                    ;initialize halfway page
00914A  1  8C 5B 07               sty HalfwayPage
00914D  1  AD 4E 07               lda AreaType                ;check area type
009150  1  D0 01                  bne ChkStPos                ;if water type, set swimming flag, otherwise do not set
009152  1  C8                     iny
009153  1  8C 04 07     ChkStPos: sty SwimmingFlag
009156  1  AE 10 07               ldx PlayerEntranceCtrl      ;get starting position loaded from header
009159  1  AC 52 07               ldy AltEntranceControl      ;check alternate mode of entry flag for 0 or 1
00915C  1  F0 07                  beq SetStPos
00915E  1  C0 01                  cpy #$01
009160  1  F0 03                  beq SetStPos
009162  1  BE 18 91               ldx AltYPosOffset-2,y       ;if not 0 or 1, override $0710 with new offset in X
009165  1  B9 16 91     SetStPos: lda PlayerStarting_X_Pos,y  ;load appropriate horizontal position
009168  1  85 86                  sta Player_X_Position       ;and vertical positions for the player, using
00916A  1  BD 1C 91               lda PlayerStarting_Y_Pos,x  ;AltEntranceControl as offset for horizontal and either $0710
00916D  1  85 CE                  sta Player_Y_Position       ;or value that overwrote $0710 as offset for vertical
00916F  1  BD 25 91               lda PlayerBGPriorityData,x
009172  1  8D C4 03               sta Player_SprAttrib        ;set player sprite attributes using offset in X
009175  1  20 F1 85               jsr GetPlayerColors         ;get appropriate player palette
009178  1  AC 15 07               ldy GameTimerSetting        ;get timer control value from header
00917B  1  F0 1A                  beq ChkOverR                ;if set to zero, branch (do not use dummy byte for this)
00917D  1  AD 57 07               lda FetchNewGameTimerFlag   ;do we need to set the game timer? if not, use
009180  1  F0 15                  beq ChkOverR                ;old game timer setting
009182  1  B9 2D 91               lda GameTimerData,y         ;if game timer is set and game timer flag is also set,
009185  1  8D F8 07               sta GameTimerDisplay        ;use value of game timer control for first digit of game timer
009188  1  A9 01                  lda #$01
00918A  1  8D FA 07               sta GameTimerDisplay+2      ;set last digit of game timer to 1
00918D  1  4A                     lsr
00918E  1  8D F9 07               sta GameTimerDisplay+1      ;set second digit of game timer
009191  1  8D 57 07               sta FetchNewGameTimerFlag   ;clear flag for game timer reset
009194  1  8D 9F 07               sta StarInvincibleTimer     ;clear star mario timer
009197  1  AC 58 07     ChkOverR: ldy JoypadOverride          ;if controller bits not set, branch to skip this part
00919A  1  F0 14                  beq ChkSwimE
00919C  1  A9 03                  lda #$03                    ;set player state to climbing
00919E  1  85 1D                  sta Player_State
0091A0  1  A2 00                  ldx #$00                    ;set offset for first slot, for block object
0091A2  1  20 84 BD               jsr InitBlock_XY_Pos
0091A5  1  A9 F0                  lda #$f0                    ;set vertical coordinate for block object
0091A7  1  85 D7                  sta Block_Y_Position
0091A9  1  A2 05                  ldx #$05                    ;set offset in X for last enemy object buffer slot
0091AB  1  A0 00                  ldy #$00                    ;set offset in Y for object coordinates used earlier
0091AD  1  20 1E B9               jsr Setup_Vine              ;do a sub to grow vine
0091B0  1  AC 4E 07     ChkSwimE: ldy AreaType                ;if level not water-type,
0091B3  1  D0 03                  bne SetPESub                ;skip this subroutine
0091B5  1  20 0B B7               jsr SetupBubble             ;otherwise, execute sub to set up air bubbles
0091B8  1  A9 07        SetPESub: lda #$07                    ;set to run player entrance subroutine
0091BA  1  85 0E                  sta GameEngineSubroutine    ;on the next frame of game engine
0091BC  1  60                     rts
