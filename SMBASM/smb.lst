00E3F0  1               BlockBufferCollision:
00E3F0  1  48                  pha                         ;save contents of A to stack
00E3F1  1  84 04               sty $04                     ;save contents of Y here
00E3F3  1  B9 B0 E3            lda BlockBuffer_X_Adder,y   ;add horizontal coordinate
00E3F6  1  18                  clc                         ;of object to value obtained using Y as offset
00E3F7  1  75 86               adc SprObject_X_Position,x
00E3F9  1  85 05               sta $05                     ;store here
00E3FB  1  B5 6D               lda SprObject_PageLoc,x
00E3FD  1  69 00               adc #$00                    ;add carry to page location
00E3FF  1  29 01               and #$01                    ;get LSB, mask out all other bits
00E401  1  4A                  lsr                         ;move to carry
00E402  1  05 05               ora $05                     ;get stored value
00E404  1  6A                  ror                         ;rotate carry to MSB of A
00E405  1  4A                  lsr                         ;and effectively move high nybble to
00E406  1  4A                  lsr                         ;lower, LSB which became MSB will be
00E407  1  4A                  lsr                         ;d4 at this point
00E408  1  20 E1 9B            jsr GetBlockBufferAddr      ;get address of block buffer into $06, $07
00E40B  1  A4 04               ldy $04                     ;get old contents of Y
