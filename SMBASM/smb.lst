00F64D  1               PlayNoiseSfx:
00F64D  1  8D 0C 40             sta SND_NOISE_REG        ;play the sfx
00F650  1  8E 0E 40             stx SND_NOISE_REG+2
00F653  1  A9 18                lda #$18
00F655  1  8D 0F 40             sta SND_NOISE_REG+3
00F658  1               
00F658  1               DecrementSfx3Length:
00F658  1  CE BF 07             dec Noise_SfxLenCounter  ;decrement length of sfx
00F65B  1  D0 09                bne ExSfx3
00F65D  1  A9 F0                lda #$f0                 ;if done, stop playing the sfx
00F65F  1  8D 0C 40             sta SND_NOISE_REG
00F662  1  A9 00                lda #$00
00F664  1  85 F3                sta NoiseSoundBuffer
00F666  1  60           ExSfx3: rts
00F667  1               
00F667  1               NoiseSfxHandler:
00F667  1  A4 FD                ldy NoiseSoundQueue   ;check for sfx in queue
00F669  1  F0 0A                beq CheckNoiseBuffer
00F66B  1  84 F3                sty NoiseSoundBuffer  ;if found, put in buffer
00F66D  1  46 FD                lsr NoiseSoundQueue
00F66F  1  B0 CA                bcs PlayBrickShatter  ;brick shatter
00F671  1  46 FD                lsr NoiseSoundQueue
00F673  1  B0 0B                bcs PlayBowserFlame   ;bowser flame
00F675  1               
00F675  1               CheckNoiseBuffer:
00F675  1  A5 F3                lda NoiseSoundBuffer      ;check for sfx in buffer
00F677  1  F0 06                beq ExNH                  ;if not found, exit sub
00F679  1  4A                   lsr
00F67A  1  B0 C4                bcs ContinueBrickShatter  ;brick shatter
00F67C  1  4A                   lsr
00F67D  1  B0 06                bcs ContinueBowserFlame   ;bowser flame
