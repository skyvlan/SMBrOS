0091CD  1               PlayerLoseLife:
0091CD  1  EE 74 07                  inc DisableScreenFlag    ;disable screen and sprite 0 check
0091D0  1  A9 00                     lda #$00
0091D2  1  8D 22 07                  sta Sprite0HitDetectFlag
0091D5  1  A9 80                     lda #Silence             ;silence music
0091D7  1  85 FC                     sta EventMusicQueue
0091D9  1  CE 5A 07                  dec NumberofLives        ;take one life from player
0091DC  1  10 0B                     bpl StillInGame          ;if player still has lives, branch
0091DE  1  A9 00                     lda #$00
0091E0  1  8D 72 07                  sta OperMode_Task        ;initialize mode task,
0091E3  1  A9 03                     lda #GameOverModeValue   ;switch to game over mode
0091E5  1  8D 70 07                  sta OperMode             ;and leave
0091E8  1  60                        rts
0091E9  1  AD 5F 07     StillInGame: lda WorldNumber          ;multiply world number by 2 and use
0091EC  1  0A                        asl                      ;as offset
0091ED  1  AA                        tax
0091EE  1  AD 5C 07                  lda LevelNumber          ;if in area -3 or -4, increment
0091F1  1  29 02                     and #$02                 ;offset by one byte, otherwise
0091F3  1  F0 01                     beq GetHalfway           ;leave offset alone
0091F5  1  E8                        inx
0091F6  1  BC BD 91     GetHalfway:  ldy HalfwayPageNybbles,x ;get halfway page number with offset
0091F9  1  AD 5C 07                  lda LevelNumber          ;check area number's LSB
0091FC  1  4A                        lsr
0091FD  1  98                        tya                      ;if in area -2 or -4, use lower nybble
0091FE  1  B0 04                     bcs MaskHPNyb
009200  1  4A                        lsr                      ;move higher nybble to lower if area
009201  1  4A                        lsr                      ;number is -1 or -3
009202  1  4A                        lsr
009203  1  4A                        lsr
009204  1  29 0F        MaskHPNyb:   and #%00001111           ;mask out all but lower nybble
009206  1  CD 1A 07                  cmp ScreenLeft_PageLoc
009209  1  F0 04                     beq SetHalfway           ;left side of screen must be at the halfway page,
00920B  1  90 02                     bcc SetHalfway           ;otherwise player must start at the
00920D  1  A9 00                     lda #$00                 ;beginning of the level
00920F  1  8D 5B 07     SetHalfway:  sta HalfwayPage          ;store as halfway page for player
009212  1  20 82 92                  jsr TransposePlayers     ;switch players around if 2-player game
009215  1  4C 64 92                  jmp ContinueGame         ;continue the game
