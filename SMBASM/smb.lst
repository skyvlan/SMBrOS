00E021  1  B0 0C                  bcs SetStun                ;$09, $0e, $0f or $10, it will be modified, and not
00E023  1  C9 0A                  cmp #$0a                   ;modified if not any of those values, note that piranha plant will
00E025  1  90 04                  bcc Demote                 ;always fail this test because A will still have vertical
00E027  1  C9 0D                  cmp #PiranhaPlant          ;coordinate from previous addition, also these comparisons
00E029  1  90 04                  bcc SetStun                ;are only necessary if branching from $d7a1
00E02B  1  29 01        Demote:   and #%00000001             ;erase all but LSB, essentially turning enemy object
00E02D  1  95 16                  sta Enemy_ID,x             ;into green or red koopa troopa to demote them
00E02F  1  B5 1E        SetStun:  lda Enemy_State,x          ;load enemy state
00E031  1  29 F0                  and #%11110000             ;save high nybble
00E033  1  09 02                  ora #%00000010
00E035  1  95 1E                  sta Enemy_State,x          ;set d1 of enemy state
00E037  1  D6 CF                  dec Enemy_Y_Position,x
00E039  1  D6 CF                  dec Enemy_Y_Position,x     ;subtract two pixels from enemy's vertical position
00E03B  1  B5 16                  lda Enemy_ID,x
00E03D  1  C9 07                  cmp #Bloober               ;check for bloober object
00E03F  1  F0 07                  beq SetWYSpd
00E041  1  A9 FD                  lda #$fd                   ;set default vertical speed
00E043  1  AC 4E 07               ldy AreaType
00E046  1  D0 02                  bne SetNotW                ;if area type not water, set as speed, otherwise
00E048  1  A9 FF        SetWYSpd: lda #$ff                   ;change the vertical speed
00E04A  1  95 A0        SetNotW:  sta Enemy_Y_Speed,x        ;set vertical speed now
00E04C  1  A0 01                  ldy #$01
00E04E  1  20 43 E1               jsr PlayerEnemyDiff        ;get horizontal difference between player and enemy object
00E051  1  10 01                  bpl ChkBBill               ;branch if enemy is to the right of player
00E053  1  C8                     iny                        ;increment Y if not
00E054  1  B5 16        ChkBBill: lda Enemy_ID,x
00E056  1  C9 33                  cmp #BulletBill_CannonVar  ;check for bullet bill (cannon variant)
00E058  1  F0 06                  beq NoCDirF
00E05A  1  C9 08                  cmp #BulletBill_FrenzyVar  ;check for bullet bill (frenzy variant)
00E05C  1  F0 02                  beq NoCDirF                ;branch if either found, direction does not change
00E05E  1  94 46                  sty Enemy_MovingDir,x      ;store as moving direction
00E060  1  88           NoCDirF:  dey                        ;decrement and use as offset
00E061  1  B9 BF DF               lda EnemyBGCXSpdData,y     ;get proper horizontal speed
00E064  1  95 58                  sta Enemy_X_Speed,x        ;and store, then leave
