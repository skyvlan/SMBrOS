008EF4  1               ;status bar name table offset and length data
008EF4  1               StatusBarData:
008EF4  1  F0 06              .byte $f0, $06 ; top score display on title screen
008EF6  1  62 06              .byte $62, $06 ; player score
008EF8  1  62 06              .byte $62, $06
008EFA  1  6D 02              .byte $6d, $02 ; coin tally
008EFC  1  6D 02              .byte $6d, $02
008EFE  1  7A 03              .byte $7a, $03 ; game timer
008F00  1               
