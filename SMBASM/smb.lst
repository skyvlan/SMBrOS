008000  1               ;-------------------------------------------------------------------------------------
008000  1               
008000  1               Start:
008000  1  78                        sei                          ;pretty standard 6502 type init here
008001  1  D8                        cld
008002  1  A9 10                     lda #%00010000               ;init PPU control register 1
008004  1  8D 00 20                  sta PPU_CTRL_REG1
008007  1  A2 FF                     ldx #$ff                     ;reset stack pointer
008009  1  9A                        txs
00800A  1  AD 02 20     VBlank1:     lda PPU_STATUS               ;wait two frames
00800D  1  10 FB                     bpl VBlank1
00800F  1  AD 02 20     VBlank2:     lda PPU_STATUS
008012  1  10 FB                     bpl VBlank2
008014  1  A0 FE                     ldy #ColdBootOffset          ;load default cold boot pointer
008016  1  A2 05                     ldx #$05                     ;this is where we check for a warm boot
008018  1  BD D7 07     WBootCheck:  lda TopScoreDisplay,x        ;check each score digit in the top score
00801B  1  C9 0A                     cmp #10                      ;to see if we have a valid digit
00801D  1  B0 0C                     bcs ColdBoot                 ;if not, give up and proceed with cold boot
00801F  1  CA                        dex
008020  1  10 F6                     bpl WBootCheck
008022  1  AD FF 07                  lda WarmBootValidation       ;second checkpoint, check to see if
008025  1  C9 A5                     cmp #$a5                     ;another location has a specific value
008027  1  D0 02                     bne ColdBoot
008029  1  A0 D6                     ldy #WarmBootOffset          ;if passed both, load warm boot pointer
00802B  1  20 CC 90     ColdBoot:    jsr InitializeMemory         ;clear memory using pointer in Y
00802E  1  8D 11 40                  sta SND_DELTA_REG+1          ;reset delta counter load register
008031  1  8D 70 07                  sta OperMode                 ;reset primary mode of operation
008034  1  A9 A5                     lda #$a5                     ;set warm boot flag
008036  1  8D FF 07                  sta WarmBootValidation
008039  1  8D A7 07                  sta PseudoRandomBitReg       ;set seed for pseudorandom register
00803C  1  A9 0F                     lda #%00001111
00803E  1  8D 15 40                  sta SND_MASTERCTRL_REG       ;enable all sound channels except dmc
008041  1  A9 06                     lda #%00000110
008043  1  8D 01 20                  sta PPU_CTRL_REG2            ;turn off clipping for OAM and background
008046  1  20 20 82                  jsr MoveAllSpritesOffscreen
008049  1  20 19 8E                  jsr InitializeNameTables     ;initialize both name tables
00804C  1  EE 74 07                  inc DisableScreenFlag        ;set flag to disable screen output
00804F  1  AD 78 07                  lda Mirror_PPU_CTRL_REG1
008052  1  09 80                     ora #%10000000               ;enable NMIs
008054  1  20 ED 8E                  jsr WritePPUReg1
008057  1  4C 57 80     EndlessLoop: jmp EndlessLoop              ;endless loop, need I say more?
00805A  1               
00805A  1               ;-------------------------------------------------------------------------------------
00805A  1               ;$00 - vram buffer address table low, also used for pseudorandom bit
00805A  1               ;$01 - vram buffer address table high
00805A  1               
00805A  1               VRAM_AddrTable_Low:
00805A  1  01 A4 C8           .byte <VRAM_Buffer1, <WaterPaletteData, <GroundPaletteData
00805D  1  EC 10 00           .byte <UndergroundPaletteData, <CastlePaletteData, <VRAM_Buffer1_Offset
008060  1  41 41 4C           .byte <VRAM_Buffer2, <VRAM_Buffer2, <BowserPaletteData
008063  1  34 3C 44           .byte <DaySnowPaletteData, <NightSnowPaletteData, <MushroomPaletteData
008066  1  54 68 7C           .byte <MarioThanksMessage, <LuigiThanksMessage, <MushroomRetainerSaved
008069  1  A8 BF DE           .byte <PrincessSaved1, <PrincessSaved2, <WorldSelectMessage1
00806C  1  EF                 .byte <WorldSelectMessage2
00806D  1               
00806D  1               VRAM_AddrTable_High:
00806D  1  03 8C 8C           .byte >VRAM_Buffer1, >WaterPaletteData, >GroundPaletteData
008070  1  8C 8D 03           .byte >UndergroundPaletteData, >CastlePaletteData, >VRAM_Buffer1_Offset
008073  1  03 03 8D           .byte >VRAM_Buffer2, >VRAM_Buffer2, >BowserPaletteData
008076  1  8D 8D 8D           .byte >DaySnowPaletteData, >NightSnowPaletteData, >MushroomPaletteData
008079  1  8D 8D 8D           .byte >MarioThanksMessage, >LuigiThanksMessage, >MushroomRetainerSaved
00807C  1  8D 8D 8D           .byte >PrincessSaved1, >PrincessSaved2, >WorldSelectMessage1
00807F  1  8D                 .byte >WorldSelectMessage2
008080  1               
008080  1               VRAM_Buffer_Offset:
008080  1  00 40              .byte <VRAM_Buffer1_Offset, <VRAM_Buffer2_Offset
008082  1               
008082  1               NonMaskableInterrupt:
008082  1  AD 78 07                    lda Mirror_PPU_CTRL_REG1  ;disable NMIs in mirror reg
008085  1  29 7F                       and #%01111111            ;save all other bits
008087  1  8D 78 07                    sta Mirror_PPU_CTRL_REG1
00808A  1  29 7E                       and #%01111110            ;alter name table address to be $2800
00808C  1  8D 00 20                    sta PPU_CTRL_REG1         ;(essentially $2000) but save other bits
00808F  1  AD 79 07                    lda Mirror_PPU_CTRL_REG2  ;disable OAM and background display by default
008092  1  29 E6                       and #%11100110
008094  1  AC 74 07                    ldy DisableScreenFlag     ;get screen disable flag
008097  1  D0 05                       bne ScreenOff             ;if set, used bits as-is
008099  1  AD 79 07                    lda Mirror_PPU_CTRL_REG2  ;otherwise reenable bits and save them
00809C  1  09 1E                       ora #%00011110
00809E  1  8D 79 07     ScreenOff:     sta Mirror_PPU_CTRL_REG2  ;save bits for later but not in register at the moment
0080A1  1  29 E7                       and #%11100111            ;disable screen for now
0080A3  1  8D 01 20                    sta PPU_CTRL_REG2
0080A6  1  AE 02 20                    ldx PPU_STATUS            ;reset flip-flop and reset scroll registers to zero
0080A9  1  A9 00                       lda #$00
0080AB  1  20 E6 8E                    jsr InitScroll
0080AE  1  8D 03 20                    sta PPU_SPR_ADDR          ;reset spr-ram address register
0080B1  1  A9 02                       lda #$02                  ;perform spr-ram DMA access on $0200-$02ff
0080B3  1  8D 14 40                    sta SPR_DMA
0080B6  1  AE 73 07                    ldx VRAM_Buffer_AddrCtrl  ;load control for pointer to buffer contents
0080B9  1  BD 5A 80                    lda VRAM_AddrTable_Low,x  ;set indirect at $00 to pointer
0080BC  1  85 00                       sta $00
0080BE  1  BD 6D 80                    lda VRAM_AddrTable_High,x
0080C1  1  85 01                       sta $01
0080C3  1  20 DD 8E                    jsr UpdateScreen          ;update screen with buffer contents
0080C6  1  A0 00                       ldy #$00
0080C8  1  AE 73 07                    ldx VRAM_Buffer_AddrCtrl  ;check for usage of $0341
0080CB  1  E0 06                       cpx #$06
0080CD  1  D0 01                       bne InitBuffer
0080CF  1  C8                          iny                       ;get offset based on usage
0080D0  1  BE 80 80     InitBuffer:    ldx VRAM_Buffer_Offset,y
0080D3  1  A9 00                       lda #$00                  ;clear buffer header at last location
0080D5  1  9D 00 03                    sta VRAM_Buffer1_Offset,x
0080D8  1  9D 01 03                    sta VRAM_Buffer1,x
0080DB  1  8D 73 07                    sta VRAM_Buffer_AddrCtrl  ;reinit address control to $0301
0080DE  1  AD 79 07                    lda Mirror_PPU_CTRL_REG2  ;copy mirror of $2001 to register
0080E1  1  8D 01 20                    sta PPU_CTRL_REG2
0080E4  1  20 D0 F2                    jsr SoundEngine           ;play sound
0080E7  1  20 5C 8E                    jsr ReadJoypads           ;read joypads
0080EA  1  20 82 81                    jsr PauseRoutine          ;handle pause
0080ED  1  20 97 8F                    jsr UpdateTopScore
0080F0  1  AD 76 07                    lda GamePauseStatus       ;check for pause status
0080F3  1  4A                          lsr
0080F4  1  B0 25                       bcs PauseSkip
0080F6  1  AD 47 07                    lda TimerControl          ;if master timer control not set, decrement
0080F9  1  F0 05                       beq DecTimers             ;all frame and interval timers
0080FB  1  CE 47 07                    dec TimerControl
0080FE  1  D0 19                       bne NoDecTimers
008100  1  A2 14        DecTimers:     ldx #$14                  ;load end offset for end of frame timers
008102  1  CE 7F 07                    dec IntervalTimerControl  ;decrement interval timer control,
008105  1  10 07                       bpl DecTimersLoop         ;if not expired, only frame timers will decrement
008107  1  A9 14                       lda #$14
008109  1  8D 7F 07                    sta IntervalTimerControl  ;if control for interval timers expired,
00810C  1  A2 23                       ldx #$23                  ;interval timers will decrement along with frame timers
00810E  1  BD 80 07     DecTimersLoop: lda Timers,x              ;check current timer
008111  1  F0 03                       beq SkipExpTimer          ;if current timer expired, branch to skip,
008113  1  DE 80 07                    dec Timers,x              ;otherwise decrement the current timer
008116  1  CA           SkipExpTimer:  dex                       ;move onto next timer
008117  1  10 F5                       bpl DecTimersLoop         ;do this until all timers are dealt with
008119  1  E6 09        NoDecTimers:   inc FrameCounter          ;increment frame counter
00811B  1  A2 00        PauseSkip:     ldx #$00
00811D  1  A0 07                       ldy #$07
00811F  1  AD A7 07                    lda PseudoRandomBitReg    ;get first memory location of LSFR bytes
008122  1  29 02                       and #%00000010            ;mask out all but d1
008124  1  85 00                       sta $00                   ;save here
008126  1  AD A8 07                    lda PseudoRandomBitReg+1  ;get second memory location
008129  1  29 02                       and #%00000010            ;mask out all but d1
00812B  1  45 00                       eor $00                   ;perform exclusive-OR on d1 from first and second bytes
00812D  1  18                          clc                       ;if neither or both are set, carry will be clear
00812E  1  F0 01                       beq RotPRandomBit
008130  1  38                          sec                       ;if one or the other is set, carry will be set
008131  1  7E A7 07     RotPRandomBit: ror PseudoRandomBitReg,x  ;rotate carry into d7, and rotate last bit into carry
008134  1  E8                          inx                       ;increment to next byte
008135  1  88                          dey                       ;decrement for loop
008136  1  D0 F9                       bne RotPRandomBit
008138  1  AD 22 07                    lda Sprite0HitDetectFlag  ;check for flag here
00813B  1  F0 1F                       beq SkipSprite0
00813D  1  AD 02 20     Sprite0Clr:    lda PPU_STATUS            ;wait for sprite 0 flag to clear, which will
008140  1  29 40                       and #%01000000            ;not happen until vblank has ended
008142  1  D0 F9                       bne Sprite0Clr
008144  1  AD 76 07                    lda GamePauseStatus       ;if in pause mode, do not bother with sprites at all
008147  1  4A                          lsr
008148  1  B0 06                       bcs Sprite0Hit
00814A  1  20 23 82                    jsr MoveSpritesOffscreen
00814D  1  20 C6 81                    jsr SpriteShuffler
008150  1  AD 02 20     Sprite0Hit:    lda PPU_STATUS            ;do sprite #0 hit detection
008153  1  29 40                       and #%01000000
008155  1  F0 F9                       beq Sprite0Hit
008157  1  A0 14                       ldy #$14                  ;small delay, to wait until we hit horizontal blank time
008159  1  88           HBlankDelay:   dey
00815A  1  D0 FD                       bne HBlankDelay
00815C  1  AD 3F 07     SkipSprite0:   lda HorizontalScroll      ;set scroll registers from variables
00815F  1  8D 05 20                    sta PPU_SCROLL_REG
008162  1  AD 40 07                    lda VerticalScroll
008165  1  8D 05 20                    sta PPU_SCROLL_REG
008168  1  AD 78 07                    lda Mirror_PPU_CTRL_REG1  ;load saved mirror of $2000
00816B  1  48                          pha
00816C  1  8D 00 20                    sta PPU_CTRL_REG1
00816F  1  AD 76 07                    lda GamePauseStatus       ;if in pause mode, do not perform operation mode stuff
008172  1  4A                          lsr
008173  1  B0 03                       bcs SkipMainOper
008175  1  20 12 82                    jsr OperModeExecutionTree ;otherwise do one of many, many possible subroutines
008178  1  AD 02 20     SkipMainOper:  lda PPU_STATUS            ;reset flip-flop
00817B  1  68                          pla
00817C  1  09 80                       ora #%10000000            ;reactivate NMIs
00817E  1  8D 00 20                    sta PPU_CTRL_REG1
008181  1  40                          rti                       ;we are done until the next frame!
008182  1               
008182  1               ;-------------------------------------------------------------------------------------
008182  1               
008182  1               PauseRoutine:
008182  1  AD 70 07                    lda OperMode           ;are we in victory mode?
008185  1  C9 02                       cmp #VictoryModeValue  ;if so, go ahead
008187  1  F0 0B                       beq ChkPauseTimer
008189  1  C9 01                       cmp #GameModeValue     ;are we in game mode?
00818B  1  D0 38                       bne ExitPause          ;if not, leave
00818D  1  AD 72 07                    lda OperMode_Task      ;if we are in game mode, are we running game engine?
008190  1  C9 03                       cmp #$03
008192  1  D0 31                       bne ExitPause          ;if not, leave
008194  1  AD 77 07     ChkPauseTimer: lda GamePauseTimer     ;check if pause timer is still counting down
008197  1  F0 04                       beq ChkStart
008199  1  CE 77 07                    dec GamePauseTimer     ;if so, decrement and leave
00819C  1  60                          rts
00819D  1  AD FC 06     ChkStart:      lda SavedJoypad1Bits   ;check to see if start is pressed
0081A0  1  29 10                       and #Start_Button      ;on controller 1
0081A2  1  F0 19                       beq ClrPauseTimer
0081A4  1  AD 76 07                    lda GamePauseStatus    ;check to see if timer flag is set
0081A7  1  29 80                       and #%10000000         ;and if so, do not reset timer (residual,
0081A9  1  D0 1A                       bne ExitPause          ;joypad reading routine makes this unnecessary)
0081AB  1  A9 2B                       lda #$2b               ;set pause timer
0081AD  1  8D 77 07                    sta GamePauseTimer
0081B0  1  AD 76 07                    lda GamePauseStatus
0081B3  1  A8                          tay
0081B4  1  C8                          iny                    ;set pause sfx queue for next pause mode
0081B5  1  84 FA                       sty PauseSoundQueue
0081B7  1  49 01                       eor #%00000001         ;invert d0 and set d7
0081B9  1  09 80                       ora #%10000000
0081BB  1  D0 05                       bne SetPause           ;unconditional branch
0081BD  1  AD 76 07     ClrPauseTimer: lda GamePauseStatus    ;clear timer flag if timer is at zero and start button
0081C0  1  29 7F                       and #%01111111         ;is not pressed
0081C2  1  8D 76 07     SetPause:      sta GamePauseStatus
0081C5  1  60           ExitPause:     rts
0081C6  1               
0081C6  1               ;-------------------------------------------------------------------------------------
0081C6  1               ;$00 - used for preset value
0081C6  1               
0081C6  1               SpriteShuffler:
0081C6  1  AC 4E 07                    ldy AreaType                ;load level type, likely residual code
0081C9  1  A9 28                       lda #$28                    ;load preset value which will put it at
0081CB  1  85 00                       sta $00                     ;sprite #10
0081CD  1  A2 0E                       ldx #$0e                    ;start at the end of OAM data offsets
0081CF  1  BD E4 06     ShuffleLoop:   lda SprDataOffset,x         ;check for offset value against
0081D2  1  C5 00                       cmp $00                     ;the preset value
0081D4  1  90 0F                       bcc NextSprOffset           ;if less, skip this part
0081D6  1  AC E0 06                    ldy SprShuffleAmtOffset     ;get current offset to preset value we want to add
0081D9  1  18                          clc
0081DA  1  79 E1 06                    adc SprShuffleAmt,y         ;get shuffle amount, add to current sprite offset
0081DD  1  90 03                       bcc StrSprOffset            ;if not exceeded $ff, skip second add
0081DF  1  18                          clc
0081E0  1  65 00                       adc $00                     ;otherwise add preset value $28 to offset
0081E2  1  9D E4 06     StrSprOffset:  sta SprDataOffset,x         ;store new offset here or old one if branched to here
0081E5  1  CA           NextSprOffset: dex                         ;move backwards to next one
0081E6  1  10 E7                       bpl ShuffleLoop
0081E8  1  AE E0 06                    ldx SprShuffleAmtOffset     ;load offset
0081EB  1  E8                          inx
0081EC  1  E0 03                       cpx #$03                    ;check if offset + 1 goes to 3
0081EE  1  D0 02                       bne SetAmtOffset            ;if offset + 1 not 3, store
0081F0  1  A2 00                       ldx #$00                    ;otherwise, init to 0
0081F2  1  8E E0 06     SetAmtOffset:  stx SprShuffleAmtOffset
0081F5  1  A2 08                       ldx #$08                    ;load offsets for values and storage
0081F7  1  A0 02                       ldy #$02
0081F9  1  B9 E9 06     SetMiscOffset: lda SprDataOffset+5,y       ;load one of three OAM data offsets
0081FC  1  9D F1 06                    sta Misc_SprDataOffset-2,x  ;store first one unmodified, but
0081FF  1  18                          clc                         ;add eight to the second and eight
008200  1  69 08                       adc #$08                    ;more to the third one
008202  1  9D F2 06                    sta Misc_SprDataOffset-1,x  ;note that due to the way X is set up,
008205  1  18                          clc                         ;this code loads into the misc sprite offsets
008206  1  69 08                       adc #$08
008208  1  9D F3 06                    sta Misc_SprDataOffset,x
00820B  1  CA                          dex
00820C  1  CA                          dex
00820D  1  CA                          dex
00820E  1  88                          dey
00820F  1  10 E8                       bpl SetMiscOffset           ;do this until all misc spr offsets are loaded
008211  1  60                          rts
