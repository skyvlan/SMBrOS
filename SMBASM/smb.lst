0084A1  1  F6 FB              .byte $f6, $fb ; "100"
0084A3  1  F7 FB              .byte $f7, $fb ; "200"
0084A5  1  F8 FB              .byte $f8, $fb ; "400"
0084A7  1  F9 FB              .byte $f9, $fb ; "500"
0084A9  1  FA FB              .byte $fa, $fb ; "800"
