00F1BD  1  65 00                adc $00       ;appropriate offset, then give back to X
00F1BF  1  AA                   tax
00F1C0  1               
00F1C0  1               GetOffScreenBitsSet:
00F1C0  1  98                   tya                         ;save offscreen bits offset to stack for now
00F1C1  1  48                   pha
00F1C2  1  20 D7 F1             jsr RunOffscrBitsSubs
00F1C5  1  0A                   asl                         ;move low nybble to high nybble
00F1C6  1  0A                   asl
00F1C7  1  0A                   asl
00F1C8  1  0A                   asl
00F1C9  1  05 00                ora $00                     ;mask together with previously saved low nybble
00F1CB  1  85 00                sta $00                     ;store both here
00F1CD  1  68                   pla                         ;get offscreen bits offset from stack
00F1CE  1  A8                   tay
00F1CF  1  A5 00                lda $00                     ;get value here and store elsewhere
00F1D1  1  99 D0 03             sta SprObject_OffscrBits,y
00F1D4  1  A6 08                ldx ObjectOffset
00F1D6  1  60                   rts
00F1D7  1               
00F1D7  1               RunOffscrBitsSubs:
00F1D7  1  20 F6 F1             jsr GetXOffscreenBits  ;do subroutine here
00F1DA  1  4A                   lsr                    ;move high nybble to low
00F1DB  1  4A                   lsr
00F1DC  1  4A                   lsr
00F1DD  1  4A                   lsr
00F1DE  1  85 00                sta $00                ;store here
00F1E0  1  4C 39 F2             jmp GetYOffscreenBits
00F1E3  1               
00F1E3  1               ;--------------------------------
00F1E3  1               ;(these apply to these three subsections)
00F1E3  1               ;$04 - used to store proper offset
00F1E3  1               ;$05 - used as adder in DividePDiff
00F1E3  1               ;$06 - used to store preset value used to compare to pixel difference in $07
00F1E3  1               ;$07 - used to store difference between coordinates of object and screen edges
00F1E3  1               
00F1E3  1               XOffscreenBitsData:
00F1E3  1  7F 3F 1F 0F          .byte $7f, $3f, $1f, $0f, $07, $03, $01, $00
00F1E7  1  07 03 01 00  
00F1EB  1  80 C0 E0 F0          .byte $80, $c0, $e0, $f0, $f8, $fc, $fe, $ff
00F1EF  1  F8 FC FE FF  
00F1F3  1               
00F1F3  1               DefaultXOnscreenOfs:
00F1F3  1  07 0F 07             .byte $07, $0f, $07
00F1F6  1               
00F1F6  1               GetXOffscreenBits:
00F1F6  1  86 04                  stx $04                     ;save position in buffer to here
00F1F8  1  A0 01                  ldy #$01                    ;start with right side of screen
00F1FA  1  B9 1C 07     XOfsLoop: lda ScreenEdge_X_Pos,y      ;get pixel coordinate of edge
00F1FD  1  38                     sec                         ;get difference between pixel coordinate of edge
00F1FE  1  F5 86                  sbc SprObject_X_Position,x  ;and pixel coordinate of object position
00F200  1  85 07                  sta $07                     ;store here
00F202  1  B9 1A 07               lda ScreenEdge_PageLoc,y    ;get page location of edge
00F205  1  F5 6D                  sbc SprObject_PageLoc,x     ;subtract from page location of object position
00F207  1  BE F3 F1               ldx DefaultXOnscreenOfs,y   ;load offset value here
00F20A  1  C9 00                  cmp #$00
00F20C  1  30 10                  bmi XLdBData                ;if beyond right edge or in front of left edge, branch
00F20E  1  BE F4 F1               ldx DefaultXOnscreenOfs+1,y ;if not, load alternate offset value here
00F211  1  C9 01                  cmp #$01
00F213  1  10 09                  bpl XLdBData                ;if one page or more to the left of either edge, branch
00F215  1  A9 38                  lda #$38                    ;if no branching, load value here and store
00F217  1  85 06                  sta $06
00F219  1  A9 08                  lda #$08                    ;load some other value and execute subroutine
00F21B  1  20 6D F2               jsr DividePDiff
00F21E  1  BD E3 F1     XLdBData: lda XOffscreenBitsData,x    ;get bits here
00F221  1  A6 04                  ldx $04                     ;reobtain position in buffer
00F223  1  C9 00                  cmp #$00                    ;if bits not zero, branch to leave
00F225  1  D0 03                  bne ExXOfsBS
00F227  1  88                     dey                         ;otherwise, do left side of screen now
00F228  1  10 D0                  bpl XOfsLoop                ;branch if not already done with left side
00F22A  1  60           ExXOfsBS: rts
