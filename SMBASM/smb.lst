00C9D8  1               ProcHammerBro:
00C9D8  1  B5 1E               lda Enemy_State,x          ;check hammer bro's enemy state for d5 set
00C9DA  1  29 20               and #%00100000
00C9DC  1  F0 03               beq ChkJH                  ;if not set, go ahead with code
00C9DE  1  4C E5 CA            jmp MoveDefeatedEnemy      ;otherwise jump to something else
00C9E1  1  B5 3C        ChkJH: lda HammerBroJumpTimer,x   ;check jump timer
00C9E3  1  F0 2D               beq HammerBroJumpCode      ;if expired, branch to jump
00C9E5  1  D6 3C               dec HammerBroJumpTimer,x   ;otherwise decrement jump timer
00C9E7  1  AD D1 03            lda Enemy_OffscreenBits
00C9EA  1  29 0C               and #%00001100             ;check offscreen bits
00C9EC  1  D0 6A               bne MoveHammerBroXDir      ;if hammer bro a little offscreen, skip to movement code
00C9EE  1  BD A2 03            lda HammerThrowingTimer,x  ;check hammer throwing timer
00C9F1  1  D0 17               bne DecHT                  ;if not expired, skip ahead, do not throw hammer
00C9F3  1  AC CC 06            ldy SecondaryHardMode      ;otherwise get secondary hard mode flag
00C9F6  1  B9 CE C9            lda HammerThrowTmrData,y   ;get timer data using flag as offset
00C9F9  1  9D A2 03            sta HammerThrowingTimer,x  ;set as new timer
00C9FC  1  20 94 BA            jsr SpawnHammerObj         ;do a sub here to spawn hammer object
00C9FF  1  90 09               bcc DecHT                  ;if carry clear, hammer not spawned, skip to decrement timer
00CA01  1  B5 1E               lda Enemy_State,x
00CA03  1  09 08               ora #%00001000             ;set d3 in enemy state for hammer throw
00CA05  1  95 1E               sta Enemy_State,x
00CA07  1  4C 58 CA            jmp MoveHammerBroXDir      ;jump to move hammer bro
00CA0A  1  DE A2 03     DecHT: dec HammerThrowingTimer,x  ;decrement timer
00CA0D  1  4C 58 CA            jmp MoveHammerBroXDir      ;jump to move hammer bro
00CA10  1               
00CA10  1               HammerBroJumpLData:
00CA10  1  20 37              .byte $20, $37
00CA12  1               
00CA12  1               HammerBroJumpCode:
00CA12  1  B5 1E               lda Enemy_State,x           ;get hammer bro's enemy state
00CA14  1  29 07               and #%00000111              ;mask out all but 3 LSB
00CA16  1  C9 01               cmp #$01                    ;check for d0 set (for jumping)
00CA18  1  F0 3E               beq MoveHammerBroXDir       ;if set, branch ahead to moving code
00CA1A  1  A9 00               lda #$00                    ;load default value here
00CA1C  1  85 00               sta $00                     ;save into temp variable for now
00CA1E  1  A0 FA               ldy #$fa                    ;set default vertical speed
00CA20  1  B5 CF               lda Enemy_Y_Position,x      ;check hammer bro's vertical coordinate
00CA22  1  30 13               bmi SetHJ                   ;if on the bottom half of the screen, use current speed
00CA24  1  A0 FD               ldy #$fd                    ;otherwise set alternate vertical speed
00CA26  1  C9 70               cmp #$70                    ;check to see if hammer bro is above the middle of screen
00CA28  1  E6 00               inc $00                     ;increment preset value to $01
00CA2A  1  90 0B               bcc SetHJ                   ;if above the middle of the screen, use current speed and $01
00CA2C  1  C6 00               dec $00                     ;otherwise return value to $00
00CA2E  1  BD A8 07            lda PseudoRandomBitReg+1,x  ;get part of LSFR, mask out all but LSB
00CA31  1  29 01               and #$01
00CA33  1  D0 02               bne SetHJ                   ;if d0 of LSFR set, branch and use current speed and $00
00CA35  1  A0 FA               ldy #$fa                    ;otherwise reset to default vertical speed
00CA37  1  94 A0        SetHJ: sty Enemy_Y_Speed,x         ;set vertical speed for jumping
00CA39  1  B5 1E               lda Enemy_State,x           ;set d0 in enemy state for jumping
00CA3B  1  09 01               ora #$01
00CA3D  1  95 1E               sta Enemy_State,x
00CA3F  1  A5 00               lda $00                     ;load preset value here to use as bitmask
00CA41  1  3D A9 07            and PseudoRandomBitReg+2,x  ;and do bit-wise comparison with part of LSFR
00CA44  1  A8                  tay                         ;then use as offset
00CA45  1  AD CC 06            lda SecondaryHardMode       ;check secondary hard mode flag
00CA48  1  D0 01               bne HJump
00CA4A  1  A8                  tay                         ;if secondary hard mode flag clear, set offset to 0
00CA4B  1  B9 10 CA     HJump: lda HammerBroJumpLData,y    ;get jump length timer data using offset from before
00CA4E  1  9D 8A 07            sta EnemyFrameTimer,x       ;save in enemy timer
00CA51  1  BD A8 07            lda PseudoRandomBitReg+1,x
00CA54  1  09 C0               ora #%11000000              ;get contents of part of LSFR, set d7 and d6, then
00CA56  1  95 3C               sta HammerBroJumpTimer,x    ;store in jump timer
00CA58  1               
00CA58  1               MoveHammerBroXDir:
00CA58  1  A0 FC                 ldy #$fc                  ;move hammer bro a little to the left
00CA5A  1  A5 09                 lda FrameCounter
00CA5C  1  29 40                 and #%01000000            ;change hammer bro's direction every 64 frames
00CA5E  1  D0 02                 bne Shimmy
00CA60  1  A0 04                 ldy #$04                  ;if d6 set in counter, move him a little to the right
00CA62  1  94 58        Shimmy:  sty Enemy_X_Speed,x       ;store horizontal speed
00CA64  1  A0 01                 ldy #$01                  ;set to face right by default
00CA66  1  20 43 E1              jsr PlayerEnemyDiff       ;get horizontal difference between player and hammer bro
00CA69  1  30 0A                 bmi SetShim               ;if enemy to the left of player, skip this part
00CA6B  1  C8                    iny                       ;set to face left
00CA6C  1  BD 96 07              lda EnemyIntervalTimer,x  ;check walking timer
00CA6F  1  D0 04                 bne SetShim               ;if not yet expired, skip to set moving direction
00CA71  1  A9 F8                 lda #$f8
00CA73  1  95 58                 sta Enemy_X_Speed,x       ;otherwise, make the hammer bro walk left towards player
00CA75  1  94 46        SetShim: sty Enemy_MovingDir,x     ;set moving direction
00CA77  1               
00CA77  1               MoveNormalEnemy:
00CA77  1  A0 00               ldy #$00                   ;init Y to leave horizontal movement as-is
00CA79  1  B5 1E               lda Enemy_State,x
00CA7B  1  29 40               and #%01000000             ;check enemy state for d6 set, if set skip
00CA7D  1  D0 19               bne FallE                  ;to move enemy vertically, then horizontally if necessary
00CA7F  1  B5 1E               lda Enemy_State,x
00CA81  1  0A                  asl                        ;check enemy state for d7 set
00CA82  1  B0 30               bcs SteadM                 ;if set, branch to move enemy horizontally
00CA84  1  B5 1E               lda Enemy_State,x
00CA86  1  29 20               and #%00100000             ;check enemy state for d5 set
00CA88  1  D0 5B               bne MoveDefeatedEnemy      ;if set, branch to move defeated enemy object
00CA8A  1  B5 1E               lda Enemy_State,x
00CA8C  1  29 07               and #%00000111             ;check d2-d0 of enemy state for any set bits
00CA8E  1  F0 24               beq SteadM                 ;if enemy in normal state, branch to move enemy horizontally
00CA90  1  C9 05               cmp #$05
00CA92  1  F0 04               beq FallE                  ;if enemy in state used by spiny's egg, go ahead here
00CA94  1  C9 03               cmp #$03
00CA96  1  B0 30               bcs ReviveStunned          ;if enemy in states $03 or $04, skip ahead to yet another part
00CA98  1  20 63 BF     FallE: jsr MoveD_EnemyVertically  ;do a sub here to move enemy downwards
00CA9B  1  A0 00               ldy #$00
00CA9D  1  B5 1E               lda Enemy_State,x          ;check for enemy state $02
00CA9F  1  C9 02               cmp #$02
00CAA1  1  F0 0C               beq MEHor                  ;if found, branch to move enemy horizontally
00CAA3  1  29 40               and #%01000000             ;check for d6 set
00CAA5  1  F0 0D               beq SteadM                 ;if not set, branch to something else
00CAA7  1  B5 16               lda Enemy_ID,x
00CAA9  1  C9 2E               cmp #PowerUpObject         ;check for power-up object
00CAAB  1  F0 07               beq SteadM
00CAAD  1  D0 03               bne SlowM                  ;if any other object where d6 set, jump to set Y
00CAAF  1  4C 02 BF     MEHor: jmp MoveEnemyHorizontally  ;jump here to move enemy horizontally for <> $2e and d6 set
00CAB2  1               
00CAB2  1  A0 01        SlowM:  ldy #$01                  ;if branched here, increment Y to slow horizontal movement
00CAB4  1  B5 58        SteadM: lda Enemy_X_Speed,x       ;get current horizontal speed
00CAB6  1  48                   pha                       ;save to stack
00CAB7  1  10 02                bpl AddHS                 ;if not moving or moving right, skip, leave Y alone
00CAB9  1  C8                   iny
00CABA  1  C8                   iny                       ;otherwise increment Y to next data
00CABB  1  18           AddHS:  clc
00CABC  1  79 D0 C9             adc XSpeedAdderData,y     ;add value here to slow enemy down if necessary
00CABF  1  95 58                sta Enemy_X_Speed,x       ;save as horizontal speed temporarily
00CAC1  1  20 02 BF             jsr MoveEnemyHorizontally ;then do a sub to move horizontally
00CAC4  1  68                   pla
00CAC5  1  95 58                sta Enemy_X_Speed,x       ;get old horizontal speed from stack and return to
00CAC7  1  60                   rts                       ;original memory location, then leave
00CAC8  1               
00CAC8  1               ReviveStunned:
00CAC8  1  BD 96 07              lda EnemyIntervalTimer,x  ;if enemy timer not expired yet,
00CACB  1  D0 1E                 bne ChkKillGoomba         ;skip ahead to something else
00CACD  1  95 1E                 sta Enemy_State,x         ;otherwise initialize enemy state to normal
00CACF  1  A5 09                 lda FrameCounter
00CAD1  1  29 01                 and #$01                  ;get d0 of frame counter
00CAD3  1  A8                    tay                       ;use as Y and increment for movement direction
00CAD4  1  C8                    iny
00CAD5  1  94 46                 sty Enemy_MovingDir,x     ;store as pseudorandom movement direction
00CAD7  1  88                    dey                       ;decrement for use as pointer
00CAD8  1  AD 6A 07              lda PrimaryHardMode       ;check primary hard mode flag
00CADB  1  F0 02                 beq SetRSpd               ;if not set, use pointer as-is
00CADD  1  C8                    iny
00CADE  1  C8                    iny                       ;otherwise increment 2 bytes to next data
00CADF  1  B9 D4 C9     SetRSpd: lda RevivedXSpeed,y       ;load and store new horizontal speed
00CAE2  1  95 58                 sta Enemy_X_Speed,x       ;and leave
00CAE4  1  60                    rts
