008AA0  1  A5 06                    lda $06               ;get low byte of block buffer pointer
008AA2  1  C9 D0                    cmp #$d0              ;check to see if we're on odd-page block buffer
008AA4  1  90 02                    bcc SaveHAdder        ;if not, use current high byte
008AA6  1  A0 24                    ldy #$24              ;otherwise load high byte for name table 1
008AA8  1  84 03        SaveHAdder: sty $03               ;save high byte here
008AAA  1  29 0F                    and #$0f              ;mask out high nybble of block buffer pointer
008AAC  1  0A                       asl                   ;multiply by 2 to get appropriate name table low byte
008AAD  1  85 04                    sta $04               ;and then store it here
008AAF  1  A9 00                    lda #$00
008AB1  1  85 05                    sta $05               ;initialize temp high byte
008AB3  1  A5 02                    lda $02               ;get vertical high nybble offset used in block buffer routine
008AB5  1  18                       clc
008AB6  1  69 20                    adc #$20              ;add 32 pixels for the status bar
008AB8  1  0A                       asl
008AB9  1  26 05                    rol $05               ;shift and rotate d7 onto d0 and d6 into carry
008ABB  1  0A                       asl
008ABC  1  26 05                    rol $05               ;shift and rotate d6 onto d0 and d5 into carry
008ABE  1  65 04                    adc $04               ;add low byte of name table and carry to vertical high nybble
008AC0  1  85 04                    sta $04               ;and store here
008AC2  1  A5 05                    lda $05               ;get whatever was in d7 and d6 of vertical high nybble
008AC4  1  69 00                    adc #$00              ;add carry
008AC6  1  18                       clc
008AC7  1  65 03                    adc $03               ;then add high byte of name table
008AC9  1  85 05                    sta $05               ;store here
008ACB  1  A4 01                    ldy $01               ;get vram buffer offset to be used
008ACD  1  BD 39 8A     RemBridge:  lda BlockGfxData,x    ;write top left and top right
008AD0  1  99 03 03                 sta VRAM_Buffer1+2,y  ;tile numbers into first spot
008AD3  1  BD 3A 8A                 lda BlockGfxData+1,x
008AD6  1  99 04 03                 sta VRAM_Buffer1+3,y
008AD9  1  BD 3B 8A                 lda BlockGfxData+2,x  ;write bottom left and bottom
008ADC  1  99 08 03                 sta VRAM_Buffer1+7,y  ;right tiles numbers into
008ADF  1  BD 3C 8A                 lda BlockGfxData+3,x  ;second spot
008AE2  1  99 09 03                 sta VRAM_Buffer1+8,y
008AE5  1  A5 04                    lda $04
008AE7  1  99 01 03                 sta VRAM_Buffer1,y    ;write low byte of name table
008AEA  1  18                       clc                   ;into first slot as read
008AEB  1  69 20                    adc #$20              ;add 32 bytes to value
008AED  1  99 06 03                 sta VRAM_Buffer1+5,y  ;write low byte of name table
008AF0  1  A5 05                    lda $05               ;plus 32 bytes into second slot
008AF2  1  99 00 03                 sta VRAM_Buffer1-1,y  ;write high byte of name
008AF5  1  99 05 03                 sta VRAM_Buffer1+4,y  ;table address to both slots
008AF8  1  A9 02                    lda #$02
008AFA  1  99 02 03                 sta VRAM_Buffer1+1,y  ;put length of 2 in
008AFD  1  99 07 03                 sta VRAM_Buffer1+6,y  ;both slots
008B00  1  A9 00                    lda #$00
008B02  1  99 0A 03                 sta VRAM_Buffer1+9,y  ;put null terminator at end
008B05  1  A6 00                    ldx $00               ;get offset control bit here
008B07  1  60                       rts                   ;and leave
