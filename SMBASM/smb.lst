00E54E  1  AD AE 03           lda Enemy_Rel_XPos             ;get relative horizontal coordinate
00E551  1  99 03 02           sta Sprite_X_Position,y        ;store as X coordinate for first sprite
00E554  1  18                 clc
00E555  1  69 08              adc #$08                       ;add eight pixels and store
