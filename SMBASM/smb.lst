008291  1  49 01                      eor #%00000001              ;change number of players and draw icon accordingly
008293  1  8D 7A 07                   sta NumberOfPlayers
008296  1  20 25 83                   jsr DrawMushroomIcon
008299  1  4C BB 82                   jmp NullJoypad
