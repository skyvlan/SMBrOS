00974C  1               TreeLedge:
00974C  1  20 BB 9B               jsr GetLrgObjAttrib     ;get row and length of green ledge
00974F  1  BD 30 07               lda AreaObjectLength,x  ;check length counter for expiration
009752  1  F0 1F                  beq EndTreeL
009754  1  10 11                  bpl MidTreeL
009756  1  98                     tya
009757  1  9D 30 07               sta AreaObjectLength,x  ;store lower nybble into buffer flag as length of ledge
00975A  1  AD 25 07               lda CurrentPageLoc
00975D  1  0D 26 07               ora CurrentColumnPos    ;are we at the start of the level?
009760  1  F0 05                  beq MidTreeL
009762  1  A9 16                  lda #$16                ;render start of tree ledge
009764  1  4C B0 97               jmp NoUnder
009767  1  A6 07        MidTreeL: ldx $07
009769  1  A9 17                  lda #$17                ;render middle of tree ledge
00976B  1  9D A1 06               sta MetatileBuffer,x    ;note that this is also used if ledge position is
00976E  1  A9 4C                  lda #$4c                ;at the start of level for continuous effect
009770  1  4C AA 97               jmp AllUnder            ;now render the part underneath
009773  1  A9 18        EndTreeL: lda #$18                ;render end of tree ledge
009775  1  4C B0 97               jmp NoUnder
009778  1               
009778  1               MushroomLedge:
009778  1  20 AC 9B               jsr ChkLrgObjLength        ;get shroom dimensions
00977B  1  84 06                  sty $06                    ;store length here for now
00977D  1  90 0C                  bcc EndMushL
00977F  1  BD 30 07               lda AreaObjectLength,x     ;divide length by 2 and store elsewhere
009782  1  4A                     lsr
009783  1  9D 36 07               sta MushroomLedgeHalfLen,x
009786  1  A9 19                  lda #$19                   ;render start of mushroom
009788  1  4C B0 97               jmp NoUnder
00978B  1  A9 1B        EndMushL: lda #$1b                   ;if at the end, render end of mushroom
00978D  1  BC 30 07               ldy AreaObjectLength,x
009790  1  F0 1E                  beq NoUnder
009792  1  BD 36 07               lda MushroomLedgeHalfLen,x ;get divided length and store where length
009795  1  85 06                  sta $06                    ;was stored originally
009797  1  A6 07                  ldx $07
009799  1  A9 1A                  lda #$1a
00979B  1  9D A1 06               sta MetatileBuffer,x       ;render middle of mushroom
00979E  1  C4 06                  cpy $06                    ;are we smack dab in the center?
0097A0  1  D0 2C                  bne MushLExit              ;if not, branch to leave
0097A2  1  E8                     inx
0097A3  1  A9 4F                  lda #$4f
0097A5  1  9D A1 06               sta MetatileBuffer,x       ;render stem top of mushroom underneath the middle
0097A8  1  A9 50                  lda #$50
0097AA  1  E8           AllUnder: inx
0097AB  1  A0 0F                  ldy #$0f                   ;set $0f to render all way down
0097AD  1  4C 7D 9B               jmp RenderUnderPart       ;now render the stem of mushroom
0097B0  1  A6 07        NoUnder:  ldx $07                    ;load row of ledge
0097B2  1  A0 00                  ldy #$00                   ;set 0 for no bottom on this part
0097B4  1  4C 7D 9B               jmp RenderUnderPart
