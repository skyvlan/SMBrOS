00B8B6  1               
00B8B6  1               Jumpspring_Y_PosData:
00B8B6  1  08 10 08 00        .byte $08, $10, $08, $00
00B8BA  1               
00B8BA  1               JumpspringHandler:
00B8BA  1  20 AF F1                jsr GetEnemyOffscreenBits   ;get offscreen information
00B8BD  1  AD 47 07                lda TimerControl            ;check master timer control
00B8C0  1  D0 40                   bne DrawJSpr                ;branch to last section if set
00B8C2  1  AD 0E 07                lda JumpspringAnimCtrl      ;check jumpspring frame control
00B8C5  1  F0 3B                   beq DrawJSpr                ;branch to last section if not set
00B8C7  1  A8                      tay
00B8C8  1  88                      dey                         ;subtract one from frame control,
00B8C9  1  98                      tya                         ;the only way a poor nmos 6502 can
00B8CA  1  29 02                   and #%00000010              ;mask out all but d1, original value still in Y
00B8CC  1  D0 07                   bne DownJSpr                ;if set, branch to move player up
00B8CE  1  E6 CE                   inc Player_Y_Position
00B8D0  1  E6 CE                   inc Player_Y_Position       ;move player's vertical position down two pixels
00B8D2  1  4C D9 B8                jmp PosJSpr                 ;skip to next part
00B8D5  1  C6 CE        DownJSpr:  dec Player_Y_Position       ;move player's vertical position up two pixels
00B8D7  1  C6 CE                   dec Player_Y_Position
00B8D9  1  B5 58        PosJSpr:   lda Jumpspring_FixedYPos,x  ;get permanent vertical position
00B8DB  1  18                      clc
00B8DC  1  79 B6 B8                adc Jumpspring_Y_PosData,y  ;add value using frame control as offset
00B8DF  1  95 CF                   sta Enemy_Y_Position,x      ;store as new vertical position
00B8E1  1  C0 01                   cpy #$01                    ;check frame control offset (second frame is $00)
00B8E3  1  90 0F                   bcc BounceJS                ;if offset not yet at third frame ($01), skip to next part
00B8E5  1  A5 0A                   lda A_B_Buttons
00B8E7  1  29 80                   and #A_Button               ;check saved controller bits for A button press
00B8E9  1  F0 09                   beq BounceJS                ;skip to next part if A not pressed
00B8EB  1  25 0D                   and PreviousA_B_Buttons     ;check for A button pressed in previous frame
00B8ED  1  D0 05                   bne BounceJS                ;skip to next part if so
00B8EF  1  A9 F4                   lda #$f4
00B8F1  1  8D DB 06                sta JumpspringForce         ;otherwise write new jumpspring force here
00B8F4  1  C0 03        BounceJS:  cpy #$03                    ;check frame control offset again
00B8F6  1  D0 0A                   bne DrawJSpr                ;skip to last part if not yet at fifth frame ($03)
00B8F8  1  AD DB 06                lda JumpspringForce
00B8FB  1  85 9F                   sta Player_Y_Speed          ;store jumpspring force as player's new vertical speed
00B8FD  1  A9 00                   lda #$00
00B8FF  1  8D 0E 07                sta JumpspringAnimCtrl      ;initialize jumpspring frame control
00B902  1  20 52 F1     DrawJSpr:  jsr RelativeEnemyPosition   ;get jumpspring's relative coordinates
00B905  1  20 7D E8                jsr EnemyGfxHandler         ;draw jumpspring
00B908  1  20 7A D6                jsr OffscreenBoundsCheck    ;check to see if we need to kill it
00B90B  1  AD 0E 07                lda JumpspringAnimCtrl      ;if frame control at zero, don't bother
00B90E  1  F0 0D                   beq ExJSpring               ;trying to animate it, just leave
00B910  1  AD 86 07                lda JumpspringTimer
00B913  1  D0 08                   bne ExJSpring               ;if jumpspring timer not expired yet, leave
00B915  1  A9 04                   lda #$04
00B917  1  8D 86 07                sta JumpspringTimer         ;otherwise initialize jumpspring timer
00B91A  1  EE 0E 07                inc JumpspringAnimCtrl      ;increment frame control to animate jumpspring
00B91D  1  60           ExJSpring: rts                         ;leave
