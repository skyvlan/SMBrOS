00D2F2  1               GameTimerFireworks:
00D2F2  1  A0 05                ldy #$05               ;set default state for star flag object
00D2F4  1  AD FA 07             lda GameTimerDisplay+2 ;get game timer's last digit
00D2F7  1  C9 01                cmp #$01
00D2F9  1  F0 0E                beq SetFWC             ;if last digit of game timer set to 1, skip ahead
00D2FB  1  A0 03                ldy #$03               ;otherwise load new value for state
00D2FD  1  C9 03                cmp #$03
00D2FF  1  F0 08                beq SetFWC             ;if last digit of game timer set to 3, skip ahead
00D301  1  A0 00                ldy #$00               ;otherwise load one more potential value for state
00D303  1  C9 06                cmp #$06
00D305  1  F0 02                beq SetFWC             ;if last digit of game timer set to 6, skip ahead
00D307  1  A9 FF                lda #$ff               ;otherwise set value for no fireworks
00D309  1  8D D7 06     SetFWC: sta FireworksCounter   ;set fireworks counter here
00D30C  1  94 1E                sty Enemy_State,x      ;set whatever state we have in star flag object
00D30E  1               
