00972B  1               
00972B  1  A6 00        AreaFrenzy:  ldx $00               ;use area object identifier bit as offset
00972D  1  BD 20 97                  lda FrenzyIDData-8,x  ;note that it starts at 8, thus weird address here
009730  1  A0 05                     ldy #$05
009732  1  88           FreCompLoop: dey                   ;check regular slots of enemy object buffer
009733  1  30 07                     bmi ExitAFrenzy       ;if all slots checked and enemy object not found, branch to store
009735  1  D9 16 00                  cmp Enemy_ID,y    ;check for enemy object in buffer versus frenzy object
009738  1  D0 F8                     bne FreCompLoop
00973A  1  A9 00                     lda #$00              ;if enemy object already present, nullify queue and leave
00973C  1  8D CD 06     ExitAFrenzy: sta EnemyFrenzyQueue  ;store enemy into frenzy queue
00973F  1  60                        rts
