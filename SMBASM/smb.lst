008220  1               MoveAllSpritesOffscreen:
008220  1  A0 00                      ldy #$00                ;this routine moves all sprites off the screen
008222  1  2C                         .byte $2c                 ;BIT instruction opcode
008223  1               
008223  1               MoveSpritesOffscreen:
008223  1  A0 04                      ldy #$04                ;this routine moves all but sprite 0
008225  1  A9 F8                      lda #$f8                ;off the screen
008227  1  99 00 02     SprInitLoop:  sta Sprite_Y_Position,y ;write 248 into OAM data's Y coordinate
00822A  1  C8                         iny                     ;which will move it off the screen
00822B  1  C8                         iny
00822C  1  C8                         iny
00822D  1  C8                         iny
00822E  1  D0 F7                      bne SprInitLoop
008230  1  60                         rts
