00E14F  1               
00E14F  1               EnemyLanding:
00E14F  1  20 63 C3           jsr InitVStf            ;do something here to vertical speed and something else
00E152  1  B5 CF              lda Enemy_Y_Position,x
00E154  1  29 F0              and #%11110000          ;save high nybble of vertical coordinate, and
00E156  1  09 08              ora #%00001000          ;set d3, then store, probably used to set enemy object
00E158  1  95 CF              sta Enemy_Y_Position,x  ;neatly on whatever it's landing on
00E15A  1  60                 rts
00E15B  1               
00E15B  1               SubtEnemyYPos:
00E15B  1  B5 CF              lda Enemy_Y_Position,x  ;add 62 pixels to enemy object's
00E15D  1  18                 clc                     ;vertical coordinate
00E15E  1  69 3E              adc #$3e
00E160  1  C9 44              cmp #$44                ;compare against a certain range
00E162  1  60                 rts                     ;and leave with flags set for conditional branch
00E163  1               
00E163  1               EnemyJump:
00E163  1  20 5B E1             jsr SubtEnemyYPos     ;do a sub here
00E166  1  90 1A                bcc DoSide            ;if enemy vertical coord + 62 < 68, branch to leave
00E168  1  B5 A0                lda Enemy_Y_Speed,x
00E16A  1  18                   clc                   ;add two to vertical speed
00E16B  1  69 02                adc #$02
00E16D  1  C9 03                cmp #$03              ;if green paratroopa not falling, branch ahead
00E16F  1  90 11                bcc DoSide
