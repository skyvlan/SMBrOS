00B9BA  1               ;-------------------------------------------------------------------------------------
00B9BA  1               
00B9BA  1               CannonBitmasks:
00B9BA  1  0F 07              .byte %00001111, %00000111
00B9BC  1               
00B9BC  1               ProcessCannons:
00B9BC  1  AD 4E 07                lda AreaType                ;get area type
00B9BF  1  F0 6F                   beq ExCannon                ;if water type area, branch to leave
00B9C1  1  A2 02                   ldx #$02
00B9C3  1  86 08        ThreeSChk: stx ObjectOffset            ;start at third enemy slot
00B9C5  1  B5 0F                   lda Enemy_Flag,x            ;check enemy buffer flag
00B9C7  1  D0 51                   bne Chk_BB                  ;if set, branch to check enemy
00B9C9  1  BD A8 07                lda PseudoRandomBitReg+1,x  ;otherwise get part of LSFR
00B9CC  1  AC CC 06                ldy SecondaryHardMode       ;get secondary hard mode flag, use as offset
00B9CF  1  39 BA B9                and CannonBitmasks,y        ;mask out bits of LSFR as decided by flag
00B9D2  1  C9 06                   cmp #$06                    ;check to see if lower nybble is above certain value
00B9D4  1  B0 44                   bcs Chk_BB                  ;if so, branch to check enemy
00B9D6  1  A8                      tay                         ;transfer masked contents of LSFR to Y as pseudorandom offset
00B9D7  1  B9 6B 04                lda Cannon_PageLoc,y        ;get page location
00B9DA  1  F0 3E                   beq Chk_BB                  ;if not set or on page 0, branch to check enemy
00B9DC  1  B9 7D 04                lda Cannon_Timer,y          ;get cannon timer
00B9DF  1  F0 08                   beq FireCannon              ;if expired, branch to fire cannon
00B9E1  1  E9 00                   sbc #$00                    ;otherwise subtract borrow (note carry will always be clear here)
00B9E3  1  99 7D 04                sta Cannon_Timer,y          ;to count timer down
00B9E6  1  4C 1A BA                jmp Chk_BB                  ;then jump ahead to check enemy
00B9E9  1               
00B9E9  1               FireCannon:
00B9E9  1  AD 47 07               lda TimerControl           ;if master timer control set,
00B9EC  1  D0 2C                  bne Chk_BB                 ;branch to check enemy
00B9EE  1  A9 0E                  lda #$0e                   ;otherwise we start creating one
00B9F0  1  99 7D 04               sta Cannon_Timer,y         ;first, reset cannon timer
00B9F3  1  B9 6B 04               lda Cannon_PageLoc,y       ;get page location of cannon
00B9F6  1  95 6E                  sta Enemy_PageLoc,x        ;save as page location of bullet bill
00B9F8  1  B9 71 04               lda Cannon_X_Position,y    ;get horizontal coordinate of cannon
00B9FB  1  95 87                  sta Enemy_X_Position,x     ;save as horizontal coordinate of bullet bill
00B9FD  1  B9 77 04               lda Cannon_Y_Position,y    ;get vertical coordinate of cannon
00BA00  1  38                     sec
00BA01  1  E9 08                  sbc #$08                   ;subtract eight pixels (because enemies are 24 pixels tall)
00BA03  1  95 CF                  sta Enemy_Y_Position,x     ;save as vertical coordinate of bullet bill
00BA05  1  A9 01                  lda #$01
00BA07  1  95 B6                  sta Enemy_Y_HighPos,x      ;set vertical high byte of bullet bill
00BA09  1  95 0F                  sta Enemy_Flag,x           ;set buffer flag
00BA0B  1  4A                     lsr                        ;shift right once to init A
00BA0C  1  95 1E                  sta Enemy_State,x          ;then initialize enemy's state
00BA0E  1  A9 09                  lda #$09
00BA10  1  9D 9A 04               sta Enemy_BoundBoxCtrl,x   ;set bounding box size control for bullet bill
00BA13  1  A9 33                  lda #BulletBill_CannonVar
00BA15  1  95 16                  sta Enemy_ID,x             ;load identifier for bullet bill (cannon variant)
00BA17  1  4C 2D BA               jmp Next3Slt               ;move onto next slot
00BA1A  1  B5 16        Chk_BB:   lda Enemy_ID,x             ;check enemy identifier for bullet bill (cannon variant)
00BA1C  1  C9 33                  cmp #BulletBill_CannonVar
00BA1E  1  D0 0D                  bne Next3Slt               ;if not found, branch to get next slot
00BA20  1  20 7A D6               jsr OffscreenBoundsCheck   ;otherwise, check to see if it went offscreen
00BA23  1  B5 0F                  lda Enemy_Flag,x           ;check enemy buffer flag
00BA25  1  F0 06                  beq Next3Slt               ;if not set, branch to get next slot
00BA27  1  20 AF F1               jsr GetEnemyOffscreenBits  ;otherwise, get offscreen information
00BA2A  1  20 33 BA               jsr BulletBillHandler      ;then do sub to handle bullet bill
00BA2D  1  CA           Next3Slt: dex                        ;move onto next slot
00BA2E  1  10 93                  bpl ThreeSChk              ;do this until first three slots are checked
00BA30  1  60           ExCannon: rts                        ;then leave
00BA31  1               
00BA31  1               ;--------------------------------
00BA31  1               
00BA31  1               BulletBillXSpdData:
00BA31  1  18 E8              .byte $18, $e8
00BA33  1               
00BA33  1               BulletBillHandler:
00BA33  1  AD 47 07                lda TimerControl          ;if master timer control set,
00BA36  1  D0 3E                   bne RunBBSubs             ;branch to run subroutines except movement sub
00BA38  1  B5 1E                   lda Enemy_State,x
00BA3A  1  D0 2E                   bne ChkDSte               ;if bullet bill's state set, branch to check defeated state
00BA3C  1  AD D1 03                lda Enemy_OffscreenBits   ;otherwise load offscreen bits
00BA3F  1  29 0C                   and #%00001100            ;mask out bits
00BA41  1  C9 0C                   cmp #%00001100            ;check to see if all bits are set
00BA43  1  F0 40                   beq KillBB                ;if so, branch to kill this object
00BA45  1  A0 01                   ldy #$01                  ;set to move right by default
00BA47  1  20 43 E1                jsr PlayerEnemyDiff       ;get horizontal difference between player and bullet bill
00BA4A  1  30 01                   bmi SetupBB               ;if enemy to the left of player, branch
00BA4C  1  C8                      iny                       ;otherwise increment to move left
00BA4D  1  94 46        SetupBB:   sty Enemy_MovingDir,x     ;set bullet bill's moving direction
00BA4F  1  88                      dey                       ;decrement to use as offset
00BA50  1  B9 31 BA                lda BulletBillXSpdData,y  ;get horizontal speed based on moving direction
00BA53  1  95 58                   sta Enemy_X_Speed,x       ;and store it
00BA55  1  A5 00                   lda $00                   ;get horizontal difference
00BA57  1  69 28                   adc #$28                  ;add 40 pixels
00BA59  1  C9 50                   cmp #$50                  ;if less than a certain amount, player is too close
00BA5B  1  90 28                   bcc KillBB                ;to cannon either on left or right side, thus branch
00BA5D  1  A9 01                   lda #$01
00BA5F  1  95 1E                   sta Enemy_State,x         ;otherwise set bullet bill's state
00BA61  1  A9 0A                   lda #$0a
00BA63  1  9D 8A 07                sta EnemyFrameTimer,x     ;set enemy frame timer
00BA66  1  A9 08                   lda #Sfx_Blast
00BA68  1  85 FE                   sta Square2SoundQueue     ;play fireworks/gunfire sound
00BA6A  1  B5 1E        ChkDSte:   lda Enemy_State,x         ;check enemy state for d5 set
00BA6C  1  29 20                   and #%00100000
00BA6E  1  F0 03                   beq BBFly                 ;if not set, skip to move horizontally
00BA70  1  20 63 BF                jsr MoveD_EnemyVertically ;otherwise do sub to move bullet bill vertically
00BA73  1  20 02 BF     BBFly:     jsr MoveEnemyHorizontally ;do sub to move bullet bill horizontally
00BA76  1  20 AF F1     RunBBSubs: jsr GetEnemyOffscreenBits ;get offscreen information
00BA79  1  20 52 F1                jsr RelativeEnemyPosition ;get relative coordinates
00BA7C  1  20 43 E2                jsr GetEnemyBoundBox      ;get bounding box coordinates
00BA7F  1  20 53 D8                jsr PlayerEnemyCollision  ;handle player to enemy collisions
00BA82  1  4C 7D E8                jmp EnemyGfxHandler       ;draw the bullet bill and leave
00BA85  1  20 98 C9     KillBB:    jsr EraseEnemyObject      ;kill bullet bill and leave
00BA88  1  60                      rts
