00CEDF  1               MoveFlyingCheepCheep:
00CEDF  1  B5 1E                lda Enemy_State,x          ;check cheep-cheep's enemy state
00CEE1  1  29 20                and #%00100000             ;for d5 set
00CEE3  1  F0 08                beq FlyCC                  ;branch to continue code if not set
00CEE5  1  A9 00                lda #$00
00CEE7  1  9D C5 03             sta Enemy_SprAttrib,x      ;otherwise clear sprite attributes
00CEEA  1  4C 92 BF             jmp MoveJ_EnemyVertically  ;and jump to move defeated cheep-cheep downwards
00CEED  1  20 02 BF     FlyCC:  jsr MoveEnemyHorizontally  ;move cheep-cheep horizontally based on speed and force
00CEF0  1  A0 0D                ldy #$0d                   ;set vertical movement amount
00CEF2  1  A9 05                lda #$05                   ;set maximum speed
00CEF4  1  20 96 BF             jsr SetXMoveAmt            ;branch to impose gravity on flying cheep-cheep
00CEF7  1  BD 34 04             lda Enemy_Y_MoveForce,x
00CEFA  1  4A                   lsr                        ;get vertical movement force and
00CEFB  1  4A                   lsr                        ;move high nybble to low
00CEFC  1  4A                   lsr
00CEFD  1  4A                   lsr
00CEFE  1  A8                   tay                        ;save as offset (note this tends to go into reach of code)
00CEFF  1  B5 CF                lda Enemy_Y_Position,x     ;get vertical position
00CF01  1  38                   sec                        ;subtract pseudorandom value based on offset from position
00CF02  1  F9 D5 CE             sbc PRandomSubtracter,y
00CF05  1  10 05                bpl AddCCF                  ;if result within top half of screen, skip this part
00CF07  1  49 FF                eor #$ff
00CF09  1  18                   clc                        ;otherwise get two's compliment
00CF0A  1  69 01                adc #$01
00CF0C  1  C9 08        AddCCF: cmp #$08                   ;if result or two's compliment greater than eight,
00CF0E  1  B0 0E                bcs BPGet                  ;skip to the end without changing movement force
00CF10  1  BD 34 04             lda Enemy_Y_MoveForce,x
00CF13  1  18                   clc
00CF14  1  69 10                adc #$10                   ;otherwise add to it
00CF16  1  9D 34 04             sta Enemy_Y_MoveForce,x
00CF19  1  4A                   lsr                        ;move high nybble to low again
00CF1A  1  4A                   lsr
00CF1B  1  4A                   lsr
00CF1C  1  4A                   lsr
00CF1D  1  A8                   tay
00CF1E  1  B9 DA CE     BPGet:  lda FlyCCBPriority,y       ;load bg priority data and store (this is very likely
00CF21  1  9D C5 03             sta Enemy_SprAttrib,x      ;broken or residual code, value is overwritten before
00CF24  1  60                   rts                        ;drawing it next frame), then leave
