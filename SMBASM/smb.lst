009716  1               KillEnemies:
009716  1  85 00                   sta $00           ;store identifier here
009718  1  A9 00                   lda #$00
00971A  1  A2 04                   ldx #$04          ;check for identifier in enemy object buffer
00971C  1  B4 16        KillELoop: ldy Enemy_ID,x
00971E  1  C4 00                   cpy $00           ;if not found, branch
009720  1  D0 02                   bne NoKillE
009722  1  95 0F                   sta Enemy_Flag,x  ;if found, deactivate enemy object flag
009724  1  CA           NoKillE:   dex               ;do this until all slots are checked
009725  1  10 F5                   bpl KillELoop
009727  1  60                      rts
