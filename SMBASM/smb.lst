009806  1               CastleObject:
009806  1  20 BB 9B                 jsr GetLrgObjAttrib      ;save lower nybble as starting row
009809  1  84 07                    sty $07                  ;if starting row is above $0a, game will crash!!!
00980B  1  A0 04                    ldy #$04
00980D  1  20 AF 9B                 jsr ChkLrgObjFixedLength ;load length of castle if not already loaded
009810  1  8A                       txa
009811  1  48                       pha                      ;save obj buffer offset to stack
009812  1  BC 30 07                 ldy AreaObjectLength,x   ;use current length as offset for castle data
009815  1  A6 07                    ldx $07                  ;begin at starting row
009817  1  A9 0B                    lda #$0b
009819  1  85 06                    sta $06                  ;load upper limit of number of rows to print
00981B  1  B9 CF 97     CRendLoop:  lda CastleMetatiles,y    ;load current byte using offset
00981E  1  9D A1 06                 sta MetatileBuffer,x
009821  1  E8                       inx                      ;store in buffer and increment buffer offset
009822  1  A5 06                    lda $06
009824  1  F0 07                    beq ChkCFloor            ;have we reached upper limit yet?
009826  1  C8                       iny                      ;if not, increment column-wise
009827  1  C8                       iny                      ;to byte in next row
009828  1  C8                       iny
009829  1  C8                       iny
00982A  1  C8                       iny
00982B  1  C6 06                    dec $06                  ;move closer to upper limit
00982D  1  E0 0B        ChkCFloor:  cpx #$0b                 ;have we reached the row just before floor?
00982F  1  D0 EA                    bne CRendLoop            ;if not, go back and do another row
009831  1  68                       pla
009832  1  AA                       tax                      ;get obj buffer offset from before
009833  1  AD 25 07                 lda CurrentPageLoc
009836  1  F0 36                    beq ExitCastle           ;if we're at page 0, we do not need to do anything else
009838  1  BD 30 07                 lda AreaObjectLength,x   ;check length
00983B  1  C9 01                    cmp #$01                 ;if length almost about to expire, put brick at floor
00983D  1  F0 2A                    beq PlayerStop
00983F  1  A4 07                    ldy $07                  ;check starting row for tall castle ($00)
009841  1  D0 04                    bne NotTall
009843  1  C9 03                    cmp #$03                 ;if found, then check to see if we're at the second column
009845  1  F0 22                    beq PlayerStop
009847  1  C9 02        NotTall:    cmp #$02                 ;if not tall castle, check to see if we're at the third column
009849  1  D0 23                    bne ExitCastle           ;if we aren't and the castle is tall, don't create flag yet
00984B  1  20 CB 9B                 jsr GetAreaObjXPosition  ;otherwise, obtain and save horizontal pixel coordinate
00984E  1  48                       pha
00984F  1  20 4A 99                 jsr FindEmptyEnemySlot   ;find an empty place on the enemy object buffer
009852  1  68                       pla
009853  1  95 87                    sta Enemy_X_Position,x   ;then write horizontal coordinate for star flag
009855  1  AD 25 07                 lda CurrentPageLoc
009858  1  95 6E                    sta Enemy_PageLoc,x      ;set page location for star flag
00985A  1  A9 01                    lda #$01
00985C  1  95 B6                    sta Enemy_Y_HighPos,x    ;set vertical high byte
00985E  1  95 0F                    sta Enemy_Flag,x         ;set flag for buffer
009860  1  A9 90                    lda #$90
009862  1  95 CF                    sta Enemy_Y_Position,x   ;set vertical coordinate
009864  1  A9 31                    lda #StarFlagObject      ;set star flag value in buffer itself
009866  1  95 16                    sta Enemy_ID,x
009868  1  60                       rts
009869  1  A0 52        PlayerStop: ldy #$52                 ;put brick at floor to stop player at end of level
00986B  1  8C AB 06                 sty MetatileBuffer+10    ;this is only done if we're on the second column
00986E  1  60           ExitCastle: rts
