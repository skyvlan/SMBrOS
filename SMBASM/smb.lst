00C3E8  1  C9 2C                  cmp #$2c
00C3EA  1  90 F9                  bcc ExLSHand
00C3EC  1  B9 1E 00               lda Enemy_State,y          ;if lakitu is not in normal state, branch to leave
00C3EF  1  D0 F4                  bne ExLSHand
00C3F1  1  B9 6E 00               lda Enemy_PageLoc,y        ;store horizontal coordinates (high and low) of lakitu
00C3F4  1  95 6E                  sta Enemy_PageLoc,x        ;into the coordinates of the spiny we're going to create
00C3F6  1  B9 87 00               lda Enemy_X_Position,y
00C3F9  1  95 87                  sta Enemy_X_Position,x
00C3FB  1  A9 01                  lda #$01                   ;put spiny within vertical screen unit
00C3FD  1  95 B6                  sta Enemy_Y_HighPos,x
00C3FF  1  B9 CF 00               lda Enemy_Y_Position,y     ;put spiny eight pixels above where lakitu is
00C402  1  38                     sec
00C403  1  E9 08                  sbc #$08
00C405  1  95 CF                  sta Enemy_Y_Position,x
00C407  1  BD A7 07               lda PseudoRandomBitReg,x   ;get 2 LSB of LSFR and save to Y
00C40A  1  29 03                  and #%00000011
00C40C  1  A8                     tay
00C40D  1  A2 02                  ldx #$02
00C40F  1  B9 98 C3     DifLoop:  lda PRDiffAdjustData,y     ;get three values and save them
00C412  1  95 01                  sta $01,x                  ;to $01-$03
00C414  1  C8                     iny
00C415  1  C8                     iny                        ;increment Y four bytes for each value
00C416  1  C8                     iny
00C417  1  C8                     iny
00C418  1  CA                     dex                        ;decrement X for each one
00C419  1  10 F4                  bpl DifLoop                ;loop until all three are written
00C41B  1  A6 08                  ldx ObjectOffset           ;get enemy object buffer offset
00C41D  1  20 6C CF               jsr PlayerLakituDiff       ;move enemy, change direction, get value - difference
00C420  1  A4 57                  ldy Player_X_Speed         ;check player's horizontal speed
00C422  1  C0 08                  cpy #$08
00C424  1  B0 0E                  bcs SetSpSpd               ;if moving faster than a certain amount, branch elsewhere
00C426  1  A8                     tay                        ;otherwise save value in A to Y for now
00C427  1  BD A8 07               lda PseudoRandomBitReg+1,x
00C42A  1  29 03                  and #%00000011             ;get one of the LSFR parts and save the 2 LSB
00C42C  1  F0 05                  beq UsePosv                ;branch if neither bits are set
00C42E  1  98                     tya
00C42F  1  49 FF                  eor #%11111111             ;otherwise get two's compliment of Y
00C431  1  A8                     tay
00C432  1  C8                     iny
00C433  1  98           UsePosv:  tya                        ;put value from A in Y back to A (they will be lost anyway)
00C434  1  20 46 C3     SetSpSpd: jsr SmallBBox              ;set bounding box control, init attributes, lose contents of A
00C437  1  A0 02                  ldy #$02
00C439  1  95 58                  sta Enemy_X_Speed,x        ;set horizontal speed to zero because previous contents
00C43B  1  C9 00                  cmp #$00                   ;of A were lost...branch here will never be taken for
00C43D  1  30 01                  bmi SpinyRte               ;the same reason
00C43F  1  88                     dey
00C440  1  94 46        SpinyRte: sty Enemy_MovingDir,x      ;set moving direction to the right
00C442  1  A9 FD                  lda #$fd
00C444  1  95 A0                  sta Enemy_Y_Speed,x        ;set vertical speed to move upwards
