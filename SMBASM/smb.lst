00C152  1  C9 0E                cmp #$0e
00C154  1  F0 0E                beq CheckRightBounds     ;if found, branch, otherwise
00C156  1  E0 05                cpx #$05                 ;check for end of buffer
00C158  1  90 0A                bcc CheckRightBounds     ;if not at end of buffer, branch
00C15A  1  C8                   iny
00C15B  1  B1 E9                lda (EnemyData),y        ;check for specific value here
00C15D  1  29 3F                and #%00111111           ;not sure what this was intended for, exactly
00C15F  1  C9 2E                cmp #$2e                 ;this part is quite possibly residual code
00C161  1  F0 01                beq CheckRightBounds     ;but it has the effect of keeping enemies out of
00C163  1  60                   rts                      ;the sixth slot
