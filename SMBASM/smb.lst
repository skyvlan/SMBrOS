00CE8E  1               GetFirebarPosition:
00CE8E  1  48                      pha                        ;save high byte of spinstate to the stack
00CE8F  1  29 0F                   and #%00001111             ;mask out low nybble
00CE91  1  C9 09                   cmp #$09
00CE93  1  90 05                   bcc GetHAdder              ;if lower than $09, branch ahead
00CE95  1  49 0F                   eor #%00001111             ;otherwise get two's compliment to oscillate
00CE97  1  18                      clc
00CE98  1  69 01                   adc #$01
00CE9A  1  85 01        GetHAdder: sta $01                    ;store result, modified or not, here
00CE9C  1  A4 00                   ldy $00                    ;load number of firebar ball where we're at
00CE9E  1  B9 2E CD                lda FirebarTblOffsets,y    ;load offset to firebar position data
00CEA1  1  18                      clc
00CEA2  1  65 01                   adc $01                    ;add oscillated high byte of spinstate
00CEA4  1  A8                      tay                        ;to offset here and use as new offset
00CEA5  1  B9 C7 CC                lda FirebarPosLookupTbl,y  ;get data here and store as horizontal adder
00CEA8  1  85 01                   sta $01
00CEAA  1  68                      pla                        ;pull whatever was in A from the stack
00CEAB  1  48                      pha                        ;save it again because we still need it
00CEAC  1  18                      clc
00CEAD  1  69 08                   adc #$08                   ;add eight this time, to get vertical adder
00CEAF  1  29 0F                   and #%00001111             ;mask out high nybble
00CEB1  1  C9 09                   cmp #$09                   ;if lower than $09, branch ahead
00CEB3  1  90 05                   bcc GetVAdder
00CEB5  1  49 0F                   eor #%00001111             ;otherwise get two's compliment
00CEB7  1  18                      clc
00CEB8  1  69 01                   adc #$01
00CEBA  1  85 02        GetVAdder: sta $02                    ;store result here
00CEBC  1  A4 00                   ldy $00
00CEBE  1  B9 2E CD                lda FirebarTblOffsets,y    ;load offset to firebar position data again
00CEC1  1  18                      clc
00CEC2  1  65 02                   adc $02                    ;this time add value in $02 to offset here and use as offset
00CEC4  1  A8                      tay
00CEC5  1  B9 C7 CC                lda FirebarPosLookupTbl,y  ;get data here and store as vertica adder
00CEC8  1  85 02                   sta $02
00CECA  1  68                      pla                        ;pull out whatever was in A one last time
00CECB  1  4A                      lsr                        ;divide by eight or shift three to the right
00CECC  1  4A                      lsr
00CECD  1  4A                      lsr
00CECE  1  A8                      tay                        ;use as offset
00CECF  1  B9 2A CD                lda FirebarMirrorData,y    ;load mirroring data here
00CED2  1  85 03                   sta $03                    ;store
00CED4  1  60                      rts
