00EB71  1  20 C1 EB              jsr MoveESprColOffscreen  ;and move them offscreen
00EB74  1  68           LcChk:   pla                       ;get from stack
00EB75  1  4A                    lsr                       ;move d3 to carry
00EB76  1  48                    pha                       ;save to stack
00EB77  1  90 05                 bcc Row3C                 ;branch if not set
00EB79  1  A9 00                 lda #$00                  ;set for left column sprites,
00EB7B  1  20 C1 EB              jsr MoveESprColOffscreen  ;move them offscreen
00EB7E  1  68           Row3C:   pla                       ;get from stack again
00EB7F  1  4A                    lsr                       ;move d5 to carry this time
00EB80  1  4A                    lsr
00EB81  1  48                    pha                       ;save to stack again
00EB82  1  90 05                 bcc Row23C                ;branch if carry not set
00EB84  1  A9 10                 lda #$10                  ;set for third row of sprites
00EB86  1  20 B7 EB              jsr MoveESprRowOffscreen  ;and move them offscreen
00EB89  1  68           Row23C:  pla                       ;get from stack
00EB8A  1  4A                    lsr                       ;move d6 into carry
00EB8B  1  48                    pha                       ;save to stack
00EB8C  1  90 05                 bcc AllRowC
00EB8E  1  A9 08                 lda #$08                  ;set for second and third rows
00EB90  1  20 B7 EB              jsr MoveESprRowOffscreen  ;move them offscreen
00EB93  1  68           AllRowC: pla                       ;get from stack once more
00EB94  1  4A                    lsr                       ;move d7 into carry
00EB95  1  90 12                 bcc ExEGHandler
00EB97  1  20 B7 EB              jsr MoveESprRowOffscreen  ;move all sprites offscreen (A should be 0 by now)
00EB9A  1  B5 16                 lda Enemy_ID,x
00EB9C  1  C9 0C                 cmp #Podoboo              ;check enemy identifier for podoboo
00EB9E  1  F0 09                 beq ExEGHandler           ;skip this part if found, we do not want to erase podoboo!
00EBA0  1  B5 B6                 lda Enemy_Y_HighPos,x     ;check high byte of vertical position
00EBA2  1  C9 02                 cmp #$02                  ;if not yet past the bottom of the screen, branch
00EBA4  1  D0 03                 bne ExEGHandler
00EBA6  1  20 98 C9              jsr EraseEnemyObject      ;what it says
00EBA9  1               
00EBA9  1               ExEGHandler:
00EBA9  1  60                 rts
00EBAA  1               
00EBAA  1               DrawEnemyObjRow:
00EBAA  1  BD 3E E7           lda EnemyGraphicsTable,x    ;load two tiles of enemy graphics
00EBAD  1  85 00              sta $00
00EBAF  1  BD 3F E7           lda EnemyGraphicsTable+1,x
00EBB2  1               
00EBB2  1               DrawOneSpriteRow:
00EBB2  1  85 01              sta $01
00EBB4  1  4C 82 F2           jmp DrawSpriteObject        ;draw them
00EBB7  1               
00EBB7  1               MoveESprRowOffscreen:
00EBB7  1  18                 clc                         ;add A to enemy object OAM data offset
00EBB8  1  7D E5 06           adc Enemy_SprDataOffset,x
00EBBB  1  A8                 tay                         ;use as offset
00EBBC  1  A9 F8              lda #$f8
00EBBE  1  4C C1 E5           jmp DumpTwoSpr              ;move first row of sprites offscreen
00EBC1  1               
00EBC1  1               MoveESprColOffscreen:
00EBC1  1  18                 clc                         ;add A to enemy object OAM data offset
00EBC2  1  7D E5 06           adc Enemy_SprDataOffset,x
00EBC5  1  A8                 tay                         ;use as offset
00EBC6  1  20 4A EC           jsr MoveColOffscreen        ;move first and second row sprites in column offscreen
00EBC9  1  99 10 02           sta Sprite_Data+16,y        ;move third row sprite in column offscreen
00EBCC  1  60                 rts
00EBCD  1               
00EBCD  1               ;-------------------------------------------------------------------------------------
00EBCD  1               ;$00-$01 - tile numbers
00EBCD  1               ;$02 - relative Y position
00EBCD  1               ;$03 - horizontal flip flag (not used here)
00EBCD  1               ;$04 - attributes
00EBCD  1               ;$05 - relative X position
00EBCD  1               
00EBCD  1               DefaultBlockObjTiles:
00EBCD  1  85 85 86 86        .byte $85, $85, $86, $86             ;brick w/ line (these are sprite tiles, not BG!)
00EBD1  1               
00EBD1  1               DrawBlock:
00EBD1  1  AD BC 03                lda Block_Rel_YPos            ;get relative vertical coordinate of block object
00EBD4  1  85 02                   sta $02                       ;store here
00EBD6  1  AD B1 03                lda Block_Rel_XPos            ;get relative horizontal coordinate of block object
00EBD9  1  85 05                   sta $05                       ;store here
00EBDB  1  A9 03                   lda #$03
00EBDD  1  85 04                   sta $04                       ;set attribute byte here
00EBDF  1  4A                      lsr
00EBE0  1  85 03                   sta $03                       ;set horizontal flip bit here (will not be used)
00EBE2  1  BC EC 06                ldy Block_SprDataOffset,x     ;get sprite data offset
00EBE5  1  A2 00                   ldx #$00                      ;reset X for use as offset to tile data
00EBE7  1  BD CD EB     DBlkLoop:  lda DefaultBlockObjTiles,x    ;get left tile number
00EBEA  1  85 00                   sta $00                       ;set here
00EBEC  1  BD CE EB                lda DefaultBlockObjTiles+1,x  ;get right tile number
00EBEF  1  20 B2 EB                jsr DrawOneSpriteRow          ;do sub to write tile numbers to first row of sprites
00EBF2  1  E0 04                   cpx #$04                      ;check incremented offset
00EBF4  1  D0 F1                   bne DBlkLoop                  ;and loop back until all four sprites are done
00EBF6  1  A6 08                   ldx ObjectOffset              ;get block object offset
00EBF8  1  BC EC 06                ldy Block_SprDataOffset,x     ;get sprite data offset
00EBFB  1  AD 4E 07                lda AreaType
00EBFE  1  C9 01                   cmp #$01                      ;check for ground level type area
00EC00  1  F0 08                   beq ChkRep                    ;if found, branch to next part
00EC02  1  A9 86                   lda #$86
00EC04  1  99 01 02                sta Sprite_Tilenumber,y       ;otherwise remove brick tiles with lines
00EC07  1  99 05 02                sta Sprite_Tilenumber+4,y     ;and replace then with lineless brick tiles
00EC0A  1  BD E8 03     ChkRep:    lda Block_Metatile,x          ;check replacement metatile
00EC0D  1  C9 C4                   cmp #$c4                      ;if not used block metatile, then
00EC0F  1  D0 24                   bne BlkOffscr                 ;branch ahead to use current graphics
00EC11  1  A9 87                   lda #$87                      ;set A for used block tile
00EC13  1  C8                      iny                           ;increment Y to write to tile bytes
00EC14  1  20 BB E5                jsr DumpFourSpr               ;do sub to dump into all four sprites
00EC17  1  88                      dey                           ;return Y to original offset
00EC18  1  A9 03                   lda #$03                      ;set palette bits
00EC1A  1  AE 4E 07                ldx AreaType
00EC1D  1  CA                      dex                           ;check for ground level type area again
00EC1E  1  F0 01                   beq SetBFlip                  ;if found, use current palette bits
00EC20  1  4A                      lsr                           ;otherwise set to $01
00EC21  1  A6 08        SetBFlip:  ldx ObjectOffset              ;put block object offset back in X
00EC23  1  99 02 02                sta Sprite_Attributes,y       ;store attribute byte as-is in first sprite
00EC26  1  09 40                   ora #%01000000
00EC28  1  99 06 02                sta Sprite_Attributes+4,y     ;set horizontal flip bit for second sprite
00EC2B  1  09 80                   ora #%10000000
00EC2D  1  99 0E 02                sta Sprite_Attributes+12,y    ;set both flip bits for fourth sprite
00EC30  1  29 83                   and #%10000011
00EC32  1  99 0A 02                sta Sprite_Attributes+8,y     ;set vertical flip bit for third sprite
00EC35  1  AD D4 03     BlkOffscr: lda Block_OffscreenBits       ;get offscreen bits for block object
00EC38  1  48                      pha                           ;save to stack
00EC39  1  29 04                   and #%00000100                ;check to see if d2 in offscreen bits are set
00EC3B  1  F0 08                   beq PullOfsB                  ;if not set, branch, otherwise move sprites offscreen
00EC3D  1  A9 F8                   lda #$f8                      ;move offscreen two OAMs
00EC3F  1  99 04 02                sta Sprite_Y_Position+4,y     ;on the right side
00EC42  1  99 0C 02                sta Sprite_Y_Position+12,y
00EC45  1  68           PullOfsB:  pla                           ;pull offscreen bits from stack
00EC46  1  29 08        ChkLeftCo: and #%00001000                ;check to see if d3 in offscreen bits are set
00EC48  1  F0 08                   beq ExDBlk                    ;if not set, branch, otherwise move sprites offscreen
00EC4A  1               
00EC4A  1               MoveColOffscreen:
00EC4A  1  A9 F8                lda #$f8                   ;move offscreen two OAMs
00EC4C  1  99 00 02             sta Sprite_Y_Position,y    ;on the left side (or two rows of enemy on either side
00EC4F  1  99 08 02             sta Sprite_Y_Position+8,y  ;if branched here from enemy graphics handler)
00EC52  1  60           ExDBlk: rts
00EC53  1               
00EC53  1               ;-------------------------------------------------------------------------------------
00EC53  1               ;$00 - used to hold palette bits for attribute byte or relative X position
00EC53  1               
00EC53  1               DrawBrickChunks:
00EC53  1  A9 02                 lda #$02                   ;set palette bits here
00EC55  1  85 00                 sta $00
00EC57  1  A9 75                 lda #$75                   ;set tile number for ball (something residual, likely)
00EC59  1  A4 0E                 ldy GameEngineSubroutine
00EC5B  1  C0 05                 cpy #$05                   ;if end-of-level routine running,
00EC5D  1  F0 06                 beq DChunks                ;use palette and tile number assigned
00EC5F  1  A9 03                 lda #$03                   ;otherwise set different palette bits
00EC61  1  85 00                 sta $00
00EC63  1  A9 84                 lda #$84                   ;and set tile number for brick chunks
00EC65  1  BC EC 06     DChunks: ldy Block_SprDataOffset,x  ;get OAM data offset
00EC68  1  C8                    iny                        ;increment to start with tile bytes in OAM
00EC69  1  20 BB E5              jsr DumpFourSpr            ;do sub to dump tile number into all four sprites
00EC6C  1  A5 09                 lda FrameCounter           ;get frame counter
00EC6E  1  0A                    asl
00EC6F  1  0A                    asl
00EC70  1  0A                    asl                        ;move low nybble to high
00EC71  1  0A                    asl
00EC72  1  29 C0                 and #$c0                   ;get what was originally d3-d2 of low nybble
00EC74  1  05 00                 ora $00                    ;add palette bits
00EC76  1  C8                    iny                        ;increment offset for attribute bytes
00EC77  1  20 BB E5              jsr DumpFourSpr            ;do sub to dump attribute data into all four sprites
00EC7A  1  88                    dey
00EC7B  1  88                    dey                        ;decrement offset to Y coordinate
00EC7C  1  AD BC 03              lda Block_Rel_YPos         ;get first block object's relative vertical coordinate
00EC7F  1  20 C1 E5              jsr DumpTwoSpr             ;do sub to dump current Y coordinate into two sprites
00EC82  1  AD B1 03              lda Block_Rel_XPos         ;get first block object's relative horizontal coordinate
00EC85  1  99 03 02              sta Sprite_X_Position,y    ;save into X coordinate of first sprite
00EC88  1  BD F1 03              lda Block_Orig_XPos,x      ;get original horizontal coordinate
00EC8B  1  38                    sec
00EC8C  1  ED 1C 07              sbc ScreenLeft_X_Pos       ;subtract coordinate of left side from original coordinate
00EC8F  1  85 00                 sta $00                    ;store result as relative horizontal coordinate of original
00EC91  1  38                    sec
00EC92  1  ED B1 03              sbc Block_Rel_XPos         ;get difference of relative positions of original - current
00EC95  1  65 00                 adc $00                    ;add original relative position to result
00EC97  1  69 06                 adc #$06                   ;plus 6 pixels to position second brick chunk correctly
00EC99  1  99 07 02              sta Sprite_X_Position+4,y  ;save into X coordinate of second sprite
00EC9C  1  AD BD 03              lda Block_Rel_YPos+1       ;get second block object's relative vertical coordinate
00EC9F  1  99 08 02              sta Sprite_Y_Position+8,y
00ECA2  1  99 0C 02              sta Sprite_Y_Position+12,y ;dump into Y coordinates of third and fourth sprites
00ECA5  1  AD B2 03              lda Block_Rel_XPos+1       ;get second block object's relative horizontal coordinate
00ECA8  1  99 0B 02              sta Sprite_X_Position+8,y  ;save into X coordinate of third sprite
00ECAB  1  A5 00                 lda $00                    ;use original relative horizontal position
00ECAD  1  38                    sec
00ECAE  1  ED B2 03              sbc Block_Rel_XPos+1       ;get difference of relative positions of original - current
00ECB1  1  65 00                 adc $00                    ;add original relative position to result
00ECB3  1  69 06                 adc #$06                   ;plus 6 pixels to position fourth brick chunk correctly
00ECB5  1  99 0F 02              sta Sprite_X_Position+12,y ;save into X coordinate of fourth sprite
00ECB8  1  AD D4 03              lda Block_OffscreenBits    ;get offscreen bits for block object
00ECBB  1  20 46 EC              jsr ChkLeftCo              ;do sub to move left half of sprites offscreen if necessary
00ECBE  1  AD D4 03              lda Block_OffscreenBits    ;get offscreen bits again
00ECC1  1  0A                    asl                        ;shift d7 into carry
00ECC2  1  90 05                 bcc ChnkOfs                ;if d7 not set, branch to last part
00ECC4  1  A9 F8                 lda #$f8
00ECC6  1  20 C1 E5              jsr DumpTwoSpr             ;otherwise move top sprites offscreen
00ECC9  1  A5 00        ChnkOfs: lda $00                    ;if relative position on left side of screen,
00ECCB  1  10 10                 bpl ExBCDr                 ;go ahead and leave
00ECCD  1  B9 03 02              lda Sprite_X_Position,y    ;otherwise compare left-side X coordinate
00ECD0  1  D9 07 02              cmp Sprite_X_Position+4,y  ;to right-side X coordinate
00ECD3  1  90 08                 bcc ExBCDr                 ;branch to leave if less
00ECD5  1  A9 F8                 lda #$f8                   ;otherwise move right half of sprites offscreen
00ECD7  1  99 04 02              sta Sprite_Y_Position+4,y
00ECDA  1  99 0C 02              sta Sprite_Y_Position+12,y
00ECDD  1  60           ExBCDr:  rts                        ;leave
00ECDE  1               
00ECDE  1               ;-------------------------------------------------------------------------------------
00ECDE  1               
00ECDE  1               DrawFireball:
00ECDE  1  BC F1 06           ldy FBall_SprDataOffset,x  ;get fireball's sprite data offset
00ECE1  1  AD BA 03           lda Fireball_Rel_YPos      ;get relative vertical coordinate
00ECE4  1  99 00 02           sta Sprite_Y_Position,y    ;store as sprite Y coordinate
00ECE7  1  AD AF 03           lda Fireball_Rel_XPos      ;get relative horizontal coordinate
00ECEA  1  99 03 02           sta Sprite_X_Position,y    ;store as sprite X coordinate, then do shared code
00ECED  1               
00ECED  1               DrawFirebar:
00ECED  1  A5 09               lda FrameCounter         ;get frame counter
00ECEF  1  4A                  lsr                      ;divide by four
00ECF0  1  4A                  lsr
00ECF1  1  48                  pha                      ;save result to stack
00ECF2  1  29 01               and #$01                 ;mask out all but last bit
00ECF4  1  49 64               eor #$64                 ;set either tile $64 or $65 as fireball tile
00ECF6  1  99 01 02            sta Sprite_Tilenumber,y  ;thus tile changes every four frames
00ECF9  1  68                  pla                      ;get from stack
00ECFA  1  4A                  lsr                      ;divide by four again
00ECFB  1  4A                  lsr
00ECFC  1  A9 02               lda #$02                 ;load value $02 to set palette in attrib byte
00ECFE  1  90 02               bcc FireA                ;if last bit shifted out was not set, skip this
00ED00  1  09 C0               ora #%11000000           ;otherwise flip both ways every eight frames
00ED02  1  99 02 02     FireA: sta Sprite_Attributes,y  ;store attribute byte and leave
00ED05  1  60                  rts
00ED06  1               
00ED06  1               ;-------------------------------------------------------------------------------------
00ED06  1               
00ED06  1               ExplosionTiles:
00ED06  1  68 67 66           .byte $68, $67, $66
00ED09  1               
00ED09  1               DrawExplosion_Fireball:
00ED09  1  BC EC 06           ldy Alt_SprDataOffset,x  ;get OAM data offset of alternate sort for fireball's explosion
00ED0C  1  B5 24              lda Fireball_State,x     ;load fireball state
00ED0E  1  F6 24              inc Fireball_State,x     ;increment state for next frame
00ED10  1  4A                 lsr                      ;divide by 2
00ED11  1  29 07              and #%00000111           ;mask out all but d3-d1
00ED13  1  C9 03              cmp #$03                 ;check to see if time to kill fireball
00ED15  1  B0 4A              bcs KillFireBall         ;branch if so, otherwise continue to draw explosion
00ED17  1               
00ED17  1               DrawExplosion_Fireworks:
00ED17  1  AA                 tax                         ;use whatever's in A for offset
00ED18  1  BD 06 ED           lda ExplosionTiles,x        ;get tile number using offset
00ED1B  1  C8                 iny                         ;increment Y (contains sprite data offset)
00ED1C  1  20 BB E5           jsr DumpFourSpr             ;and dump into tile number part of sprite data
00ED1F  1  88                 dey                         ;decrement Y so we have the proper offset again
00ED20  1  A6 08              ldx ObjectOffset            ;return enemy object buffer offset to X
00ED22  1  AD BA 03           lda Fireball_Rel_YPos       ;get relative vertical coordinate
00ED25  1  38                 sec                         ;subtract four pixels vertically
00ED26  1  E9 04              sbc #$04                    ;for first and third sprites
00ED28  1  99 00 02           sta Sprite_Y_Position,y
00ED2B  1  99 08 02           sta Sprite_Y_Position+8,y
00ED2E  1  18                 clc                         ;add eight pixels vertically
00ED2F  1  69 08              adc #$08                    ;for second and fourth sprites
00ED31  1  99 04 02           sta Sprite_Y_Position+4,y
00ED34  1  99 0C 02           sta Sprite_Y_Position+12,y
00ED37  1  AD AF 03           lda Fireball_Rel_XPos       ;get relative horizontal coordinate
00ED3A  1  38                 sec                         ;subtract four pixels horizontally
00ED3B  1  E9 04              sbc #$04                    ;for first and second sprites
00ED3D  1  99 03 02           sta Sprite_X_Position,y
00ED40  1  99 07 02           sta Sprite_X_Position+4,y
00ED43  1  18                 clc                         ;add eight pixels horizontally
00ED44  1  69 08              adc #$08                    ;for third and fourth sprites
00ED46  1  99 0B 02           sta Sprite_X_Position+8,y
00ED49  1  99 0F 02           sta Sprite_X_Position+12,y
00ED4C  1  A9 02              lda #$02                    ;set palette attributes for all sprites, but
00ED4E  1  99 02 02           sta Sprite_Attributes,y     ;set no flip at all for first sprite
00ED51  1  A9 82              lda #$82
00ED53  1  99 06 02           sta Sprite_Attributes+4,y   ;set vertical flip for second sprite
00ED56  1  A9 42              lda #$42
00ED58  1  99 0A 02           sta Sprite_Attributes+8,y   ;set horizontal flip for third sprite
00ED5B  1  A9 C2              lda #$c2
00ED5D  1  99 0E 02           sta Sprite_Attributes+12,y  ;set both flips for fourth sprite
00ED60  1  60                 rts                         ;we are done
00ED61  1               
00ED61  1               KillFireBall:
00ED61  1  A9 00              lda #$00                    ;clear fireball state to kill it
00ED63  1  95 24              sta Fireball_State,x
00ED65  1  60                 rts
00ED66  1               
