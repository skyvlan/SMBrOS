008F5F  1               DigitsMathRoutine:
008F5F  1  AD 70 07                 lda OperMode              ;check mode of operation
008F62  1  C9 00                    cmp #TitleScreenModeValue
008F64  1  F0 16                    beq EraseDMods            ;if in title screen mode, branch to lock score
008F66  1  A2 05                    ldx #$05
008F68  1  BD 34 01     AddModLoop: lda DigitModifier,x       ;load digit amount to increment
008F6B  1  18                       clc
008F6C  1  79 D7 07                 adc DisplayDigits,y       ;add to current digit
008F6F  1  30 16                    bmi BorrowOne             ;if result is a negative number, branch to subtract
008F71  1  C9 0A                    cmp #10
008F73  1  B0 19                    bcs CarryOne              ;if digit greater than $09, branch to add
008F75  1  99 D7 07     StoreNewD:  sta DisplayDigits,y       ;store as new score or game timer digit
008F78  1  88                       dey                       ;move onto next digits in score or game timer
008F79  1  CA                       dex                       ;and digit amounts to increment
008F7A  1  10 EC                    bpl AddModLoop            ;loop back if we're not done yet
008F7C  1  A9 00        EraseDMods: lda #$00                  ;store zero here
008F7E  1  A2 06                    ldx #$06                  ;start with the last digit
008F80  1  9D 33 01     EraseMLoop: sta DigitModifier-1,x     ;initialize the digit amounts to increment
008F83  1  CA                       dex
008F84  1  10 FA                    bpl EraseMLoop            ;do this until they're all reset, then leave
008F86  1  60                       rts
008F87  1  DE 33 01     BorrowOne:  dec DigitModifier-1,x     ;decrement the previous digit, then put $09 in
008F8A  1  A9 09                    lda #$09                  ;the game timer digit we're currently on to "borrow
008F8C  1  D0 E7                    bne StoreNewD             ;the one", then do an unconditional branch back
008F8E  1  38           CarryOne:   sec                       ;subtract ten from our digit to make it a
008F8F  1  E9 0A                    sbc #10                   ;proper BCD number, then increment the digit
008F91  1  FE 33 01                 inc DigitModifier-1,x     ;preceding current digit to "carry the one" properly
008F94  1  4C 75 8F                 jmp StoreNewD             ;go back to just after we branched here
