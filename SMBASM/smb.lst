00C578  1  B9 0F 00             lda Enemy_Flag,y        ;check enemy buffer flag for empty slot
00C57B  1  D0 FA                bne FSLoop              ;if set, branch and keep checking
00C57D  1  8C CF 06             sty DuplicateObj_Offset ;otherwise set offset here
00C580  1  8A                   txa                     ;transfer original enemy buffer offset
00C581  1  09 80                ora #%10000000          ;store with d7 set as flag in new enemy
00C583  1  99 0F 00             sta Enemy_Flag,y        ;slot as well as enemy offset
00C586  1  B5 6E                lda Enemy_PageLoc,x
00C588  1  99 6E 00             sta Enemy_PageLoc,y     ;copy page location and horizontal coordinates
00C58B  1  B5 87                lda Enemy_X_Position,x  ;from original enemy to new enemy
00C58D  1  99 87 00             sta Enemy_X_Position,y
00C590  1  A9 01                lda #$01
00C592  1  95 0F                sta Enemy_Flag,x        ;set flag as normal for original enemy
00C594  1  99 B6 00             sta Enemy_Y_HighPos,y   ;set high vertical byte for new enemy
00C597  1  B5 CF                lda Enemy_Y_Position,x
00C599  1  99 CF 00             sta Enemy_Y_Position,y  ;copy vertical coordinate from original to new
