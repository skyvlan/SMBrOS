00E0EC  1  B5 1E        Chk2MSBSt:   lda Enemy_State,x         ;save enemy state into Y
00E0EE  1  A8                        tay
00E0EF  1  0A                        asl                       ;check for d7 set
00E0F0  1  90 07                     bcc GetSteFromD           ;branch if not set
