00BCBB  1  A5 23                   lda Enemy_State+5          ;load power-up object state
00BCBD  1  E6 23                   inc Enemy_State+5          ;increment state for next frame (to make power-up rise)
00BCBF  1  C9 11                   cmp #$11                   ;if power-up object state not yet past 16th pixel,
00BCC1  1  90 0F                   bcc ChkPUSte               ;branch ahead to last part here
00BCC3  1  A9 10                   lda #$10
00BCC5  1  95 58                   sta Enemy_X_Speed,x        ;otherwise set horizontal speed
00BCC7  1  A9 80                   lda #%10000000
00BCC9  1  85 23                   sta Enemy_State+5          ;and then set d7 in power-up object's state
00BCCB  1  0A                      asl                        ;shift once to init A
00BCCC  1  8D CA 03                sta Enemy_SprAttrib+5      ;initialize background priority bit set here
00BCCF  1  2A                      rol                        ;rotate A to set right moving direction
00BCD0  1  95 46                   sta Enemy_MovingDir,x      ;set moving direction
00BCD2  1  A5 23        ChkPUSte:  lda Enemy_State+5          ;check power-up object's state
00BCD4  1  C9 06                   cmp #$06                   ;for if power-up has risen enough
00BCD6  1  90 12                   bcc ExitPUp                ;if not, don't even bother running these routines
