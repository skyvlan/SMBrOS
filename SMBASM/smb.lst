00F0D0  1               GetOffsetFromAnimCtrl:
00F0D0  1  0A                   asl                        ;multiply animation frame control
00F0D1  1  0A                   asl                        ;by eight to get proper amount
00F0D2  1  0A                   asl                        ;to add to our offset
00F0D3  1  79 07 EE             adc PlayerGfxTblOffsets,y  ;add to offset to graphics table
00F0D6  1  60                   rts                        ;and return with result in A
00F0D7  1               
00F0D7  1               ShrinkPlayer:
00F0D7  1  98                   tya                          ;add ten bytes to frame control as offset
00F0D8  1  18                   clc
00F0D9  1  69 0A                adc #$0a                     ;this thing apparently uses two of the swimming frames
00F0DB  1  AA                   tax                          ;to draw the player shrinking
00F0DC  1  A0 09                ldy #$09                     ;load offset for small player swimming
00F0DE  1  BD 9C F0             lda ChangeSizeOffsetAdder,x  ;get what would normally be offset adder
00F0E1  1  D0 02                bne ShrPlF                   ;and branch to use offset if nonzero
00F0E3  1  A0 01                ldy #$01                     ;otherwise load offset for big player swimming
00F0E5  1  B9 07 EE     ShrPlF: lda PlayerGfxTblOffsets,y    ;get offset to graphics table based on offset loaded
00F0E8  1  60                   rts                          ;and leave
00F0E9  1               
00F0E9  1               ChkForPlayerAttrib:
00F0E9  1  AC E4 06                ldy Player_SprDataOffset    ;get sprite data offset
00F0EC  1  A5 0E                   lda GameEngineSubroutine
00F0EE  1  C9 0B                   cmp #$0b                    ;if executing specific game engine routine,
00F0F0  1  F0 13                   beq KilledAtt               ;branch to change third and fourth row OAM attributes
00F0F2  1  AD D5 06                lda PlayerGfxOffset         ;get graphics table offset
00F0F5  1  C9 50                   cmp #$50
00F0F7  1  F0 1E                   beq C_S_IGAtt               ;if crouch offset, either standing offset,
00F0F9  1  C9 B8                   cmp #$b8                    ;or intermediate growing offset,
00F0FB  1  F0 1A                   beq C_S_IGAtt               ;go ahead and execute code to change
00F0FD  1  C9 C0                   cmp #$c0                    ;fourth row OAM attributes only
00F0FF  1  F0 16                   beq C_S_IGAtt
00F101  1  C9 C8                   cmp #$c8
00F103  1  D0 24                   bne ExPlyrAt                ;if none of these, branch to leave
00F105  1  B9 12 02     KilledAtt: lda Sprite_Attributes+16,y
00F108  1  29 3F                   and #%00111111              ;mask out horizontal and vertical flip bits
00F10A  1  99 12 02                sta Sprite_Attributes+16,y  ;for third row sprites and save
00F10D  1  B9 16 02                lda Sprite_Attributes+20,y
00F110  1  29 3F                   and #%00111111
00F112  1  09 40                   ora #%01000000              ;set horizontal flip bit for second
00F114  1  99 16 02                sta Sprite_Attributes+20,y  ;sprite in the third row
00F117  1  B9 1A 02     C_S_IGAtt: lda Sprite_Attributes+24,y
00F11A  1  29 3F                   and #%00111111              ;mask out horizontal and vertical flip bits
00F11C  1  99 1A 02                sta Sprite_Attributes+24,y  ;for fourth row sprites and save
00F11F  1  B9 1E 02                lda Sprite_Attributes+28,y
00F122  1  29 3F                   and #%00111111
00F124  1  09 40                   ora #%01000000              ;set horizontal flip bit for second
00F126  1  99 1E 02                sta Sprite_Attributes+28,y  ;sprite in the fourth row
00F129  1  60           ExPlyrAt:  rts                         ;leave
