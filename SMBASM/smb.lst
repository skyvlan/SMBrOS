00C08C  1               ExecGameLoopback:
00C08C  1  A5 6D              lda Player_PageLoc        ;send player back four pages
00C08E  1  38                 sec
00C08F  1  E9 04              sbc #$04
00C091  1  85 6D              sta Player_PageLoc
00C093  1  AD 25 07           lda CurrentPageLoc        ;send current page back four pages
00C096  1  38                 sec
00C097  1  E9 04              sbc #$04
00C099  1  8D 25 07           sta CurrentPageLoc
00C09C  1  AD 1A 07           lda ScreenLeft_PageLoc    ;subtract four from page location
00C09F  1  38                 sec                       ;of screen's left border
00C0A0  1  E9 04              sbc #$04
00C0A2  1  8D 1A 07           sta ScreenLeft_PageLoc
00C0A5  1  AD 1B 07           lda ScreenRight_PageLoc   ;do the same for the page location
00C0A8  1  38                 sec                       ;of screen's right border
00C0A9  1  E9 04              sbc #$04
00C0AB  1  8D 1B 07           sta ScreenRight_PageLoc
