008311  1  8D 66 07                   sta OffScr_WorldNumber      ;of the previously saved world number
008314  1  A2 00                      ldx #$00                    ;note that on power-up using this function
008316  1  8E 60 07                   stx AreaNumber              ;will make no difference
008319  1  8E 67 07                   stx OffScr_AreaNumber
