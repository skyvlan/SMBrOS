00C0CC  1               ProcLoopCommand:
00C0CC  1  AD 45 07               lda LoopCommand           ;check if loop command was found
00C0CF  1  F0 5E                  beq ChkEnemyFrenzy
00C0D1  1  AD 26 07               lda CurrentColumnPos      ;check to see if we're still on the first page
00C0D4  1  D0 59                  bne ChkEnemyFrenzy        ;if not, do not loop yet
00C0D6  1  A0 0B                  ldy #$0b                  ;start at the end of each set of loop data
00C0D8  1  88           FindLoop: dey
00C0D9  1  30 54                  bmi ChkEnemyFrenzy        ;if all data is checked and not match, do not loop
00C0DB  1  AD 5F 07               lda WorldNumber           ;check to see if one of the world numbers
00C0DE  1  D9 6B C0               cmp LoopCmdWorldNumber,y  ;matches our current world number
00C0E1  1  D0 F5                  bne FindLoop
00C0E3  1  AD 25 07               lda CurrentPageLoc        ;check to see if one of the page numbers
00C0E6  1  D9 76 C0               cmp LoopCmdPageNumber,y   ;matches the page we're currently on
00C0E9  1  D0 ED                  bne FindLoop
00C0EB  1  A5 CE                  lda Player_Y_Position     ;check to see if the player is at the correct position
00C0ED  1  D9 81 C0               cmp LoopCmdYPosition,y    ;if not, branch to check for world 7
00C0F0  1  D0 23                  bne WrongChk
00C0F2  1  A5 1D                  lda Player_State          ;check to see if the player is
00C0F4  1  C9 00                  cmp #$00                  ;on solid ground (i.e. not jumping or falling)
00C0F6  1  D0 1D                  bne WrongChk              ;if not, player fails to pass loop, and loopback
00C0F8  1  AD 5F 07               lda WorldNumber           ;are we in world 7? (check performed on correct
00C0FB  1  C9 06                  cmp #World7               ;vertical position and on solid ground)
00C0FD  1  D0 23                  bne InitMLp               ;if not, initialize flags used there, otherwise
00C0FF  1  EE D9 06               inc MultiLoopCorrectCntr  ;increment counter for correct progression
00C102  1  EE DA 06     IncMLoop: inc MultiLoopPassCntr     ;increment master multi-part counter
00C105  1  AD DA 06               lda MultiLoopPassCntr     ;have we done all three parts?
00C108  1  C9 03                  cmp #$03
00C10A  1  D0 1E                  bne InitLCmd              ;if not, skip this part
00C10C  1  AD D9 06               lda MultiLoopCorrectCntr  ;if so, have we done them all correctly?
00C10F  1  C9 03                  cmp #$03
00C111  1  F0 0F                  beq InitMLp               ;if so, branch past unnecessary check here
00C113  1  D0 07                  bne DoLpBack              ;unconditional branch if previous branch fails
00C115  1  AD 5F 07     WrongChk: lda WorldNumber           ;are we in world 7? (check performed on
00C118  1  C9 06                  cmp #World7               ;incorrect vertical position or not on solid ground)
00C11A  1  F0 E6                  beq IncMLoop
00C11C  1  20 8C C0     DoLpBack: jsr ExecGameLoopback      ;if player is not in right place, loop back
00C11F  1  20 71 D0               jsr KillAllEnemies
