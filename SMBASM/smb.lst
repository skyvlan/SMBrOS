00867F  1  C8                 iny                     ;increment for proper number display
008680  1  98                 tya
008681  1  9D 06 03           sta VRAM_Buffer1+5,x
008684  1  A9 00              lda #$00                ;put null terminator on
008686  1  9D 07 03           sta VRAM_Buffer1+6,x
008689  1  8A                 txa                     ;move the buffer offset up by 6 bytes
00868A  1  18                 clc
00868B  1  69 06              adc #$06
00868D  1  8D 00 03           sta VRAM_Buffer1_Offset
008690  1  4C 45 87           jmp IncSubtask
