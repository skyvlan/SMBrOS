00B450  1               PlayerPhysicsSub:
00B450  1  A5 1D                   lda Player_State          ;check player state
00B452  1  C9 03                   cmp #$03
00B454  1  D0 23                   bne CheckForJumping       ;if not climbing, branch
00B456  1  A0 00                   ldy #$00
00B458  1  A5 0B                   lda Up_Down_Buttons       ;get controller bits for up/down
00B45A  1  2D 90 04                and Player_CollisionBits  ;check against player's collision detection bits
00B45D  1  F0 06                   beq ProcClimb             ;if not pressing up or down, branch
00B45F  1  C8                      iny
00B460  1  29 08                   and #%00001000            ;check for pressing up
00B462  1  D0 01                   bne ProcClimb
00B464  1  C8                      iny
00B465  1  BE 4D B4     ProcClimb: ldx Climb_Y_MForceData,y  ;load value here
00B468  1  8E 33 04                stx Player_Y_MoveForce    ;store as vertical movement force
00B46B  1  A9 08                   lda #$08                  ;load default animation timing
00B46D  1  BE 4A B4                ldx Climb_Y_SpeedData,y   ;load some other value here
00B470  1  86 9F                   stx Player_Y_Speed        ;store as vertical speed
00B472  1  30 01                   bmi SetCAnim              ;if climbing down, use default animation timing value
00B474  1  4A                      lsr                       ;otherwise divide timer setting by 2
00B475  1  8D 0C 07     SetCAnim:  sta PlayerAnimTimerSet    ;store animation timer setting and leave
00B478  1  60                      rts
00B479  1               
00B479  1               CheckForJumping:
00B479  1  AD 0E 07             lda JumpspringAnimCtrl    ;if jumpspring animating,
00B47C  1  D0 0A                bne NoJump                ;skip ahead to something else
00B47E  1  A5 0A                lda A_B_Buttons           ;check for A button press
00B480  1  29 80                and #A_Button
00B482  1  F0 04                beq NoJump                ;if not, branch to something else
00B484  1  25 0D                and PreviousA_B_Buttons   ;if button not pressed in previous frame, branch
00B486  1  F0 03                beq ProcJumping
00B488  1  4C 1C B5     NoJump: jmp X_Physics             ;otherwise, jump to something else
00B48B  1               
00B48B  1               ProcJumping:
00B48B  1  A5 1D                   lda Player_State           ;check player state
00B48D  1  F0 11                   beq InitJS                 ;if on the ground, branch
00B48F  1  AD 04 07                lda SwimmingFlag           ;if swimming flag not set, jump to do something else
00B492  1  F0 F4                   beq NoJump                 ;to prevent midair jumping, otherwise continue
00B494  1  AD 82 07                lda JumpSwimTimer          ;if jump/swim timer nonzero, branch
00B497  1  D0 07                   bne InitJS
00B499  1  A5 9F                   lda Player_Y_Speed         ;check player's vertical speed
00B49B  1  10 03                   bpl InitJS                 ;if player's vertical speed motionless or down, branch
00B49D  1  4C 1C B5                jmp X_Physics              ;if timer at zero and player still rising, do not swim
00B4A0  1  A9 20        InitJS:    lda #$20                   ;set jump/swim timer
00B4A2  1  8D 82 07                sta JumpSwimTimer
00B4A5  1  A0 00                   ldy #$00                   ;initialize vertical force and dummy variable
00B4A7  1  8C 16 04                sty Player_YMF_Dummy
00B4AA  1  8C 33 04                sty Player_Y_MoveForce
00B4AD  1  A5 B5                   lda Player_Y_HighPos       ;get vertical high and low bytes of jump origin
00B4AF  1  8D 07 07                sta JumpOrigin_Y_HighPos   ;and store them next to each other here
00B4B2  1  A5 CE                   lda Player_Y_Position
00B4B4  1  8D 08 07                sta JumpOrigin_Y_Position
00B4B7  1  A9 01                   lda #$01                   ;set player state to jumping/swimming
00B4B9  1  85 1D                   sta Player_State
00B4BB  1  AD 00 07                lda Player_XSpeedAbsolute  ;check value related to walking/running speed
00B4BE  1  C9 09                   cmp #$09
00B4C0  1  90 10                   bcc ChkWtr                 ;branch if below certain values, increment Y
00B4C2  1  C8                      iny                        ;for each amount equal or exceeded
00B4C3  1  C9 10                   cmp #$10
00B4C5  1  90 0B                   bcc ChkWtr
00B4C7  1  C8                      iny
00B4C8  1  C9 19                   cmp #$19
00B4CA  1  90 06                   bcc ChkWtr
00B4CC  1  C8                      iny
00B4CD  1  C9 1C                   cmp #$1c
00B4CF  1  90 01                   bcc ChkWtr                 ;note that for jumping, range is 0-4 for Y
00B4D1  1  C8                      iny
00B4D2  1  A9 01        ChkWtr:    lda #$01                   ;set value here (apparently always set to 1)
00B4D4  1  8D 06 07                sta DiffToHaltJump
00B4D7  1  AD 04 07                lda SwimmingFlag           ;if swimming flag disabled, branch
00B4DA  1  F0 08                   beq GetYPhy
00B4DC  1  A0 05                   ldy #$05                   ;otherwise set Y to 5, range is 5-6
00B4DE  1  AD 7D 04                lda Whirlpool_Flag         ;if whirlpool flag not set, branch
00B4E1  1  F0 01                   beq GetYPhy
00B4E3  1  C8                      iny                        ;otherwise increment to 6
00B4E4  1  B9 24 B4     GetYPhy:   lda JumpMForceData,y       ;store appropriate jump/swim
00B4E7  1  8D 09 07                sta VerticalForce          ;data here
00B4EA  1  B9 2B B4                lda FallMForceData,y
00B4ED  1  8D 0A 07                sta VerticalForceDown
00B4F0  1  B9 39 B4                lda InitMForceData,y
00B4F3  1  8D 33 04                sta Player_Y_MoveForce
00B4F6  1  B9 32 B4                lda PlayerYSpdData,y
00B4F9  1  85 9F                   sta Player_Y_Speed
00B4FB  1  AD 04 07                lda SwimmingFlag           ;if swimming flag disabled, branch
00B4FE  1  F0 11                   beq PJumpSnd
00B500  1  A9 04                   lda #Sfx_EnemyStomp        ;load swim/goomba stomp sound into
00B502  1  85 FF                   sta Square1SoundQueue      ;square 1's sfx queue
00B504  1  A5 CE                   lda Player_Y_Position
00B506  1  C9 14                   cmp #$14                   ;check vertical low byte of player position
00B508  1  B0 12                   bcs X_Physics              ;if below a certain point, branch
00B50A  1  A9 00                   lda #$00                   ;otherwise reset player's vertical speed
00B50C  1  85 9F                   sta Player_Y_Speed         ;and jump to something else to keep player
00B50E  1  4C 1C B5                jmp X_Physics              ;from swimming above water level
00B511  1  A9 01        PJumpSnd:  lda #Sfx_BigJump           ;load big mario's jump sound by default
00B513  1  AC 54 07                ldy PlayerSize             ;is mario big?
00B516  1  F0 02                   beq SJumpSnd
00B518  1  A9 80                   lda #Sfx_SmallJump         ;if not, load small mario's jump sound
00B51A  1  85 FF        SJumpSnd:  sta Square1SoundQueue      ;store appropriate jump sound in square 1 sfx queue
00B51C  1  A0 00        X_Physics: ldy #$00
00B51E  1  84 00                   sty $00                    ;init value here
00B520  1  A5 1D                   lda Player_State           ;if mario is on the ground, branch
00B522  1  F0 09                   beq ProcPRun
00B524  1  AD 00 07                lda Player_XSpeedAbsolute  ;check something that seems to be related
00B527  1  C9 19                   cmp #$19                   ;to mario's speed
00B529  1  B0 33                   bcs GetXPhy                ;if =>$19 branch here
00B52B  1  90 18                   bcc ChkRFast               ;if not branch elsewhere
00B52D  1  C8           ProcPRun:  iny                        ;if mario on the ground, increment Y
00B52E  1  AD 4E 07                lda AreaType               ;check area type
00B531  1  F0 12                   beq ChkRFast               ;if water type, branch
00B533  1  88                      dey                        ;decrement Y by default for non-water type area
00B534  1  A5 0C                   lda Left_Right_Buttons     ;get left/right controller bits
00B536  1  C5 45                   cmp Player_MovingDir       ;check against moving direction
00B538  1  D0 0B                   bne ChkRFast               ;if controller bits <> moving direction, skip this part
00B53A  1  A5 0A                   lda A_B_Buttons            ;check for b button pressed
00B53C  1  29 40                   and #B_Button
00B53E  1  D0 19                   bne SetRTmr                ;if pressed, skip ahead to set timer
00B540  1  AD 83 07                lda RunningTimer           ;check for running timer set
00B543  1  D0 19                   bne GetXPhy                ;if set, branch
00B545  1  C8           ChkRFast:  iny                        ;if running timer not set or level type is water,
00B546  1  E6 00                   inc $00                    ;increment Y again and temp variable in memory
00B548  1  AD 03 07                lda RunningSpeed
00B54B  1  D0 07                   bne FastXSp                ;if running speed set here, branch
00B54D  1  AD 00 07                lda Player_XSpeedAbsolute
00B550  1  C9 21                   cmp #$21                   ;otherwise check player's walking/running speed
00B552  1  90 0A                   bcc GetXPhy                ;if less than a certain amount, branch ahead
00B554  1  E6 00        FastXSp:   inc $00                    ;if running speed set or speed => $21 increment $00
00B556  1  4C 5E B5                jmp GetXPhy                ;and jump ahead
00B559  1  A9 0A        SetRTmr:   lda #$0a                   ;if b button pressed, set running timer
00B55B  1  8D 83 07                sta RunningTimer
00B55E  1  B9 40 B4     GetXPhy:   lda MaxLeftXSpdData,y      ;get maximum speed to the left
00B561  1  8D 50 04                sta MaximumLeftSpeed
00B564  1  A5 0E                   lda GameEngineSubroutine   ;check for specific routine running
00B566  1  C9 07                   cmp #$07                   ;(player entrance)
00B568  1  D0 02                   bne GetXPhy2               ;if not running, skip and use old value of Y
00B56A  1  A0 03                   ldy #$03                   ;otherwise set Y to 3
00B56C  1  B9 43 B4     GetXPhy2:  lda MaxRightXSpdData,y     ;get maximum speed to the right
00B56F  1  8D 56 04                sta MaximumRightSpeed
00B572  1  A4 00                   ldy $00                    ;get other value in memory
00B574  1  B9 47 B4                lda FrictionData,y         ;get value using value in memory as offset
00B577  1  8D 02 07                sta FrictionAdderLow
00B57A  1  A9 00                   lda #$00
00B57C  1  8D 01 07                sta FrictionAdderHigh      ;init something here
00B57F  1  A5 33                   lda PlayerFacingDir
00B581  1  C5 45                   cmp Player_MovingDir       ;check facing direction against moving direction
00B583  1  F0 06                   beq ExitPhy                ;if the same, branch to leave
00B585  1  0E 02 07                asl FrictionAdderLow       ;otherwise shift d7 of friction adder low into carry
00B588  1  2E 01 07                rol FrictionAdderHigh      ;then rotate carry onto d0 of friction adder high
00B58B  1  60           ExitPhy:   rts                        ;and then leave
