00B3C7  1               
00B3C7  1               ClimbAdderLow:
00B3C7  1  0E 04 FC F2        .byte $0e, $04, $fc, $f2
00B3CB  1               ClimbAdderHigh:
00B3CB  1  00 00 FF FF        .byte $00, $00, $ff, $ff
00B3CF  1               
00B3CF  1               ClimbingSub:
00B3CF  1  AD 16 04                  lda Player_YMF_Dummy
00B3D2  1  18                        clc                      ;add movement force to dummy variable
00B3D3  1  6D 33 04                  adc Player_Y_MoveForce   ;save with carry
00B3D6  1  8D 16 04                  sta Player_YMF_Dummy
00B3D9  1  A0 00                     ldy #$00                 ;set default adder here
00B3DB  1  A5 9F                     lda Player_Y_Speed       ;get player's vertical speed
00B3DD  1  10 01                     bpl MoveOnVine           ;if not moving upwards, branch
00B3DF  1  88                        dey                      ;otherwise set adder to $ff
00B3E0  1  84 00        MoveOnVine:  sty $00                  ;store adder here
00B3E2  1  65 CE                     adc Player_Y_Position    ;add carry to player's vertical position
00B3E4  1  85 CE                     sta Player_Y_Position    ;and store to move player up or down
00B3E6  1  A5 B5                     lda Player_Y_HighPos
00B3E8  1  65 00                     adc $00                  ;add carry to player's page location
00B3EA  1  85 B5                     sta Player_Y_HighPos     ;and store
00B3EC  1  A5 0C                     lda Left_Right_Buttons   ;compare left/right controller bits
00B3EE  1  2D 90 04                  and Player_CollisionBits ;to collision flag
00B3F1  1  F0 2D                     beq InitCSTimer          ;if not set, skip to end
00B3F3  1  AC 89 07                  ldy ClimbSideTimer       ;otherwise check timer
00B3F6  1  D0 27                     bne ExitCSub             ;if timer not expired, branch to leave
00B3F8  1  A0 18                     ldy #$18
00B3FA  1  8C 89 07                  sty ClimbSideTimer       ;otherwise set timer now
00B3FD  1  A2 00                     ldx #$00                 ;set default offset here
00B3FF  1  A4 33                     ldy PlayerFacingDir      ;get facing direction
00B401  1  4A                        lsr                      ;move right button controller bit to carry
00B402  1  B0 02                     bcs ClimbFD              ;if controller right pressed, branch ahead
00B404  1  E8                        inx
00B405  1  E8                        inx                      ;otherwise increment offset by 2 bytes
00B406  1  88           ClimbFD:     dey                      ;check to see if facing right
00B407  1  F0 01                     beq CSetFDir             ;if so, branch, do not increment
00B409  1  E8                        inx                      ;otherwise increment by 1 byte
00B40A  1  A5 86        CSetFDir:    lda Player_X_Position
00B40C  1  18                        clc                      ;add or subtract from player's horizontal position
00B40D  1  7D C7 B3                  adc ClimbAdderLow,x      ;using value here as adder and X as offset
00B410  1  85 86                     sta Player_X_Position
00B412  1  A5 6D                     lda Player_PageLoc       ;add or subtract carry or borrow using value here
00B414  1  7D CB B3                  adc ClimbAdderHigh,x     ;from the player's page location
00B417  1  85 6D                     sta Player_PageLoc
00B419  1  A5 0C                     lda Left_Right_Buttons   ;get left/right controller bits again
00B41B  1  49 03                     eor #%00000011           ;invert them and store them while player
00B41D  1  85 33                     sta PlayerFacingDir      ;is on vine to face player in opposite direction
00B41F  1  60           ExitCSub:    rts                      ;then leave
00B420  1  8D 89 07     InitCSTimer: sta ClimbSideTimer       ;initialize timer here
00B423  1  60                        rts
