009C03  1               LoadAreaPointer:
009C03  1  20 13 9C                  jsr FindAreaPointer  ;find it and store it here
009C06  1  8D 50 07                  sta AreaPointer
009C09  1  29 60        GetAreaType: and #%01100000       ;mask out all but d6 and d5
009C0B  1  0A                        asl
009C0C  1  2A                        rol
009C0D  1  2A                        rol
009C0E  1  2A                        rol                  ;make %0xx00000 into %000000xx
009C0F  1  8D 4E 07                  sta AreaType         ;save 2 MSB as area type
009C12  1  60                        rts
009C13  1               
009C13  1               FindAreaPointer:
009C13  1  AC 5F 07           ldy WorldNumber        ;load offset from world variable
009C16  1  B9 B4 9C           lda WorldAddrOffsets,y
009C19  1  18                 clc                    ;add area number used to find data
009C1A  1  6D 60 07           adc AreaNumber
009C1D  1  A8                 tay
009C1E  1  B9 BC 9C           lda AreaAddrOffsets,y  ;from there we have our area pointer
009C21  1  60                 rts
009C22  1               
009C22  1               
009C22  1               GetAreaDataAddrs:
009C22  1  AD 50 07                 lda AreaPointer          ;use 2 MSB for Y
009C25  1  20 09 9C                 jsr GetAreaType
009C28  1  A8                       tay
009C29  1  AD 50 07                 lda AreaPointer          ;mask out all but 5 LSB
009C2C  1  29 1F                    and #%00011111
009C2E  1  8D 4F 07                 sta AreaAddrsLOffset     ;save as low offset
009C31  1  B9 E0 9C                 lda EnemyAddrHOffsets,y  ;load base value with 2 altered MSB,
009C34  1  18                       clc                      ;then add base value to 5 LSB, result
009C35  1  6D 4F 07                 adc AreaAddrsLOffset     ;becomes offset for level data
009C38  1  A8                       tay
009C39  1  B9 E4 9C                 lda EnemyDataAddrLow,y   ;use offset to load pointer
009C3C  1  85 E9                    sta EnemyDataLow
009C3E  1  B9 06 9D                 lda EnemyDataAddrHigh,y
009C41  1  85 EA                    sta EnemyDataHigh
009C43  1  AC 4E 07                 ldy AreaType             ;use area type as offset
009C46  1  B9 28 9D                 lda AreaDataHOffsets,y   ;do the same thing but with different base value
009C49  1  18                       clc
009C4A  1  6D 4F 07                 adc AreaAddrsLOffset
009C4D  1  A8                       tay
009C4E  1  B9 2C 9D                 lda AreaDataAddrLow,y    ;use this offset to load another pointer
009C51  1  85 E7                    sta AreaDataLow
009C53  1  B9 4E 9D                 lda AreaDataAddrHigh,y
009C56  1  85 E8                    sta AreaDataHigh
009C58  1  A0 00                    ldy #$00                 ;load first byte of header
009C5A  1  B1 E7                    lda (AreaData),y
009C5C  1  48                       pha                      ;save it to the stack for now
009C5D  1  29 07                    and #%00000111           ;save 3 LSB for foreground scenery or bg color control
009C5F  1  C9 04                    cmp #$04
009C61  1  90 05                    bcc StoreFore
009C63  1  8D 44 07                 sta BackgroundColorCtrl  ;if 4 or greater, save value here as bg color control
009C66  1  A9 00                    lda #$00
009C68  1  8D 41 07     StoreFore:  sta ForegroundScenery    ;if less, save value here as foreground scenery
009C6B  1  68                       pla                      ;pull byte from stack and push it back
009C6C  1  48                       pha
009C6D  1  29 38                    and #%00111000           ;save player entrance control bits
009C6F  1  4A                       lsr                      ;shift bits over to LSBs
009C70  1  4A                       lsr
009C71  1  4A                       lsr
009C72  1  8D 10 07                 sta PlayerEntranceCtrl       ;save value here as player entrance control
009C75  1  68                       pla                      ;pull byte again but do not push it back
009C76  1  29 C0                    and #%11000000           ;save 2 MSB for game timer setting
009C78  1  18                       clc
009C79  1  2A                       rol                      ;rotate bits over to LSBs
009C7A  1  2A                       rol
009C7B  1  2A                       rol
009C7C  1  8D 15 07                 sta GameTimerSetting     ;save value here as game timer setting
009C7F  1  C8                       iny
009C80  1  B1 E7                    lda (AreaData),y         ;load second byte of header
009C82  1  48                       pha                      ;save to stack
009C83  1  29 0F                    and #%00001111           ;mask out all but lower nybble
009C85  1  8D 27 07                 sta TerrainControl
009C88  1  68                       pla                      ;pull and push byte to copy it to A
009C89  1  48                       pha
009C8A  1  29 30                    and #%00110000           ;save 2 MSB for background scenery type
009C8C  1  4A                       lsr
009C8D  1  4A                       lsr                      ;shift bits to LSBs
009C8E  1  4A                       lsr
009C8F  1  4A                       lsr
009C90  1  8D 42 07                 sta BackgroundScenery    ;save as background scenery
009C93  1  68                       pla
009C94  1  29 C0                    and #%11000000
009C96  1  18                       clc
009C97  1  2A                       rol                      ;rotate bits over to LSBs
009C98  1  2A                       rol
009C99  1  2A                       rol
009C9A  1  C9 03                    cmp #%00000011           ;if set to 3, store here
009C9C  1  D0 05                    bne StoreStyle           ;and nullify other value
009C9E  1  8D 43 07                 sta CloudTypeOverride    ;otherwise store value in other place
009CA1  1  A9 00                    lda #$00
009CA3  1  8D 33 07     StoreStyle: sta AreaStyle
009CA6  1  A5 E7                    lda AreaDataLow          ;increment area data address by 2 bytes
009CA8  1  18                       clc
009CA9  1  69 02                    adc #$02
009CAB  1  85 E7                    sta AreaDataLow
009CAD  1  A5 E8                    lda AreaDataHigh
009CAF  1  69 00                    adc #$00
009CB1  1  85 E8                    sta AreaDataHigh
009CB3  1  60                       rts
