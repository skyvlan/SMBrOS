0082F8  1  8D 6A 07                   sta PrimaryHardMode         ;hard mode must be on as well
0082FB  1  A9 00                      lda #$00
0082FD  1  8D 72 07                   sta OperMode_Task           ;set game mode here, and clear demo timer
008300  1  8D A2 07                   sta DemoTimer
008303  1  A2 17                      ldx #$17
008305  1  A9 00                      lda #$00
