0096F2  1               ScrollLockObject_Warp:
0096F2  1  A2 04                 ldx #$04            ;load value of 4 for game text routine as default
0096F4  1  AD 5F 07              lda WorldNumber     ;warp zone (4-3-2), then check world number
0096F7  1  F0 08                 beq WarpNum
0096F9  1  E8                    inx                 ;if world number > 1, increment for next warp zone (5)
0096FA  1  AC 4E 07              ldy AreaType        ;check area type
0096FD  1  88                    dey
0096FE  1  D0 01                 bne WarpNum         ;if ground area type, increment for last warp zone
009700  1  E8                    inx                 ;(8-7-6) and move on
009701  1  8A           WarpNum: txa
009702  1  8D D6 06              sta WarpZoneControl ;store number here to be used by warp zone routine
009705  1  20 08 88              jsr WriteGameText   ;print text and warp zone numbers
009708  1  A9 0D                 lda #PiranhaPlant
00970A  1  20 16 97              jsr KillEnemies     ;load identifier for piranha plants and do sub
