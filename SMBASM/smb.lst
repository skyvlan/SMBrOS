00F367  1  AC C0 07               ldy DAC_Counter        ;load some sort of counter
00F36A  1  A5 F4                  lda AreaMusicBuffer
00F36C  1  29 03                  and #%00000011         ;check for specific music
00F36E  1  F0 07                  beq NoIncDAC
00F370  1  EE C0 07               inc DAC_Counter        ;increment and check counter
00F373  1  C0 30                  cpy #$30
00F375  1  90 06                  bcc StrWave            ;if not there yet, just store it
00F377  1  98           NoIncDAC: tya
00F378  1  F0 03                  beq StrWave            ;if we are at zero, do not decrement
00F37A  1  CE C0 07               dec DAC_Counter        ;decrement counter
00F37D  1  8C 11 40     StrWave:  sty SND_DELTA_REG+1    ;store into DMC load register (??)
