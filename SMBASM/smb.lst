00E4B3  1  18                  clc
00E4B4  1  69 08               adc #$08           ;add eight pixels
00E4B6  1  C8                  iny
00E4B7  1  C8                  iny                ;move offset four bytes forward
00E4B8  1  C8                  iny
00E4B9  1  C8                  iny
