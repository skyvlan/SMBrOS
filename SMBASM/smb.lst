00E0FE  1               ;$00 - used to store bitmask (not used but initialized here)
00E0FE  1               ;$eb - used in DoEnemySideCheck as counter and to compare moving directions
00E0FE  1               
00E0FE  1               DoEnemySideCheck:
00E0FE  1  B5 CF                  lda Enemy_Y_Position,x     ;if enemy within status bar, branch to leave
00E100  1  C9 20                  cmp #$20                   ;because there's nothing there that impedes movement
00E102  1  90 1F                  bcc ExESdeC
00E104  1  A0 16                  ldy #$16                   ;start by finding block to the left of enemy ($00,$14)
00E106  1  A9 02                  lda #$02                   ;set value here in what is also used as
00E108  1  85 EB                  sta $eb                    ;OAM data offset
00E10A  1  A5 EB        SdeCLoop: lda $eb                    ;check value
00E10C  1  D5 46                  cmp Enemy_MovingDir,x      ;compare value against moving direction
00E10E  1  D0 0C                  bne NextSdeC               ;branch if different and do not seek block there
00E110  1  A9 01                  lda #$01                   ;set flag in A for save horizontal coordinate
00E112  1  20 88 E3               jsr BlockBufferChk_Enemy   ;find block to left or right of enemy object
00E115  1  F0 05                  beq NextSdeC               ;if nothing found, branch
00E117  1  20 B5 E1               jsr ChkForNonSolids        ;check for non-solid blocks
00E11A  1  D0 08                  bne ChkForBump_HammerBroJ  ;branch if not found
00E11C  1  C6 EB        NextSdeC: dec $eb                    ;move to the next direction
00E11E  1  C8                     iny
00E11F  1  C0 18                  cpy #$18                   ;increment Y, loop only if Y < $18, thus we check
00E121  1  90 E7                  bcc SdeCLoop               ;enemy ($00, $14) and ($10, $14) pixel coordinates
00E123  1  60           ExESdeC:  rts
00E124  1               
00E124  1               ChkForBump_HammerBroJ:
00E124  1  E0 05                cpx #$05               ;check if we're on the special use slot
00E126  1  F0 09                beq NoBump             ;and if so, branch ahead and do not play sound
00E128  1  B5 1E                lda Enemy_State,x      ;if enemy state d7 not set, branch
00E12A  1  0A                   asl                    ;ahead and do not play sound
00E12B  1  90 04                bcc NoBump
00E12D  1  A9 02                lda #Sfx_Bump          ;otherwise, play bump sound
00E12F  1  85 FF                sta Square1SoundQueue  ;sound will never be played if branching from ChkForRedKoopa
00E131  1  B5 16        NoBump: lda Enemy_ID,x         ;check for hammer bro
00E133  1  C9 05                cmp #$05
00E135  1  D0 09                bne InvEnemyDir        ;branch if not found
00E137  1  A9 00                lda #$00
00E139  1  85 00                sta $00                ;initialize value here for bitmask
00E13B  1  A0 FA                ldy #$fa               ;load default vertical speed for jumping
00E13D  1  4C 37 CA             jmp SetHJ              ;jump to code that makes hammer bro jump
