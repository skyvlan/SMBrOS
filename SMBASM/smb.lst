009237  1               ;-------------------------------------------------------------------------------------
009237  1               
009237  1               RunGameOver:
009237  1  A9 00              lda #$00              ;reenable screen
009239  1  8D 74 07           sta DisableScreenFlag
00923C  1  AD FC 06           lda SavedJoypad1Bits  ;check controller for start pressed
00923F  1  29 10              and #Start_Button
009241  1  D0 05              bne TerminateGame
009243  1  AD A0 07           lda ScreenTimer       ;if not pressed, wait for
009246  1  D0 39              bne GameIsOn          ;screen timer to expire
009248  1               TerminateGame:
009248  1  A9 80              lda #Silence          ;silence music
00924A  1  85 FC              sta EventMusicQueue
00924C  1  20 82 92           jsr TransposePlayers  ;check if other player can keep
00924F  1  90 13              bcc ContinueGame      ;going, and do so if possible
009251  1  AD 5F 07           lda WorldNumber       ;otherwise put world number of current
009254  1  8D FD 07           sta ContinueWorld     ;player into secret continue function variable
009257  1  A9 00              lda #$00
009259  1  0A                 asl                   ;residual ASL instruction
00925A  1  8D 72 07           sta OperMode_Task     ;reset all modes to title screen and
00925D  1  8D A0 07           sta ScreenTimer       ;leave
009260  1  8D 70 07           sta OperMode
009263  1  60                 rts
009264  1               
009264  1               ContinueGame:
009264  1  20 03 9C                jsr LoadAreaPointer       ;update level pointer with
009267  1  A9 01                   lda #$01                  ;actual world and area numbers, then
009269  1  8D 54 07                sta PlayerSize            ;reset player's size, status, and
00926C  1  EE 57 07                inc FetchNewGameTimerFlag ;set game timer flag to reload
00926F  1  A9 00                   lda #$00                  ;game timer from header
009271  1  8D 47 07                sta TimerControl          ;also set flag for timers to count again
009274  1  8D 56 07                sta PlayerStatus
009277  1  85 0E                   sta GameEngineSubroutine  ;reset task for game core
009279  1  8D 72 07                sta OperMode_Task         ;set modes and leave
00927C  1  A9 01                   lda #$01                  ;if in game over mode, switch back to
00927E  1  8D 70 07                sta OperMode              ;game mode, because game is still on
009281  1  60           GameIsOn:  rts
009282  1               
009282  1               TransposePlayers:
009282  1  38                      sec                       ;set carry flag by default to end game
009283  1  AD 7A 07                lda NumberOfPlayers       ;if only a 1 player game, leave
009286  1  F0 21                   beq ExTrans
009288  1  AD 61 07                lda OffScr_NumberofLives  ;does offscreen player have any lives left?
00928B  1  30 1C                   bmi ExTrans               ;branch if not
00928D  1  AD 53 07                lda CurrentPlayer         ;invert bit to update
009290  1  49 01                   eor #%00000001            ;which player is on the screen
009292  1  8D 53 07                sta CurrentPlayer
009295  1  A2 06                   ldx #$06
009297  1  BD 5A 07     TransLoop: lda OnscreenPlayerInfo,x    ;transpose the information
00929A  1  48                      pha                         ;of the onscreen player
00929B  1  BD 61 07                lda OffscreenPlayerInfo,x   ;with that of the offscreen player
00929E  1  9D 5A 07                sta OnscreenPlayerInfo,x
0092A1  1  68                      pla
0092A2  1  9D 61 07                sta OffscreenPlayerInfo,x
0092A5  1  CA                      dex
0092A6  1  10 EF                   bpl TransLoop
0092A8  1  18                      clc            ;clear carry flag to get game going
0092A9  1  60           ExTrans:   rts
