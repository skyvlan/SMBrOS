00986F  1               WaterPipe:
00986F  1  20 BB 9B           jsr GetLrgObjAttrib     ;get row and lower nybble
009872  1  BC 30 07           ldy AreaObjectLength,x  ;get length (residual code, water pipe is 1 col thick)
009875  1  A6 07              ldx $07                 ;get row
009877  1  A9 6B              lda #$6b
009879  1  9D A1 06           sta MetatileBuffer,x    ;draw something here and below it
00987C  1  A9 6C              lda #$6c
00987E  1  9D A2 06           sta MetatileBuffer+1,x
009881  1  60                 rts
009882  1               
009882  1               ;--------------------------------
009882  1               ;$05 - used to store length of vertical shaft in RenderSidewaysPipe
009882  1               ;$06 - used to store leftover horizontal length in RenderSidewaysPipe
009882  1               ; and vertical length in VerticalPipe and GetPipeHeight
009882  1               
009882  1               IntroPipe:
009882  1  A0 03                       ldy #$03                 ;check if length set, if not set, set it
009884  1  20 AF 9B                    jsr ChkLrgObjFixedLength
009887  1  A0 0A                       ldy #$0a                 ;set fixed value and render the sideways part
009889  1  20 B3 98                    jsr RenderSidewaysPipe
00988C  1  B0 10                       bcs NoBlankP             ;if carry flag set, not time to draw vertical pipe part
00988E  1  A2 06                       ldx #$06                 ;blank everything above the vertical pipe part
009890  1  A9 00        VPipeSectLoop: lda #$00                 ;all the way to the top of the screen
009892  1  9D A1 06                    sta MetatileBuffer,x     ;because otherwise it will look like exit pipe
009895  1  CA                          dex
009896  1  10 F8                       bpl VPipeSectLoop
009898  1  B9 DD 98                    lda VerticalPipeData,y   ;draw the end of the vertical pipe part
00989B  1  8D A8 06                    sta MetatileBuffer+7
00989E  1  60           NoBlankP:      rts
00989F  1               
00989F  1               SidePipeShaftData:
00989F  1  15 14              .byte $15, $14  ;used to control whether or not vertical pipe shaft
0098A1  1  00 00              .byte $00, $00  ;is drawn, and if so, controls the metatile number
0098A3  1               SidePipeTopPart:
0098A3  1  15 1E              .byte $15, $1e  ;top part of sideways part of pipe
0098A5  1  1D 1C              .byte $1d, $1c
0098A7  1               SidePipeBottomPart:
0098A7  1  15 21              .byte $15, $21  ;bottom part of sideways part of pipe
0098A9  1  20 1F              .byte $20, $1f
0098AB  1               
0098AB  1               ExitPipe:
0098AB  1  A0 03              ldy #$03                 ;check if length set, if not set, set it
0098AD  1  20 AF 9B           jsr ChkLrgObjFixedLength
0098B0  1  20 BB 9B           jsr GetLrgObjAttrib      ;get vertical length, then plow on through RenderSidewaysPipe
0098B3  1               
0098B3  1               RenderSidewaysPipe:
0098B3  1  88                         dey                       ;decrement twice to make room for shaft at bottom
0098B4  1  88                         dey                       ;and store here for now as vertical length
0098B5  1  84 05                      sty $05
0098B7  1  BC 30 07                   ldy AreaObjectLength,x    ;get length left over and store here
0098BA  1  84 06                      sty $06
0098BC  1  A6 05                      ldx $05                   ;get vertical length plus one, use as buffer offset
0098BE  1  E8                         inx
0098BF  1  B9 9F 98                   lda SidePipeShaftData,y   ;check for value $00 based on horizontal offset
0098C2  1  C9 00                      cmp #$00
0098C4  1  F0 08                      beq DrawSidePart          ;if found, do not draw the vertical pipe shaft
0098C6  1  A2 00                      ldx #$00
0098C8  1  A4 05                      ldy $05                   ;init buffer offset and get vertical length
0098CA  1  20 7D 9B                   jsr RenderUnderPart       ;and render vertical shaft using tile number in A
0098CD  1  18                         clc                       ;clear carry flag to be used by IntroPipe
0098CE  1  A4 06        DrawSidePart: ldy $06                   ;render side pipe part at the bottom
0098D0  1  B9 A3 98                   lda SidePipeTopPart,y
0098D3  1  9D A1 06                   sta MetatileBuffer,x      ;note that the pipe parts are stored
0098D6  1  B9 A7 98                   lda SidePipeBottomPart,y  ;backwards horizontally
0098D9  1  9D A2 06                   sta MetatileBuffer+1,x
0098DC  1  60                         rts
0098DD  1               
0098DD  1               VerticalPipeData:
0098DD  1  11 10              .byte $11, $10 ;used by pipes that lead somewhere
0098DF  1  15 14              .byte $15, $14
0098E1  1  13 12              .byte $13, $12 ;used by decoration pipes
0098E3  1  15 14              .byte $15, $14
0098E5  1               
0098E5  1               VerticalPipe:
0098E5  1  20 39 99               jsr GetPipeHeight
0098E8  1  A5 00                  lda $00                  ;check to see if value was nullified earlier
0098EA  1  F0 04                  beq WarpPipe             ;(if d3, the usage control bit of second byte, was set)
0098EC  1  C8                     iny
0098ED  1  C8                     iny
0098EE  1  C8                     iny
0098EF  1  C8                     iny                      ;add four if usage control bit was not set
0098F0  1  98           WarpPipe: tya                      ;save value in stack
0098F1  1  48                     pha
0098F2  1  AD 60 07               lda AreaNumber
0098F5  1  0D 5F 07               ora WorldNumber          ;if at world 1-1, do not add piranha plant ever
0098F8  1  F0 2B                  beq DrawPipe
0098FA  1  BC 30 07               ldy AreaObjectLength,x   ;if on second column of pipe, branch
0098FD  1  F0 26                  beq DrawPipe             ;(because we only need to do this once)
0098FF  1  20 4A 99               jsr FindEmptyEnemySlot   ;check for an empty moving data buffer space
009902  1  B0 21                  bcs DrawPipe             ;if not found, too many enemies, thus skip
009904  1  20 CB 9B               jsr GetAreaObjXPosition  ;get horizontal pixel coordinate
009907  1  18                     clc
009908  1  69 08                  adc #$08                 ;add eight to put the piranha plant in the center
00990A  1  95 87                  sta Enemy_X_Position,x   ;store as enemy's horizontal coordinate
00990C  1  AD 25 07               lda CurrentPageLoc       ;add carry to current page number
00990F  1  69 00                  adc #$00
009911  1  95 6E                  sta Enemy_PageLoc,x      ;store as enemy's page coordinate
