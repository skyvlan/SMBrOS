00829F  1  E8                         inx
0082A0  1  8A                         txa
0082A1  1  29 07                      and #%00000111              ;mask out higher bits
0082A3  1  8D 6B 07                   sta WorldSelectNumber       ;store as current world select number
0082A6  1  20 0E 83                   jsr GoContinue
0082A9  1  BD 3F 82     UpdateShroom: lda WSelectBufferTemplate,x ;write template for world select in vram buffer
0082AC  1  9D 00 03                   sta VRAM_Buffer1-1,x        ;do this until all bytes are written
0082AF  1  E8                         inx
0082B0  1  E0 06                      cpx #$06
0082B2  1  30 F5                      bmi UpdateShroom
0082B4  1  AC 5F 07                   ldy WorldNumber             ;get world number from variable and increment for
0082B7  1  C8                         iny                         ;proper display, and put in blank byte before
0082B8  1  8C 04 03                   sty VRAM_Buffer1+3          ;null terminator
