0096C5  1               ;(these apply to all area object subroutines in this section unless otherwise stated)
0096C5  1               ;$00 - used to store offset used to find object code
0096C5  1               ;$07 - starts with adder from area parser, used to store row offset
0096C5  1               
0096C5  1               AlterAreaAttributes:
0096C5  1  BC 2D 07              ldy AreaObjOffsetBuffer,x ;load offset for level object data saved in buffer
0096C8  1  C8                    iny                       ;load second byte
0096C9  1  B1 E7                 lda (AreaData),y
0096CB  1  48                    pha                       ;save in stack for now
0096CC  1  29 40                 and #%01000000
0096CE  1  D0 12                 bne Alter2                ;branch if d6 is set
0096D0  1  68                    pla
0096D1  1  48                    pha                       ;pull and push offset to copy to A
0096D2  1  29 0F                 and #%00001111            ;mask out high nybble and store as
0096D4  1  8D 27 07              sta TerrainControl        ;new terrain height type bits
0096D7  1  68                    pla
0096D8  1  29 30                 and #%00110000            ;pull and mask out all but d5 and d4
0096DA  1  4A                    lsr                       ;move bits to lower nybble and store
0096DB  1  4A                    lsr                       ;as new background scenery bits
0096DC  1  4A                    lsr
0096DD  1  4A                    lsr
0096DE  1  8D 42 07              sta BackgroundScenery     ;then leave
0096E1  1  60                    rts
0096E2  1  68           Alter2:  pla
0096E3  1  29 07                 and #%00000111            ;mask out all but 3 LSB
0096E5  1  C9 04                 cmp #$04                  ;if four or greater, set color control bits
0096E7  1  90 05                 bcc SetFore               ;and nullify foreground scenery bits
0096E9  1  8D 44 07              sta BackgroundColorCtrl
0096EC  1  A9 00                 lda #$00
0096EE  1  8D 41 07     SetFore: sta ForegroundScenery     ;otherwise set new foreground scenery bits
0096F1  1  60                    rts
