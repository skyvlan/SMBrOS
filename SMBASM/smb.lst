00D2D9  1  A9 00              lda #$00                 ;initialize enemy frenzy buffer
00D2DB  1  8D CB 06           sta EnemyFrenzyBuffer
00D2DE  1  AD 46 07           lda StarFlagTaskControl  ;check star flag object task number here
00D2E1  1  C9 05              cmp #$05                 ;if greater than 5, branch to exit
00D2E3  1  B0 2C              bcs StarFlagExit
