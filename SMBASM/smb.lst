00B91E  1               Setup_Vine:
00B91E  1  A9 2F                lda #VineObject          ;load identifier for vine object
00B920  1  95 16                sta Enemy_ID,x           ;store in buffer
00B922  1  A9 01                lda #$01
00B924  1  95 0F                sta Enemy_Flag,x         ;set flag for enemy object buffer
00B926  1  B9 76 00             lda Block_PageLoc,y
00B929  1  95 6E                sta Enemy_PageLoc,x      ;copy page location from previous object
00B92B  1  B9 8F 00             lda Block_X_Position,y
00B92E  1  95 87                sta Enemy_X_Position,x   ;copy horizontal coordinate from previous object
00B930  1  B9 D7 00             lda Block_Y_Position,y
00B933  1  95 CF                sta Enemy_Y_Position,x   ;copy vertical coordinate from previous object
00B935  1  AC 98 03             ldy VineFlagOffset       ;load vine flag/offset to next available vine slot
00B938  1  D0 03                bne NextVO               ;if set at all, don't bother to store vertical
00B93A  1  8D 9D 03             sta VineStart_Y_Position ;otherwise store vertical coordinate here
00B93D  1  8A           NextVO: txa                      ;store object offset to next available vine slot
00B93E  1  99 9A 03             sta VineObjOffset,y      ;using vine flag as offset
00B941  1  EE 98 03             inc VineFlagOffset       ;increment vine flag offset
00B944  1  A9 04                lda #Sfx_GrowVine
00B946  1  85 FE                sta Square2SoundQueue    ;load vine grow sound
00B948  1  60                   rts
00B949  1               
00B949  1               ;-------------------------------------------------------------------------------------
00B949  1               ;$06-$07 - used as address to block buffer data
00B949  1               ;$02 - used as vertical high nybble of block buffer offset
00B949  1               
00B949  1               VineHeightData:
00B949  1  30 60              .byte $30, $60
00B94B  1               
00B94B  1               VineObjectHandler:
00B94B  1  E0 05                   cpx #$05                  ;check enemy offset for special use slot
00B94D  1  D0 68                   bne ExitVH                ;if not in last slot, branch to leave
00B94F  1  AC 98 03                ldy VineFlagOffset
00B952  1  88                      dey                       ;decrement vine flag in Y, use as offset
00B953  1  AD 99 03                lda VineHeight
00B956  1  D9 49 B9                cmp VineHeightData,y      ;if vine has reached certain height,
00B959  1  F0 0F                   beq RunVSubs              ;branch ahead to skip this part
00B95B  1  A5 09                   lda FrameCounter          ;get frame counter
00B95D  1  4A                      lsr                       ;shift d1 into carry
00B95E  1  4A                      lsr
00B95F  1  90 09                   bcc RunVSubs              ;if d1 not set (2 frames every 4) skip this part
00B961  1  A5 D4                   lda Enemy_Y_Position+5
00B963  1  E9 01                   sbc #$01                  ;subtract vertical position of vine
00B965  1  85 D4                   sta Enemy_Y_Position+5    ;one pixel every frame it's time
00B967  1  EE 99 03                inc VineHeight            ;increment vine height
00B96A  1  AD 99 03     RunVSubs:  lda VineHeight            ;if vine still very small,
00B96D  1  C9 08                   cmp #$08                  ;branch to leave
00B96F  1  90 46                   bcc ExitVH
00B971  1  20 52 F1                jsr RelativeEnemyPosition ;get relative coordinates of vine,
00B974  1  20 AF F1                jsr GetEnemyOffscreenBits ;and any offscreen bits
00B977  1  A0 00                   ldy #$00                  ;initialize offset used in draw vine sub
00B979  1  20 35 E4     VDrawLoop: jsr DrawVine              ;draw vine
00B97C  1  C8                      iny                       ;increment offset
00B97D  1  CC 98 03                cpy VineFlagOffset        ;if offset in Y and offset here
00B980  1  D0 F7                   bne VDrawLoop             ;do not yet match, loop back to draw more vine
00B982  1  AD D1 03                lda Enemy_OffscreenBits
00B985  1  29 0C                   and #%00001100            ;mask offscreen bits
00B987  1  F0 10                   beq WrCMTile              ;if none of the saved offscreen bits set, skip ahead
00B989  1  88                      dey                       ;otherwise decrement Y to get proper offset again
00B98A  1  BE 9A 03     KillVine:  ldx VineObjOffset,y       ;get enemy object offset for this vine object
00B98D  1  20 98 C9                jsr EraseEnemyObject      ;kill this vine object
00B990  1  88                      dey                       ;decrement Y
00B991  1  10 F7                   bpl KillVine              ;if any vine objects left, loop back to kill it
00B993  1  8D 98 03                sta VineFlagOffset        ;initialize vine flag/offset
00B996  1  8D 99 03                sta VineHeight            ;initialize vine height
00B999  1  AD 99 03     WrCMTile:  lda VineHeight            ;check vine height
00B99C  1  C9 20                   cmp #$20                  ;if vine small (less than 32 pixels tall)
00B99E  1  90 17                   bcc ExitVH                ;then branch ahead to leave
00B9A0  1  A2 06                   ldx #$06                  ;set offset in X to last enemy slot
00B9A2  1  A9 01                   lda #$01                  ;set A to obtain horizontal in $04, but we don't care
00B9A4  1  A0 1B                   ldy #$1b                  ;set Y to offset to get block at ($04, $10) of coordinates
00B9A6  1  20 F0 E3                jsr BlockBufferCollision  ;do a sub to get block buffer address set, return contents
00B9A9  1  A4 02                   ldy $02
00B9AB  1  C0 D0                   cpy #$d0                  ;if vertical high nybble offset beyond extent of
00B9AD  1  B0 08                   bcs ExitVH                ;current block buffer, branch to leave, do not write
00B9AF  1  B1 06                   lda ($06),y               ;otherwise check contents of block buffer at
00B9B1  1  D0 04                   bne ExitVH                ;current offset, if not empty, branch to leave
00B9B3  1  A9 26                   lda #$26
00B9B5  1  91 06                   sta ($06),y               ;otherwise, write climbing metatile to block buffer
00B9B7  1  A6 08        ExitVH:    ldx ObjectOffset          ;get enemy object offset and leave
00B9B9  1  60                      rts
