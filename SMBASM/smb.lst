008245  1               GameMenuRoutine:
008245  1  A0 00                      ldy #$00
008247  1  AD FC 06                   lda SavedJoypad1Bits        ;check to see if either player pressed
00824A  1  0D FD 06                   ora SavedJoypad2Bits        ;only the start button (either joypad)
00824D  1  C9 10                      cmp #Start_Button
00824F  1  F0 04                      beq StartGame
008251  1  C9 90                      cmp #A_Button+Start_Button  ;check to see if A + start was pressed
008253  1  D0 03                      bne ChkSelect               ;if not, branch to check select button
008255  1  4C D8 82     StartGame:    jmp ChkContinue             ;if either start or A + start, execute here
008258  1  C9 20        ChkSelect:    cmp #Select_Button          ;check to see if the select button was pressed
