00C124  1  8D DA 06               sta MultiLoopPassCntr
00C127  1  8D D9 06               sta MultiLoopCorrectCntr
00C12A  1  A9 00        InitLCmd: lda #$00                  ;initialize loop command flag
00C12C  1  8D 45 07               sta LoopCommand
