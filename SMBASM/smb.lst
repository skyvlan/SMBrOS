00CAE5  1               MoveDefeatedEnemy:
00CAE5  1  20 63 BF           jsr MoveD_EnemyVertically      ;execute sub to move defeated enemy downwards
00CAE8  1  4C 02 BF           jmp MoveEnemyHorizontally      ;now move defeated enemy horizontally
00CAEB  1               
00CAEB  1               ChkKillGoomba:
00CAEB  1  C9 0E                cmp #$0e              ;check to see if enemy timer has reached
00CAED  1  D0 09                bne NKGmba            ;a certain point, and branch to leave if not
00CAEF  1  B5 16                lda Enemy_ID,x
00CAF1  1  C9 06                cmp #Goomba           ;check for goomba object
00CAF3  1  D0 03                bne NKGmba            ;branch if not found
00CAF5  1  20 98 C9             jsr EraseEnemyObject  ;otherwise, kill this goomba object
00CAF8  1  60           NKGmba: rts                   ;leave!
