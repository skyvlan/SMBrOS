00B35A  1               ;-------------------------------------------------------------------------------------
00B35A  1               ;$00 - used by ClimbingSub to store high vertical adder
00B35A  1               
00B35A  1               OnGroundStateSub:
00B35A  1  20 8F B5              jsr GetPlayerAnimSpeed     ;do a sub to set animation frame timing
00B35D  1  A5 0C                 lda Left_Right_Buttons
00B35F  1  F0 02                 beq GndMove                ;if left/right controller bits not set, skip instruction
00B361  1  85 33                 sta PlayerFacingDir        ;otherwise set new facing direction
00B363  1  20 CC B5     GndMove: jsr ImposeFriction         ;do a sub to impose friction on player's walk/run
00B366  1  20 09 BF              jsr MovePlayerHorizontally ;do another sub to move player horizontally
00B369  1  8D FF 06              sta Player_X_Scroll        ;set returned value as player's movement speed for scroll
00B36C  1  60                    rts
00B36D  1               
00B36D  1               ;--------------------------------
00B36D  1               
00B36D  1               FallingSub:
00B36D  1  AD 0A 07           lda VerticalForceDown
00B370  1  8D 09 07           sta VerticalForce      ;dump vertical movement force for falling into main one
00B373  1  4C AC B3           jmp LRAir              ;movement force, then skip ahead to process left/right movement
00B376  1               
00B376  1               ;--------------------------------
00B376  1               
00B376  1               JumpSwimSub:
00B376  1  A4 9F                  ldy Player_Y_Speed         ;if player's vertical speed zero
00B378  1  10 13                  bpl DumpFall               ;or moving downwards, branch to falling
00B37A  1  A5 0A                  lda A_B_Buttons
00B37C  1  29 80                  and #A_Button              ;check to see if A button is being pressed
00B37E  1  25 0D                  and PreviousA_B_Buttons    ;and was pressed in previous frame
00B380  1  D0 11                  bne ProcSwim               ;if so, branch elsewhere
00B382  1  AD 08 07               lda JumpOrigin_Y_Position  ;get vertical position player jumped from
00B385  1  38                     sec
00B386  1  E5 CE                  sbc Player_Y_Position      ;subtract current from original vertical coordinate
00B388  1  CD 06 07               cmp DiffToHaltJump         ;compare to value set here to see if player is in mid-jump
00B38B  1  90 06                  bcc ProcSwim               ;or just starting to jump, if just starting, skip ahead
00B38D  1  AD 0A 07     DumpFall: lda VerticalForceDown      ;otherwise dump falling into main fractional
00B390  1  8D 09 07               sta VerticalForce
00B393  1  AD 04 07     ProcSwim: lda SwimmingFlag           ;if swimming flag not set,
00B396  1  F0 14                  beq LRAir                  ;branch ahead to last part
00B398  1  20 8F B5               jsr GetPlayerAnimSpeed     ;do a sub to get animation frame timing
00B39B  1  A5 CE                  lda Player_Y_Position
00B39D  1  C9 14                  cmp #$14                   ;check vertical position against preset value
00B39F  1  B0 05                  bcs LRWater                ;if not yet reached a certain position, branch ahead
00B3A1  1  A9 18                  lda #$18
00B3A3  1  8D 09 07               sta VerticalForce          ;otherwise set fractional
00B3A6  1  A5 0C        LRWater:  lda Left_Right_Buttons     ;check left/right controller bits (check for swimming)
00B3A8  1  F0 02                  beq LRAir                  ;if not pressing any, skip
00B3AA  1  85 33                  sta PlayerFacingDir        ;otherwise set facing direction accordingly
00B3AC  1  A5 0C        LRAir:    lda Left_Right_Buttons     ;check left/right controller bits (check for jumping/falling)
00B3AE  1  F0 03                  beq JSMove                 ;if not pressing any, skip
00B3B0  1  20 CC B5               jsr ImposeFriction         ;otherwise process horizontal movement
00B3B3  1  20 09 BF     JSMove:   jsr MovePlayerHorizontally ;do a sub to move player horizontally
00B3B6  1  8D FF 06               sta Player_X_Scroll        ;set player's speed here, to be used for scroll later
00B3B9  1  A5 0E                  lda GameEngineSubroutine
00B3BB  1  C9 0B                  cmp #$0b                   ;check for specific routine selected
00B3BD  1  D0 05                  bne ExitMov1               ;branch if not set to run
00B3BF  1  A9 28                  lda #$28
00B3C1  1  8D 09 07               sta VerticalForce          ;otherwise set fractional
00B3C4  1  4C 4D BF     ExitMov1: jmp MovePlayerVertically   ;jump to move player vertically, then leave
