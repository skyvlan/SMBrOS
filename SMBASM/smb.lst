00CBDC  1               MoveDefeatedBloober:
00CBDC  1  4C 8C BF           jmp MoveEnemySlowVert    ;jump to move defeated bloober downwards
00CBDF  1               
00CBDF  1               ProcSwimmingB:
00CBDF  1  B5 A0                lda BlooperMoveCounter,x  ;get enemy's movement counter
00CBE1  1  29 02                and #%00000010            ;check for d1 set
00CBE3  1  D0 37                bne ChkForFloatdown       ;branch if set
00CBE5  1  A5 09                lda FrameCounter
00CBE7  1  29 07                and #%00000111            ;get 3 LSB of frame counter
00CBE9  1  48                   pha                       ;and save it to the stack
00CBEA  1  B5 A0                lda BlooperMoveCounter,x  ;get enemy's movement counter
00CBEC  1  4A                   lsr                       ;check for d0 set
00CBED  1  B0 15                bcs SlowSwim              ;branch if set
00CBEF  1  68                   pla                       ;pull 3 LSB of frame counter from the stack
00CBF0  1  D0 11                bne BSwimE                ;branch to leave, execute code only every eighth frame
00CBF2  1  BD 34 04             lda Enemy_Y_MoveForce,x
00CBF5  1  18                   clc                       ;add to movement force to speed up swim
00CBF6  1  69 01                adc #$01
00CBF8  1  9D 34 04             sta Enemy_Y_MoveForce,x   ;set movement force
00CBFB  1  95 58                sta BlooperMoveSpeed,x    ;set as movement speed
00CBFD  1  C9 02                cmp #$02
00CBFF  1  D0 02                bne BSwimE                ;if certain horizontal speed, branch to leave
00CC01  1  F6 A0                inc BlooperMoveCounter,x  ;otherwise increment movement counter
00CC03  1  60           BSwimE: rts
00CC04  1               
00CC04  1               SlowSwim:
00CC04  1  68                  pla                      ;pull 3 LSB of frame counter from the stack
00CC05  1  D0 14               bne NoSSw                ;branch to leave, execute code only every eighth frame
00CC07  1  BD 34 04            lda Enemy_Y_MoveForce,x
00CC0A  1  38                  sec                      ;subtract from movement force to slow swim
00CC0B  1  E9 01               sbc #$01
00CC0D  1  9D 34 04            sta Enemy_Y_MoveForce,x  ;set movement force
00CC10  1  95 58               sta BlooperMoveSpeed,x   ;set as movement speed
00CC12  1  D0 07               bne NoSSw                ;if any speed, branch to leave
00CC14  1  F6 A0               inc BlooperMoveCounter,x ;otherwise increment movement counter
00CC16  1  A9 02               lda #$02
00CC18  1  9D 96 07            sta EnemyIntervalTimer,x ;set enemy's timer
00CC1B  1  60           NoSSw: rts                      ;leave
00CC1C  1               
00CC1C  1               ChkForFloatdown:
00CC1C  1  BD 96 07           lda EnemyIntervalTimer,x ;get enemy timer
00CC1F  1  F0 08              beq ChkNearPlayer        ;branch if expired
00CC21  1               
00CC21  1               Floatdown:
00CC21  1  A5 09              lda FrameCounter        ;get frame counter
00CC23  1  4A                 lsr                     ;check for d0 set
00CC24  1  B0 02              bcs NoFD                ;branch to leave on every other frame
00CC26  1  F6 CF              inc Enemy_Y_Position,x  ;otherwise increment vertical coordinate
00CC28  1  60           NoFD: rts                     ;leave
00CC29  1               
00CC29  1               ChkNearPlayer:
00CC29  1  B5 CF              lda Enemy_Y_Position,x    ;get vertical coordinate
00CC2B  1  69 10              adc #$10                  ;add sixteen pixels
00CC2D  1  C5 CE              cmp Player_Y_Position     ;compare result with player's vertical coordinate
00CC2F  1  90 F0              bcc Floatdown             ;if modified vertical less than player's, branch
00CC31  1  A9 00              lda #$00
00CC33  1  95 A0              sta BlooperMoveCounter,x  ;otherwise nullify movement counter
00CC35  1  60                 rts
