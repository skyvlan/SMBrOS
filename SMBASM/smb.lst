00F38D  1  A8                   tay
00F38E  1  B9 01 FF             lda FreqRegLookupTbl+1,y  ;use previous contents of A for sound reg offset
00F391  1  F0 0B                beq NoTone                ;if zero, then do not load
00F393  1  9D 02 40             sta SND_REGISTER+2,x      ;first byte goes into LSB of frequency divider
00F396  1  B9 00 FF             lda FreqRegLookupTbl,y    ;second byte goes into 3 MSB plus extra bit for
00F399  1  09 08                ora #%00001000            ;length counter
