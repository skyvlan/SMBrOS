00CC4C  1  29 20                and #%00100000            ;for d5 set
00CC4E  1  F0 03                beq CCSwim                ;if not set, continue with movement code
00CC50  1  4C 8C BF             jmp MoveEnemySlowVert     ;otherwise jump to move defeated cheep-cheep downwards
00CC53  1  85 03        CCSwim: sta $03                   ;save enemy state in $03
00CC55  1  B5 16                lda Enemy_ID,x            ;get enemy identifier
00CC57  1  38                   sec
00CC58  1  E9 0A                sbc #$0a                  ;subtract ten for cheep-cheep identifiers
00CC5A  1  A8                   tay                       ;use as offset
00CC5B  1  B9 46 CC             lda SwimCCXMoveData,y     ;load value here
00CC5E  1  85 02                sta $02
00CC60  1  BD 01 04             lda Enemy_X_MoveForce,x   ;load horizontal force
00CC63  1  38                   sec
00CC64  1  E5 02                sbc $02                   ;subtract preset value from horizontal force
00CC66  1  9D 01 04             sta Enemy_X_MoveForce,x   ;store as new horizontal force
00CC69  1  B5 87                lda Enemy_X_Position,x    ;get horizontal coordinate
00CC6B  1  E9 00                sbc #$00                  ;subtract borrow (thus moving it slowly)
00CC6D  1  95 87                sta Enemy_X_Position,x    ;and save as new horizontal coordinate
00CC6F  1  B5 6E                lda Enemy_PageLoc,x
00CC71  1  E9 00                sbc #$00                  ;subtract borrow again, this time from the
00CC73  1  95 6E                sta Enemy_PageLoc,x       ;page location, then save
00CC75  1  A9 20                lda #$20
00CC77  1  85 02                sta $02                   ;save new value here
00CC79  1  E0 02                cpx #$02                  ;check enemy object offset
00CC7B  1  90 49                bcc ExSwCC                ;if in first or second slot, branch to leave
00CC7D  1  B5 58                lda CheepCheepMoveMFlag,x ;check movement flag
00CC7F  1  C9 10                cmp #$10                  ;if movement speed set to $00,
00CC81  1  90 16                bcc CCSwimUpwards         ;branch to move upwards
00CC83  1  BD 17 04             lda Enemy_YMF_Dummy,x
00CC86  1  18                   clc
00CC87  1  65 02                adc $02                   ;add preset value to dummy variable to get carry
00CC89  1  9D 17 04             sta Enemy_YMF_Dummy,x     ;and save dummy
00CC8C  1  B5 CF                lda Enemy_Y_Position,x    ;get vertical coordinate
00CC8E  1  65 03                adc $03                   ;add carry to it plus enemy state to slowly move it downwards
00CC90  1  95 CF                sta Enemy_Y_Position,x    ;save as new vertical coordinate
00CC92  1  B5 B6                lda Enemy_Y_HighPos,x
00CC94  1  69 00                adc #$00                  ;add carry to page location and
00CC96  1  4C AC CC             jmp ChkSwimYPos           ;jump to end of movement code
00CC99  1               
00CC99  1               CCSwimUpwards:
00CC99  1  BD 17 04             lda Enemy_YMF_Dummy,x
00CC9C  1  38                   sec
00CC9D  1  E5 02                sbc $02                   ;subtract preset value to dummy variable to get borrow
00CC9F  1  9D 17 04             sta Enemy_YMF_Dummy,x     ;and save dummy
00CCA2  1  B5 CF                lda Enemy_Y_Position,x    ;get vertical coordinate
00CCA4  1  E5 03                sbc $03                   ;subtract borrow to it plus enemy state to slowly move it upwards
00CCA6  1  95 CF                sta Enemy_Y_Position,x    ;save as new vertical coordinate
00CCA8  1  B5 B6                lda Enemy_Y_HighPos,x
00CCAA  1  E9 00                sbc #$00                  ;subtract borrow from page location
00CCAC  1               
00CCAC  1               ChkSwimYPos:
00CCAC  1  95 B6                sta Enemy_Y_HighPos,x     ;save new page location here
00CCAE  1  A0 00                ldy #$00                  ;load movement speed to upwards by default
00CCB0  1  B5 CF                lda Enemy_Y_Position,x    ;get vertical coordinate
00CCB2  1  38                   sec
00CCB3  1  FD 34 04             sbc CheepCheepOrigYPos,x  ;subtract original coordinate from current
00CCB6  1  10 07                bpl YPDiff                ;if result positive, skip to next part
00CCB8  1  A0 10                ldy #$10                  ;otherwise load movement speed to downwards
00CCBA  1  49 FF                eor #$ff
00CCBC  1  18                   clc                       ;get two's compliment of result
00CCBD  1  69 01                adc #$01                  ;to obtain total difference of original vs. current
00CCBF  1  C9 0F        YPDiff: cmp #$0f                  ;if difference between original vs. current vertical
00CCC1  1  90 03                bcc ExSwCC                ;coordinates < 15 pixels, leave movement speed alone
00CCC3  1  98                   tya
00CCC4  1  95 58                sta CheepCheepMoveMFlag,x ;otherwise change movement speed
00CCC6  1  60           ExSwCC: rts                       ;leave
