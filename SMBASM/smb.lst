008900  1  C8                       iny
008901  1  B1 06                    lda ($06),y                  ;now get the second (bottom left or bottom right) and store
008903  1  9D 45 03                 sta VRAM_Buffer2+4,x
008906  1  A4 04                    ldy $04                      ;get current attribute row
008908  1  A5 05                    lda $05                      ;get LSB of current column where we're at, and
00890A  1  D0 0E                    bne RightCheck               ;branch if set (clear = left attrib, set = right)
00890C  1  A5 01                    lda $01                      ;get current row we're rendering
00890E  1  4A                       lsr                          ;branch if LSB set (clear = top left, set = bottom left)
00890F  1  B0 19                    bcs LLeft
008911  1  26 03                    rol $03                      ;rotate attribute bits 3 to the left
008913  1  26 03                    rol $03                      ;thus in d1-d0, for upper left square
008915  1  26 03                    rol $03
008917  1  4C 30 89                 jmp SetAttrib
00891A  1  A5 01        RightCheck: lda $01                      ;get LSB of current row we're rendering
00891C  1  4A                       lsr                          ;branch if set (clear = top right, set = bottom right)
00891D  1  B0 0F                    bcs NextMTRow
00891F  1  46 03                    lsr $03                      ;shift attribute bits 4 to the right
008921  1  46 03                    lsr $03                      ;thus in d3-d2, for upper right square
008923  1  46 03                    lsr $03
008925  1  46 03                    lsr $03
008927  1  4C 30 89                 jmp SetAttrib
