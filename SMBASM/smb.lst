008693  1               DisplayTimeUp:
008693  1  AD 59 07               lda GameTimerExpiredFlag  ;if game timer not expired, increment task
008696  1  F0 0A                  beq NoTimeUp              ;control 2 tasks forward, otherwise, stay here
008698  1  A9 00                  lda #$00
00869A  1  8D 59 07               sta GameTimerExpiredFlag  ;reset timer expiration flag
00869D  1  A9 02                  lda #$02                  ;output time-up screen to buffer
00869F  1  4C C7 86               jmp OutputInter
0086A2  1  EE 3C 07     NoTimeUp: inc ScreenRoutineTask     ;increment control task 2 tasks forward
0086A5  1  4C 45 87               jmp IncSubtask
0086A8  1               
0086A8  1               ;-------------------------------------------------------------------------------------
0086A8  1               
0086A8  1               DisplayIntermediate:
0086A8  1  AD 70 07                    lda OperMode                 ;check primary mode of operation
0086AB  1  F0 33                       beq NoInter                  ;if in title screen mode, skip this
0086AD  1  C9 03                       cmp #GameOverModeValue       ;are we in game over mode?
0086AF  1  F0 22                       beq GameOverInter            ;if so, proceed to display game over screen
0086B1  1  AD 52 07                    lda AltEntranceControl       ;otherwise check for mode of alternate entry
0086B4  1  D0 2A                       bne NoInter                  ;and branch if found
0086B6  1  AC 4E 07                    ldy AreaType                 ;check if we are on castle level
0086B9  1  C0 03                       cpy #$03                     ;and if so, branch (possibly residual)
0086BB  1  F0 05                       beq PlayerInter
0086BD  1  AD 69 07                    lda DisableIntermediate      ;if this flag is set, skip intermediate lives display
0086C0  1  D0 1E                       bne NoInter                  ;and jump to specific task, otherwise
0086C2  1  20 A4 EF     PlayerInter:   jsr DrawPlayer_Intermediate  ;put player in appropriate place for
0086C5  1  A9 01                       lda #$01                     ;lives display, then output lives display to buffer
0086C7  1  20 08 88     OutputInter:   jsr WriteGameText
0086CA  1  20 A5 88                    jsr ResetScreenTimer
0086CD  1  A9 00                       lda #$00
0086CF  1  8D 74 07                    sta DisableScreenFlag        ;reenable screen output
0086D2  1  60                          rts
0086D3  1  A9 12        GameOverInter: lda #$12                     ;set screen timer
0086D5  1  8D A0 07                    sta ScreenTimer
0086D8  1  A9 03                       lda #$03                     ;output game over screen to buffer
0086DA  1  20 08 88                    jsr WriteGameText
0086DD  1  4C 4E 87                    jmp IncModeTask_B
0086E0  1  A9 08        NoInter:       lda #$08                     ;set for specific task and leave
0086E2  1  8D 3C 07                    sta ScreenRoutineTask
0086E5  1  60                          rts
