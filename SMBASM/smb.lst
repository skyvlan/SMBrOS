00F22B  1               
00F22B  1               YOffscreenBitsData:
00F22B  1  00 08 0C 0E          .byte $00, $08, $0c, $0e
00F22F  1  0F 07 03 01          .byte $0f, $07, $03, $01
00F233  1  00                   .byte $00
00F234  1               
00F234  1               DefaultYOnscreenOfs:
00F234  1  04 00 04             .byte $04, $00, $04
00F237  1               
00F237  1               HighPosUnitData:
00F237  1  FF 00                .byte $ff, $00
00F239  1               
00F239  1               GetYOffscreenBits:
00F239  1  86 04                  stx $04                      ;save position in buffer to here
00F23B  1  A0 01                  ldy #$01                     ;start with top of screen
00F23D  1  B9 37 F2     YOfsLoop: lda HighPosUnitData,y        ;load coordinate for edge of vertical unit
00F240  1  38                     sec
00F241  1  F5 CE                  sbc SprObject_Y_Position,x   ;subtract from vertical coordinate of object
00F243  1  85 07                  sta $07                      ;store here
00F245  1  A9 01                  lda #$01                     ;subtract one from vertical high byte of object
00F247  1  F5 B5                  sbc SprObject_Y_HighPos,x
00F249  1  BE 34 F2               ldx DefaultYOnscreenOfs,y    ;load offset value here
00F24C  1  C9 00                  cmp #$00
00F24E  1  30 10                  bmi YLdBData                 ;if under top of the screen or beyond bottom, branch
00F250  1  BE 35 F2               ldx DefaultYOnscreenOfs+1,y  ;if not, load alternate offset value here
00F253  1  C9 01                  cmp #$01
00F255  1  10 09                  bpl YLdBData                 ;if one vertical unit or more above the screen, branch
00F257  1  A9 20                  lda #$20                     ;if no branching, load value here and store
00F259  1  85 06                  sta $06
00F25B  1  A9 04                  lda #$04                     ;load some other value and execute subroutine
00F25D  1  20 6D F2               jsr DividePDiff
00F260  1  BD 2B F2     YLdBData: lda YOffscreenBitsData,x     ;get offscreen data bits using offset
00F263  1  A6 04                  ldx $04                      ;reobtain position in buffer
00F265  1  C9 00                  cmp #$00
00F267  1  D0 03                  bne ExYOfsBS                 ;if bits not zero, branch to leave
00F269  1  88                     dey                          ;otherwise, do bottom of the screen now
00F26A  1  10 D1                  bpl YOfsLoop
00F26C  1  60           ExYOfsBS: rts
