00CD3C  1               ProcFirebar:
00CD3C  1  20 AF F1               jsr GetEnemyOffscreenBits   ;get offscreen information
00CD3F  1  AD D1 03               lda Enemy_OffscreenBits     ;check for d3 set
00CD42  1  29 08                  and #%00001000              ;if so, branch to leave
00CD44  1  D0 74                  bne SkipFBar
00CD46  1  AD 47 07               lda TimerControl            ;if master timer control set, branch
00CD49  1  D0 0A                  bne SusFbar                 ;ahead of this part
00CD4B  1  BD 88 03               lda FirebarSpinSpeed,x      ;load spinning speed of firebar
00CD4E  1  20 10 D4               jsr FirebarSpin             ;modify current spinstate
00CD51  1  29 1F                  and #%00011111              ;mask out all but 5 LSB
00CD53  1  95 A0                  sta FirebarSpinState_High,x ;and store as new high byte of spinstate
00CD55  1  B5 A0        SusFbar:  lda FirebarSpinState_High,x ;get high byte of spinstate
00CD57  1  B4 16                  ldy Enemy_ID,x              ;check enemy identifier
00CD59  1  C0 1F                  cpy #$1f
00CD5B  1  90 0D                  bcc SetupGFB                ;if < $1f (long firebar), branch
00CD5D  1  C9 08                  cmp #$08                    ;check high byte of spinstate
00CD5F  1  F0 04                  beq SkpFSte                 ;if eight, branch to change
00CD61  1  C9 18                  cmp #$18
00CD63  1  D0 05                  bne SetupGFB                ;if not at twenty-four branch to not change
00CD65  1  18           SkpFSte:  clc
00CD66  1  69 01                  adc #$01                    ;add one to spinning thing to avoid horizontal state
00CD68  1  95 A0                  sta FirebarSpinState_High,x
00CD6A  1  85 EF        SetupGFB: sta $ef                     ;save high byte of spinning thing, modified or otherwise
00CD6C  1  20 52 F1               jsr RelativeEnemyPosition   ;get relative coordinates to screen
00CD6F  1  20 8E CE               jsr GetFirebarPosition      ;do a sub here (residual, too early to be used now)
00CD72  1  BC E5 06               ldy Enemy_SprDataOffset,x   ;get OAM data offset
00CD75  1  AD B9 03               lda Enemy_Rel_YPos          ;get relative vertical coordinate
00CD78  1  99 00 02               sta Sprite_Y_Position,y     ;store as Y in OAM data
00CD7B  1  85 07                  sta $07                     ;also save here
00CD7D  1  AD AE 03               lda Enemy_Rel_XPos          ;get relative horizontal coordinate
00CD80  1  99 03 02               sta Sprite_X_Position,y     ;store as X in OAM data
00CD83  1  85 06                  sta $06                     ;also save here
00CD85  1  A9 01                  lda #$01
00CD87  1  85 00                  sta $00                     ;set $01 value here (not necessary)
00CD89  1  20 08 CE               jsr FirebarCollision        ;draw fireball part and do collision detection
00CD8C  1  A0 05                  ldy #$05                    ;load value for short firebars by default
00CD8E  1  B5 16                  lda Enemy_ID,x
00CD90  1  C9 1F                  cmp #$1f                    ;are we doing a long firebar?
00CD92  1  90 02                  bcc SetMFbar                ;no, branch then
00CD94  1  A0 0B                  ldy #$0b                    ;otherwise load value for long firebars
00CD96  1  84 ED        SetMFbar: sty $ed                     ;store maximum value for length of firebars
00CD98  1  A9 00                  lda #$00
00CD9A  1  85 00                  sta $00                     ;initialize counter here
00CD9C  1  A5 EF        DrawFbar: lda $ef                     ;load high byte of spinstate
00CD9E  1  20 8E CE               jsr GetFirebarPosition      ;get fireball position data depending on firebar part
00CDA1  1  20 BB CD               jsr DrawFirebar_Collision   ;position it properly, draw it and do collision detection
00CDA4  1  A5 00                  lda $00                     ;check which firebar part
00CDA6  1  C9 04                  cmp #$04
00CDA8  1  D0 08                  bne NextFbar
00CDAA  1  AC CF 06               ldy DuplicateObj_Offset     ;if we arrive at fifth firebar part,
00CDAD  1  B9 E5 06               lda Enemy_SprDataOffset,y   ;get offset from long firebar and load OAM data offset
00CDB0  1  85 06                  sta $06                     ;using long firebar offset, then store as new one here
00CDB2  1  E6 00        NextFbar: inc $00                     ;move onto the next firebar part
00CDB4  1  A5 00                  lda $00
00CDB6  1  C5 ED                  cmp $ed                     ;if we end up at the maximum part, go on and leave
00CDB8  1  90 E2                  bcc DrawFbar                ;otherwise go back and do another
00CDBA  1  60           SkipFBar: rts
00CDBB  1               
00CDBB  1               DrawFirebar_Collision:
00CDBB  1  A5 03                 lda $03                  ;store mirror data elsewhere
00CDBD  1  85 05                 sta $05
00CDBF  1  A4 06                 ldy $06                  ;load OAM data offset for firebar
00CDC1  1  A5 01                 lda $01                  ;load horizontal adder we got from position loader
00CDC3  1  46 05                 lsr $05                  ;shift LSB of mirror data
00CDC5  1  B0 04                 bcs AddHA                ;if carry was set, skip this part
00CDC7  1  49 FF                 eor #$ff
00CDC9  1  69 01                 adc #$01                 ;otherwise get two's compliment of horizontal adder
00CDCB  1  18           AddHA:   clc                      ;add horizontal coordinate relative to screen to
00CDCC  1  6D AE 03              adc Enemy_Rel_XPos       ;horizontal adder, modified or otherwise
00CDCF  1  99 03 02              sta Sprite_X_Position,y  ;store as X coordinate here
00CDD2  1  85 06                 sta $06                  ;store here for now, note offset is saved in Y still
00CDD4  1  CD AE 03              cmp Enemy_Rel_XPos       ;compare X coordinate of sprite to original X of firebar
00CDD7  1  B0 09                 bcs SubtR1               ;if sprite coordinate => original coordinate, branch
00CDD9  1  AD AE 03              lda Enemy_Rel_XPos
00CDDC  1  38                    sec                      ;otherwise subtract sprite X from the
00CDDD  1  E5 06                 sbc $06                  ;original one and skip this part
00CDDF  1  4C E6 CD              jmp ChkFOfs
00CDE2  1  38           SubtR1:  sec                      ;subtract original X from the
00CDE3  1  ED AE 03              sbc Enemy_Rel_XPos       ;current sprite X
00CDE6  1  C9 59        ChkFOfs: cmp #$59                 ;if difference of coordinates within a certain range,
00CDE8  1  90 04                 bcc VAHandl              ;continue by handling vertical adder
00CDEA  1  A9 F8                 lda #$f8                 ;otherwise, load offscreen Y coordinate
00CDEC  1  D0 15                 bne SetVFbr              ;and unconditionally branch to move sprite offscreen
00CDEE  1  AD B9 03     VAHandl: lda Enemy_Rel_YPos       ;if vertical relative coordinate offscreen,
00CDF1  1  C9 F8                 cmp #$f8                 ;skip ahead of this part and write into sprite Y coordinate
00CDF3  1  F0 0E                 beq SetVFbr
00CDF5  1  A5 02                 lda $02                  ;load vertical adder we got from position loader
00CDF7  1  46 05                 lsr $05                  ;shift LSB of mirror data one more time
00CDF9  1  B0 04                 bcs AddVA                ;if carry was set, skip this part
00CDFB  1  49 FF                 eor #$ff
00CDFD  1  69 01                 adc #$01                 ;otherwise get two's compliment of second part
00CDFF  1  18           AddVA:   clc                      ;add vertical coordinate relative to screen to
00CE00  1  6D B9 03              adc Enemy_Rel_YPos       ;the second data, modified or otherwise
00CE03  1  99 00 02     SetVFbr: sta Sprite_Y_Position,y  ;store as Y coordinate here
00CE06  1  85 07                 sta $07                  ;also store here for now
00CE08  1               
00CE08  1               FirebarCollision:
00CE08  1  20 ED EC              jsr DrawFirebar          ;run sub here to draw current tile of firebar
00CE0B  1  98                    tya                      ;return OAM data offset and save
00CE0C  1  48                    pha                      ;to the stack for now
00CE0D  1  AD 9F 07              lda StarInvincibleTimer  ;if star mario invincibility timer
00CE10  1  0D 47 07              ora TimerControl         ;or master timer controls set
00CE13  1  D0 70                 bne NoColFB              ;then skip all of this
00CE15  1  85 05                 sta $05                  ;otherwise initialize counter
00CE17  1  A4 B5                 ldy Player_Y_HighPos
00CE19  1  88                    dey                      ;if player's vertical high byte offscreen,
00CE1A  1  D0 69                 bne NoColFB              ;skip all of this
00CE1C  1  A4 CE                 ldy Player_Y_Position    ;get player's vertical position
00CE1E  1  AD 54 07              lda PlayerSize           ;get player's size
00CE21  1  D0 05                 bne AdjSm                ;if player small, branch to alter variables
00CE23  1  AD 14 07              lda CrouchingFlag
00CE26  1  F0 09                 beq BigJp                ;if player big and not crouching, jump ahead
00CE28  1  E6 05        AdjSm:   inc $05                  ;if small or big but crouching, execute this part
00CE2A  1  E6 05                 inc $05                  ;first increment our counter twice (setting $02 as flag)
00CE2C  1  98                    tya
00CE2D  1  18                    clc                      ;then add 24 pixels to the player's
00CE2E  1  69 18                 adc #$18                 ;vertical coordinate
00CE30  1  A8                    tay
00CE31  1  98           BigJp:   tya                      ;get vertical coordinate, altered or otherwise, from Y
00CE32  1  38           FBCLoop: sec                      ;subtract vertical position of firebar
00CE33  1  E5 07                 sbc $07                  ;from the vertical coordinate of the player
00CE35  1  10 05                 bpl ChkVFBD              ;if player lower on the screen than firebar,
00CE37  1  49 FF                 eor #$ff                 ;skip two's compliment part
00CE39  1  18                    clc                      ;otherwise get two's compliment
00CE3A  1  69 01                 adc #$01
00CE3C  1  C9 08        ChkVFBD: cmp #$08                 ;if difference => 8 pixels, skip ahead of this part
00CE3E  1  B0 1C                 bcs Chk2Ofs
00CE40  1  A5 06                 lda $06                  ;if firebar on far right on the screen, skip this,
00CE42  1  C9 F0                 cmp #$f0                 ;because, really, what's the point?
00CE44  1  B0 16                 bcs Chk2Ofs
00CE46  1  AD 07 02              lda Sprite_X_Position+4  ;get OAM X coordinate for sprite #1
00CE49  1  18                    clc
00CE4A  1  69 04                 adc #$04                 ;add four pixels
00CE4C  1  85 04                 sta $04                  ;store here
00CE4E  1  38                    sec                      ;subtract horizontal coordinate of firebar
00CE4F  1  E5 06                 sbc $06                  ;from the X coordinate of player's sprite 1
00CE51  1  10 05                 bpl ChkFBCl              ;if modded X coordinate to the right of firebar
00CE53  1  49 FF                 eor #$ff                 ;skip two's compliment part
00CE55  1  18                    clc                      ;otherwise get two's compliment
00CE56  1  69 01                 adc #$01
00CE58  1  C9 08        ChkFBCl: cmp #$08                 ;if difference < 8 pixels, collision, thus branch
00CE5A  1  90 13                 bcc ChgSDir              ;to process
00CE5C  1  A5 05        Chk2Ofs: lda $05                  ;if value of $02 was set earlier for whatever reason,
00CE5E  1  C9 02                 cmp #$02                 ;branch to increment OAM offset and leave, no collision
00CE60  1  F0 23                 beq NoColFB
00CE62  1  A4 05                 ldy $05                  ;otherwise get temp here and use as offset
00CE64  1  A5 CE                 lda Player_Y_Position
00CE66  1  18                    clc
00CE67  1  79 3A CD              adc FirebarYPos,y        ;add value loaded with offset to player's vertical coordinate
00CE6A  1  E6 05                 inc $05                  ;then increment temp and jump back
00CE6C  1  4C 32 CE              jmp FBCLoop
00CE6F  1  A2 01        ChgSDir: ldx #$01                 ;set movement direction by default
00CE71  1  A5 04                 lda $04                  ;if OAM X coordinate of player's sprite 1
00CE73  1  C5 06                 cmp $06                  ;is greater than horizontal coordinate of firebar
00CE75  1  B0 01                 bcs SetSDir              ;then do not alter movement direction
00CE77  1  E8                    inx                      ;otherwise increment it
00CE78  1  86 46        SetSDir: stx Enemy_MovingDir      ;store movement direction here
