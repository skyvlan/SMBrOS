00F0B0  1               HandleChangeSize:
00F0B0  1  AC 0D 07              ldy PlayerAnimCtrl           ;get animation frame control
00F0B3  1  A5 09                 lda FrameCounter
00F0B5  1  29 03                 and #%00000011               ;get frame counter and execute this code every
00F0B7  1  D0 0D                 bne GorSLog                  ;fourth frame, otherwise branch ahead
00F0B9  1  C8                    iny                          ;increment frame control
00F0BA  1  C0 0A                 cpy #$0a                     ;check for preset upper extent
00F0BC  1  90 05                 bcc CSzNext                  ;if not there yet, skip ahead to use
00F0BE  1  A0 00                 ldy #$00                     ;otherwise initialize both grow/shrink flag
00F0C0  1  8C 0B 07              sty PlayerChangeSizeFlag     ;and animation frame control
00F0C3  1  8C 0D 07     CSzNext: sty PlayerAnimCtrl           ;store proper frame control
00F0C6  1  AD 54 07     GorSLog: lda PlayerSize               ;get player's size
00F0C9  1  D0 0C                 bne ShrinkPlayer             ;if player small, skip ahead to next part
00F0CB  1  B9 9C F0              lda ChangeSizeOffsetAdder,y  ;get offset adder based on frame control as offset
00F0CE  1  A0 0F                 ldy #$0f                     ;load offset for player growing
