00F26D  1               ;--------------------------------
00F26D  1               
00F26D  1               DividePDiff:
00F26D  1  85 05                  sta $05       ;store current value in A here
00F26F  1  A5 07                  lda $07       ;get pixel difference
00F271  1  C5 06                  cmp $06       ;compare to preset value
00F273  1  B0 0C                  bcs ExDivPD   ;if pixel difference >= preset value, branch
00F275  1  4A                     lsr           ;divide by eight
00F276  1  4A                     lsr
00F277  1  4A                     lsr
00F278  1  29 07                  and #$07      ;mask out all but 3 LSB
00F27A  1  C0 01                  cpy #$01      ;right side of the screen or top?
00F27C  1  B0 02                  bcs SetOscrO  ;if so, branch, use difference / 8 as offset
00F27E  1  65 05                  adc $05       ;if not, add value to difference / 8
00F280  1  AA           SetOscrO: tax           ;use as offset
00F281  1  60           ExDivPD:  rts           ;leave
