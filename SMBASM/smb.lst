00838B  1               VictoryMode:
00838B  1  20 A0 83                 jsr VictoryModeSubroutines  ;run victory mode subroutines
00838E  1  AD 72 07                 lda OperMode_Task           ;get current task of victory mode
008391  1  F0 07                    beq AutoPlayer              ;if on bridge collapse, skip enemy processing
008393  1  A2 00                    ldx #$00
008395  1  86 08                    stx ObjectOffset            ;otherwise reset enemy object offset
008397  1  20 47 C0                 jsr EnemiesAndLoopsCore     ;and run enemy code
00839A  1  20 2A F1     AutoPlayer: jsr RelativePlayerPosition  ;get player's relative coordinates
00839D  1  4C E9 EE                 jmp PlayerGfxHandler        ;draw the player, then leave
0083A0  1               
