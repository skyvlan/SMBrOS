00DFDA  1  D0 03               bne HBChk                ;branch if not found
00DFDC  1  4C 63 E1            jmp EnemyJump            ;otherwise jump elsewhere
00DFDF  1  C0 05        HBChk: cpy #HammerBro           ;check for hammer bro
00DFE1  1  D0 03               bne CInvu                ;branch if not found
00DFE3  1  4C 85 E1            jmp HammerBroBGColl      ;otherwise jump elsewhere
00DFE6  1  C0 12        CInvu: cpy #Spiny               ;if enemy object is spiny, branch
00DFE8  1  F0 08               beq YesIn
