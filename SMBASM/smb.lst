00C5AF  1  85 FD                sta NoiseSoundQueue
00C5B1  1  AC 68 03             ldy BowserFront_Offset      ;get bowser's buffer offset
00C5B4  1  B9 16 00             lda Enemy_ID,y              ;check for bowser
00C5B7  1  C9 2D                cmp #Bowser
00C5B9  1  F0 31                beq SpawnFromMouth          ;branch if found
00C5BB  1  20 D9 D1             jsr SetFlameTimer           ;get timer data based on flame counter
00C5BE  1  18                   clc
00C5BF  1  69 20                adc #$20                    ;add 32 frames by default
00C5C1  1  AC CC 06             ldy SecondaryHardMode
00C5C4  1  F0 03                beq SetFrT                  ;if secondary mode flag not set, use as timer setting
