008E5C  1               ;$00 - temp joypad bit
008E5C  1               
008E5C  1               ReadJoypads:
008E5C  1  A9 01                      lda #$01               ;reset and clear strobe of joypad ports
008E5E  1  8D 16 40                   sta JOYPAD_PORT
008E61  1  4A                         lsr
008E62  1  AA                         tax                    ;start with joypad 1's port
008E63  1  8D 16 40                   sta JOYPAD_PORT
008E66  1  20 6A 8E                   jsr ReadPortBits
008E69  1  E8                         inx                    ;increment for joypad 2's port
008E6A  1  A0 08        ReadPortBits: ldy #$08
008E6C  1  48           PortLoop:     pha                    ;push previous bit onto stack
008E6D  1  BD 16 40                   lda JOYPAD_PORT,x      ;read current bit on joypad port
008E70  1  85 00                      sta $00                ;check d1 and d0 of port output
008E72  1  4A                         lsr                    ;this is necessary on the old
008E73  1  05 00                      ora $00                ;famicom systems in japan
008E75  1  4A                         lsr
008E76  1  68                         pla                    ;read bits from stack
008E77  1  2A                         rol                    ;rotate bit from carry flag
008E78  1  88                         dey
008E79  1  D0 F1                      bne PortLoop           ;count down bits left
008E7B  1  9D FC 06                   sta SavedJoypadBits,x  ;save controller status here always
008E7E  1  48                         pha
008E7F  1  29 30                      and #%00110000         ;check for select or start
008E81  1  3D 4A 07                   and JoypadBitMask,x    ;if neither saved state nor current state
008E84  1  F0 07                      beq Save8Bits          ;have any of these two set, branch
008E86  1  68                         pla
008E87  1  29 CF                      and #%11001111         ;otherwise store without select
008E89  1  9D FC 06                   sta SavedJoypadBits,x  ;or start bits and leave
008E8C  1  60                         rts
008E8D  1  68           Save8Bits:    pla
008E8E  1  9D 4A 07                   sta JoypadBitMask,x    ;save with all bits in another place and leave
008E91  1  60                         rts
