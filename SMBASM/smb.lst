00C4A8  1               InitFlyingCheepCheep:
00C4A8  1  AD 8F 07              lda FrenzyEnemyTimer       ;if timer here not expired yet, branch to leave
00C4AB  1  D0 A1                 bne ChpChpEx
00C4AD  1  20 46 C3              jsr SmallBBox              ;jump to set bounding box size $09 and init other values
00C4B0  1  BD A8 07              lda PseudoRandomBitReg+1,x
00C4B3  1  29 03                 and #%00000011             ;set pseudorandom offset here
00C4B5  1  A8                    tay
00C4B6  1  B9 A4 C4              lda FlyCCTimerData,y       ;load timer with pseudorandom offset
00C4B9  1  8D 8F 07              sta FrenzyEnemyTimer
00C4BC  1  A0 03                 ldy #$03                   ;load Y with default value
00C4BE  1  AD CC 06              lda SecondaryHardMode
00C4C1  1  F0 01                 beq MaxCC                  ;if secondary hard mode flag not set, do not increment Y
00C4C3  1  C8                    iny                        ;otherwise, increment Y to allow as many as four onscreen
00C4C4  1  84 00        MaxCC:   sty $00                    ;store whatever pseudorandom bits are in Y
00C4C6  1  E4 00                 cpx $00                    ;compare enemy object buffer offset with Y
00C4C8  1  B0 84                 bcs ChpChpEx               ;if X => Y, branch to leave
00C4CA  1  BD A7 07              lda PseudoRandomBitReg,x
00C4CD  1  29 03                 and #%00000011             ;get last two bits of LSFR, first part
00C4CF  1  85 00                 sta $00                    ;and store in two places
00C4D1  1  85 01                 sta $01
00C4D3  1  A9 FB                 lda #$fb                   ;set vertical speed for cheep-cheep
00C4D5  1  95 A0                 sta Enemy_Y_Speed,x
00C4D7  1  A9 00                 lda #$00                   ;load default value
00C4D9  1  A4 57                 ldy Player_X_Speed         ;check player's horizontal speed
00C4DB  1  F0 07                 beq GSeed                  ;if player not moving left or right, skip this part
00C4DD  1  A9 04                 lda #$04
00C4DF  1  C0 19                 cpy #$19                   ;if moving to the right but not very quickly,
00C4E1  1  90 01                 bcc GSeed                  ;do not change A
00C4E3  1  0A                    asl                        ;otherwise, multiply A by 2
00C4E4  1  48           GSeed:   pha                        ;save to stack
00C4E5  1  18                    clc
00C4E6  1  65 00                 adc $00                    ;add to last two bits of LSFR we saved earlier
00C4E8  1  85 00                 sta $00                    ;save it there
00C4EA  1  BD A8 07              lda PseudoRandomBitReg+1,x
00C4ED  1  29 03                 and #%00000011             ;if neither of the last two bits of second LSFR set,
00C4EF  1  F0 07                 beq RSeed                  ;skip this part and save contents of $00
00C4F1  1  BD A9 07              lda PseudoRandomBitReg+2,x
00C4F4  1  29 0F                 and #%00001111             ;otherwise overwrite with lower nybble of
00C4F6  1  85 00                 sta $00                    ;third LSFR part
00C4F8  1  68           RSeed:   pla                        ;get value from stack we saved earlier
00C4F9  1  18                    clc
00C4FA  1  65 01                 adc $01                    ;add to last two bits of LSFR we saved in other place
00C4FC  1  A8                    tay                        ;use as pseudorandom offset here
00C4FD  1  B9 98 C4              lda FlyCCXSpeedData,y      ;get horizontal speed using pseudorandom offset
00C500  1  95 58                 sta Enemy_X_Speed,x
00C502  1  A9 01                 lda #$01                   ;set to move towards the right
00C504  1  95 46                 sta Enemy_MovingDir,x
00C506  1  A5 57                 lda Player_X_Speed         ;if player moving left or right, branch ahead of this part
00C508  1  D0 12                 bne D2XPos1
00C50A  1  A4 00                 ldy $00                    ;get first LSFR or third LSFR lower nybble
00C50C  1  98                    tya                        ;and check for d1 set
00C50D  1  29 02                 and #%00000010
00C50F  1  F0 0B                 beq D2XPos1                ;if d1 not set, branch
00C511  1  B5 58                 lda Enemy_X_Speed,x
00C513  1  49 FF                 eor #$ff                   ;if d1 set, change horizontal speed
00C515  1  18                    clc                        ;into two's compliment, thus moving in the opposite
00C516  1  69 01                 adc #$01                   ;direction
00C518  1  95 58                 sta Enemy_X_Speed,x
00C51A  1  F6 46                 inc Enemy_MovingDir,x      ;increment to move towards the left
00C51C  1  98           D2XPos1: tya                        ;get first LSFR or third LSFR lower nybble again
00C51D  1  29 02                 and #%00000010
00C51F  1  F0 0F                 beq D2XPos2                ;check for d1 set again, branch again if not set
00C521  1  A5 86                 lda Player_X_Position      ;get player's horizontal position
00C523  1  18                    clc
00C524  1  79 88 C4              adc FlyCCXPositionData,y   ;if d1 set, add value obtained from pseudorandom offset
00C527  1  95 87                 sta Enemy_X_Position,x     ;and save as enemy's horizontal position
00C529  1  A5 6D                 lda Player_PageLoc         ;get player's page location
00C52B  1  69 00                 adc #$00                   ;add carry and jump past this part
00C52D  1  4C 3C C5              jmp FinCCSt
00C530  1  A5 86        D2XPos2: lda Player_X_Position      ;get player's horizontal position
00C532  1  38                    sec
00C533  1  F9 88 C4              sbc FlyCCXPositionData,y   ;if d1 not set, subtract value obtained from pseudorandom
00C536  1  95 87                 sta Enemy_X_Position,x     ;offset and save as enemy's horizontal position
00C538  1  A5 6D                 lda Player_PageLoc         ;get player's page location
00C53A  1  E9 00                 sbc #$00                   ;subtract borrow
00C53C  1  95 6E        FinCCSt: sta Enemy_PageLoc,x        ;save as enemy's page location
00C53E  1  A9 01                 lda #$01
00C540  1  95 0F                 sta Enemy_Flag,x           ;set enemy's buffer flag
00C542  1  95 B6                 sta Enemy_Y_HighPos,x      ;set enemy's high vertical byte
00C544  1  A9 F8                 lda #$f8
00C546  1  95 CF                 sta Enemy_Y_Position,x     ;put enemy below the screen, and we are done
00C548  1  60                    rts
