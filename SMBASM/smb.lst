00895C  1  8D 21 07                 sta CurrentNTAddr_Low        ;just under the status bar
00895F  1  AD 20 07                 lda CurrentNTAddr_High       ;and then invert d2 of the name table address high
008962  1  49 04                    eor #%00000100               ;to move onto the next appropriate name table
008964  1  8D 20 07                 sta CurrentNTAddr_High
