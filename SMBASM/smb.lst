00E003  1  A4 02              ldy $02                   ;get vertical coordinate used to find block
00E005  1  A9 00              lda #$00                  ;store default blank metatile in that spot so we won't
00E007  1  91 06              sta ($06),y               ;trigger this routine accidentally again
00E009  1  B5 16              lda Enemy_ID,x
00E00B  1  C9 15              cmp #$15                  ;if enemy object => $15, branch ahead
00E00D  1  B0 0C              bcs ChkToStunEnemies
