008E92  1               WriteBufferToScreen:
008E92  1  8D 06 20                    sta PPU_ADDRESS           ;store high byte of vram address
008E95  1  C8                          iny
008E96  1  B1 00                       lda ($00),y               ;load next byte (second)
008E98  1  8D 06 20                    sta PPU_ADDRESS           ;store low byte of vram address
008E9B  1  C8                          iny
008E9C  1  B1 00                       lda ($00),y               ;load next byte (third)
008E9E  1  0A                          asl                       ;shift to left and save in stack
008E9F  1  48                          pha
008EA0  1  AD 78 07                    lda Mirror_PPU_CTRL_REG1  ;load mirror of $2000,
008EA3  1  09 04                       ora #%00000100            ;set ppu to increment by 32 by default
008EA5  1  B0 02                       bcs SetupWrites           ;if d7 of third byte was clear, ppu will
008EA7  1  29 FB                       and #%11111011            ;only increment by 1
008EA9  1  20 ED 8E     SetupWrites:   jsr WritePPUReg1          ;write to register
008EAC  1  68                          pla                       ;pull from stack and shift to left again
008EAD  1  0A                          asl
008EAE  1  90 03                       bcc GetLength             ;if d6 of third byte was clear, do not repeat byte
008EB0  1  09 02                       ora #%00000010            ;otherwise set d1 and increment Y
008EB2  1  C8                          iny
008EB3  1  4A           GetLength:     lsr                       ;shift back to the right to get proper length
008EB4  1  4A                          lsr                       ;note that d1 will now be in carry
008EB5  1  AA                          tax
008EB6  1  B0 01        OutputToVRAM:  bcs RepeatByte            ;if carry set, repeat loading the same byte
008EB8  1  C8                          iny                       ;otherwise increment Y to load next byte
008EB9  1  B1 00        RepeatByte:    lda ($00),y               ;load more data from buffer and write to vram
008EBB  1  8D 07 20                    sta PPU_DATA
008EBE  1  CA                          dex                       ;done writing?
008EBF  1  D0 F5                       bne OutputToVRAM
008EC1  1  38                          sec
008EC2  1  98                          tya
008EC3  1  65 00                       adc $00                   ;add end length plus one to the indirect at $00
008EC5  1  85 00                       sta $00                   ;to allow this routine to read another set of updates
008EC7  1  A9 00                       lda #$00
008EC9  1  65 01                       adc $01
008ECB  1  85 01                       sta $01
008ECD  1  A9 3F                       lda #$3f                  ;sets vram address to $3f00
008ECF  1  8D 06 20                    sta PPU_ADDRESS
008ED2  1  A9 00                       lda #$00
008ED4  1  8D 06 20                    sta PPU_ADDRESS
008ED7  1  8D 06 20                    sta PPU_ADDRESS           ;then reinitializes it for some reason
008EDA  1  8D 06 20                    sta PPU_ADDRESS
008EDD  1  AE 02 20     UpdateScreen:  ldx PPU_STATUS            ;reset flip-flop
008EE0  1  A0 00                       ldy #$00                  ;load first byte from indirect as a pointer
008EE2  1  B1 00                       lda ($00),y
008EE4  1  D0 AC                       bne WriteBufferToScreen   ;if byte is zero we have no further updates to make here
008EE6  1  8D 05 20     InitScroll:    sta PPU_SCROLL_REG        ;store contents of A into scroll registers
008EE9  1  8D 05 20                    sta PPU_SCROLL_REG        ;and end whatever subroutine led us here
008EEC  1  60                          rts
