00CB87  1               BlooberBitmasks:
00CB87  1  3F 03              .byte %00111111, %00000011
00CB89  1               
00CB89  1               MoveBloober:
00CB89  1  B5 1E                lda Enemy_State,x
00CB8B  1  29 20                and #%00100000             ;check enemy state for d5 set
00CB8D  1  D0 4D                bne MoveDefeatedBloober    ;branch if set to move defeated bloober
00CB8F  1  AC CC 06             ldy SecondaryHardMode      ;use secondary hard mode flag as offset
00CB92  1  BD A8 07             lda PseudoRandomBitReg+1,x ;get LSFR
00CB95  1  39 87 CB             and BlooberBitmasks,y      ;mask out bits in LSFR using bitmask loaded with offset
00CB98  1  D0 12                bne BlooberSwim            ;if any bits set, skip ahead to make swim
00CB9A  1  8A                   txa
00CB9B  1  4A                   lsr                        ;check to see if on second or fourth slot (1 or 3)
00CB9C  1  90 04                bcc FBLeft                 ;if not, branch to figure out moving direction
00CB9E  1  A4 45                ldy Player_MovingDir       ;otherwise, load player's moving direction and
00CBA0  1  B0 08                bcs SBMDir                 ;do an unconditional branch to set
00CBA2  1  A0 02        FBLeft: ldy #$02                   ;set left moving direction by default
00CBA4  1  20 43 E1             jsr PlayerEnemyDiff        ;get horizontal difference between player and bloober
00CBA7  1  10 01                bpl SBMDir                 ;if enemy to the right of player, keep left
00CBA9  1  88                   dey                        ;otherwise decrement to set right moving direction
00CBAA  1  94 46        SBMDir: sty Enemy_MovingDir,x      ;set moving direction of bloober, then continue on here
00CBAC  1               
00CBAC  1               BlooberSwim:
00CBAC  1  20 DF CB            jsr ProcSwimmingB        ;execute sub to make bloober swim characteristically
00CBAF  1  B5 CF               lda Enemy_Y_Position,x   ;get vertical coordinate
00CBB1  1  38                  sec
00CBB2  1  FD 34 04            sbc Enemy_Y_MoveForce,x  ;subtract movement force
00CBB5  1  C9 20               cmp #$20                 ;check to see if position is above edge of status bar
00CBB7  1  90 02               bcc SwimX                ;if so, don't do it
00CBB9  1  95 CF               sta Enemy_Y_Position,x   ;otherwise, set new vertical position, make bloober swim
00CBBB  1  B4 46        SwimX: ldy Enemy_MovingDir,x    ;check moving direction
00CBBD  1  88                  dey
00CBBE  1  D0 0E               bne LeftSwim             ;if moving to the left, branch to second part
00CBC0  1  B5 87               lda Enemy_X_Position,x
00CBC2  1  18                  clc                      ;add movement speed to horizontal coordinate
00CBC3  1  75 58               adc BlooperMoveSpeed,x
00CBC5  1  95 87               sta Enemy_X_Position,x   ;store result as new horizontal coordinate
00CBC7  1  B5 6E               lda Enemy_PageLoc,x
00CBC9  1  69 00               adc #$00                 ;add carry to page location
00CBCB  1  95 6E               sta Enemy_PageLoc,x      ;store as new page location and leave
00CBCD  1  60                  rts
00CBCE  1               
00CBCE  1               LeftSwim:
00CBCE  1  B5 87              lda Enemy_X_Position,x
00CBD0  1  38                 sec                      ;subtract movement speed from horizontal coordinate
00CBD1  1  F5 58              sbc BlooperMoveSpeed,x
00CBD3  1  95 87              sta Enemy_X_Position,x   ;store result as new horizontal coordinate
00CBD5  1  B5 6E              lda Enemy_PageLoc,x
00CBD7  1  E9 00              sbc #$00                 ;subtract borrow from page location
00CBD9  1  95 6E              sta Enemy_PageLoc,x      ;store as new page location and leave
00CBDB  1  60                 rts
