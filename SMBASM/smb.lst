00C03B  1  B0 09                 bcs ExVMove                  ;and if so, branch to leave
00C03D  1  A5 07                 lda $07
00C03F  1  95 9F                 sta SprObject_Y_Speed,x      ;keep vertical speed within maximum value
00C041  1  A9 FF                 lda #$ff
00C043  1  9D 33 04              sta SprObject_Y_MoveForce,x  ;clear fractional
00C046  1  60           ExVMove: rts                          ;leave!
