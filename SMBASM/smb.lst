00D295  1               RunFireworks:
00D295  1  D6 A0                   dec ExplosionTimerCounter,x ;decrement explosion timing counter here
00D297  1  D0 0C                   bne SetupExpl               ;if not expired, skip this part
00D299  1  A9 08                   lda #$08
00D29B  1  95 A0                   sta ExplosionTimerCounter,x ;reset counter
00D29D  1  F6 58                   inc ExplosionGfxCounter,x   ;increment explosion graphics counter
00D29F  1  B5 58                   lda ExplosionGfxCounter,x
00D2A1  1  C9 03                   cmp #$03                    ;check explosion graphics counter
00D2A3  1  B0 18                   bcs FireworksSoundScore     ;if at a certain point, branch to kill this object
00D2A5  1  20 52 F1     SetupExpl: jsr RelativeEnemyPosition   ;get relative coordinates of explosion
00D2A8  1  AD B9 03                lda Enemy_Rel_YPos          ;copy relative coordinates
00D2AB  1  8D BA 03                sta Fireball_Rel_YPos       ;from the enemy object to the fireball object
00D2AE  1  AD AE 03                lda Enemy_Rel_XPos          ;first vertical, then horizontal
00D2B1  1  8D AF 03                sta Fireball_Rel_XPos
00D2B4  1  BC E5 06                ldy Enemy_SprDataOffset,x   ;get OAM data offset
00D2B7  1  B5 58                   lda ExplosionGfxCounter,x   ;get explosion graphics counter
00D2B9  1  20 17 ED                jsr DrawExplosion_Fireworks ;do a sub to draw the explosion then leave
00D2BC  1  60                      rts
00D2BD  1               
00D2BD  1               FireworksSoundScore:
00D2BD  1  A9 00              lda #$00               ;disable enemy buffer flag
00D2BF  1  95 0F              sta Enemy_Flag,x
