0083B0  1               SetupVictoryMode:
0083B0  1  AE 1B 07           ldx ScreenRight_PageLoc  ;get page location of right side of screen
0083B3  1  E8                 inx                      ;increment to next page
0083B4  1  86 34              stx DestinationPageLoc   ;store here
0083B6  1  A9 08              lda #EndOfCastleMusic
0083B8  1  85 FC              sta EventMusicQueue      ;play win castle music
0083BA  1  4C 4E 87           jmp IncModeTask_B        ;jump to set next major task in victory mode
0083BD  1               
0083BD  1               ;-------------------------------------------------------------------------------------
0083BD  1               
0083BD  1               PlayerVictoryWalk:
0083BD  1  A0 00                     ldy #$00                ;set value here to not walk player by default
0083BF  1  84 35                     sty VictoryWalkControl
0083C1  1  A5 6D                     lda Player_PageLoc      ;get player's page location
0083C3  1  C5 34                     cmp DestinationPageLoc  ;compare with destination page location
0083C5  1  D0 06                     bne PerformWalk         ;if page locations don't match, branch
0083C7  1  A5 86                     lda Player_X_Position   ;otherwise get player's horizontal position
0083C9  1  C9 60                     cmp #$60                ;compare with preset horizontal position
0083CB  1  B0 03                     bcs DontWalk            ;if still on other page, branch ahead
0083CD  1  E6 35        PerformWalk: inc VictoryWalkControl  ;otherwise increment value and Y
0083CF  1  C8                        iny                     ;note Y will be used to walk the player
0083D0  1  98           DontWalk:    tya                     ;put contents of Y in A and
0083D1  1  20 E6 B0                  jsr AutoControlPlayer   ;use A to move player to the right or not
0083D4  1  AD 1A 07                  lda ScreenLeft_PageLoc  ;check page location of left side of screen
0083D7  1  C5 34                     cmp DestinationPageLoc  ;against set value here
0083D9  1  F0 16                     beq ExitVWalk           ;branch if equal to change modes if necessary
0083DB  1  AD 68 07                  lda ScrollFractional
0083DE  1  18                        clc                     ;do fixed point math on fractional part of scroll
0083DF  1  69 80                     adc #$80
0083E1  1  8D 68 07                  sta ScrollFractional    ;save fractional movement amount
0083E4  1  A9 01                     lda #$01                ;set 1 pixel per frame
0083E6  1  69 00                     adc #$00                ;add carry from previous addition
0083E8  1  A8                        tay                     ;use as scroll amount
0083E9  1  20 C4 AF                  jsr ScrollScreen        ;do sub to scroll the screen
0083EC  1  20 6F AF                  jsr UpdScrollVar        ;do another sub to update screen and scroll variables
0083EF  1  E6 35                     inc VictoryWalkControl  ;increment value to stay in this routine
0083F1  1  A5 35        ExitVWalk:   lda VictoryWalkControl  ;load value set here
0083F3  1  F0 68                     beq IncModeTask_A       ;if zero, branch to change modes
0083F5  1  60                        rts                     ;otherwise leave
