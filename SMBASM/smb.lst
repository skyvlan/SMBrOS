008E19  1               InitializeNameTables:
008E19  1  AD 02 20                   lda PPU_STATUS            ;reset flip-flop
008E1C  1  AD 78 07                   lda Mirror_PPU_CTRL_REG1  ;load mirror of ppu reg $2000
008E1F  1  09 10                      ora #%00010000            ;set sprites for first 4k and background for second 4k
008E21  1  29 F0                      and #%11110000            ;clear rest of lower nybble, leave higher alone
008E23  1  20 ED 8E                   jsr WritePPUReg1
008E26  1  A9 24                      lda #$24                  ;set vram address to start of name table 1
008E28  1  20 2D 8E                   jsr WriteNTAddr
008E2B  1  A9 20                      lda #$20                  ;and then set it to name table 0
008E2D  1  8D 06 20     WriteNTAddr:  sta PPU_ADDRESS
008E30  1  A9 00                      lda #$00
008E32  1  8D 06 20                   sta PPU_ADDRESS
008E35  1  A2 04                      ldx #$04                  ;clear name table with blank tile #24
008E37  1  A0 C0                      ldy #$c0
008E39  1  A9 24                      lda #$24
008E3B  1  8D 07 20     InitNTLoop:   sta PPU_DATA              ;count out exactly 768 tiles
008E3E  1  88                         dey
008E3F  1  D0 FA                      bne InitNTLoop
008E41  1  CA                         dex
008E42  1  D0 F7                      bne InitNTLoop
008E44  1  A0 40                      ldy #64                   ;now to clear the attribute table (with zero this time)
008E46  1  8A                         txa
008E47  1  8D 00 03                   sta VRAM_Buffer1_Offset   ;init vram buffer 1 offset
008E4A  1  8D 01 03                   sta VRAM_Buffer1          ;init vram buffer 1
008E4D  1  8D 07 20     InitATLoop:   sta PPU_DATA
008E50  1  88                         dey
008E51  1  D0 FA                      bne InitATLoop
008E53  1  8D 3F 07                   sta HorizontalScroll      ;reset scroll variables
008E56  1  8D 40 07                   sta VerticalScroll
008E59  1  4C E6 8E                   jmp InitScroll            ;initialize scroll registers to zero
