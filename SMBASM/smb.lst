00C9CE  1               ;$00 - used in HammerBroJumpCode as bitmask
00C9CE  1               
00C9CE  1               HammerThrowTmrData:
00C9CE  1  30 1C              .byte $30, $1c
00C9D0  1               
00C9D0  1               XSpeedAdderData:
00C9D0  1  00 E8 00 18        .byte $00, $e8, $00, $18
