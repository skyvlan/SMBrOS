00EEE9  1               PlayerGfxHandler:
00EEE9  1  AD 9E 07             lda InjuryTimer             ;if player's injured invincibility timer
00EEEC  1  F0 05                beq CntPl                   ;not set, skip checkpoint and continue code
00EEEE  1  A5 09                lda FrameCounter
00EEF0  1  4A                   lsr                         ;otherwise check frame counter and branch
00EEF1  1  B0 40                bcs ExPGH                   ;to leave on every other frame (when d0 is set)
00EEF3  1  A5 0E        CntPl:  lda GameEngineSubroutine    ;if executing specific game engine routine,
00EEF5  1  C9 0B                cmp #$0b                    ;branch ahead to some other part
00EEF7  1  F0 47                beq PlayerKilled
00EEF9  1  AD 0B 07             lda PlayerChangeSizeFlag    ;if grow/shrink flag set
00EEFC  1  D0 3C                bne DoChangeSize            ;then branch to some other code
00EEFE  1  AC 04 07             ldy SwimmingFlag            ;if swimming flag set, branch to
00EF01  1  F0 31                beq FindPlayerAction        ;different part, do not return
00EF03  1  A5 1D                lda Player_State
00EF05  1  C9 00                cmp #$00                    ;if player status normal,
00EF07  1  F0 2B                beq FindPlayerAction        ;branch and do not return
00EF09  1  20 34 EF             jsr FindPlayerAction        ;otherwise jump and return
00EF0C  1  A5 09                lda FrameCounter
00EF0E  1  29 04                and #%00000100              ;check frame counter for d2 set (8 frames every
00EF10  1  D0 21                bne ExPGH                   ;eighth frame), and branch if set to leave
00EF12  1  AA                   tax                         ;initialize X to zero
00EF13  1  AC E4 06             ldy Player_SprDataOffset    ;get player sprite data offset
00EF16  1  A5 33                lda PlayerFacingDir         ;get player's facing direction
00EF18  1  4A                   lsr
00EF19  1  B0 04                bcs SwimKT                  ;if player facing to the right, use current offset
00EF1B  1  C8                   iny
00EF1C  1  C8                   iny                         ;otherwise move to next OAM data
00EF1D  1  C8                   iny
00EF1E  1  C8                   iny
00EF1F  1  AD 54 07     SwimKT: lda PlayerSize              ;check player's size
00EF22  1  F0 09                beq BigKTS                  ;if big, use first tile
00EF24  1  B9 19 02             lda Sprite_Tilenumber+24,y  ;check tile number of seventh/eighth sprite
00EF27  1  CD B5 EE             cmp SwimTileRepOffset       ;against tile number in player graphics table
00EF2A  1  F0 07                beq ExPGH                   ;if spr7/spr8 tile number = value, branch to leave
00EF2C  1  E8                   inx                         ;otherwise increment X for second tile
00EF2D  1  BD E7 EE     BigKTS: lda SwimKickTileNum,x       ;overwrite tile number in sprite 7/8
00EF30  1  99 19 02             sta Sprite_Tilenumber+24,y  ;to animate player's feet when swimming
00EF33  1  60           ExPGH:  rts                         ;then leave
