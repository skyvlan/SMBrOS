00D015  1  CE 64 03              dec BowserFeetCounter     ;decrement timer to control bowser's feet
00D018  1  D0 44                 bne NoBFall               ;if not expired, skip all of this
00D01A  1  A9 04                 lda #$04
00D01C  1  8D 64 03              sta BowserFeetCounter     ;otherwise, set timer now
00D01F  1  AD 63 03              lda BowserBodyControls
00D022  1  49 01                 eor #$01                  ;invert bit to control bowser's feet
00D024  1  8D 63 03              sta BowserBodyControls
00D027  1  A9 22                 lda #$22                  ;put high byte of name table address here for now
00D029  1  85 05                 sta $05
00D02B  1  AC 69 03              ldy BridgeCollapseOffset  ;get bridge collapse offset here
00D02E  1  B9 DD CF              lda BridgeCollapseData,y  ;load low byte of name table address and store here
00D031  1  85 04                 sta $04
