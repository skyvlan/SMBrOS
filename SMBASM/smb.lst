00CC38  1  29 20                 and #%00100000
00CC3A  1  F0 03                 beq NotDefB                ;if not set, continue with movement code
00CC3C  1  4C 92 BF              jmp MoveJ_EnemyVertically  ;otherwise jump to move defeated bullet bill downwards
00CC3F  1  A9 E8        NotDefB: lda #$e8                   ;set bullet bill's horizontal speed
00CC41  1  95 58                 sta Enemy_X_Speed,x        ;and move it accordingly (note: this bullet bill
00CC43  1  4C 02 BF              jmp MoveEnemyHorizontally  ;object occurs in frenzy object $17, not from cannons)
