00BA89  1               HammerEnemyOfsData:
00BA89  1  04 04 04 05        .byte $04, $04, $04, $05, $05, $05
00BA8D  1  05 05        
00BA8F  1  06 06 06           .byte $06, $06, $06
00BA92  1               
00BA92  1               HammerXSpdData:
00BA92  1  10 F0              .byte $10, $f0
00BA94  1               
00BA94  1               SpawnHammerObj:
00BA94  1  AD A8 07               lda PseudoRandomBitReg+1 ;get pseudorandom bits from
00BA97  1  29 07                  and #%00000111           ;second part of LSFR
00BA99  1  D0 05                  bne SetMOfs              ;if any bits are set, branch and use as offset
00BA9B  1  AD A8 07               lda PseudoRandomBitReg+1
00BA9E  1  29 08                  and #%00001000           ;get d3 from same part of LSFR
00BAA0  1  A8           SetMOfs:  tay                      ;use either d3 or d2-d0 for offset here
00BAA1  1  B9 2A 00               lda Misc_State,y         ;if any values loaded in
00BAA4  1  D0 19                  bne NoHammer             ;$2a-$32 where offset is then leave with carry clear
00BAA6  1  BE 89 BA               ldx HammerEnemyOfsData,y ;get offset of enemy slot to check using Y as offset
00BAA9  1  B5 0F                  lda Enemy_Flag,x         ;check enemy buffer flag at offset
00BAAB  1  D0 12                  bne NoHammer             ;if buffer flag set, branch to leave with carry clear
00BAAD  1  A6 08                  ldx ObjectOffset         ;get original enemy object offset
00BAAF  1  8A                     txa
00BAB0  1  99 AE 06               sta HammerEnemyOffset,y  ;save here
00BAB3  1  A9 90                  lda #$90
00BAB5  1  99 2A 00               sta Misc_State,y         ;save hammer's state here
00BAB8  1  A9 07                  lda #$07
00BABA  1  99 A2 04               sta Misc_BoundBoxCtrl,y  ;set something else entirely, here
00BABD  1  38                     sec                      ;return with carry set
00BABE  1  60                     rts
