0090CC  1               ;$06 - RAM address low
0090CC  1               ;$07 - RAM address high
0090CC  1               
0090CC  1               InitializeMemory:
0090CC  1  A2 07                      ldx #$07          ;set initial high byte to $0700-$07ff
0090CE  1  A9 00                      lda #$00          ;set initial low byte to start of page (at $00 of page)
0090D0  1  85 06                      sta $06
0090D2  1  86 07        InitPageLoop: stx $07
0090D4  1  E0 01        InitByteLoop: cpx #$01          ;check to see if we're on the stack ($0100-$01ff)
0090D6  1  D0 04                      bne InitByte      ;if not, go ahead anyway
0090D8  1  C0 60                      cpy #$60          ;otherwise, check to see if we're at $0160-$01ff
0090DA  1  B0 02                      bcs SkipByte      ;if so, skip write
0090DC  1  91 06        InitByte:     sta ($06),y       ;otherwise, initialize byte with current low byte in Y
0090DE  1  88           SkipByte:     dey
0090DF  1  C0 FF                      cpy #$ff          ;do this until all bytes in page have been erased
0090E1  1  D0 F1                      bne InitByteLoop
0090E3  1  CA                         dex               ;go onto the next page
0090E4  1  10 EC                      bpl InitPageLoop  ;do this until all pages of memory have been erased
0090E6  1  60                         rts
