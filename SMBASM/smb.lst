009040  1  AD 5C 07                    lda LevelNumber          ;otherwise, world 5, so check level number
009043  1  C9 02                       cmp #Level3              ;if 1 or 2, do not set secondary hard mode flag
009045  1  90 03                       bcc CheckHalfway
