0083F6  1               PrintVictoryMessages:
0083F6  1  AD 49 07                    lda SecondaryMsgCounter   ;load secondary message counter
0083F9  1  D0 48                       bne IncMsgCounter         ;if set, branch to increment message counters
0083FB  1  AD 19 07                    lda PrimaryMsgCounter     ;otherwise load primary message counter
0083FE  1  F0 18                       beq ThankPlayer           ;if set to zero, branch to print first message
008400  1  C9 09                       cmp #$09                  ;if at 9 or above, branch elsewhere (this comparison
008402  1  B0 3F                       bcs IncMsgCounter         ;is residual code, counter never reaches 9)
008404  1  AC 5F 07                    ldy WorldNumber           ;check world number
008407  1  C0 07                       cpy #World8
008409  1  D0 09                       bne MRetainerMsg          ;if not at world 8, skip to next part
00840B  1  C9 03                       cmp #$03                  ;check primary message counter again
00840D  1  90 34                       bcc IncMsgCounter         ;if not at 3 yet (world 8 only), branch to increment
00840F  1  E9 01                       sbc #$01                  ;otherwise subtract one
008411  1  4C 18 84                    jmp ThankPlayer           ;and skip to next part
008414  1  C9 02        MRetainerMsg:  cmp #$02                  ;check primary message counter
008416  1  90 2B                       bcc IncMsgCounter         ;if not at 2 yet (world 1-7 only), branch
008418  1  A8           ThankPlayer:   tay                       ;put primary message counter into Y
008419  1  D0 08                       bne SecondPartMsg         ;if counter nonzero, skip this part, do not print first message
00841B  1  AD 53 07                    lda CurrentPlayer         ;otherwise get player currently on the screen
00841E  1  F0 14                       beq EvalForMusic          ;if mario, branch
008420  1  C8                          iny                       ;otherwise increment Y once for luigi and
008421  1  D0 11                       bne EvalForMusic          ;do an unconditional branch to the same place
008423  1  C8           SecondPartMsg: iny                       ;increment Y to do world 8's message
008424  1  AD 5F 07                    lda WorldNumber
008427  1  C9 07                       cmp #World8               ;check world number
008429  1  F0 09                       beq EvalForMusic          ;if at world 8, branch to next part
00842B  1  88                          dey                       ;otherwise decrement Y for world 1-7's message
00842C  1  C0 04                       cpy #$04                  ;if counter at 4 (world 1-7 only)
00842E  1  B0 26                       bcs SetEndTimer           ;branch to set victory end timer
008430  1  C0 03                       cpy #$03                  ;if counter at 3 (world 1-7 only)
008432  1  B0 0F                       bcs IncMsgCounter         ;branch to keep counting
008434  1  C0 03        EvalForMusic:  cpy #$03                  ;if counter not yet at 3 (world 8 only), branch
008436  1  D0 04                       bne PrintMsg              ;to print message only (note world 1-7 will only
008438  1  A9 04                       lda #VictoryMusic         ;reach this code if counter = 0, and will always branch)
00843A  1  85 FC                       sta EventMusicQueue       ;otherwise load victory music first (world 8 only)
00843C  1  98           PrintMsg:      tya                       ;put primary message counter in A
00843D  1  18                          clc                       ;add $0c or 12 to counter thus giving an appropriate value,
00843E  1  69 0C                       adc #$0c                  ;($0c-$0d = first), ($0e = world 1-7's), ($0f-$12 = world 8's)
008440  1  8D 73 07                    sta VRAM_Buffer_AddrCtrl  ;write message counter to vram address controller
008443  1  AD 49 07     IncMsgCounter: lda SecondaryMsgCounter
008446  1  18                          clc
008447  1  69 04                       adc #$04                      ;add four to secondary message counter
008449  1  8D 49 07                    sta SecondaryMsgCounter
00844C  1  AD 19 07                    lda PrimaryMsgCounter
00844F  1  69 00                       adc #$00                      ;add carry to primary message counter
008451  1  8D 19 07                    sta PrimaryMsgCounter
008454  1  C9 07                       cmp #$07                      ;check primary counter one more time
008456  1  90 08        SetEndTimer:   bcc ExitMsgs                  ;if not reached value yet, branch to leave
008458  1  A9 06                       lda #$06
00845A  1  8D A1 07                    sta WorldEndTimer             ;otherwise set world end timer
00845D  1  EE 72 07     IncModeTask_A: inc OperMode_Task             ;move onto next task in mode
008460  1  60           ExitMsgs:      rts                           ;leave
