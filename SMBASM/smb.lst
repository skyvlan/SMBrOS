00BB24  1  95 C2                  sta Misc_Y_HighPos,x       ;set hammer's vertical high byte
00BB26  1  D0 03                  bne RunHSubs               ;unconditional branch to skip first routine
00BB28  1  20 C4 D7     RunAllH:  jsr PlayerHammerCollision  ;handle collisions
