00C144  1               ;$06 - used to hold page location of extended right boundary
00C144  1               ;$07 - used to hold high nybble of position of extended right boundary
00C144  1               
00C144  1               ProcessEnemyData:
00C144  1  AC 39 07             ldy EnemyDataOffset      ;get offset of enemy object data
00C147  1  B1 E9                lda (EnemyData),y        ;load first byte
00C149  1  C9 FF                cmp #$ff                 ;check for EOD terminator
00C14B  1  D0 03                bne CheckEndofBuffer
