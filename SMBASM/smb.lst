008662  1  9D 01 03           sta VRAM_Buffer1,x
008665  1  A9 73              lda #$73
008667  1  9D 02 03           sta VRAM_Buffer1+1,x
00866A  1  A9 03              lda #$03                ;write length for it
00866C  1  9D 03 03           sta VRAM_Buffer1+2,x
00866F  1  AC 5F 07           ldy WorldNumber         ;first the world number
008672  1  C8                 iny
008673  1  98                 tya
008674  1  9D 04 03           sta VRAM_Buffer1+3,x
