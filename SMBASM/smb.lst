0086FF  1               DrawTitleScreen:
0086FF  1  AD 70 07                 lda OperMode                 ;are we in title screen mode?
008702  1  D0 4A                    bne IncModeTask_B            ;if not, exit
008704  1  A9 1E                    lda #>TitleScreenDataOffset  ;load address $1ec0 into
008706  1  8D 06 20                 sta PPU_ADDRESS              ;the vram address register
008709  1  A9 C0                    lda #<TitleScreenDataOffset
00870B  1  8D 06 20                 sta PPU_ADDRESS
00870E  1  A9 03                    lda #$03                     ;put address $0300 into
008710  1  85 01                    sta $01                      ;the indirect at $00
008712  1  A0 00                    ldy #$00
008714  1  84 00                    sty $00
008716  1  AD 07 20                 lda PPU_DATA                 ;do one garbage read
008719  1  AD 07 20     OutputTScr: lda PPU_DATA                 ;get title screen from chr-rom
00871C  1  91 00                    sta ($00),y                  ;store 256 bytes into buffer
00871E  1  C8                       iny
00871F  1  D0 02                    bne ChkHiByte                ;if not past 256 bytes, do not increment
008721  1  E6 01                    inc $01                      ;otherwise increment high byte of indirect
008723  1  A5 01        ChkHiByte:  lda $01                      ;check high byte?
008725  1  C9 04                    cmp #$04                     ;at $0400?
008727  1  D0 F0                    bne OutputTScr               ;if not, loop back and do another
008729  1  C0 3A                    cpy #$3a                     ;check if offset points past end of data
00872B  1  90 EC                    bcc OutputTScr               ;if not, loop back and do another
00872D  1  A9 05                    lda #$05                     ;set buffer transfer control to $0300,
00872F  1  4C 4C 86                 jmp SetVRAMAddr_B            ;increment task and exit
