00AEDC  1               
00AEDC  1               ;indirect jump routine called when
00AEDC  1               ;$0770 is set to 1
00AEDC  1               GameMode:
00AEDC  1  AD 72 07           lda OperMode_Task
00AEDF  1  20 04 8E           jsr JumpEngine
00AEE2  1               
00AEE2  1  E4 8F              .word InitializeArea
00AEE4  1  67 85              .word ScreenRoutines
00AEE6  1  71 90              .word SecondaryGameSetup
00AEE8  1  EA AE              .word GameCoreRoutine
00AEEA  1               
00AEEA  1               ;-------------------------------------------------------------------------------------
00AEEA  1               
00AEEA  1               GameCoreRoutine:
00AEEA  1  AE 53 07           ldx CurrentPlayer          ;get which player is on the screen
00AEED  1  BD FC 06           lda SavedJoypadBits,x      ;use appropriate player's controller bits
00AEF0  1  8D FC 06           sta SavedJoypadBits        ;as the master controller bits
00AEF3  1  20 4A B0           jsr GameRoutines           ;execute one of many possible subs
00AEF6  1  AD 72 07           lda OperMode_Task          ;check major task of operating mode
00AEF9  1  C9 03              cmp #$03                   ;if we are supposed to be here,
00AEFB  1  B0 01              bcs GameEngine             ;branch to the game engine itself
00AEFD  1  60                 rts
00AEFE  1               
00AEFE  1               GameEngine:
00AEFE  1  20 24 B6                   jsr ProcFireball_Bubble    ;process fireballs and air bubbles
00AF01  1  A2 00                      ldx #$00
00AF03  1  86 08        ProcELoop:    stx ObjectOffset           ;put incremented offset in X as enemy object offset
00AF05  1  20 47 C0                   jsr EnemiesAndLoopsCore    ;process enemy objects
00AF08  1  20 C3 84                   jsr FloateyNumbersRoutine  ;process floatey numbers
00AF0B  1  E8                         inx
00AF0C  1  E0 06                      cpx #$06                   ;do these two subroutines until the whole buffer is done
00AF0E  1  D0 F3                      bne ProcELoop
00AF10  1  20 80 F1                   jsr GetPlayerOffscreenBits ;get offscreen bits for player object
00AF13  1  20 2A F1                   jsr RelativePlayerPosition ;get relative coordinates for player object
00AF16  1  20 E9 EE                   jsr PlayerGfxHandler       ;draw the player
00AF19  1  20 D4 BE                   jsr BlockObjMT_Updater     ;replace block objects with metatiles if necessary
00AF1C  1  A2 01                      ldx #$01
00AF1E  1  86 08                      stx ObjectOffset           ;set offset for second
00AF20  1  20 70 BE                   jsr BlockObjectsCore       ;process second block object
00AF23  1  CA                         dex
00AF24  1  86 08                      stx ObjectOffset           ;set offset for first
00AF26  1  20 70 BE                   jsr BlockObjectsCore       ;process first block object
00AF29  1  20 96 BB                   jsr MiscObjectsCore        ;process misc objects (hammer, jumping coins)
00AF2C  1  20 BC B9                   jsr ProcessCannons         ;process bullet bill cannons
00AF2F  1  20 B8 B7                   jsr ProcessWhirlpools      ;process whirlpools
00AF32  1  20 55 B8                   jsr FlagpoleRoutine        ;process the flagpole
00AF35  1  20 4F B7                   jsr RunGameTimer           ;count down the game timer
00AF38  1  20 E1 89                   jsr ColorRotation          ;cycle one of the background colors
00AF3B  1  A5 B5                      lda Player_Y_HighPos
00AF3D  1  C9 02                      cmp #$02                   ;if player is below the screen, don't bother with the music
00AF3F  1  10 11                      bpl NoChgMus
00AF41  1  AD 9F 07                   lda StarInvincibleTimer    ;if star mario invincibility timer at zero,
00AF44  1  F0 1E                      beq ClrPlrPal              ;skip this part
00AF46  1  C9 04                      cmp #$04
00AF48  1  D0 08                      bne NoChgMus               ;if not yet at a certain point, continue
00AF4A  1  AD 7F 07                   lda IntervalTimerControl   ;if interval timer not yet expired,
00AF4D  1  D0 03                      bne NoChgMus               ;branch ahead, don't bother with the music
00AF4F  1  20 ED 90                   jsr GetAreaMusic           ;to re-attain appropriate level music
00AF52  1  AC 9F 07     NoChgMus:     ldy StarInvincibleTimer    ;get invincibility timer
00AF55  1  A5 09                      lda FrameCounter           ;get frame counter
00AF57  1  C0 08                      cpy #$08                   ;if timer still above certain point,
00AF59  1  B0 02                      bcs CycleTwo               ;branch to cycle player's palette quickly
00AF5B  1  4A                         lsr                        ;otherwise, divide by 8 to cycle every eighth frame
00AF5C  1  4A                         lsr
00AF5D  1  4A           CycleTwo:     lsr                        ;if branched here, divide by 2 to cycle every other frame
00AF5E  1  20 88 B2                   jsr CyclePlayerPalette     ;do sub to cycle the palette (note: shares fire flower code)
00AF61  1  4C 67 AF                   jmp SaveAB                 ;then skip this sub to finish up the game engine
00AF64  1  20 9A B2     ClrPlrPal:    jsr ResetPalStar           ;do sub to clear player's palette bits in attributes
00AF67  1  A5 0A        SaveAB:       lda A_B_Buttons            ;save current A and B button
00AF69  1  85 0D                      sta PreviousA_B_Buttons    ;into temp variable to be used on next frame
00AF6B  1  A9 00                      lda #$00
00AF6D  1  85 0C                      sta Left_Right_Buttons     ;nullify left and right buttons temp variable
00AF6F  1  AD 73 07     UpdScrollVar: lda VRAM_Buffer_AddrCtrl
00AF72  1  C9 06                      cmp #$06                   ;if vram address controller set to 6 (one of two $0341s)
00AF74  1  F0 1C                      beq ExitEng                ;then branch to leave
00AF76  1  AD 1F 07                   lda AreaParserTaskNum      ;otherwise check number of tasks
00AF79  1  D0 14                      bne RunParser
00AF7B  1  AD 3D 07                   lda ScrollThirtyTwo        ;get horizontal scroll in 0-31 or $00-$20 range
00AF7E  1  C9 20                      cmp #$20                   ;check to see if exceeded $21
00AF80  1  30 10                      bmi ExitEng                ;branch to leave if not
00AF82  1  AD 3D 07                   lda ScrollThirtyTwo
00AF85  1  E9 20                      sbc #$20                   ;otherwise subtract $20 to set appropriately
00AF87  1  8D 3D 07                   sta ScrollThirtyTwo        ;and store
00AF8A  1  A9 00                      lda #$00                   ;reset vram buffer offset used in conjunction with
00AF8C  1  8D 40 03                   sta VRAM_Buffer2_Offset    ;level graphics buffer at $0341-$035f
00AF8F  1  20 B0 92     RunParser:    jsr AreaParserTaskHandler  ;update the name table with more level graphics
00AF92  1  60           ExitEng:      rts                        ;and after all that, we're finally done!
00AF93  1               
00AF93  1               ;-------------------------------------------------------------------------------------
00AF93  1               
00AF93  1               ScrollHandler:
00AF93  1  AD FF 06                 lda Player_X_Scroll       ;load value saved here
00AF96  1  18                       clc
00AF97  1  6D A1 03                 adc Platform_X_Scroll     ;add value used by left/right platforms
00AF9A  1  8D FF 06                 sta Player_X_Scroll       ;save as new value here to impose force on scroll
00AF9D  1  AD 23 07                 lda ScrollLock            ;check scroll lock flag
00AFA0  1  D0 59                    bne InitScrlAmt           ;skip a bunch of code here if set
00AFA2  1  AD 55 07                 lda Player_Pos_ForScroll
00AFA5  1  C9 50                    cmp #$50                  ;check player's horizontal screen position
00AFA7  1  90 52                    bcc InitScrlAmt           ;if less than 80 pixels to the right, branch
00AFA9  1  AD 85 07                 lda SideCollisionTimer    ;if timer related to player's side collision
00AFAC  1  D0 4D                    bne InitScrlAmt           ;not expired, branch
00AFAE  1  AC FF 06                 ldy Player_X_Scroll       ;get value and decrement by one
00AFB1  1  88                       dey                       ;if value originally set to zero or otherwise
00AFB2  1  30 47                    bmi InitScrlAmt           ;negative for left movement, branch
00AFB4  1  C8                       iny
00AFB5  1  C0 02                    cpy #$02                  ;if value $01, branch and do not decrement
00AFB7  1  90 01                    bcc ChkNearMid
00AFB9  1  88                       dey                       ;otherwise decrement by one
00AFBA  1  AD 55 07     ChkNearMid: lda Player_Pos_ForScroll
00AFBD  1  C9 70                    cmp #$70                  ;check player's horizontal screen position
00AFBF  1  90 03                    bcc ScrollScreen          ;if less than 112 pixels to the right, branch
00AFC1  1  AC FF 06                 ldy Player_X_Scroll       ;otherwise get original value undecremented
00AFC4  1               
00AFC4  1               ScrollScreen:
00AFC4  1  98                         tya
00AFC5  1  8D 75 07                   sta ScrollAmount          ;save value here
00AFC8  1  18                         clc
00AFC9  1  6D 3D 07                   adc ScrollThirtyTwo       ;add to value already set here
00AFCC  1  8D 3D 07                   sta ScrollThirtyTwo       ;save as new value here
00AFCF  1  98                         tya
00AFD0  1  18                         clc
00AFD1  1  6D 1C 07                   adc ScreenLeft_X_Pos      ;add to left side coordinate
00AFD4  1  8D 1C 07                   sta ScreenLeft_X_Pos      ;save as new left side coordinate
00AFD7  1  8D 3F 07                   sta HorizontalScroll      ;save here also
00AFDA  1  AD 1A 07                   lda ScreenLeft_PageLoc
00AFDD  1  69 00                      adc #$00                  ;add carry to page location for left
00AFDF  1  8D 1A 07                   sta ScreenLeft_PageLoc    ;side of the screen
00AFE2  1  29 01                      and #$01                  ;get LSB of page location
00AFE4  1  85 00                      sta $00                   ;save as temp variable for PPU register 1 mirror
00AFE6  1  AD 78 07                   lda Mirror_PPU_CTRL_REG1  ;get PPU register 1 mirror
00AFE9  1  29 FE                      and #%11111110            ;save all bits except d0
00AFEB  1  05 00                      ora $00                   ;get saved bit here and save in PPU register 1
00AFED  1  8D 78 07                   sta Mirror_PPU_CTRL_REG1  ;mirror to be used to set name table later
00AFF0  1  20 38 B0                   jsr GetScreenPosition     ;figure out where the right side is
00AFF3  1  A9 08                      lda #$08
00AFF5  1  8D 95 07                   sta ScrollIntervalTimer   ;set scroll timer (residual, not used elsewhere)
00AFF8  1  4C 00 B0                   jmp ChkPOffscr            ;skip this part
00AFFB  1  A9 00        InitScrlAmt:  lda #$00
00AFFD  1  8D 75 07                   sta ScrollAmount          ;initialize value here
00B000  1  A2 00        ChkPOffscr:   ldx #$00                  ;set X for player offset
00B002  1  20 F6 F1                   jsr GetXOffscreenBits     ;get horizontal offscreen bits for player
00B005  1  85 00                      sta $00                   ;save them here
00B007  1  A0 00                      ldy #$00                  ;load default offset (left side)
00B009  1  0A                         asl                       ;if d7 of offscreen bits are set,
00B00A  1  B0 07                      bcs KeepOnscr             ;branch with default offset
00B00C  1  C8                         iny                         ;otherwise use different offset (right side)
00B00D  1  A5 00                      lda $00
00B00F  1  29 20                      and #%00100000              ;check offscreen bits for d5 set
00B011  1  F0 1B                      beq InitPlatScrl            ;if not set, branch ahead of this part
00B013  1  B9 1C 07     KeepOnscr:    lda ScreenEdge_X_Pos,y      ;get left or right side coordinate based on offset
00B016  1  38                         sec
00B017  1  F9 34 B0                   sbc X_SubtracterData,y      ;subtract amount based on offset
00B01A  1  85 86                      sta Player_X_Position       ;store as player position to prevent movement further
00B01C  1  B9 1A 07                   lda ScreenEdge_PageLoc,y    ;get left or right page location based on offset
00B01F  1  E9 00                      sbc #$00                    ;subtract borrow
00B021  1  85 6D                      sta Player_PageLoc          ;save as player's page location
00B023  1  A5 0C                      lda Left_Right_Buttons      ;check saved controller bits
00B025  1  D9 36 B0                   cmp OffscrJoypadBitsData,y  ;against bits based on offset
00B028  1  F0 04                      beq InitPlatScrl            ;if not equal, branch
00B02A  1  A9 00                      lda #$00
00B02C  1  85 57                      sta Player_X_Speed          ;otherwise nullify horizontal speed of player
00B02E  1  A9 00        InitPlatScrl: lda #$00                    ;nullify platform force imposed on scroll
00B030  1  8D A1 03                   sta Platform_X_Scroll
00B033  1  60                         rts
00B034  1               
00B034  1               X_SubtracterData:
00B034  1  00 10              .byte $00, $10
00B036  1               
00B036  1               OffscrJoypadBitsData:
00B036  1  01 02              .byte $01, $02
00B038  1               
00B038  1               ;-------------------------------------------------------------------------------------
00B038  1               
00B038  1               GetScreenPosition:
00B038  1  AD 1C 07           lda ScreenLeft_X_Pos    ;get coordinate of screen's left boundary
00B03B  1  18                 clc
00B03C  1  69 FF              adc #$ff                ;add 255 pixels
00B03E  1  8D 1D 07           sta ScreenRight_X_Pos   ;store as coordinate of screen's right boundary
00B041  1  AD 1A 07           lda ScreenLeft_PageLoc  ;get page number where left boundary is
00B044  1  69 00              adc #$00                ;add carry from before
00B046  1  8D 1B 07           sta ScreenRight_PageLoc ;store as page number where right boundary is
00B049  1  60                 rts
00B04A  1               
00B04A  1               ;-------------------------------------------------------------------------------------
