00B315  1  EE 60 07     NextArea: inc AreaNumber            ;increment area number used for address loader
00B318  1  20 03 9C               jsr LoadAreaPointer       ;get new level pointer
00B31B  1  EE 57 07               inc FetchNewGameTimerFlag ;set flag to load new game timer
00B31E  1  20 13 B2               jsr ChgAreaMode           ;do sub to set secondary mode, disable screen and sprite 0
00B321  1  8D 5B 07               sta HalfwayPage           ;reset halfway page to 0 (beginning)
00B324  1  A9 80                  lda #Silence
00B326  1  85 FC                  sta EventMusicQueue       ;silence music and leave
00B328  1  60           ExitNA:   rts
00B329  1               
00B329  1               ;-------------------------------------------------------------------------------------
00B329  1               
00B329  1               PlayerMovementSubs:
00B329  1  A9 00                   lda #$00                  ;set A to init crouch flag by default
00B32B  1  AC 54 07                ldy PlayerSize            ;is player small?
00B32E  1  D0 08                   bne SetCrouch             ;if so, branch
00B330  1  A5 1D                   lda Player_State          ;check state of player
00B332  1  D0 07                   bne ProcMove              ;if not on the ground, branch
00B334  1  A5 0B                   lda Up_Down_Buttons       ;load controller bits for up and down
00B336  1  29 04                   and #%00000100            ;single out bit for down button
00B338  1  8D 14 07     SetCrouch: sta CrouchingFlag         ;store value in crouch flag
00B33B  1  20 50 B4     ProcMove:  jsr PlayerPhysicsSub      ;run sub related to jumping and swimming
00B33E  1  AD 0B 07                lda PlayerChangeSizeFlag  ;if growing/shrinking flag set,
00B341  1  D0 16                   bne NoMoveSub             ;branch to leave
00B343  1  A5 1D                   lda Player_State
00B345  1  C9 03                   cmp #$03                  ;get player state
00B347  1  F0 05                   beq MoveSubs              ;if climbing, branch ahead, leave timer unset
00B349  1  A0 18                   ldy #$18
00B34B  1  8C 89 07                sty ClimbSideTimer        ;otherwise reset timer now
00B34E  1  20 04 8E     MoveSubs:  jsr JumpEngine
00B351  1               
00B351  1  5A B3              .word OnGroundStateSub
00B353  1  76 B3              .word JumpSwimSub
00B355  1  6D B3              .word FallingSub
00B357  1  CF B3              .word ClimbingSub
00B359  1               
00B359  1  60           NoMoveSub: rts
