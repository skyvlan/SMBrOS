00D1EB  1               ProcBowserFlame:
00D1EB  1  AD 47 07              lda TimerControl            ;if master timer control flag set,
00D1EE  1  D0 30                 bne SetGfxF                 ;skip all of this
00D1F0  1  A9 40                 lda #$40                    ;load default movement force
00D1F2  1  AC CC 06              ldy SecondaryHardMode
00D1F5  1  F0 02                 beq SFlmX                   ;if secondary hard mode flag not set, use default
00D1F7  1  A9 60                 lda #$60                    ;otherwise load alternate movement force to go faster
00D1F9  1  85 00        SFlmX:   sta $00                     ;store value here
00D1FB  1  BD 01 04              lda Enemy_X_MoveForce,x
00D1FE  1  38                    sec                         ;subtract value from movement force
00D1FF  1  E5 00                 sbc $00
00D201  1  9D 01 04              sta Enemy_X_MoveForce,x     ;save new value
00D204  1  B5 87                 lda Enemy_X_Position,x
00D206  1  E9 01                 sbc #$01                    ;subtract one from horizontal position to move
00D208  1  95 87                 sta Enemy_X_Position,x      ;to the left
00D20A  1  B5 6E                 lda Enemy_PageLoc,x
00D20C  1  E9 00                 sbc #$00                    ;subtract borrow from page location
00D20E  1  95 6E                 sta Enemy_PageLoc,x
00D210  1  BC 17 04              ldy BowserFlamePRandomOfs,x ;get some value here and use as offset
00D213  1  B5 CF                 lda Enemy_Y_Position,x      ;load vertical coordinate
00D215  1  D9 9D C5              cmp FlameYPosData,y         ;compare against coordinate data using $0417,x as offset
00D218  1  F0 06                 beq SetGfxF                 ;if equal, branch and do not modify coordinate
00D21A  1  18                    clc
00D21B  1  7D 34 04              adc Enemy_Y_MoveForce,x     ;otherwise add value here to coordinate and store
00D21E  1  95 CF                 sta Enemy_Y_Position,x      ;as new vertical coordinate
00D220  1  20 52 F1     SetGfxF: jsr RelativeEnemyPosition   ;get new relative coordinates
00D223  1  B5 1E                 lda Enemy_State,x           ;if bowser's flame not in normal state,
00D225  1  D0 C3                 bne ExFl                    ;branch to leave
00D227  1  A9 51                 lda #$51                    ;otherwise, continue
00D229  1  85 00                 sta $00                     ;write first tile number
00D22B  1  A0 02                 ldy #$02                    ;load attributes without vertical flip by default
00D22D  1  A5 09                 lda FrameCounter
00D22F  1  29 02                 and #%00000010              ;invert vertical flip bit every 2 frames
00D231  1  F0 02                 beq FlmeAt                  ;if d1 not set, write default value
00D233  1  A0 82                 ldy #$82                    ;otherwise write value with vertical flip bit set
00D235  1  84 01        FlmeAt:  sty $01                     ;set bowser's flame sprite attributes here
00D237  1  BC E5 06              ldy Enemy_SprDataOffset,x   ;get OAM data offset
00D23A  1  A2 00                 ldx #$00
00D23C  1               
00D23C  1               DrawFlameLoop:
00D23C  1  AD B9 03              lda Enemy_Rel_YPos         ;get Y relative coordinate of current enemy object
00D23F  1  99 00 02              sta Sprite_Y_Position,y    ;write into Y coordinate of OAM data
00D242  1  A5 00                 lda $00
00D244  1  99 01 02              sta Sprite_Tilenumber,y    ;write current tile number into OAM data
00D247  1  E6 00                 inc $00                    ;increment tile number to draw more bowser's flame
00D249  1  A5 01                 lda $01
00D24B  1  99 02 02              sta Sprite_Attributes,y    ;write saved attributes into OAM data
00D24E  1  AD AE 03              lda Enemy_Rel_XPos
00D251  1  99 03 02              sta Sprite_X_Position,y    ;write X relative coordinate of current enemy object
00D254  1  18                    clc
00D255  1  69 08                 adc #$08
00D257  1  8D AE 03              sta Enemy_Rel_XPos         ;then add eight to it and store
00D25A  1  C8                    iny
00D25B  1  C8                    iny
00D25C  1  C8                    iny
00D25D  1  C8                    iny                        ;increment Y four times to move onto the next OAM
00D25E  1  E8                    inx                        ;move onto the next OAM, and branch if three
00D25F  1  E0 03                 cpx #$03                   ;have not yet been done
00D261  1  90 D9                 bcc DrawFlameLoop
00D263  1  A6 08                 ldx ObjectOffset           ;reload original enemy offset
00D265  1  20 AF F1              jsr GetEnemyOffscreenBits  ;get offscreen information
00D268  1  BC E5 06              ldy Enemy_SprDataOffset,x  ;get OAM data offset
00D26B  1  AD D1 03              lda Enemy_OffscreenBits    ;get enemy object offscreen bits
00D26E  1  4A                    lsr                        ;move d0 to carry and result to stack
00D26F  1  48                    pha
00D270  1  90 05                 bcc M3FOfs                 ;branch if carry not set
00D272  1  A9 F8                 lda #$f8                   ;otherwise move sprite offscreen, this part likely
00D274  1  99 0C 02              sta Sprite_Y_Position+12,y ;residual since flame is only made of three sprites
00D277  1  68           M3FOfs:  pla                        ;get bits from stack
00D278  1  4A                    lsr                        ;move d1 to carry and move bits back to stack
00D279  1  48                    pha
00D27A  1  90 05                 bcc M2FOfs                 ;branch if carry not set again
00D27C  1  A9 F8                 lda #$f8                   ;otherwise move third sprite offscreen
00D27E  1  99 08 02              sta Sprite_Y_Position+8,y
00D281  1  68           M2FOfs:  pla                        ;get bits from stack again
00D282  1  4A                    lsr                        ;move d2 to carry and move bits back to stack again
00D283  1  48                    pha
00D284  1  90 05                 bcc M1FOfs                 ;branch if carry not set yet again
00D286  1  A9 F8                 lda #$f8                   ;otherwise move second sprite offscreen
00D288  1  99 04 02              sta Sprite_Y_Position+4,y
00D28B  1  68           M1FOfs:  pla                        ;get bits from stack one last time
00D28C  1  4A                    lsr                        ;move d3 to carry
00D28D  1  90 05                 bcc ExFlmeD                ;branch if carry not set one last time
00D28F  1  A9 F8                 lda #$f8
00D291  1  99 00 02              sta Sprite_Y_Position,y    ;otherwise move first sprite offscreen
00D294  1  60           ExFlmeD: rts                        ;leave
