0085C2  1  BE BB 85                    ldx AreaPalette,y        ;based on area type
0085C5  1  8E 73 07     SetVRAMAddr_A: stx VRAM_Buffer_AddrCtrl ;store offset into buffer control
0085C8  1  4C 45 87     NextSubtask:   jmp IncSubtask           ;move onto next task
0085CB  1               
0085CB  1               ;-------------------------------------------------------------------------------------
0085CB  1               ;$00 - used as temp counter in GetPlayerColors
0085CB  1               
0085CB  1               BGColorCtrl_Addr:
0085CB  1  00 09 0A 04        .byte $00, $09, $0a, $04
0085CF  1               
0085CF  1               BackgroundColors:
0085CF  1  22 22 0F 0F        .byte $22, $22, $0f, $0f ;used by area type if bg color ctrl not set
0085D3  1  0F 22 0F 0F        .byte $0f, $22, $0f, $0f ;used by background color control if set
0085D7  1               
0085D7  1               PlayerColors:
0085D7  1  22 16 27 18        .byte $22, $16, $27, $18 ;mario's colors
0085DB  1  22 30 27 19        .byte $22, $30, $27, $19 ;luigi's colors
0085DF  1  22 37 27 16        .byte $22, $37, $27, $16 ;fiery (used by both)
0085E3  1               
0085E3  1               GetBackgroundColor:
0085E3  1  AC 44 07                ldy BackgroundColorCtrl   ;check background color control
0085E6  1  F0 06                   beq NoBGColor             ;if not set, increment task and fetch palette
0085E8  1  B9 C7 85                lda BGColorCtrl_Addr-4,y  ;put appropriate palette into vram
0085EB  1  8D 73 07                sta VRAM_Buffer_AddrCtrl  ;note that if set to 5-7, $0301 will not be read
0085EE  1  EE 3C 07     NoBGColor: inc ScreenRoutineTask     ;increment to next subtask and plod on through
0085F1  1               
0085F1  1               GetPlayerColors:
0085F1  1  AE 00 03                    ldx VRAM_Buffer1_Offset  ;get current buffer offset
0085F4  1  A0 00                       ldy #$00
0085F6  1  AD 53 07                    lda CurrentPlayer        ;check which player is on the screen
0085F9  1  F0 02                       beq ChkFiery
0085FB  1  A0 04                       ldy #$04                 ;load offset for luigi
0085FD  1  AD 56 07     ChkFiery:      lda PlayerStatus         ;check player status
008600  1  C9 02                       cmp #$02
008602  1  D0 02                       bne StartClrGet          ;if fiery, load alternate offset for fiery player
008604  1  A0 08                       ldy #$08
008606  1  A9 03        StartClrGet:   lda #$03                 ;do four colors
008608  1  85 00                       sta $00
00860A  1  B9 D7 85     ClrGetLoop:    lda PlayerColors,y       ;fetch player colors and store them
00860D  1  9D 04 03                    sta VRAM_Buffer1+3,x     ;in the buffer
008610  1  C8                          iny
008611  1  E8                          inx
008612  1  C6 00                       dec $00
008614  1  10 F4                       bpl ClrGetLoop
008616  1  AE 00 03                    ldx VRAM_Buffer1_Offset  ;load original offset from before
008619  1  AC 44 07                    ldy BackgroundColorCtrl  ;if this value is four or greater, it will be set
00861C  1  D0 03                       bne SetBGColor           ;therefore use it as offset to background color
00861E  1  AC 4E 07                    ldy AreaType             ;otherwise use area type bits from area offset as offset
008621  1  B9 CF 85     SetBGColor:    lda BackgroundColors,y   ;to background color instead
008624  1  9D 04 03                    sta VRAM_Buffer1+3,x
008627  1  A9 3F                       lda #$3f                 ;set for sprite palette address
008629  1  9D 01 03                    sta VRAM_Buffer1,x       ;save to buffer
00862C  1  A9 10                       lda #$10
00862E  1  9D 02 03                    sta VRAM_Buffer1+1,x
008631  1  A9 04                       lda #$04                 ;write length byte to buffer
008633  1  9D 03 03                    sta VRAM_Buffer1+2,x
008636  1  A9 00                       lda #$00                 ;now the null terminator
008638  1  9D 08 03                    sta VRAM_Buffer1+7,x
00863B  1  8A                          txa                      ;move the buffer pointer ahead 7 bytes
00863C  1  18                          clc                      ;in case we want to write anything else later
00863D  1  69 07                       adc #$07
00863F  1  8D 00 03     SetVRAMOffset: sta VRAM_Buffer1_Offset  ;store as new vram buffer offset
008642  1  60                          rts
