00E533  1  29 FC                    and #%11111100              ;check offscreen bits
00E535  1  F0 09                    beq NoHOffscr               ;if all bits clear, leave object alone
00E537  1  A9 00                    lda #$00
00E539  1  95 2A                    sta Misc_State,x            ;otherwise nullify misc object state
00E53B  1  A9 F8                    lda #$f8
00E53D  1  20 C1 E5                 jsr DumpTwoSpr              ;do sub to move hammer sprites offscreen
00E540  1  60           NoHOffscr:  rts                         ;leave
