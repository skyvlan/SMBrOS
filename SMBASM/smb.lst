00CB25  1               ;$00 - used to store adder for movement, also used as adder for platform
00CB25  1               ;$01 - used to store maximum value for secondary counter
00CB25  1               
00CB25  1               MoveFlyGreenPTroopa:
00CB25  1  20 45 CB             jsr XMoveCntr_GreenPTroopa ;do sub to increment primary and secondary counters
00CB28  1  20 66 CB             jsr MoveWithXMCntrs        ;do sub to move green paratroopa accordingly, and horizontally
00CB2B  1  A0 01                ldy #$01                   ;set Y to move green paratroopa down
00CB2D  1  A5 09                lda FrameCounter
00CB2F  1  29 03                and #%00000011             ;check frame counter 2 LSB for any bits set
00CB31  1  D0 11                bne NoMGPT                 ;branch to leave if set to move up/down every fourth frame
00CB33  1  A5 09                lda FrameCounter
00CB35  1  29 40                and #%01000000             ;check frame counter for d6 set
00CB37  1  D0 02                bne YSway                  ;branch to move green paratroopa down if set
00CB39  1  A0 FF                ldy #$ff                   ;otherwise set Y to move green paratroopa up
00CB3B  1  84 00        YSway:  sty $00                    ;store adder here
00CB3D  1  B5 CF                lda Enemy_Y_Position,x
00CB3F  1  18                   clc                        ;add or subtract from vertical position
00CB40  1  65 00                adc $00                    ;to give green paratroopa a wavy flight
00CB42  1  95 CF                sta Enemy_Y_Position,x
00CB44  1  60           NoMGPT: rts                        ;leave!
00CB45  1               
00CB45  1               XMoveCntr_GreenPTroopa:
00CB45  1  A9 13                 lda #$13                    ;load preset maximum value for secondary counter
00CB47  1               
00CB47  1               XMoveCntr_Platform:
00CB47  1  85 01                 sta $01                     ;store value here
00CB49  1  A5 09                 lda FrameCounter
00CB4B  1  29 03                 and #%00000011              ;branch to leave if not on
00CB4D  1  D0 0D                 bne NoIncXM                 ;every fourth frame
00CB4F  1  B4 58                 ldy XMoveSecondaryCounter,x ;get secondary counter
00CB51  1  B5 A0                 lda XMovePrimaryCounter,x   ;get primary counter
00CB53  1  4A                    lsr
00CB54  1  B0 0A                 bcs DecSeXM                 ;if d0 of primary counter set, branch elsewhere
00CB56  1  C4 01                 cpy $01                     ;compare secondary counter to preset maximum value
00CB58  1  F0 03                 beq IncPXM                  ;if equal, branch ahead of this part
00CB5A  1  F6 58                 inc XMoveSecondaryCounter,x ;increment secondary counter and leave
00CB5C  1  60           NoIncXM: rts
00CB5D  1  F6 A0        IncPXM:  inc XMovePrimaryCounter,x   ;increment primary counter and leave
00CB5F  1  60                    rts
00CB60  1  98           DecSeXM: tya                         ;put secondary counter in A
00CB61  1  F0 FA                 beq IncPXM                  ;if secondary counter at zero, branch back
00CB63  1  D6 58                 dec XMoveSecondaryCounter,x ;otherwise decrement secondary counter and leave
00CB65  1  60                    rts
00CB66  1               
00CB66  1               MoveWithXMCntrs:
00CB66  1  B5 58                 lda XMoveSecondaryCounter,x  ;save secondary counter to stack
00CB68  1  48                    pha
00CB69  1  A0 01                 ldy #$01                     ;set value here by default
00CB6B  1  B5 A0                 lda XMovePrimaryCounter,x
00CB6D  1  29 02                 and #%00000010               ;if d1 of primary counter is
00CB6F  1  D0 0B                 bne XMRight                  ;set, branch ahead of this part here
00CB71  1  B5 58                 lda XMoveSecondaryCounter,x
00CB73  1  49 FF                 eor #$ff                     ;otherwise change secondary
00CB75  1  18                    clc                          ;counter to two's compliment
00CB76  1  69 01                 adc #$01
00CB78  1  95 58                 sta XMoveSecondaryCounter,x
00CB7A  1  A0 02                 ldy #$02                     ;load alternate value here
00CB7C  1  94 46        XMRight: sty Enemy_MovingDir,x        ;store as moving direction
00CB7E  1  20 02 BF              jsr MoveEnemyHorizontally
00CB81  1  85 00                 sta $00                      ;save value obtained from sub here
00CB83  1  68                    pla                          ;get secondary counter from stack
00CB84  1  95 58                 sta XMoveSecondaryCounter,x  ;and return to original place
00CB86  1  60                    rts
