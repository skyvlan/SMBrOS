009BAC  1               ChkLrgObjLength:
009BAC  1  20 BB 9B             jsr GetLrgObjAttrib     ;get row location and size (length if branched to from here)
009BAF  1               
009BAF  1               ChkLrgObjFixedLength:
009BAF  1  BD 30 07             lda AreaObjectLength,x  ;check for set length counter
009BB2  1  18                   clc                     ;clear carry flag for not just starting
009BB3  1  10 05                bpl LenSet              ;if counter not set, load it, otherwise leave alone
009BB5  1  98                   tya                     ;save length into length counter
009BB6  1  9D 30 07             sta AreaObjectLength,x
009BB9  1  38                   sec                     ;set carry flag if just starting
009BBA  1  60           LenSet: rts
009BBB  1               
009BBB  1               
009BBB  1               GetLrgObjAttrib:
009BBB  1  BC 2D 07           ldy AreaObjOffsetBuffer,x ;get offset saved from area obj decoding routine
009BBE  1  B1 E7              lda (AreaData),y          ;get first byte of level object
009BC0  1  29 0F              and #%00001111
009BC2  1  85 07              sta $07                   ;save row location
009BC4  1  C8                 iny
009BC5  1  B1 E7              lda (AreaData),y          ;get next byte, save lower nybble (length or height)
009BC7  1  29 0F              and #%00001111            ;as Y, then leave
009BC9  1  A8                 tay
009BCA  1  60                 rts
009BCB  1               
009BCB  1               ;--------------------------------
009BCB  1               
009BCB  1               GetAreaObjXPosition:
009BCB  1  AD 26 07           lda CurrentColumnPos    ;multiply current offset where we're at by 16
009BCE  1  0A                 asl                     ;to obtain horizontal pixel coordinate
009BCF  1  0A                 asl
009BD0  1  0A                 asl
009BD1  1  0A                 asl
009BD2  1  60                 rts
009BD3  1               
009BD3  1               ;--------------------------------
009BD3  1               
009BD3  1               GetAreaObjYPosition:
009BD3  1  A5 07              lda $07  ;multiply value by 16
009BD5  1  0A                 asl
009BD6  1  0A                 asl      ;this will give us the proper vertical pixel coordinate
009BD7  1  0A                 asl
009BD8  1  0A                 asl
009BD9  1  18                 clc
009BDA  1  69 20              adc #32  ;add 32 pixels for the status bar
009BDC  1  60                 rts
