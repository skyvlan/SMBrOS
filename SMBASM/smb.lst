009BE1  1               GetBlockBufferAddr:
009BE1  1  48                 pha                      ;take value of A, save
009BE2  1  4A                 lsr                      ;move high nybble to low
009BE3  1  4A                 lsr
009BE4  1  4A                 lsr
009BE5  1  4A                 lsr
009BE6  1  A8                 tay                      ;use nybble as pointer to high byte
009BE7  1  B9 DF 9B           lda BlockBufferAddr+2,y  ;of indirect here
009BEA  1  85 07              sta $07
009BEC  1  68                 pla
009BED  1  29 0F              and #%00001111           ;pull from stack, mask out high nybble
009BEF  1  18                 clc
009BF0  1  79 DD 9B           adc BlockBufferAddr,y    ;add to low byte
009BF3  1  85 06              sta $06                  ;store here and leave
009BF5  1  60                 rts
