00C9B0  1               MovePodoboo:
00C9B0  1  BD 96 07           lda EnemyIntervalTimer,x   ;check enemy timer
00C9B3  1  D0 16              bne PdbM                   ;branch to move enemy if not expired
00C9B5  1  20 F7 C2           jsr InitPodoboo            ;otherwise set up podoboo again
00C9B8  1  BD A8 07           lda PseudoRandomBitReg+1,x ;get part of LSFR
00C9BB  1  09 80              ora #%10000000             ;set d7
00C9BD  1  9D 34 04           sta Enemy_Y_MoveForce,x    ;store as movement force
00C9C0  1  29 0F              and #%00001111             ;mask out high nybble
00C9C2  1  09 06              ora #$06                   ;set for at least six intervals
00C9C4  1  9D 96 07           sta EnemyIntervalTimer,x   ;store as new enemy timer
00C9C7  1  A9 F9              lda #$f9
00C9C9  1  95 A0              sta Enemy_Y_Speed,x        ;set vertical speed to move podoboo upwards
00C9CB  1  4C 92 BF     PdbM: jmp MoveJ_EnemyVertically  ;branch to impose gravity on podoboo
