00F5E7  1               
00F5E7  1               ContinueExtraLife:
00F5E7  1  AD BD 07               lda Squ2_SfxLenCounter
00F5EA  1  A2 03                  ldx #$03                  ;load new tones only every eight frames
00F5EC  1  4A           DivLLoop: lsr
00F5ED  1  B0 D6                  bcs JumpToDecLength2      ;if any bits set here, branch to dec the length
00F5EF  1  CA                     dex
00F5F0  1  D0 FA                  bne DivLLoop              ;do this until all bits checked, if none set, continue
00F5F2  1  A8                     tay
00F5F3  1  B9 D3 F4               lda ExtraLifeFreqData-1,y ;load our reg contents
00F5F6  1  A2 82                  ldx #$82
00F5F8  1  A0 7F                  ldy #$7f
00F5FA  1  D0 E4                  bne EL_LRegs              ;unconditional branch
00F5FC  1               
00F5FC  1               PlayGrowPowerUp:
