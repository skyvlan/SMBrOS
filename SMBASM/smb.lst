00C55C  1  A9 DF              lda #$df
00C55E  1  8D 90 07           sta BowserFireBreathTimer ;store something here
00C561  1  95 46              sta Enemy_MovingDir,x     ;and in moving direction
00C563  1  A9 20              lda #$20
00C565  1  8D 64 03           sta BowserFeetCounter     ;set bowser's feet timer and in enemy timer
00C568  1  9D 8A 07           sta EnemyFrameTimer,x
00C56B  1  A9 05              lda #$05
00C56D  1  8D 83 04           sta BowserHitPoints       ;give bowser 5 hit points
