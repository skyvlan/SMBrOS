00C5F9  1  B9 CF 00            lda Enemy_Y_Position,y
00C5FC  1  18                  clc                       ;add 8 pixels to bowser's vertical position
00C5FD  1  69 08               adc #$08
00C5FF  1  95 CF               sta Enemy_Y_Position,x    ;save as flame's vertical position
00C601  1  BD A7 07            lda PseudoRandomBitReg,x
00C604  1  29 03               and #%00000011            ;get 2 LSB from first part of LSFR
00C606  1  9D 17 04            sta Enemy_YMF_Dummy,x     ;save here
00C609  1  A8                  tay                       ;use as offset
00C60A  1  B9 9D C5            lda FlameYPosData,y       ;get value here using bits as offset
00C60D  1  A0 00               ldy #$00                  ;load default offset
00C60F  1  D5 CF               cmp Enemy_Y_Position,x    ;compare value to flame's current vertical position
00C611  1  90 01               bcc SetMF                 ;if less, do not increment offset
00C613  1  C8                  iny                       ;otherwise increment now
00C614  1  B9 A1 C5     SetMF: lda FlameYMFAdderData,y   ;get value here and save
00C617  1  9D 34 04            sta Enemy_Y_MoveForce,x   ;to vertical movement force
