00F602  1               
00F602  1               GrowItemRegs:
00F602  1  8D BD 07             sta Squ2_SfxLenCounter
00F605  1  A9 7F                lda #$7f                  ;load contents of reg for both sounds directly
00F607  1  8D 05 40             sta SND_SQUARE2_REG+1
00F60A  1  A9 00                lda #$00                  ;start secondary counter for both sounds
00F60C  1  8D BE 07             sta Sfx_SecondaryCounter
00F60F  1               
00F60F  1               ContinueGrowItems:
