00E174  1  F0 0C                beq DoSide            ;standing on anything, then branch to same place if not
00E176  1  20 B5 E1             jsr ChkForNonSolids   ;check for non-solid blocks
00E179  1  F0 07                beq DoSide            ;branch if found
00E17B  1  20 4F E1             jsr EnemyLanding      ;change vertical coordinate and speed
00E17E  1  A9 FD                lda #$fd
00E180  1  95 A0                sta Enemy_Y_Speed,x   ;make the paratroopa jump again
00E182  1  4C FE E0     DoSide: jmp DoEnemySideCheck  ;check for horizontal blockage, then leave
00E185  1               
00E185  1               ;--------------------------------
00E185  1               
00E185  1               HammerBroBGColl:
00E185  1  20 AE E1           jsr ChkUnderEnemy    ;check to see if hammer bro is standing on anything
00E188  1  F0 1D              beq NoUnderHammerBro
00E18A  1  C9 23              cmp #$23             ;check for blank metatile $23 and branch if not found
00E18C  1  D0 08              bne UnderHammerBro
00E18E  1               
00E18E  1               KillEnemyAboveBlock:
00E18E  1  20 95 D7           jsr ShellOrBlockDefeat  ;do this sub to kill enemy
00E191  1  A9 FC              lda #$fc                ;alter vertical speed of enemy and leave
00E193  1  95 A0              sta Enemy_Y_Speed,x
00E195  1  60                 rts
00E196  1               
00E196  1               UnderHammerBro:
00E196  1  BD 8A 07           lda EnemyFrameTimer,x ;check timer used by hammer bro
00E199  1  D0 0C              bne NoUnderHammerBro  ;branch if not expired
00E19B  1  B5 1E              lda Enemy_State,x
00E19D  1  29 88              and #%10001000        ;save d7 and d3 from enemy state, nullify other bits
00E19F  1  95 1E              sta Enemy_State,x     ;and store
00E1A1  1  20 4F E1           jsr EnemyLanding      ;modify vertical coordinate, speed and something else
00E1A4  1  4C FE E0           jmp DoEnemySideCheck  ;then check for horizontal blockage and leave
00E1A7  1               
00E1A7  1               NoUnderHammerBro:
00E1A7  1  B5 1E              lda Enemy_State,x  ;if hammer bro is not standing on anything, set d0
00E1A9  1  09 01              ora #$01           ;in the enemy state to indicate jumping or falling, then leave
00E1AB  1  95 1E              sta Enemy_State,x
00E1AD  1  60                 rts
00E1AE  1               
00E1AE  1               ChkUnderEnemy:
00E1AE  1  A9 00              lda #$00                  ;set flag in A for save vertical coordinate
00E1B0  1  A0 15              ldy #$15                  ;set Y to check the bottom middle (8,18) of enemy object
00E1B2  1  4C 88 E3           jmp BlockBufferChk_Enemy  ;hop to it!
00E1B5  1               
00E1B5  1               ChkForNonSolids:
00E1B5  1  C9 26               cmp #$26       ;blank metatile used for vines?
00E1B7  1  F0 0E               beq NSFnd
00E1B9  1  C9 C2               cmp #$c2       ;regular coin?
00E1BB  1  F0 0A               beq NSFnd
00E1BD  1  C9 C3               cmp #$c3       ;underwater coin?
00E1BF  1  F0 06               beq NSFnd
00E1C1  1  C9 5F               cmp #$5f       ;hidden coin block?
00E1C3  1  F0 02               beq NSFnd
00E1C5  1  C9 60               cmp #$60       ;hidden 1-up block?
00E1C7  1  60           NSFnd: rts
00E1C8  1               
00E1C8  1               ;-------------------------------------------------------------------------------------
00E1C8  1               
00E1C8  1               FireballBGCollision:
00E1C8  1  B5 D5              lda Fireball_Y_Position,x   ;check fireball's vertical coordinate
00E1CA  1  C9 18              cmp #$18
00E1CC  1  90 21              bcc ClearBounceFlag         ;if within the status bar area of the screen, branch ahead
00E1CE  1  20 9C E3           jsr BlockBufferChk_FBall    ;do fireball to background collision detection on bottom of it
00E1D1  1  F0 1C              beq ClearBounceFlag         ;if nothing underneath fireball, branch
00E1D3  1  20 B5 E1           jsr ChkForNonSolids         ;check for non-solid metatiles
00E1D6  1  F0 17              beq ClearBounceFlag         ;branch if any found
00E1D8  1  B5 A6              lda Fireball_Y_Speed,x      ;if fireball's vertical speed set to move upwards,
00E1DA  1  30 18              bmi InitFireballExplode     ;branch to set exploding bit in fireball's state
00E1DC  1  B5 3A              lda FireballBouncingFlag,x  ;if bouncing flag already set,
00E1DE  1  D0 14              bne InitFireballExplode     ;branch to set exploding bit in fireball's state
00E1E0  1  A9 FD              lda #$fd
00E1E2  1  95 A6              sta Fireball_Y_Speed,x      ;otherwise set vertical speed to move upwards (give it bounce)
00E1E4  1  A9 01              lda #$01
00E1E6  1  95 3A              sta FireballBouncingFlag,x  ;set bouncing flag
00E1E8  1  B5 D5              lda Fireball_Y_Position,x
00E1EA  1  29 F8              and #$f8                    ;modify vertical coordinate to land it properly
00E1EC  1  95 D5              sta Fireball_Y_Position,x   ;store as new vertical coordinate
00E1EE  1  60                 rts                         ;leave
00E1EF  1               
00E1EF  1               ClearBounceFlag:
00E1EF  1  A9 00              lda #$00
00E1F1  1  95 3A              sta FireballBouncingFlag,x  ;clear bouncing flag by default
00E1F3  1  60                 rts                         ;leave
00E1F4  1               
00E1F4  1               InitFireballExplode:
00E1F4  1  A9 80              lda #$80
00E1F6  1  95 24              sta Fireball_State,x        ;set exploding flag in fireball's state
00E1F8  1  A9 02              lda #Sfx_Bump
00E1FA  1  85 FF              sta Square1SoundQueue       ;load bump sound
00E1FC  1  60                 rts                         ;leave
00E1FD  1               
00E1FD  1               ;-------------------------------------------------------------------------------------
00E1FD  1               ;$00 - used to hold one of bitmasks, or offset
00E1FD  1               ;$01 - used for relative X coordinate, also used to store middle screen page location
00E1FD  1               ;$02 - used for relative Y coordinate, also used to store middle screen coordinate
00E1FD  1               
00E1FD  1               ;this data added to relative coordinates of sprite objects
00E1FD  1               ;stored in order: left edge, top edge, right edge, bottom edge
00E1FD  1               BoundBoxCtrlData:
00E1FD  1  02 08 0E 20        .byte $02, $08, $0e, $20
00E201  1  03 14 0D 20        .byte $03, $14, $0d, $20
00E205  1  02 14 0E 20        .byte $02, $14, $0e, $20
00E209  1  02 09 0E 15        .byte $02, $09, $0e, $15
00E20D  1  00 00 18 06        .byte $00, $00, $18, $06
00E211  1  00 00 20 0D        .byte $00, $00, $20, $0d
00E215  1  00 00 30 0D        .byte $00, $00, $30, $0d
00E219  1  00 00 08 08        .byte $00, $00, $08, $08
00E21D  1  06 04 0A 08        .byte $06, $04, $0a, $08
00E221  1  03 0E 0D 14        .byte $03, $0e, $0d, $14
00E225  1  00 02 10 15        .byte $00, $02, $10, $15
00E229  1  04 04 0C 1C        .byte $04, $04, $0c, $1c
00E22D  1               
00E22D  1               GetFireballBoundBox:
00E22D  1  8A                 txa         ;add seven bytes to offset
00E22E  1  18                 clc         ;to use in routines as offset for fireball
00E22F  1  69 07              adc #$07
00E231  1  AA                 tax
00E232  1  A0 02              ldy #$02    ;set offset for relative coordinates
00E234  1  D0 07              bne FBallB  ;unconditional branch
00E236  1               
00E236  1               GetMiscBoundBox:
00E236  1  8A                   txa                       ;add nine bytes to offset
00E237  1  18                   clc                       ;to use in routines as offset for misc object
00E238  1  69 09                adc #$09
00E23A  1  AA                   tax
00E23B  1  A0 06                ldy #$06                  ;set offset for relative coordinates
00E23D  1  20 9C E2     FBallB: jsr BoundingBoxCore       ;get bounding box coordinates
00E240  1  4C DE E2             jmp CheckRightScreenBBox  ;jump to handle any offscreen coordinates
00E243  1               
00E243  1               GetEnemyBoundBox:
00E243  1  A0 48              ldy #$48                 ;store bitmask here for now
00E245  1  84 00              sty $00
00E247  1  A0 44              ldy #$44                 ;store another bitmask here for now and jump
00E249  1  4C 52 E2           jmp GetMaskedOffScrBits
00E24C  1               
00E24C  1               SmallPlatformBoundBox:
00E24C  1  A0 08              ldy #$08                 ;store bitmask here for now
00E24E  1  84 00              sty $00
00E250  1  A0 04              ldy #$04                 ;store another bitmask here for now
00E252  1               
00E252  1               GetMaskedOffScrBits:
00E252  1  B5 87                lda Enemy_X_Position,x      ;get enemy object position relative
00E254  1  38                   sec                         ;to the left side of the screen
00E255  1  ED 1C 07             sbc ScreenLeft_X_Pos
00E258  1  85 01                sta $01                     ;store here
00E25A  1  B5 6E                lda Enemy_PageLoc,x         ;subtract borrow from current page location
00E25C  1  ED 1A 07             sbc ScreenLeft_PageLoc      ;of left side
00E25F  1  30 06                bmi CMBits                  ;if enemy object is beyond left edge, branch
00E261  1  05 01                ora $01
00E263  1  F0 02                beq CMBits                  ;if precisely at the left edge, branch
00E265  1  A4 00                ldy $00                     ;if to the right of left edge, use value in $00 for A
00E267  1  98           CMBits: tya                         ;otherwise use contents of Y
00E268  1  2D D1 03             and Enemy_OffscreenBits     ;preserve bitwise whatever's in here
00E26B  1  9D D8 03             sta EnemyOffscrBitsMasked,x ;save masked offscreen bits here
00E26E  1  D0 19                bne MoveBoundBoxOffscreen   ;if anything set here, branch
00E270  1  4C 7C E2             jmp SetupEOffsetFBBox       ;otherwise, do something else
00E273  1               
00E273  1               LargePlatformBoundBox:
00E273  1  E8                 inx                        ;increment X to get the proper offset
00E274  1  20 F6 F1           jsr GetXOffscreenBits      ;then jump directly to the sub for horizontal offscreen bits
00E277  1  CA                 dex                        ;decrement to return to original offset
00E278  1  C9 FE              cmp #$fe                   ;if completely offscreen, branch to put entire bounding
00E27A  1  B0 0D              bcs MoveBoundBoxOffscreen  ;box offscreen, otherwise start getting coordinates
00E27C  1               
00E27C  1               SetupEOffsetFBBox:
00E27C  1  8A                 txa                        ;add 1 to offset to properly address
00E27D  1  18                 clc                        ;the enemy object memory locations
00E27E  1  69 01              adc #$01
00E280  1  AA                 tax
00E281  1  A0 01              ldy #$01                   ;load 1 as offset here, same reason
00E283  1  20 9C E2           jsr BoundingBoxCore        ;do a sub to get the coordinates of the bounding box
00E286  1  4C DE E2           jmp CheckRightScreenBBox   ;jump to handle offscreen coordinates of bounding box
00E289  1               
00E289  1               MoveBoundBoxOffscreen:
00E289  1  8A                 txa                            ;multiply offset by 4
00E28A  1  0A                 asl
00E28B  1  0A                 asl
00E28C  1  A8                 tay                            ;use as offset here
00E28D  1  A9 FF              lda #$ff
00E28F  1  99 B0 04           sta EnemyBoundingBoxCoord,y    ;load value into four locations here and leave
00E292  1  99 B1 04           sta EnemyBoundingBoxCoord+1,y
00E295  1  99 B2 04           sta EnemyBoundingBoxCoord+2,y
00E298  1  99 B3 04           sta EnemyBoundingBoxCoord+3,y
00E29B  1  60                 rts
00E29C  1               
00E29C  1               BoundingBoxCore:
00E29C  1  86 00              stx $00                     ;save offset here
00E29E  1  B9 B8 03           lda SprObject_Rel_YPos,y    ;store object coordinates relative to screen
00E2A1  1  85 02              sta $02                     ;vertically and horizontally, respectively
00E2A3  1  B9 AD 03           lda SprObject_Rel_XPos,y
00E2A6  1  85 01              sta $01
00E2A8  1  8A                 txa                         ;multiply offset by four and save to stack
00E2A9  1  0A                 asl
00E2AA  1  0A                 asl
00E2AB  1  48                 pha
00E2AC  1  A8                 tay                         ;use as offset for Y, X is left alone
00E2AD  1  BD 99 04           lda SprObj_BoundBoxCtrl,x   ;load value here to be used as offset for X
00E2B0  1  0A                 asl                         ;multiply that by four and use as X
00E2B1  1  0A                 asl
00E2B2  1  AA                 tax
00E2B3  1  A5 01              lda $01                     ;add the first number in the bounding box data to the
00E2B5  1  18                 clc                         ;relative horizontal coordinate using enemy object offset
00E2B6  1  7D FD E1           adc BoundBoxCtrlData,x      ;and store somewhere using same offset * 4
00E2B9  1  99 AC 04           sta BoundingBox_UL_Corner,y ;store here
00E2BC  1  A5 01              lda $01
00E2BE  1  18                 clc
00E2BF  1  7D FF E1           adc BoundBoxCtrlData+2,x    ;add the third number in the bounding box data to the
00E2C2  1  99 AE 04           sta BoundingBox_LR_Corner,y ;relative horizontal coordinate and store
00E2C5  1  E8                 inx                         ;increment both offsets
00E2C6  1  C8                 iny
00E2C7  1  A5 02              lda $02                     ;add the second number to the relative vertical coordinate
00E2C9  1  18                 clc                         ;using incremented offset and store using the other
00E2CA  1  7D FD E1           adc BoundBoxCtrlData,x      ;incremented offset
00E2CD  1  99 AC 04           sta BoundingBox_UL_Corner,y
00E2D0  1  A5 02              lda $02
00E2D2  1  18                 clc
00E2D3  1  7D FF E1           adc BoundBoxCtrlData+2,x    ;add the fourth number to the relative vertical coordinate
00E2D6  1  99 AE 04           sta BoundingBox_LR_Corner,y ;and store
00E2D9  1  68                 pla                         ;get original offset loaded into $00 * y from stack
00E2DA  1  A8                 tay                         ;use as Y
00E2DB  1  A6 00              ldx $00                     ;get original offset and use as X again
00E2DD  1  60                 rts
00E2DE  1               
00E2DE  1               CheckRightScreenBBox:
00E2DE  1  AD 1C 07            lda ScreenLeft_X_Pos       ;add 128 pixels to left side of screen
00E2E1  1  18                  clc                        ;and store as horizontal coordinate of middle
00E2E2  1  69 80               adc #$80
00E2E4  1  85 02               sta $02
00E2E6  1  AD 1A 07            lda ScreenLeft_PageLoc     ;add carry to page location of left side of screen
00E2E9  1  69 00               adc #$00                   ;and store as page location of middle
00E2EB  1  85 01               sta $01
00E2ED  1  B5 86               lda SprObject_X_Position,x ;get horizontal coordinate
00E2EF  1  C5 02               cmp $02                    ;compare against middle horizontal coordinate
00E2F1  1  B5 6D               lda SprObject_PageLoc,x    ;get page location
00E2F3  1  E5 01               sbc $01                    ;subtract from middle page location
00E2F5  1  90 15               bcc CheckLeftScreenBBox    ;if object is on the left side of the screen, branch
00E2F7  1  B9 AE 04            lda BoundingBox_DR_XPos,y  ;check right-side edge of bounding box for offscreen
00E2FA  1  30 0D               bmi NoOfs                  ;coordinates, branch if still on the screen
00E2FC  1  A9 FF               lda #$ff                   ;load offscreen value here to use on one or both horizontal sides
00E2FE  1  BE AC 04            ldx BoundingBox_UL_XPos,y  ;check left-side edge of bounding box for offscreen
00E301  1  30 03               bmi SORte                  ;coordinates, and branch if still on the screen
00E303  1  99 AC 04            sta BoundingBox_UL_XPos,y  ;store offscreen value for left side
00E306  1  99 AE 04     SORte: sta BoundingBox_DR_XPos,y  ;store offscreen value for right side
00E309  1  A6 08        NoOfs: ldx ObjectOffset           ;get object offset and leave
00E30B  1  60                  rts
00E30C  1               
00E30C  1               CheckLeftScreenBBox:
00E30C  1  B9 AC 04             lda BoundingBox_UL_XPos,y  ;check left-side edge of bounding box for offscreen
00E30F  1  10 11                bpl NoOfs2                 ;coordinates, and branch if still on the screen
00E311  1  C9 A0                cmp #$a0                   ;check to see if left-side edge is in the middle of the
00E313  1  90 0D                bcc NoOfs2                 ;screen or really offscreen, and branch if still on
00E315  1  A9 00                lda #$00
00E317  1  BE AE 04             ldx BoundingBox_DR_XPos,y  ;check right-side edge of bounding box for offscreen
00E31A  1  10 03                bpl SOLft                  ;coordinates, branch if still onscreen
00E31C  1  99 AE 04             sta BoundingBox_DR_XPos,y  ;store offscreen value for right side
00E31F  1  99 AC 04     SOLft:  sta BoundingBox_UL_XPos,y  ;store offscreen value for left side
00E322  1  A6 08        NoOfs2: ldx ObjectOffset           ;get object offset and leave
00E324  1  60                   rts
00E325  1               
00E325  1               ;-------------------------------------------------------------------------------------
00E325  1               ;$06 - second object's offset
00E325  1               ;$07 - counter
00E325  1               
00E325  1               PlayerCollisionCore:
00E325  1  A2 00              ldx #$00     ;initialize X to use player's bounding box for comparison
00E327  1               
00E327  1               SprObjectCollisionCore:
00E327  1  84 06              sty $06      ;save contents of Y here
00E329  1  A9 01              lda #$01
00E32B  1  85 07              sta $07      ;save value 1 here as counter, compare horizontal coordinates first
00E32D  1               
00E32D  1               CollisionCoreLoop:
00E32D  1  B9 AC 04           lda BoundingBox_UL_Corner,y  ;compare left/top coordinates
00E330  1  DD AC 04           cmp BoundingBox_UL_Corner,x  ;of first and second objects' bounding boxes
00E333  1  B0 2A              bcs FirstBoxGreater          ;if first left/top => second, branch
00E335  1  DD AE 04           cmp BoundingBox_LR_Corner,x  ;otherwise compare to right/bottom of second
00E338  1  90 12              bcc SecondBoxVerticalChk     ;if first left/top < second right/bottom, branch elsewhere
00E33A  1  F0 42              beq CollisionFound           ;if somehow equal, collision, thus branch
00E33C  1  B9 AE 04           lda BoundingBox_LR_Corner,y  ;if somehow greater, check to see if bottom of
00E33F  1  D9 AC 04           cmp BoundingBox_UL_Corner,y  ;first object's bounding box is greater than its top
00E342  1  90 3A              bcc CollisionFound           ;if somehow less, vertical wrap collision, thus branch
00E344  1  DD AC 04           cmp BoundingBox_UL_Corner,x  ;otherwise compare bottom of first bounding box to the top
00E347  1  B0 35              bcs CollisionFound           ;of second box, and if equal or greater, collision, thus branch
00E349  1  A4 06              ldy $06                      ;otherwise return with carry clear and Y = $0006
00E34B  1  60                 rts                          ;note horizontal wrapping never occurs
00E34C  1               
00E34C  1               SecondBoxVerticalChk:
00E34C  1  BD AE 04           lda BoundingBox_LR_Corner,x  ;check to see if the vertical bottom of the box
00E34F  1  DD AC 04           cmp BoundingBox_UL_Corner,x  ;is greater than the vertical top
00E352  1  90 2A              bcc CollisionFound           ;if somehow less, vertical wrap collision, thus branch
00E354  1  B9 AE 04           lda BoundingBox_LR_Corner,y  ;otherwise compare horizontal right or vertical bottom
00E357  1  DD AC 04           cmp BoundingBox_UL_Corner,x  ;of first box with horizontal left or vertical top of second box
00E35A  1  B0 22              bcs CollisionFound           ;if equal or greater, collision, thus branch
00E35C  1  A4 06              ldy $06                      ;otherwise return with carry clear and Y = $0006
00E35E  1  60                 rts
00E35F  1               
00E35F  1               FirstBoxGreater:
00E35F  1  DD AC 04           cmp BoundingBox_UL_Corner,x  ;compare first and second box horizontal left/vertical top again
00E362  1  F0 1A              beq CollisionFound           ;if first coordinate = second, collision, thus branch
00E364  1  DD AE 04           cmp BoundingBox_LR_Corner,x  ;if not, compare with second object right or bottom edge
00E367  1  90 15              bcc CollisionFound           ;if left/top of first less than or equal to right/bottom of second
00E369  1  F0 13              beq CollisionFound           ;then collision, thus branch
00E36B  1  D9 AE 04           cmp BoundingBox_LR_Corner,y  ;otherwise check to see if top of first box is greater than bottom
00E36E  1  90 0A              bcc NoCollisionFound         ;if less than or equal, no collision, branch to end
00E370  1  F0 08              beq NoCollisionFound
00E372  1  B9 AE 04           lda BoundingBox_LR_Corner,y  ;otherwise compare bottom of first to top of second
00E375  1  DD AC 04           cmp BoundingBox_UL_Corner,x  ;if bottom of first is greater than top of second, vertical wrap
00E378  1  B0 04              bcs CollisionFound           ;collision, and branch, otherwise, proceed onwards here
00E37A  1               
00E37A  1               NoCollisionFound:
00E37A  1  18                 clc          ;clear carry, then load value set earlier, then leave
00E37B  1  A4 06              ldy $06      ;like previous ones, if horizontal coordinates do not collide, we do
00E37D  1  60                 rts          ;not bother checking vertical ones, because what's the point?
00E37E  1               
00E37E  1               CollisionFound:
00E37E  1  E8                 inx                    ;increment offsets on both objects to check
00E37F  1  C8                 iny                    ;the vertical coordinates
00E380  1  C6 07              dec $07                ;decrement counter to reflect this
00E382  1  10 A9              bpl CollisionCoreLoop  ;if counter not expired, branch to loop
00E384  1  38                 sec                    ;otherwise we already did both sets, therefore collision, so set carry
00E385  1  A4 06              ldy $06                ;load original value set here earlier, then leave
00E387  1  60                 rts
00E388  1               
00E388  1               ;-------------------------------------------------------------------------------------
00E388  1               ;$02 - modified y coordinate
00E388  1               ;$03 - stores metatile involved in block buffer collisions
00E388  1               ;$04 - comes in with offset to block buffer adder data, goes out with low nybble x/y coordinate
00E388  1               ;$05 - modified x coordinate
00E388  1               ;$06-$07 - block buffer address
00E388  1               
00E388  1               BlockBufferChk_Enemy:
00E388  1  48                 pha        ;save contents of A to stack
00E389  1  8A                 txa
00E38A  1  18                 clc        ;add 1 to X to run sub with enemy offset in mind
00E38B  1  69 01              adc #$01
00E38D  1  AA                 tax
00E38E  1  68                 pla        ;pull A from stack and jump elsewhere
00E38F  1  4C A5 E3           jmp BBChk_E
00E392  1               
00E392  1               ResidualMiscObjectCode:
00E392  1  8A                 txa
00E393  1  18                 clc           ;supposedly used once to set offset for
00E394  1  69 0D              adc #$0d      ;miscellaneous objects
00E396  1  AA                 tax
00E397  1  A0 1B              ldy #$1b      ;supposedly used once to set offset for block buffer data
00E399  1  4C A3 E3           jmp ResJmpM   ;probably used in early stages to do misc to bg collision detection
00E39C  1               
00E39C  1               BlockBufferChk_FBall:
00E39C  1  A0 1A                 ldy #$1a                  ;set offset for block buffer adder data
00E39E  1  8A                    txa
00E39F  1  18                    clc
00E3A0  1  69 07                 adc #$07                  ;add seven bytes to use
00E3A2  1  AA                    tax
00E3A3  1  A9 00        ResJmpM: lda #$00                  ;set A to return vertical coordinate
00E3A5  1  20 F0 E3     BBChk_E: jsr BlockBufferCollision  ;do collision detection subroutine for sprite object
00E3A8  1  A6 08                 ldx ObjectOffset          ;get object offset
00E3AA  1  C9 00                 cmp #$00                  ;check to see if object bumped into anything
00E3AC  1  60                    rts
00E3AD  1               
00E3AD  1               BlockBufferAdderData:
00E3AD  1  00 07 0E           .byte $00, $07, $0e
00E3B0  1               
00E3B0  1               BlockBuffer_X_Adder:
00E3B0  1  08 03 0C 02        .byte $08, $03, $0c, $02, $02, $0d, $0d, $08
00E3B4  1  02 0D 0D 08  
00E3B8  1  03 0C 02 02        .byte $03, $0c, $02, $02, $0d, $0d, $08, $03
00E3BC  1  0D 0D 08 03  
