0090ED  1               
0090ED  1               GetAreaMusic:
0090ED  1  AD 70 07                  lda OperMode           ;if in title screen mode, leave
0090F0  1  F0 23                     beq ExitGetM
0090F2  1  AD 52 07                  lda AltEntranceControl ;check for specific alternate mode of entry
0090F5  1  C9 02                     cmp #$02               ;if found, branch without checking starting position
0090F7  1  F0 0D                     beq ChkAreaType        ;from area object data header
0090F9  1  A0 05                     ldy #$05               ;select music for pipe intro scene by default
0090FB  1  AD 10 07                  lda PlayerEntranceCtrl ;check value from level header for certain values
0090FE  1  C9 06                     cmp #$06
009100  1  F0 0E                     beq StoreMusic         ;load music for pipe intro scene if header
009102  1  C9 07                     cmp #$07               ;start position either value $06 or $07
009104  1  F0 0A                     beq StoreMusic
009106  1  AC 4E 07     ChkAreaType: ldy AreaType           ;load area type as offset for music bit
009109  1  AD 43 07                  lda CloudTypeOverride
00910C  1  F0 02                     beq StoreMusic         ;check for cloud type override
00910E  1  A0 04                     ldy #$04               ;select music for cloud type level if found
009110  1  B9 E7 90     StoreMusic:  lda MusicSelectData,y  ;otherwise select appropriate music for level type
009113  1  85 FB                     sta AreaMusicQueue     ;store in queue and leave
009115  1  60           ExitGetM:    rts
