008461  1               PlayerEndWorld:
008461  1  AD A1 07                    lda WorldEndTimer          ;check to see if world end timer expired
008464  1  D0 20                       bne EndExitOne             ;branch to leave if not
008466  1  AC 5F 07                    ldy WorldNumber            ;check world number
008469  1  C0 07                       cpy #World8                ;if on world 8, player is done with game,
00846B  1  B0 1A                       bcs EndChkBButton          ;thus branch to read controller
00846D  1  A9 00                       lda #$00
00846F  1  8D 60 07                    sta AreaNumber             ;otherwise initialize area number used as offset
008472  1  8D 5C 07                    sta LevelNumber            ;and level number control to start at area 1
008475  1  8D 72 07                    sta OperMode_Task          ;initialize secondary mode of operation
008478  1  EE 5F 07                    inc WorldNumber            ;increment world number to move onto the next world
00847B  1  20 03 9C                    jsr LoadAreaPointer        ;get area address offset for the next area
00847E  1  EE 57 07                    inc FetchNewGameTimerFlag  ;set flag to load game timer from header
008481  1  A9 01                       lda #GameModeValue
008483  1  8D 70 07                    sta OperMode               ;set mode of operation to game mode
008486  1  60           EndExitOne:    rts                        ;and leave
008487  1  AD FC 06     EndChkBButton: lda SavedJoypad1Bits
00848A  1  0D FD 06                    ora SavedJoypad2Bits       ;check to see if B button was pressed on
00848D  1  29 40                       and #B_Button              ;either controller
00848F  1  F0 0D                       beq EndExitTwo             ;branch to leave if not
008491  1  A9 01                       lda #$01                   ;otherwise set world selection flag
008493  1  8D FC 07                    sta WorldSelectEnableFlag
008496  1  A9 FF                       lda #$ff                   ;remove onscreen player's lives
008498  1  8D 5A 07                    sta NumberofLives
00849B  1  20 48 92                    jsr TerminateGame          ;do sub to continue other player or end game
00849E  1  60           EndExitTwo:    rts                        ;leave
