008A4D  1               RemoveCoin_Axe:
008A4D  1  A0 41                      ldy #$41                 ;set low byte so offset points to $0341
008A4F  1  A9 03                      lda #$03                 ;load offset for default blank metatile
008A51  1  AE 4E 07                   ldx AreaType             ;check area type
008A54  1  D0 02                      bne WriteBlankMT         ;if not water type, use offset
008A56  1  A9 04                      lda #$04                 ;otherwise load offset for blank metatile used in water
008A58  1  20 97 8A     WriteBlankMT: jsr PutBlockMetatile     ;do a sub to write blank metatile to vram buffer
