0088CB  1  A9 00                    lda #$00                     ;init attribute row
0088CD  1  85 04                    sta $04
0088CF  1  AA                       tax
0088D0  1  86 01        DrawMTLoop: stx $01                      ;store init value of 0 or incremented offset for buffer
0088D2  1  BD A1 06                 lda MetatileBuffer,x         ;get first metatile number, and mask out all but 2 MSB
0088D5  1  29 C0                    and #%11000000
0088D7  1  85 03                    sta $03                      ;store attribute table bits here
0088D9  1  0A                       asl                          ;note that metatile format is:
0088DA  1  2A                       rol                          ;%xx000000 - attribute table bits,
0088DB  1  2A                       rol                          ;%00xxxxxx - metatile number
0088DC  1  A8                       tay                          ;rotate bits to d1-d0 and use as offset here
0088DD  1  B9 08 8B                 lda MetatileGraphics_Low,y   ;get address to graphics table from here
0088E0  1  85 06                    sta $06
0088E2  1  B9 0C 8B                 lda MetatileGraphics_High,y
