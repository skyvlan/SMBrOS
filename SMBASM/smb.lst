008E04  1               JumpEngine:
008E04  1  0A                  asl          ;shift bit from contents of A
008E05  1  A8                  tay
008E06  1  68                  pla          ;pull saved return address from stack
008E07  1  85 04               sta $04      ;save to indirect
008E09  1  68                  pla
008E0A  1  85 05               sta $05
008E0C  1  C8                  iny
008E0D  1  B1 04               lda ($04),y  ;load pointer from indirect
008E0F  1  85 06               sta $06      ;note that if an RTS is performed in next routine
008E11  1  C8                  iny          ;it will return to the execution before the sub
008E12  1  B1 04               lda ($04),y  ;that called this routine
008E14  1  85 07               sta $07
008E16  1  6C 06 00            jmp ($06)    ;jump to the address we loaded
