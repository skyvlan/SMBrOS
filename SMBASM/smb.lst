00DBBC  1               
00DBBC  1               ProcLPlatCollisions:
00DBBC  1  B9 AF 04           lda BoundingBox_DR_YPos,y    ;get difference by subtracting the top
00DBBF  1  38                 sec                          ;of the player's bounding box from the bottom
00DBC0  1  ED AD 04           sbc BoundingBox_UL_YPos      ;of the platform's bounding box
00DBC3  1  C9 04              cmp #$04                     ;if difference too large or negative,
00DBC5  1  B0 08              bcs ChkForTopCollision       ;branch, do not alter vertical speed of player
00DBC7  1  A5 9F              lda Player_Y_Speed           ;check to see if player's vertical speed is moving down
00DBC9  1  10 04              bpl ChkForTopCollision       ;if so, don't mess with it
00DBCB  1  A9 01              lda #$01                     ;otherwise, set vertical
00DBCD  1  85 9F              sta Player_Y_Speed           ;speed of player to kill jump
00DBCF  1               
00DBCF  1               ChkForTopCollision:
00DBCF  1  AD AF 04           lda BoundingBox_DR_YPos      ;get difference by subtracting the top
00DBD2  1  38                 sec                          ;of the platform's bounding box from the bottom
