00ED66  1               
00ED66  1               DrawSmallPlatform:
00ED66  1  BC E5 06            ldy Enemy_SprDataOffset,x   ;get OAM data offset
00ED69  1  A9 5B               lda #$5b                    ;load tile number for small platforms
00ED6B  1  C8                  iny                         ;increment offset for tile numbers
00ED6C  1  20 B5 E5            jsr DumpSixSpr              ;dump tile number into all six sprites
00ED6F  1  C8                  iny                         ;increment offset for attributes
00ED70  1  A9 02               lda #$02                    ;load palette controls
00ED72  1  20 B5 E5            jsr DumpSixSpr              ;dump attributes into all six sprites
00ED75  1  88                  dey                         ;decrement for original offset
00ED76  1  88                  dey
00ED77  1  AD AE 03            lda Enemy_Rel_XPos          ;get relative horizontal coordinate
00ED7A  1  99 03 02            sta Sprite_X_Position,y
00ED7D  1  99 0F 02            sta Sprite_X_Position+12,y  ;dump as X coordinate into first and fourth sprites
00ED80  1  18                  clc
00ED81  1  69 08               adc #$08                    ;add eight pixels
00ED83  1  99 07 02            sta Sprite_X_Position+4,y   ;dump into second and fifth sprites
00ED86  1  99 13 02            sta Sprite_X_Position+16,y
00ED89  1  18                  clc
00ED8A  1  69 08               adc #$08                    ;add eight more pixels
00ED8C  1  99 0B 02            sta Sprite_X_Position+8,y   ;dump into third and sixth sprites
00ED8F  1  99 17 02            sta Sprite_X_Position+20,y
00ED92  1  B5 CF               lda Enemy_Y_Position,x      ;get vertical coordinate
00ED94  1  AA                  tax
00ED95  1  48                  pha                         ;save to stack
00ED96  1  E0 20               cpx #$20                    ;if vertical coordinate below status bar,
00ED98  1  B0 02               bcs TopSP                   ;do not mess with it
00ED9A  1  A9 F8               lda #$f8                    ;otherwise move first three sprites offscreen
00ED9C  1  20 BE E5     TopSP: jsr DumpThreeSpr            ;dump vertical coordinate into Y coordinates
00ED9F  1  68                  pla                         ;pull from stack
00EDA0  1  18                  clc
00EDA1  1  69 80               adc #$80                    ;add 128 pixels
00EDA3  1  AA                  tax
00EDA4  1  E0 20               cpx #$20                    ;if below status bar (taking wrap into account)
00EDA6  1  B0 02               bcs BotSP                   ;then do not change altered coordinate
00EDA8  1  A9 F8               lda #$f8                    ;otherwise move last three sprites offscreen
00EDAA  1  99 0C 02     BotSP: sta Sprite_Y_Position+12,y  ;dump vertical coordinate + 128 pixels
00EDAD  1  99 10 02            sta Sprite_Y_Position+16,y  ;into Y coordinates
00EDB0  1  99 14 02            sta Sprite_Y_Position+20,y
00EDB3  1  AD D1 03            lda Enemy_OffscreenBits     ;get offscreen bits
00EDB6  1  48                  pha                         ;save to stack
00EDB7  1  29 08               and #%00001000              ;check d3
00EDB9  1  F0 08               beq SOfs
00EDBB  1  A9 F8               lda #$f8                    ;if d3 was set, move first and
00EDBD  1  99 00 02            sta Sprite_Y_Position,y     ;fourth sprites offscreen
00EDC0  1  99 0C 02            sta Sprite_Y_Position+12,y
00EDC3  1  68           SOfs:  pla                         ;move out and back into stack
00EDC4  1  48                  pha
00EDC5  1  29 04               and #%00000100              ;check d2
00EDC7  1  F0 08               beq SOfs2
00EDC9  1  A9 F8               lda #$f8                    ;if d2 was set, move second and
00EDCB  1  99 04 02            sta Sprite_Y_Position+4,y   ;fifth sprites offscreen
00EDCE  1  99 10 02            sta Sprite_Y_Position+16,y
00EDD1  1  68           SOfs2: pla                         ;get from stack
00EDD2  1  29 02               and #%00000010              ;check d1
00EDD4  1  F0 08               beq ExSPl
00EDD6  1  A9 F8               lda #$f8                    ;if d1 was set, move third and
00EDD8  1  99 08 02            sta Sprite_Y_Position+8,y   ;sixth sprites offscreen
00EDDB  1  99 14 02            sta Sprite_Y_Position+20,y
00EDDE  1  A6 08        ExSPl: ldx ObjectOffset            ;get enemy object offset and leave
00EDE0  1  60                  rts
00EDE1  1               
00EDE1  1               ;-------------------------------------------------------------------------------------
00EDE1  1               
00EDE1  1               DrawBubble:
00EDE1  1  A4 B5                ldy Player_Y_HighPos        ;if player's vertical high position
00EDE3  1  88                   dey                         ;not within screen, skip all of this
00EDE4  1  D0 20                bne ExDBub
00EDE6  1  AD D3 03             lda Bubble_OffscreenBits    ;check air bubble's offscreen bits
00EDE9  1  29 08                and #%00001000
00EDEB  1  D0 19                bne ExDBub                  ;if bit set, branch to leave
00EDED  1  BC EE 06             ldy Bubble_SprDataOffset,x  ;get air bubble's OAM data offset
00EDF0  1  AD B0 03             lda Bubble_Rel_XPos         ;get relative horizontal coordinate
00EDF3  1  99 03 02             sta Sprite_X_Position,y     ;store as X coordinate here
00EDF6  1  AD BB 03             lda Bubble_Rel_YPos         ;get relative vertical coordinate
00EDF9  1  99 00 02             sta Sprite_Y_Position,y     ;store as Y coordinate here
00EDFC  1  A9 74                lda #$74
