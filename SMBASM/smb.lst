00F5B2  1  4A                   lsr
00F5B3  1  B0 5A                bcs ContinueGrowItems    ;vine grow
00F5B5  1  4A                   lsr
00F5B6  1  B0 8D                bcs ContinueBlast        ;fireworks/gunfire
00F5B8  1  4A                   lsr
00F5B9  1  B0 07                bcs Cont_CGrab_TTick     ;timer tick
00F5BB  1  4A                   lsr
00F5BC  1  B0 99                bcs ContinuePowerUpGrab  ;power-up grab
00F5BE  1  4A                   lsr
