00F691  1               
00F691  1               ContinueMusic:
00F691  1  4C 3A F7             jmp HandleSquare2Music  ;if we have music, start with square 2 channel
00F694  1               
00F694  1               MusicHandler:
00F694  1  A5 FC                lda EventMusicQueue     ;check event music queue
00F696  1  D0 0C                bne LoadEventMusic
00F698  1  A5 FB                lda AreaMusicQueue      ;check area music queue
00F69A  1  D0 2C                bne LoadAreaMusic
00F69C  1  AD B1 07             lda EventMusicBuffer    ;check both buffers
00F69F  1  05 F4                ora AreaMusicBuffer
00F6A1  1  D0 EE                bne ContinueMusic
00F6A3  1  60                   rts                     ;no music, then leave
00F6A4  1               
00F6A4  1               LoadEventMusic:
00F6A4  1  8D B1 07                sta EventMusicBuffer      ;copy event music queue contents to buffer
00F6A7  1  C9 01                   cmp #DeathMusic           ;is it death music?
00F6A9  1  D0 06                   bne NoStopSfx             ;if not, jump elsewhere
00F6AB  1  20 A7 F4                jsr StopSquare1Sfx        ;stop sfx in square 1 and 2
00F6AE  1  20 71 F5                jsr StopSquare2Sfx        ;but clear only square 1's sfx buffer
00F6B1  1  A6 F4        NoStopSfx: ldx AreaMusicBuffer
00F6B3  1  8E C5 07                stx AreaMusicBuffer_Alt   ;save current area music buffer to be re-obtained later
00F6B6  1  A0 00                   ldy #$00
00F6B8  1  8C C4 07                sty NoteLengthTblAdder    ;default value for additional length byte offset
00F6BB  1  84 F4                   sty AreaMusicBuffer       ;clear area music buffer
00F6BD  1  C9 40                   cmp #TimeRunningOutMusic  ;is it time running out music?
00F6BF  1  D0 30                   bne FindEventMusicHeader
00F6C1  1  A2 08                   ldx #$08                  ;load offset to be added to length byte of header
00F6C3  1  8E C4 07                stx NoteLengthTblAdder
00F6C6  1  D0 29                   bne FindEventMusicHeader  ;unconditional branch
00F6C8  1               
00F6C8  1               LoadAreaMusic:
00F6C8  1  C9 04                 cmp #$04                  ;is it underground music?
00F6CA  1  D0 03                 bne NoStop1               ;no, do not stop square 1 sfx
00F6CC  1  20 A7 F4              jsr StopSquare1Sfx
00F6CF  1  A0 10        NoStop1: ldy #$10                  ;start counter used only by ground level music
00F6D1  1  8C C7 07     GMLoopB: sty GroundMusicHeaderOfs
00F6D4  1               
00F6D4  1               HandleAreaMusicLoopB:
00F6D4  1  A0 00                 ldy #$00                  ;clear event music buffer
00F6D6  1  8C B1 07              sty EventMusicBuffer
00F6D9  1  85 F4                 sta AreaMusicBuffer       ;copy area music queue contents to buffer
00F6DB  1  C9 01                 cmp #$01                  ;is it ground level music?
00F6DD  1  D0 0E                 bne FindAreaMusicHeader
00F6DF  1  EE C7 07              inc GroundMusicHeaderOfs  ;increment but only if playing ground level music
00F6E2  1  AC C7 07              ldy GroundMusicHeaderOfs  ;is it time to loopback ground level music?
00F6E5  1  C0 32                 cpy #$32
00F6E7  1  D0 0C                 bne LoadHeader            ;branch ahead with alternate offset
00F6E9  1  A0 11                 ldy #$11
00F6EB  1  D0 E4                 bne GMLoopB               ;unconditional branch
00F6ED  1               
00F6ED  1               FindAreaMusicHeader:
00F6ED  1  A0 08                ldy #$08                   ;load Y for offset of area music
00F6EF  1  84 F7                sty MusicOffset_Square2    ;residual instruction here
00F6F1  1               
00F6F1  1               FindEventMusicHeader:
00F6F1  1  C8                   iny                       ;increment Y pointer based on previously loaded queue contents
00F6F2  1  4A                   lsr                       ;bit shift and increment until we find a set bit for music
00F6F3  1  90 FC                bcc FindEventMusicHeader
00F6F5  1               
00F6F5  1               LoadHeader:
00F6F5  1  B9 0C F9             lda MusicHeaderOffsetData,y  ;load offset for header
00F6F8  1  A8                   tay
00F6F9  1  B9 0D F9             lda MusicHeaderData,y        ;now load the header
00F6FC  1  85 F0                sta NoteLenLookupTblOfs
00F6FE  1  B9 0E F9             lda MusicHeaderData+1,y
00F701  1  85 F5                sta MusicDataLow
00F703  1  B9 0F F9             lda MusicHeaderData+2,y
00F706  1  85 F6                sta MusicDataHigh
00F708  1  B9 10 F9             lda MusicHeaderData+3,y
00F70B  1  85 F9                sta MusicOffset_Triangle
00F70D  1  B9 11 F9             lda MusicHeaderData+4,y
00F710  1  85 F8                sta MusicOffset_Square1
00F712  1  B9 12 F9             lda MusicHeaderData+5,y
00F715  1  8D B0 07             sta MusicOffset_Noise
00F718  1  8D C1 07             sta NoiseDataLoopbackOfs
00F71B  1  A9 01                lda #$01                     ;initialize music note counters
00F71D  1  8D B4 07             sta Squ2_NoteLenCounter
00F720  1  8D B6 07             sta Squ1_NoteLenCounter
00F723  1  8D B9 07             sta Tri_NoteLenCounter
00F726  1  8D BA 07             sta Noise_BeatLenCounter
00F729  1  A9 00                lda #$00                     ;initialize music data offset for square 2
00F72B  1  85 F7                sta MusicOffset_Square2
00F72D  1  8D CA 07             sta AltRegContentFlag        ;initialize alternate control reg data used by square 1
00F730  1  A9 0B                lda #$0b                     ;disable triangle channel and reenable it
00F732  1  8D 15 40             sta SND_MASTERCTRL_REG
00F735  1  A9 0F                lda #$0f
00F737  1  8D 15 40             sta SND_MASTERCTRL_REG
00F73A  1               
00F73A  1               HandleSquare2Music:
00F73A  1  CE B4 07             dec Squ2_NoteLenCounter  ;decrement square 2 note length
00F73D  1  D0 5F                bne MiscSqu2MusicTasks   ;is it time for more data?  if not, branch to end tasks
00F73F  1  A4 F7                ldy MusicOffset_Square2  ;increment square 2 music offset and fetch data
00F741  1  E6 F7                inc MusicOffset_Square2
00F743  1  B1 F5                lda (MusicData),y
00F745  1  F0 04                beq EndOfMusicData       ;if zero, the data is a null terminator
00F747  1  10 3D                bpl Squ2NoteHandler      ;if non-negative, data is a note
00F749  1  D0 2F                bne Squ2LengthHandler    ;otherwise it is length data
00F74B  1               
00F74B  1               EndOfMusicData:
00F74B  1  AD B1 07             lda EventMusicBuffer     ;check secondary buffer for time running out music
00F74E  1  C9 40                cmp #TimeRunningOutMusic
00F750  1  D0 05                bne NotTRO
00F752  1  AD C5 07             lda AreaMusicBuffer_Alt  ;load previously saved contents of primary buffer
00F755  1  D0 1D                bne MusicLoopBack        ;and start playing the song again if there is one
00F757  1  29 04        NotTRO: and #VictoryMusic        ;check for victory music (the only secondary that loops)
00F759  1  D0 1C                bne VictoryMLoopBack
00F75B  1  A5 F4                lda AreaMusicBuffer      ;check primary buffer for any music except pipe intro
00F75D  1  29 5F                and #%01011111
00F75F  1  D0 13                bne MusicLoopBack        ;if any area music except pipe intro, music loops
00F761  1  A9 00                lda #$00                 ;clear primary and secondary buffers and initialize
00F763  1  85 F4                sta AreaMusicBuffer      ;control regs of square and triangle channels
00F765  1  8D B1 07             sta EventMusicBuffer
00F768  1  8D 08 40             sta SND_TRIANGLE_REG
00F76B  1  A9 90                lda #$90
00F76D  1  8D 00 40             sta SND_SQUARE1_REG
00F770  1  8D 04 40             sta SND_SQUARE2_REG
00F773  1  60                   rts
00F774  1               
00F774  1               MusicLoopBack:
00F774  1  4C D4 F6             jmp HandleAreaMusicLoopB
00F777  1               
00F777  1               VictoryMLoopBack:
00F777  1  4C A4 F6             jmp LoadEventMusic
00F77A  1               
00F77A  1               Squ2LengthHandler:
00F77A  1  20 CB F8             jsr ProcessLengthData    ;store length of note
00F77D  1  8D B3 07             sta Squ2_NoteLenBuffer
00F780  1  A4 F7                ldy MusicOffset_Square2  ;fetch another byte (MUST NOT BE LENGTH BYTE!)
00F782  1  E6 F7                inc MusicOffset_Square2
00F784  1  B1 F5                lda (MusicData),y
00F786  1               
00F786  1               Squ2NoteHandler:
00F786  1  A6 F2                  ldx Square2SoundBuffer     ;is there a sound playing on this channel?
00F788  1  D0 0E                  bne SkipFqL1
00F78A  1  20 A9 F3               jsr SetFreq_Squ2           ;no, then play the note
00F78D  1  F0 03                  beq Rest                   ;check to see if note is rest
00F78F  1  20 D8 F8               jsr LoadControlRegs        ;if not, load control regs for square 2
00F792  1  8D B5 07     Rest:     sta Squ2_EnvelopeDataCtrl  ;save contents of A
00F795  1  20 9F F3               jsr Dump_Sq2_Regs          ;dump X and Y into square 2 control regs
00F798  1  AD B3 07     SkipFqL1: lda Squ2_NoteLenBuffer     ;save length in square 2 note counter
00F79B  1  8D B4 07               sta Squ2_NoteLenCounter
00F79E  1               
00F79E  1               MiscSqu2MusicTasks:
00F79E  1  A5 F2                   lda Square2SoundBuffer     ;is there a sound playing on square 2?
00F7A0  1  D0 1A                   bne HandleSquare1Music
00F7A2  1  AD B1 07                lda EventMusicBuffer       ;check for death music or d4 set on secondary buffer
00F7A5  1  29 91                   and #%10010001             ;note that regs for death music or d4 are loaded by default
00F7A7  1  D0 13                   bne HandleSquare1Music
00F7A9  1  AC B5 07                ldy Squ2_EnvelopeDataCtrl  ;check for contents saved from LoadControlRegs
00F7AC  1  F0 03                   beq NoDecEnv1
00F7AE  1  CE B5 07                dec Squ2_EnvelopeDataCtrl  ;decrement unless already zero
00F7B1  1  20 F4 F8     NoDecEnv1: jsr LoadEnvelopeData       ;do a load of envelope data to replace default
00F7B4  1  8D 04 40                sta SND_SQUARE2_REG        ;based on offset set by first load unless playing
00F7B7  1  A2 7F                   ldx #$7f                   ;death music or d4 set on secondary buffer
00F7B9  1  8E 05 40                stx SND_SQUARE2_REG+1
00F7BC  1               
00F7BC  1               HandleSquare1Music:
00F7BC  1  A4 F8                ldy MusicOffset_Square1    ;is there a nonzero offset here?
00F7BE  1  F0 5A                beq HandleTriangleMusic    ;if not, skip ahead to the triangle channel
00F7C0  1  CE B6 07             dec Squ1_NoteLenCounter    ;decrement square 1 note length
00F7C3  1  D0 32                bne MiscSqu1MusicTasks     ;is it time for more data?
00F7C5  1               
00F7C5  1               FetchSqu1MusicData:
00F7C5  1  A4 F8                ldy MusicOffset_Square1    ;increment square 1 music offset and fetch data
00F7C7  1  E6 F8                inc MusicOffset_Square1
00F7C9  1  B1 F5                lda (MusicData),y
00F7CB  1  D0 0F                bne Squ1NoteHandler        ;if nonzero, then skip this part
00F7CD  1  A9 83                lda #$83
00F7CF  1  8D 00 40             sta SND_SQUARE1_REG        ;store some data into control regs for square 1
00F7D2  1  A9 94                lda #$94                   ;and fetch another byte of data, used to give
00F7D4  1  8D 01 40             sta SND_SQUARE1_REG+1      ;death music its unique sound
00F7D7  1  8D CA 07             sta AltRegContentFlag
00F7DA  1  D0 E9                bne FetchSqu1MusicData     ;unconditional branch
00F7DC  1               
00F7DC  1               Squ1NoteHandler:
00F7DC  1  20 C5 F8                jsr AlternateLengthHandler
00F7DF  1  8D B6 07                sta Squ1_NoteLenCounter    ;save contents of A in square 1 note counter
00F7E2  1  A4 F1                   ldy Square1SoundBuffer     ;is there a sound playing on square 1?
00F7E4  1  D0 34                   bne HandleTriangleMusic
00F7E6  1  8A                      txa
00F7E7  1  29 3E                   and #%00111110             ;change saved data to appropriate note format
00F7E9  1  20 8B F3                jsr SetFreq_Squ1           ;play the note
00F7EC  1  F0 03                   beq SkipCtrlL
00F7EE  1  20 D8 F8                jsr LoadControlRegs
00F7F1  1  8D B7 07     SkipCtrlL: sta Squ1_EnvelopeDataCtrl  ;save envelope offset
00F7F4  1  20 81 F3                jsr Dump_Squ1_Regs
00F7F7  1               
00F7F7  1               MiscSqu1MusicTasks:
00F7F7  1  A5 F1                      lda Square1SoundBuffer     ;is there a sound playing on square 1?
00F7F9  1  D0 1F                      bne HandleTriangleMusic
00F7FB  1  AD B1 07                   lda EventMusicBuffer       ;check for death music or d4 set on secondary buffer
00F7FE  1  29 91                      and #%10010001
00F800  1  D0 0E                      bne DeathMAltReg
00F802  1  AC B7 07                   ldy Squ1_EnvelopeDataCtrl  ;check saved envelope offset
00F805  1  F0 03                      beq NoDecEnv2
00F807  1  CE B7 07                   dec Squ1_EnvelopeDataCtrl  ;decrement unless already zero
00F80A  1  20 F4 F8     NoDecEnv2:    jsr LoadEnvelopeData       ;do a load of envelope data
00F80D  1  8D 00 40                   sta SND_SQUARE1_REG        ;based on offset set by first load
00F810  1  AD CA 07     DeathMAltReg: lda AltRegContentFlag      ;check for alternate control reg data
00F813  1  D0 02                      bne DoAltLoad
00F815  1  A9 7F                      lda #$7f                   ;load this value if zero, the alternate value
00F817  1  8D 01 40     DoAltLoad:    sta SND_SQUARE1_REG+1      ;if nonzero, and let's move on
00F81A  1               
00F81A  1               HandleTriangleMusic:
00F81A  1  A5 F9                lda MusicOffset_Triangle
00F81C  1  CE B9 07             dec Tri_NoteLenCounter    ;decrement triangle note length
00F81F  1  D0 4C                bne HandleNoiseMusic      ;is it time for more data?
00F821  1  A4 F9                ldy MusicOffset_Triangle  ;increment square 1 music offset and fetch data
00F823  1  E6 F9                inc MusicOffset_Triangle
00F825  1  B1 F5                lda (MusicData),y
00F827  1  F0 41                beq LoadTriCtrlReg        ;if zero, skip all this and move on to noise
00F829  1  10 13                bpl TriNoteHandler        ;if non-negative, data is note
00F82B  1  20 CB F8             jsr ProcessLengthData     ;otherwise, it is length data
00F82E  1  8D B8 07             sta Tri_NoteLenBuffer     ;save contents of A
00F831  1  A9 1F                lda #$1f
00F833  1  8D 08 40             sta SND_TRIANGLE_REG      ;load some default data for triangle control reg
00F836  1  A4 F9                ldy MusicOffset_Triangle  ;fetch another byte
00F838  1  E6 F9                inc MusicOffset_Triangle
00F83A  1  B1 F5                lda (MusicData),y
00F83C  1  F0 2C                beq LoadTriCtrlReg        ;check once more for nonzero data
00F83E  1               
00F83E  1               TriNoteHandler:
00F83E  1  20 AD F3               jsr SetFreq_Tri
00F841  1  AE B8 07               ldx Tri_NoteLenBuffer   ;save length in triangle note counter
00F844  1  8E B9 07               stx Tri_NoteLenCounter
00F847  1  AD B1 07               lda EventMusicBuffer
00F84A  1  29 6E                  and #%01101110          ;check for death music or d4 set on secondary buffer
00F84C  1  D0 06                  bne NotDOrD4            ;if playing any other secondary, skip primary buffer check
00F84E  1  A5 F4                  lda AreaMusicBuffer     ;check primary buffer for water or castle level music
00F850  1  29 0A                  and #%00001010
00F852  1  F0 19                  beq HandleNoiseMusic    ;if playing any other primary, or death or d4, go on to noise routine
00F854  1  8A           NotDOrD4: txa                     ;if playing water or castle music or any secondary
00F855  1  C9 12                  cmp #$12                ;besides death music or d4 set, check length of note
00F857  1  B0 0F                  bcs LongN
00F859  1  AD B1 07               lda EventMusicBuffer    ;check for win castle music again if not playing a long note
00F85C  1  29 08                  and #EndOfCastleMusic
00F85E  1  F0 04                  beq MediN
00F860  1  A9 0F                  lda #$0f                ;load value $0f if playing the win castle music and playing a short
00F862  1  D0 06                  bne LoadTriCtrlReg      ;note, load value $1f if playing water or castle level music or any
00F864  1  A9 1F        MediN:    lda #$1f                ;secondary besides death and d4 except win castle or win castle and playing
00F866  1  D0 02                  bne LoadTriCtrlReg      ;a short note, and load value $ff if playing a long note on water, castle
00F868  1  A9 FF        LongN:    lda #$ff                ;or any secondary (including win castle) except death and d4
00F86A  1               
00F86A  1               LoadTriCtrlReg:
00F86A  1  8D 08 40             sta SND_TRIANGLE_REG      ;save final contents of A into control reg for triangle
00F86D  1               
00F86D  1               HandleNoiseMusic:
00F86D  1  A5 F4                lda AreaMusicBuffer       ;check if playing underground or castle music
00F86F  1  29 F3                and #%11110011
00F871  1  F0 51                beq ExitMusicHandler      ;if so, skip the noise routine
00F873  1  CE BA 07             dec Noise_BeatLenCounter  ;decrement noise beat length
00F876  1  D0 4C                bne ExitMusicHandler      ;is it time for more data?
00F878  1               
00F878  1               FetchNoiseBeatData:
00F878  1  AC B0 07             ldy MusicOffset_Noise       ;increment noise beat offset and fetch data
00F87B  1  EE B0 07             inc MusicOffset_Noise
00F87E  1  B1 F5                lda (MusicData),y           ;get noise beat data, if nonzero, branch to handle
00F880  1  D0 08                bne NoiseBeatHandler
00F882  1  AD C1 07             lda NoiseDataLoopbackOfs    ;if data is zero, reload original noise beat offset
00F885  1  8D B0 07             sta MusicOffset_Noise       ;and loopback next time around
00F888  1  D0 EE                bne FetchNoiseBeatData      ;unconditional branch
00F88A  1               
00F88A  1               NoiseBeatHandler:
00F88A  1  20 C5 F8             jsr AlternateLengthHandler
00F88D  1  8D BA 07             sta Noise_BeatLenCounter    ;store length in noise beat counter
00F890  1  8A                   txa
00F891  1  29 3E                and #%00111110              ;reload data and erase length bits
00F893  1  F0 24                beq SilentBeat              ;if no beat data, silence
00F895  1  C9 30                cmp #$30                    ;check the beat data and play the appropriate
00F897  1  F0 18                beq LongBeat                ;noise accordingly
00F899  1  C9 20                cmp #$20
00F89B  1  F0 0C                beq StrongBeat
00F89D  1  29 10                and #%00010000
00F89F  1  F0 18                beq SilentBeat
00F8A1  1  A9 1C                lda #$1c        ;short beat data
00F8A3  1  A2 03                ldx #$03
00F8A5  1  A0 18                ldy #$18
00F8A7  1  D0 12                bne PlayBeat
00F8A9  1               
00F8A9  1               StrongBeat:
00F8A9  1  A9 1C                lda #$1c        ;strong beat data
00F8AB  1  A2 0C                ldx #$0c
00F8AD  1  A0 18                ldy #$18
00F8AF  1  D0 0A                bne PlayBeat
00F8B1  1               
00F8B1  1               LongBeat:
00F8B1  1  A9 1C                lda #$1c        ;long beat data
00F8B3  1  A2 03                ldx #$03
00F8B5  1  A0 58                ldy #$58
00F8B7  1  D0 02                bne PlayBeat
00F8B9  1               
00F8B9  1               SilentBeat:
00F8B9  1  A9 10                lda #$10        ;silence
00F8BB  1               
00F8BB  1               PlayBeat:
00F8BB  1  8D 0C 40             sta SND_NOISE_REG    ;load beat data into noise regs
00F8BE  1  8E 0E 40             stx SND_NOISE_REG+2
00F8C1  1  8C 0F 40             sty SND_NOISE_REG+3
00F8C4  1               
00F8C4  1               ExitMusicHandler:
00F8C4  1  60                   rts
00F8C5  1               
00F8C5  1               AlternateLengthHandler:
00F8C5  1  AA                   tax            ;save a copy of original byte into X
00F8C6  1  6A                   ror            ;save LSB from original byte into carry
00F8C7  1  8A                   txa            ;reload original byte and rotate three times
00F8C8  1  2A                   rol            ;turning xx00000x into 00000xxx, with the
00F8C9  1  2A                   rol            ;bit in carry as the MSB here
00F8CA  1  2A                   rol
00F8CB  1               
00F8CB  1               ProcessLengthData:
00F8CB  1  29 07                and #%00000111              ;clear all but the three LSBs
00F8CD  1  18                   clc
00F8CE  1  65 F0                adc $f0                     ;add offset loaded from first header byte
00F8D0  1  6D C4 07             adc NoteLengthTblAdder      ;add extra if time running out music
00F8D3  1  A8                   tay
00F8D4  1  B9 66 FF             lda MusicLengthLookupTbl,y  ;load length
00F8D7  1  60                   rts
00F8D8  1               
00F8D8  1               LoadControlRegs:
00F8D8  1  AD B1 07                lda EventMusicBuffer  ;check secondary buffer for win castle music
00F8DB  1  29 08                   and #EndOfCastleMusic
00F8DD  1  F0 04                   beq NotECstlM
00F8DF  1  A9 04                   lda #$04              ;this value is only used for win castle music
00F8E1  1  D0 0C                   bne AllMus            ;unconditional branch
00F8E3  1  A5 F4        NotECstlM: lda AreaMusicBuffer
00F8E5  1  29 7D                   and #%01111101        ;check primary buffer for water music
00F8E7  1  F0 04                   beq WaterMus
00F8E9  1  A9 08                   lda #$08              ;this is the default value for all other music
00F8EB  1  D0 02                   bne AllMus
00F8ED  1  A9 28        WaterMus:  lda #$28              ;this value is used for water music and all other event music
00F8EF  1  A2 82        AllMus:    ldx #$82              ;load contents of other sound regs for square 2
00F8F1  1  A0 7F                   ldy #$7f
00F8F3  1  60                      rts
00F8F4  1               
00F8F4  1               LoadEnvelopeData:
00F8F4  1  AD B1 07             lda EventMusicBuffer           ;check secondary buffer for win castle music
00F8F7  1  29 08                and #EndOfCastleMusic
00F8F9  1  F0 04                beq LoadUsualEnvData
00F8FB  1  B9 96 FF             lda EndOfCastleMusicEnvData,y  ;load data from offset for win castle music
00F8FE  1  60                   rts
