00C69C  1               BulletBillCheepCheep:
00C69C  1  AD 8F 07              lda FrenzyEnemyTimer      ;if timer not expired yet, branch to leave
00C69F  1  D0 6F                 bne ExF17
00C6A1  1  AD 4E 07              lda AreaType              ;are we in a water-type level?
00C6A4  1  D0 57                 bne DoBulletBills         ;if not, branch elsewhere
00C6A6  1  E0 03                 cpx #$03                  ;are we past third enemy slot?
00C6A8  1  B0 66                 bcs ExF17                 ;if so, branch to leave
00C6AA  1  A0 00                 ldy #$00                  ;load default offset
00C6AC  1  BD A7 07              lda PseudoRandomBitReg,x
00C6AF  1  C9 AA                 cmp #$aa                  ;check first part of LSFR against preset value
00C6B1  1  90 01                 bcc ChkW2                 ;if less than preset, do not increment offset
00C6B3  1  C8                    iny                       ;otherwise increment
00C6B4  1  AD 5F 07     ChkW2:   lda WorldNumber           ;check world number
00C6B7  1  C9 01                 cmp #World2
00C6B9  1  F0 01                 beq Get17ID               ;if we're on world 2, do not increment offset
00C6BB  1  C8                    iny                       ;otherwise increment
00C6BC  1  98           Get17ID: tya
00C6BD  1  29 01                 and #%00000001            ;mask out all but last bit of offset
00C6BF  1  A8                    tay
00C6C0  1  B9 9A C6              lda SwimCC_IDData,y       ;load identifier for cheep-cheeps
00C6C3  1  95 16        Set17ID: sta Enemy_ID,x            ;store whatever's in A as enemy identifier
00C6C5  1  AD DD 06              lda BitMFilter
00C6C8  1  C9 FF                 cmp #$ff                  ;if not all bits set, skip init part and compare bits
00C6CA  1  D0 05                 bne GetRBit
00C6CC  1  A9 00                 lda #$00                  ;initialize vertical position filter
00C6CE  1  8D DD 06              sta BitMFilter
00C6D1  1  BD A7 07     GetRBit: lda PseudoRandomBitReg,x  ;get first part of LSFR
00C6D4  1  29 07                 and #%00000111            ;mask out all but 3 LSB
00C6D6  1  A8           ChkRBit: tay                       ;use as offset
00C6D7  1  B9 8A C6              lda Bitmasks,y            ;load bitmask
00C6DA  1  2C DD 06              bit BitMFilter            ;perform AND on filter without changing it
00C6DD  1  F0 07                 beq AddFBit
00C6DF  1  C8                    iny                       ;increment offset
00C6E0  1  98                    tya
00C6E1  1  29 07                 and #%00000111            ;mask out all but 3 LSB thus keeping it 0-7
00C6E3  1  4C D6 C6              jmp ChkRBit               ;do another check
00C6E6  1  0D DD 06     AddFBit: ora BitMFilter            ;add bit to already set bits in filter
00C6E9  1  8D DD 06              sta BitMFilter            ;and store
00C6EC  1  B9 92 C6              lda Enemy17YPosData,y     ;load vertical position using offset
00C6EF  1  20 D8 C5              jsr PutAtRightExtent      ;set vertical position and other values
00C6F2  1  9D 17 04              sta Enemy_YMF_Dummy,x     ;initialize dummy variable
00C6F5  1  A9 20                 lda #$20                  ;set timer
