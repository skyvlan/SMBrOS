008A61  1               ReplaceBlockMetatile:
008A61  1  20 6D 8A            jsr WriteBlockMetatile    ;write metatile to vram buffer to replace block object
008A64  1  EE F0 03            inc Block_ResidualCounter ;increment unused counter (residual code)
008A67  1  DE EC 03            dec Block_RepFlag,x       ;decrement flag (residual code)
008A6A  1  60                  rts                       ;leave
008A6B  1               
008A6B  1               DestroyBlockMetatile:
008A6B  1  A9 00               lda #$00       ;force blank metatile if branched/jumped to this point
008A6D  1               
008A6D  1               WriteBlockMetatile:
008A6D  1  A0 03                     ldy #$03                ;load offset for blank metatile
008A6F  1  C9 00                     cmp #$00                ;check contents of A for blank metatile
008A71  1  F0 14                     beq UseBOffset          ;branch if found (unconditional if branched from 8a6b)
008A73  1  A0 00                     ldy #$00                ;load offset for brick metatile w/ line
008A75  1  C9 58                     cmp #$58
008A77  1  F0 0E                     beq UseBOffset          ;use offset if metatile is brick with coins (w/ line)
008A79  1  C9 51                     cmp #$51
008A7B  1  F0 0A                     beq UseBOffset          ;use offset if metatile is breakable brick w/ line
008A7D  1  C8                        iny                     ;increment offset for brick metatile w/o line
008A7E  1  C9 5D                     cmp #$5d
008A80  1  F0 05                     beq UseBOffset          ;use offset if metatile is brick with coins (w/o line)
008A82  1  C9 52                     cmp #$52
008A84  1  F0 01                     beq UseBOffset          ;use offset if metatile is breakable brick w/o line
008A86  1  C8                        iny                     ;if any other metatile, increment offset for empty block
008A87  1  98           UseBOffset:  tya                     ;put Y in A
008A88  1  AC 00 03                  ldy VRAM_Buffer1_Offset ;get vram buffer offset
008A8B  1  C8                        iny                     ;move onto next byte
008A8C  1  20 97 8A                  jsr PutBlockMetatile    ;get appropriate block data and write to vram buffer
008A8F  1  88           MoveVOffset: dey                     ;decrement vram buffer offset
008A90  1  98                        tya                     ;add 10 bytes to it
008A91  1  18                        clc
008A92  1  69 0A                     adc #10
