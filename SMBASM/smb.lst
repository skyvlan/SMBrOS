00E06C  1  C9 05               cmp #$05                ;used to determine whether enemy landed from falling
00E06E  1  B0 72               bcs ChkForRedKoopa      ;branch if lower nybble in range of $0d-$0f before subtract
00E070  1  B5 1E               lda Enemy_State,x
00E072  1  29 40               and #%01000000          ;branch if d6 in enemy state is set
00E074  1  D0 57               bne LandEnemyInitState
00E076  1  B5 1E               lda Enemy_State,x
00E078  1  0A                  asl                     ;branch if d7 in enemy state is not set
00E079  1  90 03               bcc ChkLandedEnemyState
00E07B  1  4C FE E0     SChkA: jmp DoEnemySideCheck    ;if lower nybble < $0d, d7 set but d6 not set, jump here
00E07E  1               
00E07E  1               ChkLandedEnemyState:
00E07E  1  B5 1E                   lda Enemy_State,x         ;if enemy in normal state, branch back to jump here
00E080  1  F0 F9                   beq SChkA
00E082  1  C9 05                   cmp #$05                  ;if in state used by spiny's egg
00E084  1  F0 1F                   beq ProcEnemyDirection    ;then branch elsewhere
00E086  1  C9 03                   cmp #$03                  ;if already in state used by koopas and buzzy beetles
00E088  1  B0 1A                   bcs ExSteChk              ;or in higher numbered state, branch to leave
00E08A  1  B5 1E                   lda Enemy_State,x         ;load enemy state again (why?)
00E08C  1  C9 02                   cmp #$02                  ;if not in $02 state (used by koopas and buzzy beetles)
00E08E  1  D0 15                   bne ProcEnemyDirection    ;then branch elsewhere
00E090  1  A9 10                   lda #$10                  ;load default timer here
00E092  1  B4 16                   ldy Enemy_ID,x            ;check enemy identifier for spiny
00E094  1  C0 12                   cpy #Spiny
00E096  1  D0 02                   bne SetForStn             ;branch if not found
00E098  1  A9 00                   lda #$00                  ;set timer for $00 if spiny
00E09A  1  9D 96 07     SetForStn: sta EnemyIntervalTimer,x  ;set timer here
00E09D  1  A9 03                   lda #$03                  ;set state here, apparently used to render
00E09F  1  95 1E                   sta Enemy_State,x         ;upside-down koopas and buzzy beetles
00E0A1  1  20 4F E1                jsr EnemyLanding          ;then land it properly
00E0A4  1  60           ExSteChk:  rts                       ;then leave
