00D084  1  AD 47 07                lda TimerControl           ;if master timer control not set,
00D087  1  F0 03                   beq ChkMouth               ;skip jump and execute code here
00D089  1  4C 39 D1                jmp SkipToFB               ;otherwise, jump over a bunch of code
00D08C  1  AD 63 03     ChkMouth:  lda BowserBodyControls     ;check bowser's mouth
00D08F  1  10 03                   bpl FeetTmr                ;if bit clear, go ahead with code here
00D091  1  4C 0F D1                jmp HammerChk              ;otherwise skip a whole section starting here
00D094  1  CE 64 03     FeetTmr:   dec BowserFeetCounter      ;decrement timer to control bowser's feet
00D097  1  D0 0D                   bne ResetMDr               ;if not expired, skip this part
00D099  1  A9 20                   lda #$20                   ;otherwise, reset timer
00D09B  1  8D 64 03                sta BowserFeetCounter
00D09E  1  AD 63 03                lda BowserBodyControls     ;and invert bit used
00D0A1  1  49 01                   eor #%00000001             ;to control bowser's feet
00D0A3  1  8D 63 03                sta BowserBodyControls
00D0A6  1  A5 09        ResetMDr:  lda FrameCounter           ;check frame counter
00D0A8  1  29 0F                   and #%00001111             ;if not on every sixteenth frame, skip
00D0AA  1  D0 04                   bne B_FaceP                ;ahead to continue code
00D0AC  1  A9 02                   lda #$02                   ;otherwise reset moving/facing direction every
00D0AE  1  95 46                   sta Enemy_MovingDir,x      ;sixteen frames
00D0B0  1  BD 8A 07     B_FaceP:   lda EnemyFrameTimer,x      ;if timer set here expired,
00D0B3  1  F0 1C                   beq GetPRCmp               ;branch to next section
00D0B5  1  20 43 E1                jsr PlayerEnemyDiff        ;get horizontal difference between player and bowser,
00D0B8  1  10 17                   bpl GetPRCmp               ;and branch if bowser to the right of the player
00D0BA  1  A9 01                   lda #$01
00D0BC  1  95 46                   sta Enemy_MovingDir,x      ;set bowser to move and face to the right
00D0BE  1  A9 02                   lda #$02
00D0C0  1  8D 65 03                sta BowserMovementSpeed    ;set movement speed
00D0C3  1  A9 20                   lda #$20
00D0C5  1  9D 8A 07                sta EnemyFrameTimer,x      ;set timer here
00D0C8  1  8D 90 07                sta BowserFireBreathTimer  ;set timer used for bowser's flame
00D0CB  1  B5 87                   lda Enemy_X_Position,x
00D0CD  1  C9 C8                   cmp #$c8                   ;if bowser to the right past a certain point,
00D0CF  1  B0 3E                   bcs HammerChk              ;skip ahead to some other section
00D0D1  1  A5 09        GetPRCmp:  lda FrameCounter           ;get frame counter
00D0D3  1  29 03                   and #%00000011
00D0D5  1  D0 38                   bne HammerChk              ;execute this code every fourth frame, otherwise branch
00D0D7  1  B5 87                   lda Enemy_X_Position,x
00D0D9  1  CD 66 03                cmp BowserOrigXPos         ;if bowser not at original horizontal position,
00D0DC  1  D0 0C                   bne GetDToO                ;branch to skip this part
00D0DE  1  BD A7 07                lda PseudoRandomBitReg,x
00D0E1  1  29 03                   and #%00000011             ;get pseudorandom offset
00D0E3  1  A8                      tay
00D0E4  1  B9 61 D0                lda PRandomRange,y         ;load value using pseudorandom offset
00D0E7  1  8D DC 06                sta MaxRangeFromOrigin     ;and store here
00D0EA  1  B5 87        GetDToO:   lda Enemy_X_Position,x
00D0EC  1  18                      clc                        ;add movement speed to bowser's horizontal
00D0ED  1  6D 65 03                adc BowserMovementSpeed    ;coordinate and save as new horizontal position
00D0F0  1  95 87                   sta Enemy_X_Position,x
00D0F2  1  B4 46                   ldy Enemy_MovingDir,x
00D0F4  1  C0 01                   cpy #$01                   ;if bowser moving and facing to the right, skip ahead
00D0F6  1  F0 17                   beq HammerChk
00D0F8  1  A0 FF                   ldy #$ff                   ;set default movement speed here (move left)
00D0FA  1  38                      sec                        ;get difference of current vs. original
00D0FB  1  ED 66 03                sbc BowserOrigXPos         ;horizontal position
00D0FE  1  10 07                   bpl CompDToO               ;if current position to the right of original, skip ahead
00D100  1  49 FF                   eor #$ff
00D102  1  18                      clc                        ;get two's compliment
00D103  1  69 01                   adc #$01
00D105  1  A0 01                   ldy #$01                   ;set alternate movement speed here (move right)
00D107  1  CD DC 06     CompDToO:  cmp MaxRangeFromOrigin     ;compare difference with pseudorandom value
00D10A  1  90 03                   bcc HammerChk              ;if difference < pseudorandom value, leave speed alone
00D10C  1  8C 65 03                sty BowserMovementSpeed    ;otherwise change bowser's movement speed
00D10F  1  BD 8A 07     HammerChk: lda EnemyFrameTimer,x      ;if timer set here not expired yet, skip ahead to
00D112  1  D0 28                   bne MakeBJump              ;some other section of code
00D114  1  20 8C BF                jsr MoveEnemySlowVert      ;otherwise start by moving bowser downwards
00D117  1  AD 5F 07                lda WorldNumber            ;check world number
00D11A  1  C9 05                   cmp #World6
00D11C  1  90 09                   bcc SetHmrTmr              ;if world 1-5, skip this part (not time to throw hammers yet)
00D11E  1  A5 09                   lda FrameCounter
00D120  1  29 03                   and #%00000011             ;check to see if it's time to execute sub
00D122  1  D0 03                   bne SetHmrTmr              ;if not, skip sub, otherwise
00D124  1  20 94 BA                jsr SpawnHammerObj         ;execute sub on every fourth frame to spawn misc object (hammer)
00D127  1  B5 CF        SetHmrTmr: lda Enemy_Y_Position,x     ;get current vertical position
00D129  1  C9 80                   cmp #$80                   ;if still above a certain point
00D12B  1  90 1C                   bcc ChkFireB               ;then skip to world number check for flames
00D12D  1  BD A7 07                lda PseudoRandomBitReg,x
00D130  1  29 03                   and #%00000011             ;get pseudorandom offset
00D132  1  A8                      tay
00D133  1  B9 61 D0                lda PRandomRange,y         ;get value using pseudorandom offset
00D136  1  9D 8A 07                sta EnemyFrameTimer,x      ;set for timer here
00D139  1  4C 49 D1     SkipToFB:  jmp ChkFireB               ;jump to execute flames code
00D13C  1  C9 01        MakeBJump: cmp #$01                   ;if timer not yet about to expire,
00D13E  1  D0 09                   bne ChkFireB               ;skip ahead to next part
00D140  1  D6 CF                   dec Enemy_Y_Position,x     ;otherwise decrement vertical coordinate
00D142  1  20 63 C3                jsr InitVStf               ;initialize movement amount
00D145  1  A9 FE                   lda #$fe
00D147  1  95 A0                   sta Enemy_Y_Speed,x        ;set vertical speed to move bowser upwards
00D149  1  AD 5F 07     ChkFireB:  lda WorldNumber            ;check world number here
00D14C  1  C9 07                   cmp #World8                ;world 8?
00D14E  1  F0 04                   beq SpawnFBr               ;if so, execute this part here
00D150  1  C9 05                   cmp #World6                ;world 6-7?
00D152  1  B0 27                   bcs BowserGfxHandler       ;if so, skip this part here
00D154  1  AD 90 07     SpawnFBr:  lda BowserFireBreathTimer  ;check timer here
00D157  1  D0 22                   bne BowserGfxHandler       ;if not expired yet, skip all of this
00D159  1  A9 20                   lda #$20
00D15B  1  8D 90 07                sta BowserFireBreathTimer  ;set timer here
00D15E  1  AD 63 03                lda BowserBodyControls
00D161  1  49 80                   eor #%10000000             ;invert bowser's mouth bit to open
00D163  1  8D 63 03                sta BowserBodyControls     ;and close bowser's mouth
00D166  1  30 E1                   bmi ChkFireB               ;if bowser's mouth open, loop back
00D168  1  20 D9 D1                jsr SetFlameTimer          ;get timing for bowser's flame
00D16B  1  AC CC 06                ldy SecondaryHardMode
00D16E  1  F0 03                   beq SetFBTmr               ;if secondary hard mode flag not set, skip this
00D170  1  38                      sec
00D171  1  E9 10                   sbc #$10                   ;otherwise subtract from value in A
00D173  1  8D 90 07     SetFBTmr:  sta BowserFireBreathTimer  ;set value as timer here
00D176  1  A9 15                   lda #BowserFlame           ;put bowser's flame identifier
00D178  1  8D CB 06                sta EnemyFrenzyBuffer      ;in enemy frenzy buffer
