0086EC  1  AD 1F 07                lda AreaParserTaskNum     ;check number of tasks
0086EF  1  D0 F8                   bne TaskLoop              ;if tasks still not all done, do another one
0086F1  1  CE 1E 07                dec ColumnSets            ;do we need to render more column sets?
0086F4  1  10 03                   bpl OutputCol
